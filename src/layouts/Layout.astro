		<meta name="google-adsense-account" content="ca-pub-9007237469731115" />

		<!-- Google tag (gtag.js) Google Analytics - Immediate Page Open Tracking -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-MD357K3PTD"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-MD357K3PTD');
		</script>

		<!-- High Performance Deferred AdSense (0 Blocking Time) -->
		<script is:inline>
			(function() {
				let adLoaded = false;
				function loadAdSense() {
					if (adLoaded) return;
					adLoaded = true;
					window.removeEventListener('scroll', loadAdSense);
					window.removeEventListener('mousemove', loadAdSense);
					window.removeEventListener('touchstart', loadAdSense);
					window.removeEventListener('keydown', loadAdSense);
					window.removeEventListener('click', loadAdSense);

					const ad = document.createElement('script');
					ad.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9007237469731115';
					ad.crossOrigin = 'anonymous';
					ad.async = true;
					document.head.appendChild(ad);
				}

				window.addEventListener('scroll', loadAdSense, { passive: true, once: true });
				window.addEventListener('mousemove', loadAdSense, { passive: true, once: true });
				window.addEventListener('touchstart', loadAdSense, { passive: true, once: true });
				window.addEventListener('keydown', loadAdSense, { passive: true, once: true });
				window.addEventListener('click', loadAdSense, { passive: true, once: true });
			})();
		</script>

		<!-- OpenGraph / Twitter Social Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
