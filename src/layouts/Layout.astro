---
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Net Worth Calculator by Age | US Wealth Percentile Benchmark", 
	description = "Calculate your exact net worth percentile by age benchmarked against official US Federal Reserve Survey of Consumer Finances (SCF) data. 100% free, private & anonymous."
} = Astro.props;

const pathname = Astro.url.pathname;
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://getnetworthcalculator.com"
    },
    ...(pathname !== '/' ? [{
      "@type": "ListItem",
      "position": 2,
      "name": title.split('|')[0].trim(),
      "item": `https://getnetworthcalculator.com${pathname}`
    }] : [])
  ]
};
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png" />
		<link rel="apple-touch-icon" sizes="192x192" href="/apple-touch-icon.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- BreadcrumbList Rich Snippet Schema -->
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

		<!-- Google Search Console Verification Meta Tag -->
		<meta name="google-site-verification" content="AIK1SSTCIZNoGQQJT9_VXx635qK1qQtNGa3d06gvPeI" />

		<!-- Google Analytics 4 (GA4 - Deferred via requestIdleCallback for 95-100 PageSpeed Performance) -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			const loadGA = () => {
				const script = document.createElement('script');
				script.src = 'https://www.googletagmanager.com/gtag/js?id=G-MD357K3PTD';
				script.async = true;
				document.head.appendChild(script);
				gtag('js', new Date());
				gtag('config', 'G-MD357K3PTD');
			};
			if ('requestIdleCallback' in window) {
				requestIdleCallback(() => setTimeout(loadGA, 2000));
			} else {
				window.addEventListener('load', () => setTimeout(loadGA, 2500));
			}
		</script>

		<!-- Open Graph / Social SEO -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		
		<title>{title}</title>
		
		<!-- Prevent Flash of Unstyled Theme -->
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return 'dark';
			})();
			if (theme === 'light') {
				document.documentElement.classList.remove('dark');
			} else {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>
	<body class="bg-slate-50 dark:bg-[#060a12] text-slate-900 dark:text-slate-100 min-h-screen flex flex-col selection:bg-emerald-500/20 overflow-x-hidden relative transition-colors duration-300">
		<!-- Dynamic Ambient Glow -->
		<div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none" aria-hidden="true">
			<div class="absolute -top-[30%] left-[25%] w-[50%] h-[50%] rounded-full bg-emerald-500/5 dark:bg-emerald-950/20 blur-[160px]"></div>
			<div class="absolute top-[45%] -right-[15%] w-[45%] h-[45%] rounded-full bg-slate-300/30 dark:bg-slate-900/40 blur-[140px]"></div>
		</div>

		<!-- Navigation Header -->
		<header class="w-full border-b border-slate-200 dark:border-slate-800/60 backdrop-blur-xl bg-white/80 dark:bg-[#060a12]/85 sticky top-0 z-50 transition-colors duration-300">
			<div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
				<!-- Brand Logo -->
				<a href="/" class="flex items-center gap-3.5 group" aria-label="NetWorth. Homepage">
					<div class="w-9 h-9 relative flex items-center justify-center transition-transform group-hover:scale-105">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="w-full h-full" fill="none" aria-hidden="true">
							<path d="M16 3L27 9.35V22.65L16 29L5 22.65V9.35L16 3Z" class="fill-slate-100 dark:fill-[#0b1324] stroke-slate-300 dark:stroke-[#1e293b]" stroke-width="1.5"/>
							<path d="M16 7L23 11.03V19.03L16 23.06L9 19.03V11.03L16 7Z" fill="url(#brand-grad)" stroke="#10b981" stroke-width="1"/>
							<path d="M16 11V19M12 15H20" class="stroke-slate-100 dark:stroke-[#060a12]" stroke-width="2.2" stroke-linecap="round"/>
							<defs>
								<linearGradient id="brand-grad" x1="9" y1="7" x2="23" y2="23" gradientUnits="userSpaceOnUse">
									<stop stop-color="#10b981"/>
									<stop offset="1" stop-color="#047857"/>
								</linearGradient>
							</defs>
						</svg>
					</div>
					<div class="flex flex-col">
						<span class="text-slate-900 dark:text-white font-extrabold tracking-tight text-xl leading-none">NetWorth<span class="text-emerald-500">.</span></span>
						<span class="text-[10px] uppercase font-bold text-slate-700 dark:text-slate-400 tracking-widest leading-none mt-1">Federal Reserve Intelligence</span>
					</div>
				</a>
				
				<!-- Nav Links & Theme Toggle -->
				<div class="flex items-center gap-4 md:gap-6">
					<nav class="hidden md:flex items-center gap-5 text-sm font-semibold text-slate-700 dark:text-slate-400">
						<a href="/" class="hover:text-slate-900 dark:hover:text-white transition-colors">Calculator</a>
						
						<!-- Countries Dropdown -->
						<div class="relative group">
							<button class="hover:text-slate-900 dark:hover:text-white transition-colors flex items-center gap-1 font-semibold">
								<span>🌍 Countries</span> <span class="text-xs">▾</span>
							</button>
							<div class="absolute top-full left-0 mt-2 w-56 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
								<a href="/net-worth-by-age-india" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 text-orange-600 dark:text-orange-400 font-bold transition-colors rounded-lg mx-1">🇮🇳 India (₹ Lakhs &amp; Crores)</a>
								<a href="/net-worth-by-age-australia" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 text-blue-600 dark:text-blue-400 font-bold transition-colors rounded-lg mx-1">🇦🇺 Australia (AUD Super)</a>
								<a href="/net-worth-by-age-usa" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors rounded-lg mx-1">🇺🇸 USA (Federal Reserve)</a>
								<a href="/net-worth-by-age-uk" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors rounded-lg mx-1">🇬🇧 UK (ONS Survey)</a>
								<a href="/net-worth-by-age-canada" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors rounded-lg mx-1">🇨🇦 Canada (StatsCan)</a>
							</div>
						</div>

						<!-- Resources & Calculators Dropdown -->
						<div class="relative group">
							<button class="hover:text-slate-900 dark:hover:text-white transition-colors flex items-center gap-1 font-semibold">
								<span>📚 Guides &amp; Tools</span> <span class="text-xs">▾</span>
							</button>
							<div class="absolute top-full right-0 mt-2 w-64 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl py-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50">
								<a href="/net-worth-by-income" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 text-emerald-600 dark:text-emerald-400 font-bold transition-colors rounded-lg mx-1">📈 Net Worth by Income (Stanley)</a>
								<a href="/average-net-worth-by-age" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors rounded-lg mx-1">📊 Average Net Worth by Age Guide</a>
								<a href="/net-worth-percentile" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors rounded-lg mx-1">🏆 Wealth Percentile Ranking</a>
								<a href="/median-vs-average-net-worth" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors rounded-lg mx-1">⚖️ Median vs Average Explained</a>
								<div class="h-px bg-slate-100 dark:bg-slate-800 mx-3 my-1"></div>
								<a href="/net-worth-by-age-30" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors rounded-lg mx-1">📅 Net Worth at Age 30</a>
								<a href="/net-worth-by-age-40" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors rounded-lg mx-1">📅 Net Worth at Age 40</a>
								<a href="/net-worth-by-age-50" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors rounded-lg mx-1">📅 Net Worth at Age 50</a>
								<div class="h-px bg-slate-100 dark:bg-slate-800 mx-3 my-1"></div>
								<a href="/about" class="block px-4 py-2 text-xs hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-slate-900 dark:hover:text-white transition-colors rounded-lg mx-1">🛡️ Data Methodology</a>
							</div>
						</div>

						<a href="/contact" class="hover:text-slate-900 dark:hover:text-white transition-colors">Contact</a>
					</nav>

					<!-- Mobile Menu Drawer Toggle -->
					<button id="mobile-menu-btn" aria-label="Toggle Mobile Menu" class="md:hidden w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-700 dark:text-slate-300">
						<span class="text-xl">☰</span>
					</button>

					<!-- Dark/Light Theme Toggle Button -->
					<button id="theme-toggle-btn" aria-label="Toggle Dark or Light Theme" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-700 dark:text-slate-300 hover:text-emerald-500 dark:hover:text-emerald-400 transition-all shadow-sm">
						<!-- Sun Icon -->
						<svg id="sun-icon" class="w-5 h-5 hidden dark:block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
						</svg>
						<!-- Moon Icon -->
						<svg id="moon-icon" class="w-5 h-5 block dark:hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
						</svg>
					</button>
				</div>
			</div>

			<!-- Mobile Navigation Drawer -->
			<div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 px-6 py-4 space-y-2 text-sm font-semibold">
				<a href="/" class="block py-2 text-slate-800 dark:text-slate-200">Home Calculator</a>
				<a href="/net-worth-by-age-india" class="block py-2 text-orange-600 dark:text-orange-400 font-bold">🇮🇳 India Net Worth Calculator</a>
				<a href="/net-worth-by-age-australia" class="block py-2 text-blue-600 dark:text-blue-400 font-bold">🇦🇺 Australia Net Worth Calculator</a>
				<a href="/net-worth-by-income" class="block py-2 text-emerald-600 dark:text-emerald-400 font-bold">📈 Net Worth by Income Calculator</a>
				<a href="/net-worth-by-age-usa" class="block py-2 text-slate-800 dark:text-slate-200">🇺🇸 USA Net Worth Calculator</a>
				<a href="/net-worth-by-age-uk" class="block py-2 text-slate-800 dark:text-slate-200">🇬🇧 UK Net Worth Calculator</a>
				<a href="/net-worth-by-age-canada" class="block py-2 text-slate-800 dark:text-slate-200">🇨🇦 Canada Net Worth Calculator</a>
				<div class="h-px bg-slate-200 dark:bg-slate-800 my-2"></div>
				<a href="/average-net-worth-by-age" class="block py-2 text-slate-700 dark:text-slate-400">Average Net Worth by Age</a>
				<a href="/net-worth-percentile" class="block py-2 text-slate-700 dark:text-slate-400">Net Worth Percentile Guide</a>
				<a href="/about" class="block py-2 text-slate-700 dark:text-slate-400">Data Methodology</a>
				<a href="/contact" class="block py-2 text-slate-700 dark:text-slate-400">Contact Us</a>
			</div>
		</header>
		
		<!-- Main Content Slot -->
		<div class="flex-grow">
			<slot />
		</div>

		<!-- Footer -->
		<footer class="w-full border-t border-slate-200 dark:border-slate-800/60 bg-white dark:bg-[#04070d] mt-24 py-12 text-sm text-slate-700 dark:text-slate-400 transition-colors duration-300">
			<div class="max-w-6xl mx-auto px-6 space-y-8">
				<div class="grid grid-cols-1 md:grid-cols-4 gap-8">
					<div class="space-y-2">
						<div class="text-slate-900 dark:text-white font-extrabold text-lg">GetNetWorthCalculator.com</div>
						<p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
							Privacy-first global wealth benchmarking platform. Powered by official US Fed SCF, UK ONS, RBI India, ABS Australia, and StatsCan datasets.
						</p>
					</div>
					<div>
						<h3 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-3">Regional Calculators</h3>
						<ul class="space-y-2 text-xs">
							<li><a href="/net-worth-by-age-india" class="hover:text-orange-500 transition-colors">🇮🇳 India Net Worth (₹)</a></li>
							<li><a href="/net-worth-by-age-australia" class="hover:text-blue-500 transition-colors">🇦🇺 Australia Net Worth (AUD)</a></li>
							<li><a href="/net-worth-by-income" class="hover:text-emerald-500 transition-colors">📈 Net Worth by Income</a></li>
							<li><a href="/net-worth-by-age-usa" class="hover:text-slate-900 dark:hover:text-white transition-colors">🇺🇸 USA Net Worth (USD)</a></li>
							<li><a href="/net-worth-by-age-uk" class="hover:text-slate-900 dark:hover:text-white transition-colors">🇬🇧 UK Net Worth (GBP)</a></li>
							<li><a href="/net-worth-by-age-canada" class="hover:text-slate-900 dark:hover:text-white transition-colors">🇨🇦 Canada Net Worth (CAD)</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-3">Age Benchmarks</h3>
						<ul class="space-y-2 text-xs">
							<li><a href="/net-worth-by-age-30" class="hover:text-slate-900 dark:hover:text-white transition-colors">Net Worth at Age 30</a></li>
							<li><a href="/net-worth-by-age-40" class="hover:text-slate-900 dark:hover:text-white transition-colors">Net Worth at Age 40</a></li>
							<li><a href="/net-worth-by-age-50" class="hover:text-slate-900 dark:hover:text-white transition-colors">Net Worth at Age 50</a></li>
							<li><a href="/average-net-worth-by-age" class="hover:text-slate-900 dark:hover:text-white transition-colors">Average Net Worth Guide</a></li>
							<li><a href="/median-vs-average-net-worth" class="hover:text-slate-900 dark:hover:text-white transition-colors">Median vs Average Explained</a></li>
						</ul>
					</div>
					<div>
						<h3 class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider mb-3">Trust &amp; Legal</h3>
						<ul class="space-y-2 text-xs">
							<li><a href="/about" class="hover:text-slate-900 dark:hover:text-white transition-colors">Data Methodology</a></li>
							<li><a href="/privacy-policy" class="hover:text-slate-900 dark:hover:text-white transition-colors">Privacy Policy</a></li>
							<li><a href="/terms" class="hover:text-slate-900 dark:hover:text-white transition-colors">Terms of Service</a></li>
							<li><a href="/contact" class="hover:text-slate-900 dark:hover:text-white transition-colors">Contact Us</a></li>
						</ul>
					</div>
				</div>

				<div class="border-t border-slate-200 dark:border-slate-800 pt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
					<p>© {new Date().getFullYear()} Get Net Worth Calculator. All rights reserved.</p>
					<p>🔒 100% Client-Side Calculations. No data stored.</p>
				</div>
			</div>
		</footer>

		<!-- Vercel Speed-Optimized Analytics Integration -->
		<Analytics />

		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const toggleBtn = document.getElementById('theme-toggle-btn');
				const mobileMenuBtn = document.getElementById('mobile-menu-btn');
				const mobileMenu = document.getElementById('mobile-menu');
				
				toggleBtn?.addEventListener('click', () => {
					const isDark = document.documentElement.classList.contains('dark');
					if (isDark) {
						document.documentElement.classList.remove('dark');
						localStorage.setItem('theme', 'light');
					} else {
						document.documentElement.classList.add('dark');
						localStorage.setItem('theme', 'dark');
					}
				});

				mobileMenuBtn?.addEventListener('click', () => {
					mobileMenu?.classList.toggle('hidden');
				});
			});
		</script>
	</body>
</html>

<style is:global>
	body {
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
	
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: #04070d;
	}
	::-webkit-scrollbar-thumb {
		background: #1e293b;
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #334155;
	}
</style>
