---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { 
	title = "Net Worth Calculator by Age (2026): Exact Percentile Benchmark [US Fed Data]", 
	description = "Calculate your exact net worth percentile by age benchmarked against official US Federal Reserve Survey of Consumer Finances (SCF) data. 100% free, private & anonymous."
} = Astro.props;

const rawPath = Astro.url.pathname;
const cleanPath = rawPath.replace(/\.html$/, '').replace(/\/+$/, '') || '';
const canonicalURL = cleanPath === '' 
  ? 'https://getnetworthcalculator.com' 
  : `https://getnetworthcalculator.com${cleanPath}`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://getnetworthcalculator.com"
    },
    ...(cleanPath !== '' ? [{
      "@type": "ListItem",
      "position": 2,
      "name": title.split('|')[0].trim(),
      "item": canonicalURL
    }] : [])
  ]
};
