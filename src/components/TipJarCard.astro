---
import product from '../data/product.json';

interface Props {
  className?: string;
  headline?: string;
}

const {
  className = "",
  headline = "We Make $0 From Ads or Selling Your Financial Data."
} = Astro.props;
---

<div class={`rounded-3xl border-2 border-amber-500/30 dark:border-amber-400/25 bg-gradient-to-br from-amber-500/5 via-slate-50 to-emerald-500/10 dark:from-amber-950/20 dark:via-slate-900/90 dark:to-emerald-950/20 p-6 sm:p-8 shadow-xl relative overflow-hidden ${className}`}>
  <!-- Warm Ambient Glow -->
  <div class="absolute -top-16 -right-16 w-56 h-56 bg-amber-500/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-16 -left-16 w-56 h-56 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 space-y-5 text-left">
    <!-- Top Badge Row -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-800 dark:text-amber-300 text-xs font-black uppercase tracking-wider">
        <span class="animate-pulse">☕</span>
        <span>Independent Community Tip Jar</span>
      </div>

      <div class="inline-flex items-center gap-2 text-[11px] font-bold text-slate-500 dark:text-slate-400">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        <span>100% Private • 0 Ads • 0 Tracking</span>
      </div>
    </div>

    <!-- Main Message -->
    <div class="space-y-2">
      <h3 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight flex items-center gap-2 flex-wrap">
        <span>{headline}</span>
      </h3>
      <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
        Most financial websites bombard you with predatory loan popups, sell your banking logins to advertisers, or lock calculations behind monthly subscriptions. 
        <strong>GetNetWorthCalculator runs 100% free, private, and client-side in your browser.</strong> Server hosting, domains, and Federal Reserve SCF dataset indexing are funded entirely out of our own pocket.
      </p>
      <p class="text-xs sm:text-sm font-semibold text-emerald-700 dark:text-emerald-400">
        ✨ If this tool gave you financial clarity today, leave a small tip to keep our servers alive. <strong>As our thank-you gift, every tip unlocks our complete offline Excel &amp; Google Sheets Master Vault!</strong>
      </p>
    </div>

    <!-- Interactive Tipping Chips -->
    <div class="pt-2">
      <div class="text-[11px] uppercase font-bold text-slate-500 dark:text-slate-400 tracking-wider mb-2.5">
        Select a Tip Amount (or Pay What You Want):
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
        <!-- Chip 1: $2 Coffee -->
        <a 
          href="https://yashjha22.gumroad.com/l/vxdzfq?price=2" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-3 rounded-2xl bg-white dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 hover:border-amber-500/60 hover:bg-amber-500/5 transition-all text-center group flex flex-col items-center justify-center gap-1 shadow-sm hover:scale-[1.02] active:scale-95"
        >
          <span class="text-lg">☕</span>
          <span class="text-sm font-black text-slate-900 dark:text-white">$2 Tip</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 group-hover:text-amber-600 dark:group-hover:text-amber-400 font-bold">Buy a Coffee</span>
        </a>

        <!-- Chip 2: $4 Vault + Coffee (Popular) -->
        <a 
          href="https://yashjha22.gumroad.com/l/vxdzfq?price=4" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-3 rounded-2xl bg-gradient-to-b from-emerald-500/10 to-teal-500/10 border-2 border-emerald-500/50 text-center group flex flex-col items-center justify-center gap-1 shadow-md hover:scale-[1.03] active:scale-95 relative"
        >
          <span class="absolute -top-2.5 px-2 py-0.5 rounded-full bg-emerald-600 text-slate-950 text-[9px] font-black uppercase tracking-wider shadow">Most Popular</span>
          <span class="text-lg">📊</span>
          <span class="text-sm font-black text-slate-900 dark:text-white">$4 Tip</span>
          <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-extrabold">Vault + Coffee</span>
        </a>

        <!-- Chip 3: $8 Super Supporter -->
        <a 
          href="https://yashjha22.gumroad.com/l/vxdzfq?price=8" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-3 rounded-2xl bg-white dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800 hover:border-emerald-500/60 hover:bg-emerald-500/5 transition-all text-center group flex flex-col items-center justify-center gap-1 shadow-sm hover:scale-[1.02] active:scale-95"
        >
          <span class="text-lg">🚀</span>
          <span class="text-sm font-black text-slate-900 dark:text-white">$8 Tip</span>
          <span class="text-[10px] text-slate-500 dark:text-slate-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 font-bold">Server Hero</span>
        </a>

        <!-- Chip 4: Custom / Pay What You Want -->
        <a 
          href="https://yashjha22.gumroad.com/l/vxdzfq" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-3 rounded-2xl bg-gradient-to-br from-amber-500/10 via-slate-100 to-emerald-500/10 dark:from-amber-950/40 dark:via-slate-950 dark:to-emerald-950/40 border border-amber-500/40 hover:border-amber-400 transition-all text-center group flex flex-col items-center justify-center gap-1 shadow-sm hover:scale-[1.02] active:scale-95"
        >
          <span class="text-lg">💖</span>
          <span class="text-sm font-black text-slate-900 dark:text-white">Custom $__</span>
          <span class="text-[10px] text-amber-700 dark:text-amber-400 font-extrabold">Pay What You Want</span>
        </a>
      </div>
    </div>

    <!-- Transparency Footer Note -->
    <div class="pt-2 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-1.5 text-center sm:text-left">
        <span>🔒 Secure 1-click checkout via Gumroad (Apple Pay, Google Pay &amp; Cards). Instant file delivery.</span>
      </div>
      <a href="/support" class="font-bold text-emerald-700 dark:text-emerald-400 hover:underline shrink-0">
        Read Our Mission &amp; Server Costs →
      </a>
    </div>
  </div>
</div>
