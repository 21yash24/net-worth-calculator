---
import product from '../data/product.json';

interface Props {
  className?: string;
  headline?: string;
}

const {
  className = "",
  headline = "Built by one person. 100% free, private & ad-free."
} = Astro.props;
---

<div class={`rounded-3xl border-2 border-amber-500/40 dark:border-amber-400/35 bg-gradient-to-br from-amber-500/5 via-white to-emerald-500/10 dark:from-[#0a0f1d] dark:via-[#070b14] dark:to-emerald-950/30 p-6 sm:p-9 shadow-2xl relative overflow-hidden ${className}`} id="gamified-tip-terminal">
  <!-- Subtle Ambient Glow -->
  <div class="absolute -top-20 -right-20 w-72 h-72 bg-amber-500/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <!-- Confetti Canvas Overlay (Triggered on slider change and tip click) -->
  <canvas id="tip-confetti-canvas" class="absolute inset-0 pointer-events-none z-30 w-full h-full"></canvas>

  <div class="relative z-10 space-y-6 text-left">
    
    <!-- Top Founder Header Row -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200/80 dark:border-slate-800/80">
      <div class="flex items-center gap-3.5">
        <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br from-emerald-500 via-teal-600 to-slate-900 flex items-center justify-center text-white font-extrabold text-xl shadow-md border-2 border-emerald-400/40 shrink-0">
          YJ
        </div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-white">
              A Personal Note from Yash Jha
            </h3>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 font-bold border border-emerald-500/30">
              Solo Creator &amp; Modeler
            </span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">
            Founder of GetNetWorthCalculator.com
          </p>
        </div>
      </div>

      <!-- Live Community Fuel Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-800 dark:text-amber-300 text-xs font-black uppercase tracking-wider self-start sm:self-auto">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
        </span>
        <span>☕ Community Tip Terminal</span>
      </div>
    </div>

    <!-- The Personal Story Copy -->
    <div class="space-y-2">
      <h4 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
        {headline}
      </h4>
      <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
        "I built this whole project by myself because I was sick of opening finance sites that demanded my phone number, forced me to link real bank accounts, or pushed predatory 29% APR credit cards on me.
      </p>
      <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
        I spent hundreds of late nights crunching Federal Reserve SCF data for <strong>650+ calculators</strong> so that anyone can check where they stand <strong>100% free, private, and with zero ads</strong>. 
        Keeping these fast servers running costs real money out of my own pocket every month.
      </p>
    </div>

    <!-- The Free Gift Guarantee Box -->
    <div class="p-4 rounded-2xl bg-gradient-to-r from-emerald-500/10 via-teal-500/10 to-amber-500/10 border-2 border-emerald-500/35 flex flex-col sm:flex-row items-center justify-between gap-3 text-left">
      <div class="space-y-0.5">
        <div class="flex items-center gap-1.5 text-emerald-800 dark:text-emerald-300 font-black text-xs sm:text-sm uppercase tracking-wider">
          <span>🎁</span>
          <span>My Free Gift To Whoever Tips (Even $1):</span>
        </div>
        <p class="text-xs text-slate-700 dark:text-slate-300">
          Get the complete <strong>Master Wealth &amp; 50/30/20 Budget Vault</strong> (Google Sheets + Excel, regular $8 value) sent instantly to your email!
        </p>
      </div>
      <span class="px-2.5 py-1 rounded-lg bg-emerald-500 text-slate-950 font-black text-[11px] uppercase tracking-wider shrink-0 shadow-sm">
        Instant Download
      </span>
    </div>

    <!-- Simple, Honest Coffee Tip Options (Toast / POS Style) -->
    <div class="p-5 sm:p-6 rounded-2xl bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800/80 space-y-5 shadow-inner">
      
      <div>
        <div class="flex items-center justify-between text-xs font-bold text-slate-600 dark:text-slate-400 mb-3">
          <span class="uppercase tracking-wider">Choose a Supporter Option:</span>
          <span class="text-amber-600 dark:text-amber-400 font-extrabold flex items-center gap-1">
            <span>⭐ Most People Tip $4 (1 Coffee)</span>
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <!-- Tier 1: $4 -->
          <a 
            href="https://buymeacoffee.com/yashjha" 
            target="_blank" 
            rel="noopener noreferrer"
            class="coffee-tier-card p-4 rounded-2xl border-2 border-emerald-500 bg-emerald-500/10 text-slate-900 dark:text-white hover:border-emerald-400 transition-all text-center flex flex-col items-center justify-center gap-1 shadow-md ring-2 ring-emerald-500/20 active:scale-95 group relative cursor-pointer"
          >
            <span class="absolute -top-2.5 px-2.5 py-0.5 rounded-full bg-emerald-600 text-white text-[9px] font-black uppercase tracking-wider shadow">Most Popular</span>
            <span class="text-3xl group-hover:scale-110 transition-transform">☕</span>
            <span class="text-xl font-black text-emerald-800 dark:text-emerald-300">$4.00</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white">1 Warm Coffee</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Fuels 1 night of coding</span>
          </a>

          <!-- Tier 2: $12 -->
          <a 
            href="https://buymeacoffee.com/yashjha" 
            target="_blank" 
            rel="noopener noreferrer"
            class="coffee-tier-card p-4 rounded-2xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white hover:border-amber-500 transition-all text-center flex flex-col items-center justify-center gap-1 shadow-sm active:scale-95 group cursor-pointer"
          >
            <span class="text-3xl group-hover:scale-110 transition-transform">🍕</span>
            <span class="text-xl font-black text-amber-800 dark:text-amber-300">$12.00</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white">3 Coffees / Lunch</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Covers 2,000 visitors</span>
          </a>

          <!-- Tier 3: Custom -->
          <a 
            href="https://buymeacoffee.com/yashjha" 
            target="_blank" 
            rel="noopener noreferrer"
            class="coffee-tier-card p-4 rounded-2xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 text-slate-900 dark:text-white hover:border-emerald-500 transition-all text-center flex flex-col items-center justify-center gap-1 shadow-sm active:scale-95 group cursor-pointer"
          >
            <span class="text-3xl group-hover:scale-110 transition-transform">🚀</span>
            <span class="text-xl font-black text-slate-800 dark:text-slate-200">Custom $</span>
            <span class="text-xs font-bold text-slate-900 dark:text-white">Pay What You Want</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400">Any amount ($1+)</span>
          </a>
        </div>
      </div>

      <!-- Action Button (Big Call To Action with Confetti Trigger) -->
      <div class="space-y-3 pt-1">
        <a 
          id="main-gamified-tip-btn"
          href="https://buymeacoffee.com/yashjha" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-amber-400 via-amber-500 to-amber-400 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-base sm:text-lg transition-all shadow-xl shadow-amber-950/30 flex items-center justify-center gap-3 active:scale-98 group cursor-pointer"
        >
          <span class="text-xl group-hover:scale-125 transition-transform">☕</span>
          <span id="tip-btn-text">Buy Yash a Coffee on BuyMeACoffee.com</span>
          <span class="group-hover:translate-x-1 transition-transform">➔</span>
        </a>

        <!-- Accepted Payment Methods Trust Banner (All US / Global Methods) -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-2.5 text-slate-500 dark:text-slate-400 text-[11px] pt-1 border-t border-slate-200 dark:border-slate-800/80">
          <span class="font-semibold flex items-center gap-1.5">
            <span>🔒 Bank-Grade 256-Bit SSL Checkout:</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 font-normal hidden sm:inline">(PCI-DSS Level 1 Certified via Stripe &amp; Buy Me a Coffee)</span>
          </span>
          <div class="flex items-center gap-2 flex-wrap justify-center font-bold text-[10px] text-slate-700 dark:text-slate-300">
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs"> Apple Pay</span>
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">GPay</span>
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">PayPal</span>
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">Visa</span>
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">Mastercard</span>
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">AMEX</span>
          </div>
        </div>

        <!-- Anti-Scam & 100% Safe Verification Trust Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-2 border-t border-slate-200 dark:border-slate-800/80 text-[11px]">
          <div class="flex items-start gap-2 p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 text-slate-700 dark:text-slate-300">
            <span class="text-emerald-500 text-sm font-bold shrink-0">🛡️</span>
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold text-[11px]">100% One-Time Tip</strong>
              <span class="text-[10px] text-slate-500 dark:text-slate-400">Zero subscriptions. Zero hidden fees. You are only billed once.</span>
            </div>
          </div>
          <div class="flex items-start gap-2 p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 text-slate-700 dark:text-slate-300">
            <span class="text-blue-500 text-sm font-bold shrink-0">🔒</span>
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold text-[11px]">Zero Card Data Stored</strong>
              <span class="text-[10px] text-slate-500 dark:text-slate-400">Protected by 256-bit SSL via Buy Me a Coffee, Stripe, Apple Pay &amp; Google Pay.</span>
            </div>
          </div>
          <div class="flex items-start gap-2 p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 text-slate-700 dark:text-slate-300">
            <span class="text-amber-500 text-sm font-bold shrink-0">🤝</span>
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold text-[11px]">100% Money-Back Promise</strong>
              <span class="text-[10px] text-slate-500 dark:text-slate-400">Instant refund if not 100% happy. Email support@getnetworthcalculator.com</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- The Reverse-Psychology Out (Eliminates Sales Friction) -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400 pt-1">
      <p class="text-center sm:text-left leading-relaxed">
        💛 <em>Genuinely broke or can't afford to tip? That is 100% fine. Our 650+ calculators will always stay completely free for you. But if this tool helped your financial peace of mind today, chipping in keeps the lights on for everyone.</em>
      </p>
      <a href="/support" class="font-bold text-emerald-700 dark:text-emerald-400 hover:underline shrink-0 flex items-center gap-1">
        <span>Read My Story</span>
        <span>→</span>
      </a>
    </div>

  </div>
</div>

<!-- Interactive Celebration Audio & Confetti FX Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tipBtns = document.querySelectorAll('.coffee-tier-card, #main-gamified-tip-btn');
    const canvas = document.getElementById('tip-confetti-canvas');

    // Synthesized Web Audio Celebration Chime (Zero External Asset Dependency)
    function playCelebrationSound() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const now = ctx.currentTime;

        // Note 1: E5 (659Hz)
        const osc1 = ctx.createOscillator();
        const gain1 = ctx.createGain();
        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(659.25, now);
        gain1.gain.setValueAtTime(0.12, now);
        gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
        osc1.connect(gain1);
        gain1.connect(ctx.destination);
        osc1.start(now);
        osc1.stop(now + 0.4);

        // Note 2: B5 (987Hz) delayed chord harmony
        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.type = 'triangle';
        osc2.frequency.setValueAtTime(987.77, now + 0.08);
        gain2.gain.setValueAtTime(0.18, now + 0.08);
        gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.start(now + 0.08);
        osc2.stop(now + 0.6);
      } catch(e) {}
    }

    // Hardware-Accelerated 60FPS Confetti Cannon Particle Canvas
    function launchConfetti() {
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;

      const colors = ['#10b981', '#f59e0b', '#3b82f6', '#ec4899', '#8b5cf6', '#14b8a6'];
      const particles = [];
      const particleCount = 45;

      for (let i = 0; i < particleCount; i++) {
        particles.push({
          x: canvas.width / 2 + (Math.random() * 80 - 40),
          y: canvas.height * 0.7,
          vx: (Math.random() - 0.5) * 8,
          vy: -(Math.random() * 7 + 4),
          size: Math.random() * 5 + 3,
          color: colors[Math.floor(Math.random() * colors.length)],
          rotation: Math.random() * 360,
          vRot: (Math.random() - 0.5) * 10,
          alpha: 1
        });
      }

      let animationFrame;
      function render() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let alive = 0;

        for (let p of particles) {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.22; // gravity
          p.rotation += p.vRot;
          p.alpha -= 0.016;

          if (p.alpha > 0) {
            alive++;
            ctx.save();
            ctx.globalAlpha = p.alpha;
            ctx.translate(p.x, p.y);
            ctx.rotate((p.rotation * Math.PI) / 180);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.7);
            ctx.restore();
          }
        }

        if (alive > 0) {
          animationFrame = requestAnimationFrame(render);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          cancelAnimationFrame(animationFrame);
        }
      }
      render();
    }

    // Attach sound and confetti to all coffee buttons
    tipBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        playCelebrationSound();
        launchConfetti();
      });
    });
  });
</script>
