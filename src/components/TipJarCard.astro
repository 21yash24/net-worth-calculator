---
import product from '../data/product.json';

interface Props {
  className?: string;
  headline?: string;
}

const {
  className = "",
  headline = "Built by one person. 100% free, private & ad-free."
} = Astro.props;
---

<div class={`rounded-3xl border-2 border-amber-500/40 dark:border-amber-400/35 bg-gradient-to-br from-amber-500/5 via-white to-emerald-500/10 dark:from-[#0a0f1d] dark:via-[#070b14] dark:to-emerald-950/30 p-6 sm:p-9 shadow-2xl relative overflow-hidden ${className}`} id="gamified-tip-terminal">
  <!-- Subtle Ambient Glow -->
  <div class="absolute -top-20 -right-20 w-72 h-72 bg-amber-500/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <!-- Confetti Canvas Overlay (Triggered on slider change and tip click) -->
  <canvas id="tip-confetti-canvas" class="absolute inset-0 pointer-events-none z-30 w-full h-full"></canvas>

  <div class="relative z-10 space-y-6 text-left">
    
    <!-- Top Founder Header Row -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200/80 dark:border-slate-800/80">
      <div class="flex items-center gap-3.5">
        <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br from-emerald-500 via-teal-600 to-slate-900 flex items-center justify-center text-white font-extrabold text-xl shadow-md border-2 border-emerald-400/40 shrink-0">
          YJ
        </div>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h3 class="text-base sm:text-lg font-black text-slate-900 dark:text-white">
              A Personal Note from Yash Jha
            </h3>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 font-bold border border-emerald-500/30">
              Solo Creator &amp; Modeler
            </span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">
            Founder of GetNetWorthCalculator.com
          </p>
        </div>
      </div>

      <!-- Live Community Fuel Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-800 dark:text-amber-300 text-xs font-black uppercase tracking-wider self-start sm:self-auto">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
        </span>
        <span>☕ Community Tip Terminal</span>
      </div>
    </div>

    <!-- The Personal Story Copy -->
    <div class="space-y-2">
      <h4 class="text-xl sm:text-2xl font-black text-slate-900 dark:text-white tracking-tight">
        {headline}
      </h4>
      <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
        "I built this whole project by myself because I was sick of opening finance sites that demanded my phone number, forced me to link real bank accounts, or pushed predatory 29% APR credit cards on me.
      </p>
      <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-normal">
        I spent hundreds of late nights crunching Federal Reserve SCF data for <strong>650+ calculators</strong> so that anyone can check where they stand <strong>100% free, private, and with zero ads</strong>. 
        Keeping these fast servers running costs real money out of my own pocket every month.
      </p>
    </div>

    <!-- The Free Gift Guarantee Box -->
    <div class="p-4 rounded-2xl bg-gradient-to-r from-emerald-500/10 via-teal-500/10 to-amber-500/10 border-2 border-emerald-500/35 flex flex-col sm:flex-row items-center justify-between gap-3 text-left">
      <div class="space-y-0.5">
        <div class="flex items-center gap-1.5 text-emerald-800 dark:text-emerald-300 font-black text-xs sm:text-sm uppercase tracking-wider">
          <span>🎁</span>
          <span>My Free Gift To Whoever Tips (Even $1):</span>
        </div>
        <p class="text-xs text-slate-700 dark:text-slate-300">
          Get the complete <strong>Master Wealth &amp; 50/30/20 Budget Vault</strong> (Google Sheets + Excel, regular $8 value) sent instantly to your email!
        </p>
      </div>
      <span class="px-2.5 py-1 rounded-lg bg-emerald-500 text-slate-950 font-black text-[11px] uppercase tracking-wider shrink-0 shadow-sm">
        Instant Download
      </span>
    </div>

    <!-- Interactive Gamified American Tipping Terminal -->
    <div class="p-5 sm:p-6 rounded-2xl bg-slate-50 dark:bg-slate-950/80 border border-slate-200 dark:border-slate-800/80 space-y-5 shadow-inner">
      
      <!-- Preset Quick-Tip Chips (Toast / Square POS Style) -->
      <div>
        <div class="flex items-center justify-between text-xs font-bold text-slate-600 dark:text-slate-400 mb-2.5">
          <span class="uppercase tracking-wider">Select a Tip Amount:</span>
          <span class="text-emerald-700 dark:text-emerald-400 font-extrabold flex items-center gap-1">
            <span>⭐ Most People Tip $4</span>
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-5 gap-2" id="tip-chips-container">
          <!-- Preset 1: $1 -->
          <button 
            type="button" 
            data-amount="1"
            class="tip-chip p-2.5 sm:p-3 rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 hover:border-amber-500/60 font-bold transition-all text-center flex flex-col items-center justify-center gap-0.5 cursor-pointer active:scale-95"
          >
            <span class="text-sm font-black">$1 Tip</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">🪙 Every Bit</span>
          </button>

          <!-- Preset 2: $4 (Default / Popular) -->
          <button 
            type="button" 
            data-amount="4"
            class="tip-chip active-chip p-2.5 sm:p-3 rounded-xl border-2 border-emerald-500 bg-emerald-500/10 text-emerald-950 dark:text-emerald-300 font-black transition-all text-center flex flex-col items-center justify-center gap-0.5 cursor-pointer shadow-md ring-2 ring-emerald-500/30 active:scale-95 relative"
          >
            <span class="absolute -top-2.5 px-2 py-0.2 rounded-full bg-emerald-600 text-white text-[9px] font-black uppercase tracking-wider shadow">Most Popular</span>
            <span class="text-sm font-black text-emerald-800 dark:text-emerald-300">$4 Tip</span>
            <span class="text-[10px] text-emerald-700 dark:text-emerald-400 font-bold">☕ Coffee Fuel</span>
          </button>

          <!-- Preset 3: $8 -->
          <button 
            type="button" 
            data-amount="8"
            class="tip-chip p-2.5 sm:p-3 rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 hover:border-amber-500/60 font-bold transition-all text-center flex flex-col items-center justify-center gap-0.5 cursor-pointer active:scale-95"
          >
            <span class="text-sm font-black">$8 Tip</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">🚀 Server Hero</span>
          </button>

          <!-- Preset 4: $15 -->
          <button 
            type="button" 
            data-amount="15"
            class="tip-chip p-2.5 sm:p-3 rounded-xl border-2 border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-200 hover:border-amber-500/60 font-bold transition-all text-center flex flex-col items-center justify-center gap-0.5 cursor-pointer active:scale-95"
          >
            <span class="text-sm font-black">$15 Tip</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">👑 Wealth Patron</span>
          </button>

          <!-- Preset 5: Custom $ -->
          <button 
            type="button" 
            data-amount="custom"
            class="tip-chip p-2.5 sm:p-3 rounded-xl border-2 border-dashed border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 text-slate-800 dark:text-slate-200 hover:border-emerald-500 font-bold transition-all text-center flex flex-col items-center justify-center gap-0.5 cursor-pointer active:scale-95 col-span-2 sm:col-span-1"
          >
            <span class="text-sm font-black text-emerald-600 dark:text-emerald-400">Custom $</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 font-medium">✏️ Any Amount</span>
          </button>
        </div>
      </div>

      <!-- Gamified Slider Range Input -->
      <div class="space-y-3 pt-2">
        <div class="flex items-center justify-between">
          <label for="interactive-tip-slider" class="text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
            <span>🎮 Slide to Gameify Your Tip:</span>
          </label>
          <div class="flex items-center gap-1.5">
            <span id="slider-tier-badge" class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-400/20 text-amber-500 border border-amber-400/30">
              ☕ Coffee Fuel
            </span>
            <span id="dynamic-tip-display" class="text-2xl font-black text-slate-900 dark:text-white font-mono bg-white dark:bg-slate-900 px-3 py-1 rounded-xl border border-slate-300 dark:border-slate-800 shadow-sm">
              $4.00
            </span>
          </div>
        </div>

        <div class="relative py-1">
          <input 
            type="range" 
            id="interactive-tip-slider" 
            min="1" 
            max="50" 
            step="1" 
            value="4" 
            class="w-full h-3 bg-slate-200 dark:bg-slate-900 rounded-lg appearance-none cursor-pointer accent-emerald-500 border border-slate-300 dark:border-slate-800 focus:outline-none"
            aria-label="Gamified Tip Amount Slider"
          />
          <div class="flex justify-between text-[10px] font-bold text-slate-500 dark:text-slate-400 px-1 pt-1">
            <span>$1 (Every Bit)</span>
            <span>$10 (Server Hero)</span>
            <span>$25 (Patron)</span>
            <span>$50+ (Legend)</span>
          </div>
        </div>

        <!-- Custom Numeric Input (Type Any Custom Dollar Amount) -->
        <div class="flex items-center justify-between p-2.5 sm:p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">
          <label for="custom-tip-input" class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center gap-1.5 cursor-pointer">
            <span class="text-sm">✏️</span>
            <span>Or type any custom amount:</span>
          </label>
          <div class="flex items-center gap-1 bg-slate-100 dark:bg-slate-950 px-3 py-1 rounded-lg border border-slate-300 dark:border-slate-700 font-mono text-sm font-black focus-within:ring-2 focus-within:ring-emerald-500">
            <span class="text-emerald-500 font-bold">$</span>
            <input 
              type="number" 
              id="custom-tip-input" 
              min="1" 
              max="1000" 
              step="1" 
              value="4" 
              class="w-16 bg-transparent text-slate-900 dark:text-white font-mono font-bold focus:outline-none text-right"
              aria-label="Custom Tip Amount in USD"
            />
            <span class="text-xs text-slate-400 font-sans font-normal">USD</span>
          </div>
        </div>

        <!-- Dynamic Gamified Reaction Message -->
        <div id="slider-reaction-box" class="p-3 rounded-xl bg-amber-500/10 dark:bg-amber-950/20 border border-amber-500/30 text-xs text-amber-900 dark:text-amber-300 flex items-center gap-2.5 transition-all">
          <span id="reaction-emoji" class="text-2xl animate-bounce">☕</span>
          <div class="space-y-0.5">
            <div id="reaction-title" class="font-bold">You're Buying Yash a Warm Coffee!</div>
            <div id="reaction-sub" class="text-[11px] text-slate-600 dark:text-slate-400">
              Directly fuels late-night coding &amp; keeping this tool 100% ad-free.
            </div>
          </div>
        </div>
      </div>

      <!-- Action Button (Big Call To Action with Confetti Trigger) -->
      <div class="space-y-3 pt-1">
        <a 
          id="main-gamified-tip-btn"
          href="https://buymeacoffee.com/yashjha" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-amber-400 via-amber-500 to-amber-400 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-black text-base sm:text-lg transition-all shadow-xl shadow-amber-950/30 flex items-center justify-center gap-3 active:scale-98 group cursor-pointer"
        >
          <span class="text-xl group-hover:scale-125 transition-transform">☕</span>
          <span id="tip-btn-text">Buy Yash a Coffee ($4.00) &amp; Unlock Free Vault</span>
          <span class="group-hover:translate-x-1 transition-transform">➔</span>
        </a>

        <!-- Dynamic Buy Me a Coffee Checkout Guidance -->
        <div id="gumroad-price-instruction" class="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/30 text-[11px] text-amber-900 dark:text-amber-300 flex items-center justify-between gap-2">
          <div class="flex items-center gap-1.5">
            <span class="text-sm shrink-0">☕</span>
            <span><strong>Buy Me a Coffee:</strong> Choose or enter <span id="gumroad-suggested-amount" class="font-mono font-black text-amber-800 dark:text-amber-300 text-xs">$4</span> on Yash's verified page to unlock the free Master Vault.</span>
          </div>
          <span class="text-[9px] uppercase font-bold px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-800 dark:text-amber-300 shrink-0">Official Creator</span>
        </div>

        <!-- Accepted Payment Methods Trust Banner (All US / Global Methods) -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-2.5 text-slate-500 dark:text-slate-400 text-[11px] pt-1 border-t border-slate-200 dark:border-slate-800/80">
          <span class="font-semibold flex items-center gap-1.5">
            <span>🔒 Bank-Grade 256-Bit SSL Checkout:</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 font-normal hidden sm:inline">(PCI-DSS Level 1 Certified via Stripe &amp; Buy Me a Coffee)</span>
          </span>
          <div class="flex items-center gap-2 flex-wrap justify-center font-bold text-[10px] text-slate-700 dark:text-slate-300">
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs"> Apple Pay</span>
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">GPay</span>
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">PayPal</span>
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">Visa</span>
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">Mastercard</span>
            <span class="px-2 py-0.5 rounded bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xs">AMEX</span>
          </div>
        </div>

        <!-- Anti-Scam & 100% Safe Verification Trust Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-2 border-t border-slate-200 dark:border-slate-800/80 text-[11px]">
          <div class="flex items-start gap-2 p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 text-slate-700 dark:text-slate-300">
            <span class="text-emerald-500 text-sm font-bold shrink-0">🛡️</span>
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold text-[11px]">100% One-Time Tip</strong>
              <span class="text-[10px] text-slate-500 dark:text-slate-400">Zero subscriptions. Zero hidden fees. You are only billed once.</span>
            </div>
          </div>
          <div class="flex items-start gap-2 p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 text-slate-700 dark:text-slate-300">
            <span class="text-blue-500 text-sm font-bold shrink-0">🔒</span>
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold text-[11px]">Zero Card Data Stored</strong>
              <span class="text-[10px] text-slate-500 dark:text-slate-400">Protected by 256-bit SSL via Buy Me a Coffee, Stripe, Apple Pay &amp; Google Pay.</span>
            </div>
          </div>
          <div class="flex items-start gap-2 p-2.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 text-slate-700 dark:text-slate-300">
            <span class="text-amber-500 text-sm font-bold shrink-0">🤝</span>
            <div>
              <strong class="text-slate-900 dark:text-white block font-bold text-[11px]">100% Money-Back Promise</strong>
              <span class="text-[10px] text-slate-500 dark:text-slate-400">Instant refund if not 100% happy. Email support@getnetworthcalculator.com</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- The Reverse-Psychology Out (Eliminates Sales Friction) -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400 pt-1">
      <p class="text-center sm:text-left leading-relaxed">
        💛 <em>Genuinely broke or can't afford to tip? That is 100% fine. Our 650+ calculators will always stay completely free for you. But if this tool helped your financial peace of mind today, chipping in keeps the lights on for everyone.</em>
      </p>
      <a href="/support" class="font-bold text-emerald-700 dark:text-emerald-400 hover:underline shrink-0 flex items-center gap-1">
        <span>Read My Story</span>
        <span>→</span>
      </a>
    </div>

  </div>
</div>

<!-- Interactive Gamified Terminal Logic & Confetti Audio FX Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const slider = document.getElementById('interactive-tip-slider');
    const display = document.getElementById('dynamic-tip-display');
    const tipBtn = document.getElementById('main-gamified-tip-btn');
    const btnText = document.getElementById('tip-btn-text');
    const chips = document.querySelectorAll('.tip-chip');
    const tierBadge = document.getElementById('slider-tier-badge');
    const emoji = document.getElementById('reaction-emoji');
    const title = document.getElementById('reaction-title');
    const sub = document.getElementById('reaction-sub');
    const canvas = document.getElementById('tip-confetti-canvas');
    const customInput = document.getElementById('custom-tip-input');
    const gumroadAmountText = document.getElementById('gumroad-suggested-amount');

    if (!slider || !display || !tipBtn) return;

    // Gamification Tiers Map
    const tiers = [
      { max: 2, badge: '🪙 Micro Fuel', emoji: '🪙', title: "Every Dollar Counts!", sub: "Helps pay for server edge queries and keeps ads away." },
      { max: 4, badge: '☕ Coffee Fuel', emoji: '☕', title: "You're Buying Yash a Warm Coffee!", sub: "Directly fuels late-night coding & maintaining this tool 100% ad-free." },
      { max: 7, badge: '🍕 Lunch Fuel', emoji: '🍕', title: "Lunch is on You Today!", sub: "Covers a day's worth of server compute for 2,000 visitors." },
      { max: 14, badge: '🚀 Server Hero', emoji: '🚀', title: "You Are a Server Champion!", sub: "Covers our Cloudflare bandwidth & Fed Reserve SCF pipelines." },
      { max: 24, badge: '👑 Wealth Patron', emoji: '👑', title: "VIP Community Patron!", sub: "You are the reason financial education stays free for everyone." },
      { max: 9999, badge: '💎 Legendary Benefactor', emoji: '💎', title: "Absolute Legend!", sub: "Sponsoring entire months of server infrastructure. You are amazing." }
    ];

    // Synthesized Web Audio Celebration Chime (Zero External Asset Dependency)
    function playCelebrationSound() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        const ctx = new AudioCtx();
        const now = ctx.currentTime;

        // Note 1: E5 (659Hz)
        const osc1 = ctx.createOscillator();
        const gain1 = ctx.createGain();
        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(659.25, now);
        gain1.gain.setValueAtTime(0.12, now);
        gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.4);
        osc1.connect(gain1);
        gain1.connect(ctx.destination);
        osc1.start(now);
        osc1.stop(now + 0.4);

        // Note 2: B5 (987Hz) delayed chord harmony
        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.type = 'triangle';
        osc2.frequency.setValueAtTime(987.77, now + 0.08);
        gain2.gain.setValueAtTime(0.18, now + 0.08);
        gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.start(now + 0.08);
        osc2.stop(now + 0.6);
      } catch(e) {}
    }

    // Hardware-Accelerated 60FPS Confetti Cannon Particle Canvas
    function launchConfetti() {
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;

      const colors = ['#10b981', '#f59e0b', '#3b82f6', '#ec4899', '#8b5cf6', '#14b8a6'];
      const particles = [];
      const particleCount = 45;

      for (let i = 0; i < particleCount; i++) {
        particles.push({
          x: canvas.width / 2 + (Math.random() * 80 - 40),
          y: canvas.height * 0.7,
          vx: (Math.random() - 0.5) * 8,
          vy: -(Math.random() * 7 + 4),
          size: Math.random() * 5 + 3,
          color: colors[Math.floor(Math.random() * colors.length)],
          rotation: Math.random() * 360,
          vRot: (Math.random() - 0.5) * 10,
          alpha: 1
        });
      }

      let animationFrame;
      function render() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let alive = 0;

        for (let p of particles) {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.22; // gravity
          p.rotation += p.vRot;
          p.alpha -= 0.016;

          if (p.alpha > 0) {
            alive++;
            ctx.save();
            ctx.globalAlpha = p.alpha;
            ctx.translate(p.x, p.y);
            ctx.rotate((p.rotation * Math.PI) / 180);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 0.7);
            ctx.restore();
          }
        }

        if (alive > 0) {
          animationFrame = requestAnimationFrame(render);
        } else {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          cancelAnimationFrame(animationFrame);
        }
      }
      render();
    }

    // Update Slider State & Dynamic Gamification
    function updateTip(val, triggerEffects = false) {
      val = parseInt(val, 10);
      if (isNaN(val) || val < 1) val = 1;

      slider.value = Math.min(val, 50);
      if (customInput && document.activeElement !== customInput) {
        customInput.value = val;
      }
      display.textContent = `$${val}.00`;
      btnText.textContent = `Buy Yash a Coffee ($${val}.00) & Unlock Vault`;
      tipBtn.href = `https://buymeacoffee.com/yashjha`;
      if (gumroadAmountText) {
        gumroadAmountText.textContent = `$${val}`;
      }

      // Match Gamification Tier
      const matchedTier = tiers.find(t => val <= t.max) || tiers[tiers.length - 1];
      tierBadge.textContent = matchedTier.badge;
      emoji.textContent = matchedTier.emoji;
      title.textContent = matchedTier.title;
      sub.textContent = matchedTier.sub;

      // Update Active Chip Styling
      chips.forEach(c => {
        const amt = c.dataset.amount;
        if (amt === 'custom') {
          if (![1, 4, 8, 15].includes(val)) {
            c.classList.add('border-emerald-500', 'bg-emerald-500/10', 'active-chip');
            c.classList.remove('border-slate-300', 'dark:border-slate-700');
          } else {
            c.classList.remove('border-emerald-500', 'bg-emerald-500/10', 'active-chip');
            c.classList.add('border-slate-300', 'dark:border-slate-700');
          }
        } else {
          const numAmt = parseInt(amt, 10);
          if (numAmt === val) {
            c.classList.add('border-emerald-500', 'bg-emerald-500/10', 'active-chip');
            c.classList.remove('border-slate-200', 'dark:border-slate-800');
          } else {
            c.classList.remove('border-emerald-500', 'bg-emerald-500/10', 'active-chip');
            c.classList.add('border-slate-200', 'dark:border-slate-800');
          }
        }
      });

      if (triggerEffects) {
        playCelebrationSound();
        launchConfetti();
      }
    }

    // Slider Drag Event
    slider.addEventListener('input', (e) => {
      updateTip(e.target.value, false);
    });

    // Slider Release Celebratory Trigger
    slider.addEventListener('change', () => {
      playCelebrationSound();
      launchConfetti();
    });

    // Custom Numeric Input Events
    if (customInput) {
      customInput.addEventListener('input', (e) => {
        const val = parseInt(e.target.value, 10);
        if (!isNaN(val) && val >= 1) {
          updateTip(val, false);
        }
      });
      customInput.addEventListener('change', (e) => {
        const val = parseInt(e.target.value, 10);
        if (!isNaN(val) && val >= 1) {
          updateTip(val, true);
        }
      });
    }

    // Chip Click Events
    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const amt = chip.dataset.amount;
        if (amt === 'custom') {
          if (customInput) {
            customInput.focus();
            customInput.select();
          }
        } else {
          updateTip(amt, true);
        }
      });
    });

    // Tip Button Click Celebratory FX
    tipBtn.addEventListener('click', () => {
      playCelebrationSound();
      launchConfetti();
    });
  });
</script>
