---
interface Props {
  source?: string;
  updatedDate?: string;
  readTime?: string;
}

const {
  source = "US Federal Reserve Survey of Consumer Finances (SCF)",
  updatedDate = "October 2026",
  readTime = ""
} = Astro.props;
---

<div class="my-6 p-4 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600 dark:text-slate-400">
  <div class="flex items-center gap-3">
    <!-- Verified Shield Icon -->
    <div class="w-8 h-8 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 shrink-0">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
    </div>
    <div>
      <div class="flex items-center gap-2">
        <span class="font-bold text-slate-900 dark:text-white">Fact-Checked &amp; Mathematically Verified</span>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30">
          Institutional Rigor
        </span>
      </div>
      <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">
        Researched by <a href="/author/yash-jha" class="font-semibold text-slate-900 dark:text-slate-200 underline hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Yash Jha</a> • Source: <a href="/about" class="underline hover:text-emerald-600 dark:hover:text-emerald-400">{source}</a>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3 text-[11px] text-slate-500 dark:text-slate-400">
    <span class="inline-flex items-center gap-1">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      Reviewed: {updatedDate}
    </span>
    {readTime && (
      <span class="hidden sm:inline-flex items-center gap-1">
        • {readTime}
      </span>
    )}
    <a href="/about" class="font-semibold text-emerald-600 dark:text-emerald-400 hover:underline">
      Methodology →
    </a>
  </div>
</div>
