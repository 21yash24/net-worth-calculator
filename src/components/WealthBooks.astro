---
// src/components/WealthBooks.astro
// Amazon Associates Integration for GetNetWorthCalculator (Tag: getnetworthca-20)

interface Book {
  title: string;
  author: string;
  badge: string;
  badgeColor: string;
  description: string;
  searchQuery: string;
  rating: string;
  reviews: string;
}

const books: Book[] = [
  {
    title: "The Psychology of Money",
    author: "Morgan Housel",
    badge: "Most Recommended",
    badgeColor: "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/30",
    description: "Timeless lessons on wealth, greed, and happiness. Explores why how you behave with money is far more important than how smart you are.",
    searchQuery: "the+psychology+of+money+morgan+housel",
    rating: "4.7",
    reviews: "60,000+"
  },
  {
    title: "The Simple Path to Wealth",
    author: "JL Collins",
    badge: "Index Investing",
    badgeColor: "bg-blue-500/10 text-blue-700 dark:text-blue-400 border-blue-500/30",
    description: "The definitive guide to financial independence through broad-market VTSAX index fund investing and simple, low-stress money management.",
    searchQuery: "the+simple+path+to+wealth+jl+collins",
    rating: "4.8",
    reviews: "18,000+"
  },
  {
    title: "The Millionaire Next Door",
    author: "Thomas J. Stanley, Ph.D.",
    badge: "Wealth Accumulation",
    badgeColor: "bg-amber-500/10 text-amber-700 dark:text-amber-400 border-amber-500/30",
    description: "The groundbreaking study uncovering the surprising habits and high savings rates of America's real, self-made wealthy households.",
    searchQuery: "the+millionaire+next+door+thomas+stanley",
    rating: "4.6",
    reviews: "22,000+"
  },
  {
    title: "I Will Teach You to Be Rich",
    author: "Ramit Sethi",
    badge: "Automation & Budgeting",
    badgeColor: "bg-purple-500/10 text-purple-700 dark:text-purple-400 border-purple-500/30",
    description: "A no-guilt 6-week program to automate your savings, eliminate debt, negotiate fees, and build conscious spending systems.",
    searchQuery: "i+will+teach+you+to+be+rich+ramit+sethi",
    rating: "4.7",
    reviews: "15,000+"
  }
];

const amazonTag = "getnetworthca-20";
---

<section class="mt-8 pt-8 border-t border-slate-200 dark:border-slate-800/80 space-y-5">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-400 text-xs font-semibold mb-2">
        <span>📚</span>
        <span>Essential Financial Literacy</span>
      </div>
      <h3 class="text-xl md:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Accelerate Your Wealth: Recommended Reading
      </h3>
      <p class="text-xs md:text-sm text-slate-600 dark:text-slate-400 mt-1">
        Curated bestsellers on wealth accumulation, index compounding, and financial independence.
      </p>
    </div>
    <span class="text-[11px] text-slate-500 dark:text-slate-400 italic">
      Curated by GetNetWorth Research
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {books.map((book) => {
      const amazonUrl = `https://www.amazon.com/s?k=${book.searchQuery}&tag=${amazonTag}`;
      return (
        <div class="flex flex-col justify-between p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/50 hover:border-amber-500/40 hover:shadow-lg transition-all">
          <div class="space-y-2">
            <div class="flex items-center justify-between gap-2">
              <span class={`text-[10px] uppercase font-bold px-2 py-0.5 rounded border ${book.badgeColor}`}>
                {book.badge}
              </span>
              <span class="text-xs text-amber-500 font-semibold flex items-center gap-1">
                ★ {book.rating} <span class="text-[11px] text-slate-500 font-normal">({book.reviews})</span>
              </span>
            </div>
            
            <h4 class="text-base font-bold text-slate-900 dark:text-white leading-snug">
              {book.title}
            </h4>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">
              by {book.author}
            </p>
            <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed pt-1">
              {book.description}
            </p>
          </div>

          <div class="pt-4 mt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
            <span class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1">
              <span>Prime Eligible</span>
            </span>
            <a
              href={amazonUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-amber-500/10 hover:bg-amber-500 text-amber-900 dark:text-amber-300 hover:text-white border border-amber-500/30 hover:border-amber-500 font-bold text-xs transition-all shadow-sm"
              aria-label={`View ${book.title} on Amazon`}
            >
              <span>View on Amazon</span>
              <span>→</span>
            </a>
          </div>
        </div>
      );
    })}
  </div>

  <div class="p-3.5 rounded-xl bg-slate-100/70 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/80 text-[11px] text-slate-500 dark:text-slate-400 text-center leading-relaxed">
    <p>
      <strong>Affiliate Transparency:</strong> As an Amazon Associate, GetNetWorthCalculator.com earns from qualifying purchases made via these curated links at no additional cost to you.
    </p>
  </div>
</section>
