---
// src/components/WealthBooks.astro
// Visual Amazon Associates Integration for GetNetWorthCalculator (US: getnetworthca-20 | IN: getnetworthca-21)

interface Props {
  title?: string;
  subtitle?: string;
  region?: "US" | "IN";
}

const {
  title,
  subtitle,
  region = "US"
} = Astro.props;

interface Book {
  title: string;
  author: string;
  badge: string;
  badgeColor: string;
  description: string;
  searchQuery: string;
  rating: string;
  reviews: string;
  coverBg: string;
  spineBg: string;
  coverTextColor: string;
  authorColor: string;
  coverAccent: string;
  icon: string;
}

const isIndia = region === "IN";
const amazonDomain = isIndia ? "www.amazon.in" : "www.amazon.com";
const amazonTag = isIndia ? "getnetworthca-21" : "getnetworthca-20";

const displayTitle = title || (isIndia 
  ? "Essential Financial Literacy for Indian Investors" 
  : "Accelerate Your Wealth: Essential Reading");

const displaySubtitle = subtitle || (isIndia
  ? "Curated bestsellers on mutual fund compounding, equity investing, and long-term wealth creation in India."
  : "Curated financial literacy bestsellers on wealth accumulation, index compounding, and financial freedom.");

const usBooks: Book[] = [
  {
    title: "The Psychology of Money",
    author: "Morgan Housel",
    badge: "Most Recommended",
    badgeColor: "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/30",
    description: "Timeless lessons on wealth, greed, and happiness. Explores why your financial behavior matters far more than raw IQ.",
    searchQuery: "the+psychology+of+money+morgan+housel",
    rating: "4.7",
    reviews: "60k+",
    coverBg: "bg-gradient-to-br from-slate-900 via-slate-800 to-slate-950",
    spineBg: "bg-slate-950",
    coverTextColor: "text-amber-300",
    authorColor: "text-slate-300",
    coverAccent: "border-amber-400/30",
    icon: "🧠"
  },
  {
    title: "The Simple Path to Wealth",
    author: "JL Collins",
    badge: "Index Investing",
    badgeColor: "bg-blue-500/10 text-blue-700 dark:text-blue-400 border-blue-500/30",
    description: "The definitive roadmap to financial independence through broad-market VTSAX index funds and simple, low-stress money management.",
    searchQuery: "the+simple+path+to+wealth+jl+collins",
    rating: "4.8",
    reviews: "18k+",
    coverBg: "bg-gradient-to-br from-emerald-950 via-teal-900 to-slate-950",
    spineBg: "bg-emerald-950",
    coverTextColor: "text-emerald-300",
    authorColor: "text-emerald-100/80",
    coverAccent: "border-emerald-400/30",
    icon: "🧭"
  },
  {
    title: "The Millionaire Next Door",
    author: "Thomas J. Stanley, Ph.D.",
    badge: "Wealth Accumulation",
    badgeColor: "bg-amber-500/10 text-amber-700 dark:text-amber-400 border-amber-500/30",
    description: "The landmark study uncovering how real everyday millionaires accumulate net worth through high savings rates and discipline.",
    searchQuery: "the+millionaire+next+door+thomas+stanley",
    rating: "4.6",
    reviews: "22k+",
    coverBg: "bg-gradient-to-br from-blue-950 via-indigo-950 to-slate-950",
    spineBg: "bg-blue-950",
    coverTextColor: "text-amber-200",
    authorColor: "text-slate-300",
    coverAccent: "border-amber-500/30",
    icon: "🏛️"
  },
  {
    title: "I Will Teach You to Be Rich",
    author: "Ramit Sethi",
    badge: "Budget Automation",
    badgeColor: "bg-yellow-500/10 text-yellow-700 dark:text-yellow-400 border-yellow-500/30",
    description: "A no-guilt 6-week program to automate your personal finances, negotiate bills, eliminate debt, and build conscious spending.",
    searchQuery: "i+will+teach+you+to+be+rich+ramit+sethi",
    rating: "4.7",
    reviews: "15k+",
    coverBg: "bg-gradient-to-br from-amber-400 via-yellow-400 to-amber-500",
    spineBg: "bg-amber-600",
    coverTextColor: "text-slate-950",
    authorColor: "text-slate-900",
    coverAccent: "border-amber-600/40",
    icon: "⚡"
  }
];

const indiaBooks: Book[] = [
  {
    title: "Let's Talk Money",
    author: "Monika Halan",
    badge: "India Financial Plan",
    badgeColor: "bg-orange-500/10 text-orange-700 dark:text-orange-400 border-orange-500/30",
    description: "India's definitive personal finance roadmap. Learn how to structure bank accounts, medical insurance, emergency funds, and mutual funds in ₹.",
    searchQuery: "lets+talk+money+monika+halan",
    rating: "4.7",
    reviews: "12k+",
    coverBg: "bg-gradient-to-br from-orange-950 via-amber-900 to-slate-950",
    spineBg: "bg-orange-950",
    coverTextColor: "text-orange-300",
    authorColor: "text-orange-100/80",
    coverAccent: "border-orange-400/30",
    icon: "💰"
  },
  {
    title: "The Psychology of Money",
    author: "Morgan Housel",
    badge: "Most Recommended",
    badgeColor: "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border-emerald-500/30",
    description: "Timeless lessons on wealth, greed, and happiness. Explores why your financial behavior matters far more than mathematical IQ.",
    searchQuery: "the+psychology+of+money+morgan+housel",
    rating: "4.7",
    reviews: "60k+",
    coverBg: "bg-gradient-to-br from-slate-900 via-slate-800 to-slate-950",
    spineBg: "bg-slate-950",
    coverTextColor: "text-amber-300",
    authorColor: "text-slate-300",
    coverAccent: "border-amber-400/30",
    icon: "🧠"
  },
  {
    title: "Coffee Can Investing",
    author: "Saurabh Mukherjea",
    badge: "Long-Term Compounding",
    badgeColor: "bg-blue-500/10 text-blue-700 dark:text-blue-400 border-blue-500/30",
    description: "The low-risk roadmap to 20%+ annual compounding in Indian equities by investing in great companies with high Return on Capital Employed (ROCE).",
    searchQuery: "coffee+can+investing+saurabh+mukherjea",
    rating: "4.6",
    reviews: "8k+",
    coverBg: "bg-gradient-to-br from-blue-950 via-slate-900 to-indigo-950",
    spineBg: "bg-blue-950",
    coverTextColor: "text-amber-200",
    authorColor: "text-slate-300",
    coverAccent: "border-blue-400/30",
    icon: "📈"
  },
  {
    title: "Rich Dad Poor Dad",
    author: "Robert T. Kiyosaki",
    badge: "Asset Accumulation",
    badgeColor: "bg-purple-500/10 text-purple-700 dark:text-purple-400 border-purple-500/30",
    description: "The #1 personal finance classic exploring the vital distinction between true income-producing assets and depreciating liabilities.",
    searchQuery: "rich+dad+poor+dad+robert+kiyosaki",
    rating: "4.6",
    reviews: "95k+",
    coverBg: "bg-gradient-to-br from-purple-950 via-slate-900 to-purple-900",
    spineBg: "bg-purple-950",
    coverTextColor: "text-purple-300",
    authorColor: "text-purple-100/80",
    coverAccent: "border-purple-400/30",
    icon: "💡"
  }
];

const books = isIndia ? indiaBooks : usBooks;
---

<section class="mt-10 pt-8 border-t border-slate-200 dark:border-slate-800/80 space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
    <div>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-400 text-xs font-semibold mb-2">
        <span>📚</span>
        <span>Essential Financial Literacy</span>
      </div>
      <h3 class="text-xl md:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {displayTitle}
      </h3>
      <p class="text-xs md:text-sm text-slate-600 dark:text-slate-400 mt-1 max-w-2xl">
        {displaySubtitle}
      </p>
    </div>
    <span class="text-[11px] text-slate-500 dark:text-slate-400 italic">
      Curated by GetNetWorth Research
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {books.map((book) => {
      const amazonUrl = `https://${amazonDomain}/s?k=${book.searchQuery}&tag=${amazonTag}`;
      return (
        <div class="flex flex-col sm:flex-row gap-4 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/50 hover:border-amber-500/50 hover:shadow-xl transition-all group">
          
          <!-- 3D Book Cover Visual -->
          <div class="flex-shrink-0 self-center sm:self-start">
            <a 
              href={amazonUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="block relative w-24 h-36 rounded-r-lg rounded-l-sm shadow-lg overflow-hidden border border-slate-700/30 transition-transform duration-300 group-hover:scale-105 group-hover:-rotate-1"
              aria-label={`Buy ${book.title} on Amazon`}
            >
              <!-- 3D Spine effect shadow on left edge -->
              <div class="absolute left-0 top-0 bottom-0 w-2.5 bg-gradient-to-r from-black/50 via-white/10 to-transparent z-20"></div>
              
              <!-- Book Cover Body -->
              <div class={`w-full h-full ${book.coverBg} p-2 flex flex-col justify-between text-left relative z-10 border-l border-white/20`}>
                <div class="space-y-1">
                  <div class="text-base leading-none">{book.icon}</div>
                  <div class="text-[9px] font-mono tracking-widest uppercase opacity-70 leading-none">Bestseller</div>
                </div>

                <div class="space-y-0.5">
                  <h5 class={`text-[10px] font-extrabold ${book.coverTextColor} leading-tight line-clamp-3`}>
                    {book.title}
                  </h5>
                  <p class={`text-[8px] font-medium ${book.authorColor} truncate opacity-90`}>
                    {book.author}
                  </p>
                </div>

                <div class="flex items-center justify-between text-[8px] opacity-75 pt-1 border-t border-white/10">
                  <span class="font-bold">{isIndia ? "Amazon.in" : "Amazon"}</span>
                  <span>★ {book.rating}</span>
                </div>
              </div>
            </a>
          </div>

          <!-- Book Details Column -->
          <div class="flex flex-col justify-between flex-grow space-y-2">
            <div class="space-y-1.5">
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <span class={`text-[10px] uppercase font-bold px-2 py-0.5 rounded border ${book.badgeColor}`}>
                  {book.badge}
                </span>
                <span class="text-xs text-amber-500 font-bold flex items-center gap-1">
                  ★ {book.rating} <span class="text-[11px] text-slate-500 font-normal">({book.reviews})</span>
                </span>
              </div>
              
              <h4 class="text-base font-bold text-slate-900 dark:text-white leading-snug group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors">
                {book.title}
              </h4>
              <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">
                by {book.author}
              </p>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed line-clamp-3 pt-0.5">
                {book.description}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between">
              <span class="text-[11px] text-slate-500 dark:text-slate-400 flex items-center gap-1">
                <span>📦 Prime Delivery</span>
              </span>
              <a
                href={amazonUrl}
                target="_blank"
                rel="nofollow sponsored noopener"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500 text-amber-900 dark:text-amber-300 hover:text-white border border-amber-500/30 hover:border-amber-500 font-bold text-xs transition-all shadow-sm"
              >
                <span>{isIndia ? "Check on Amazon.in" : "Check on Amazon"}</span>
                <span>→</span>
              </a>
            </div>
          </div>

        </div>
      );
    })}
  </div>

  <div class="p-3.5 rounded-xl bg-slate-100/70 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/80 text-[11px] text-slate-500 dark:text-slate-400 text-center leading-relaxed">
    <p>
      <strong>Affiliate Transparency:</strong> As an Amazon Associate, GetNetWorthCalculator.com earns from qualifying purchases made via these links at no extra cost to you.
    </p>
  </div>
</section>
