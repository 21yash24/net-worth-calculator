---
import affiliates from '../data/affiliates.json';

interface Props {
  title?: string;
  subtitle?: string;
  variant?: 'featured' | 'compact';
  className?: string;
}

const {
  title = "Ready to Automate Your Real-Time Net Worth?",
  subtitle = "Stop updating manual spreadsheets. Connect your accounts once and watch your total wealth, 401(k) compounding, and asset allocation update automatically.",
  variant = 'featured',
  className = ""
} = Astro.props;

const { empower, monarch } = affiliates;
---

<div class={`rounded-3xl border border-emerald-500/30 dark:border-emerald-500/25 bg-gradient-to-br from-white via-emerald-50/20 to-slate-50 dark:from-slate-900/90 dark:via-emerald-950/20 dark:to-slate-950 p-6 sm:p-8 shadow-xl backdrop-blur-xl relative overflow-hidden ${className}`}>
  <!-- Decorative Background Glow -->
  <div class="absolute -top-24 -right-24 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 space-y-6">
    <!-- Header with Trust Badge -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-bold">
        <span>⚡ Recommended Net Worth Tracker</span>
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{empower.badge}</span>
      </div>

      <div class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-slate-500 dark:text-slate-400">
        <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" />
        </svg>
        <span>256-Bit Bank Encryption • Read-Only Access</span>
      </div>
    </div>

    <!-- Main Title & Copy -->
    <div class="space-y-2">
      <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {title}
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl font-normal">
        {subtitle}
      </p>
    </div>

    <!-- Two-Column Product Spotlight -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5 items-center">
      <!-- Left: Feature Bullet Grid -->
      <div class="md:col-span-7 space-y-2.5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
          {empower.features.map(f => (
            <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white/80 dark:bg-slate-950/60 border border-slate-200/80 dark:border-slate-800/80 text-slate-700 dark:text-slate-300 font-medium">
              <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] font-bold shrink-0">✓</span>
              <span class="text-[11px] leading-tight">{f}</span>
            </div>
          ))}
        </div>
        <p class="text-[11px] text-slate-500 dark:text-slate-400 italic pt-1">
          Used by over 3.3 million people to track over $500 Billion in household assets.
        </p>
      </div>

      <!-- Right: Action CTA & Dual Recommendation -->
      <div class="md:col-span-5 p-5 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-md space-y-3.5 text-center">
        <div class="flex items-center justify-center gap-2">
          <span class="text-lg font-black text-slate-900 dark:text-white">Empower</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-extrabold bg-emerald-600 text-white uppercase tracking-wider">Free App</span>
        </div>

        <a 
          href={empower.url} 
          target="_blank" 
          rel="nofollow sponsored noopener" 
          class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 active:scale-[0.98] text-white font-extrabold text-sm transition-all shadow-lg shadow-emerald-900/30"
        >
          <span>{empower.cta}</span>
          <span class="text-base">→</span>
        </a>

        <div class="pt-1 border-t border-slate-100 dark:border-slate-800 text-[11px] text-slate-500 dark:text-slate-400">
          <span>Looking for budgeting &amp; couples? </span>
          <a href={monarch.url} target="_blank" rel="nofollow sponsored noopener" class="font-bold text-emerald-600 dark:text-emerald-400 hover:underline">
            Try Monarch Money →
          </a>
        </div>
      </div>
    </div>

    <!-- FTC & Google Compliance Disclosure -->
    <div class="pt-2 border-t border-slate-200/80 dark:border-slate-800/60 text-[10px] text-slate-400 dark:text-slate-500 leading-normal flex items-start gap-1.5">
      <span class="font-bold uppercase shrink-0 text-slate-500">Partner Disclosure:</span>
      <span>GetNetWorthCalculator.com is an independent financial education tool. We partner with financial institutions like Empower and Monarch Money and may receive financial compensation when you open an account through our verified links, at zero cost to you. This does not impact our mathematically verified government benchmark data.</span>
    </div>
  </div>
</div>
