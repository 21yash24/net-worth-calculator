---
import product from '../data/product.json';

interface Props {
  className?: string;
  headline?: string;
}

const {
  className = "",
  headline = "Track Wealth & Cash Flow Without the Accounting Homework"
} = Astro.props;
---

<div class={`rounded-3xl border-2 border-emerald-500/40 dark:border-emerald-500/30 bg-gradient-to-br from-white via-slate-50 to-emerald-50/30 dark:from-slate-900/95 dark:via-slate-950 dark:to-emerald-950/30 p-6 sm:p-9 shadow-2xl relative overflow-hidden ${className}`}>
  <!-- Glowing Ambient Accents -->
  <div class="absolute -top-20 -right-20 w-72 h-72 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 space-y-6">
    <!-- Header Badge Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-black uppercase tracking-wider">
        <span>⭐ All-In-One Wealth &amp; Budget System</span>
        <span>•</span>
        <span class="text-amber-600 dark:text-amber-400 font-extrabold">{product.earlyBirdPrice} Early Access</span>
      </div>

      <div class="inline-flex items-center gap-1.5 text-[11px] font-bold text-slate-500 dark:text-slate-400">
        <span>🔒 100% Private</span>
        <span>•</span>
        <span>Google Sheets &amp; Excel</span>
      </div>
    </div>

    <!-- Main Title & Hook -->
    <div class="space-y-2">
      <h3 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
        {headline}
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl font-normal">
        Most people abandon budgeting spreadsheets because entering 40 receipts feels like a second job. The <strong>Master Wealth &amp; Smart Budget Vault</strong> simplifies everything into a <strong>2-minute monthly check-in</strong>, answers <em>"How much can I spend safely today?"</em>, and connects your savings directly to your Federal Reserve percentile rank and early retirement date.
      </p>
    </div>

    <!-- Interactive Mock Dashboard Preview & Feature Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
      <!-- Left: Mock Spreadsheet UI Preview -->
      <div class="lg:col-span-7 rounded-2xl bg-white dark:bg-slate-950 p-4 sm:p-5 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-mono text-xs shadow-md dark:shadow-inner space-y-3 transition-colors">
        <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-slate-800/80">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-rose-500 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span>
            <span class="text-[11px] text-slate-600 dark:text-slate-400 font-sans font-semibold ml-2">Master_Vault_2026.xlsx</span>
          </div>
          <span class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/15 border border-emerald-500/30 text-emerald-700 dark:text-emerald-400 font-sans font-bold">⚡ 2-Min Rule</span>
        </div>

        <!-- Metric Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-center pt-1">
          <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-sans font-semibold">TOTAL NET WORTH</span>
            <span class="text-sm sm:text-base font-extrabold text-slate-900 dark:text-white font-sans">$342,850</span>
            <span class="text-[10px] text-emerald-600 dark:text-emerald-400 block font-sans font-bold">▲ +4.2% MoM</span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
            <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-sans font-semibold">SAFE DAILY SPEND</span>
            <span class="text-sm sm:text-base font-extrabold text-emerald-600 dark:text-emerald-400 font-sans">$48 / day</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-sans">Guilt-Free Buffer</span>
          </div>
          <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 col-span-2 sm:col-span-1 shadow-sm">
            <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-sans font-semibold">FED SCF RANK</span>
            <span class="text-sm sm:text-base font-extrabold text-amber-600 dark:text-amber-400 font-sans">Top 12%</span>
            <span class="text-[10px] text-slate-500 dark:text-slate-400 block font-sans">Age Cohort 30-34</span>
          </div>
        </div>

        <!-- Trajectory Sparkline Bar -->
        <div class="p-2.5 rounded-xl bg-slate-50/90 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex items-center justify-between text-[11px] font-sans shadow-sm">
          <div class="flex items-center gap-2">
            <span class="text-emerald-600 dark:text-emerald-400 font-bold">🎯 Sinking Funds Shield:</span>
            <span class="text-slate-700 dark:text-slate-300">5 Goals on Track ($28.2k saved)</span>
          </div>
          <span class="text-amber-600 dark:text-amber-400 font-bold">FIRE Target: Oct 2038 →</span>
        </div>

        <!-- Tabs indicator -->
        <div class="flex items-center gap-1.5 pt-1 text-[10px] font-sans overflow-x-auto">
          <span class="px-2 py-0.5 rounded bg-emerald-500/15 border border-emerald-500/30 text-emerald-700 dark:text-emerald-400 font-bold whitespace-nowrap">1. ⚡ 2-Min Check-In</span>
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 whitespace-nowrap">2. 📊 Dashboard</span>
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 whitespace-nowrap">3. 💸 Smart Budget</span>
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 whitespace-nowrap">4. 🎯 Sinking Funds</span>
          <span class="px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-900 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-800 whitespace-nowrap">5. 🔥 FIRE Engine</span>
        </div>
      </div>

      <!-- Right: Price & Instant Checkout CTA -->
      <div class="lg:col-span-5 p-6 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-lg text-center space-y-4">
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-700 dark:text-amber-400 text-xs font-bold mb-2">
            <span>⚡ {product.earlyBirdLimit}: {product.earlyBirdPrice}</span>
          </div>

          <div class="flex items-baseline justify-center gap-2">
            <span class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">{product.earlyBirdPrice}</span>
            <span class="text-sm font-semibold text-slate-500 dark:text-slate-400">regular {product.price}</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400 font-medium mt-1">One-time payment • Lifetime personal use</p>
        </div>

        <ul class="text-xs text-left text-slate-700 dark:text-slate-300 space-y-2 pt-1 font-medium">
          <li class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] font-bold shrink-0">✓</span>
            <span><strong>⚡ 2-Minute Monthly Check-In:</strong> Just 4 numbers on the 1st of each month</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] font-bold shrink-0">✓</span>
            <span><strong>💸 50/30/20 Budget:</strong> Live "Safe to Spend" daily &amp; monthly buffer</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] font-bold shrink-0">✓</span>
            <span><strong>🎯 Sinking Funds Shield:</strong> Car repairs &amp; holidays never shock your budget</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] font-bold shrink-0">✓</span>
            <span><strong>🏛️ Official Fed Microdata:</strong> Compare against US SCF benchmarks</span>
          </li>
          <li class="flex items-center gap-2">
            <span class="w-4 h-4 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-[10px] font-bold shrink-0">✓</span>
            <span><strong>Google Sheets &amp; Excel:</strong> 100% offline, zero third-party bank linking</span>
          </li>
        </ul>

        <div class="pt-2 space-y-2.5">
          <a 
            href="https://yashjha22.gumroad.com/l/vxdzfq" 
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2.5 py-4 px-6 rounded-2xl bg-gradient-to-r from-emerald-500 via-emerald-600 to-teal-600 hover:from-emerald-400 hover:to-teal-500 active:scale-[0.98] text-white font-black text-base transition-all shadow-xl shadow-emerald-900/40 hover:shadow-emerald-500/20 group"
          >
            <span>⚡ Get Master Vault — {product.earlyBirdPrice}</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-black/20 text-emerald-100 font-bold tracking-wide">50% OFF</span>
          </a>

          <a 
            href="/tracker-template" 
            class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-900 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 font-bold text-xs transition-colors border border-slate-200 dark:border-slate-800"
          >
            <span>🔍 See Interactive Demo &amp; 5-Tab Walkthrough</span>
            <span>→</span>
          </a>
          
          <div class="flex items-center justify-center gap-3 text-[11px] text-slate-500 dark:text-slate-400 pt-1 font-medium">
            <span>⚡ Instant 1-Click Access</span>
            <span>•</span>
            <span>Google Sheets &amp; Excel (.xlsx)</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
