  // PDF Text Extractor
  async function parsePDF(file) {
    const arrayBuffer = await file.arrayBuffer();
    const pdf = await window.pdfjsLib.getDocument({ data: arrayBuffer }).promise;
    let extractedRows = [];

    const dateRegex = /\b(\d{1,2}[\/\-\.]\d{1,2}(?:[\/\-\.]\d{2,4})?)\b|\b((?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*\.?\s+\d{1,2}(?:,?\s+\d{2,4})?)\b/i;
    const amountRegex = /[-–—]?\$?\s*([0-9]{1,3}(?:,[0-9]{3})*\.[0-9]{2})\b/;

    for (let i = 1; i <= pdf.numPages; i++) {
      const page = await pdf.getPage(i);
      const content = await page.getTextContent();
      
      const linesMap = {};
      content.items.forEach(item => {
        const y = Math.round(item.transform[5] / 3) * 3;
        linesMap[y] = linesMap[y] || [];
        linesMap[y].push({ x: item.transform[4], str: item.str });
      });

      const sortedYs = Object.keys(linesMap).sort((a, b) => b - a);

      sortedYs.forEach(y => {
        const lineItems = linesMap[y].sort((a, b) => a.x - b.x);
        const lineText = lineItems.map(it => it.str).join(' ').trim();

        if (dateRegex.test(lineText) && amountRegex.test(lineText)) {
          const dMatch = lineText.match(dateRegex);
          const aMatch = lineText.match(amountRegex);

          if (dMatch && aMatch) {
            const dateStr = dMatch[0];
            const amtStr = aMatch[1].replace(/,/g, '');
            const parsedAmt = parseFloat(amtStr);

            let desc = lineText.replace(dMatch[0], '').replace(aMatch[0], '').trim();
            const isInflow = lineText.includes('CR') || lineText.toLowerCase().includes('deposit') || lineText.toLowerCase().includes('payroll');

            if (parsedAmt > 0 && desc.length > 2) {
              extractedRows.push({
                date: dateStr,
                raw: desc,
                amount: parsedAmt,
                isInflow: isInflow
              });
            }
          }
        }
      });
    }

    if (extractedRows.length === 0) {
      showToast('⚠️ Could not extract rows from PDF layout. Switching to demo template.');
      processRawItems(SAMPLE_STATEMENT);
    } else {
      showToast(`✅ Successfully parsed ${extractedRows.length} transactions from PDF!`);
      processRawItems(extractedRows);
    }
  }

  // CSV Parser
  function parseCSV(text) {
    const lines = text.split(/\r?\n/).filter(l => l.trim().length > 0);
    const rows = [];
    const dateRegex = /\b(\d{1,2}[\/\-\.]\d{1,2}(?:[\/\-\.]\d{2,4})?)\b/i;

    lines.forEach(line => {
      const cols = line.split(/,(?=(?:(?:[^"]*"){2})*[^"]*$)/).map(c => c.replace(/^"|"$/g, '').trim());
      if (cols.length >= 3) {
        let d = '';
        let desc = '';
        let amt = 0;

        for (const col of cols) {
          if (!d && dateRegex.test(col)) {
            d = col;
          } else if (isNaN(amt) || amt === 0) {
            const num = parseFloat(col.replace(/[$,]/g, ''));
            if (!isNaN(num) && num !== 0) amt = num;
            else if (!desc && col.length > 2) desc = col;
          } else if (!desc && col.length > 2) {
            desc = col;
          }
        }

        if (d && desc && amt !== 0) {
          rows.push({
            date: d,
            raw: desc,
            amount: Math.abs(amt),
            isInflow: amt > 0 && line.toLowerCase().includes('deposit')
          });
        }
      }
    });

    if (rows.length > 0) {
      showToast(`✅ Successfully imported ${rows.length} transactions from CSV!`);
      processRawItems(rows);
    } else {
      showToast('⚠️ CSV format unrecognized. Loading demo statement.');
      processRawItems(SAMPLE_STATEMENT);
    }
  }

