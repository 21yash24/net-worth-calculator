  }

  // Merchant Cleaning Normalizer
  function cleanMerchantName(raw) {
    let s = raw.toUpperCase();
    s = s.replace(/\b(POS DEBIT|CHECK CARD|PURCHASE|WITHDRAWAL|DEBIT CARD|RECURRING|PAYMENT|ONLINE PMT|AUTOPAY)\b/g, '');
    s = s.replace(/\b(TST\*|SQ \*|SP \*|PAYPAL \*|VSP\*)\s*/g, '');
    s = s.replace(/#\d+/g, '');
    s = s.replace(/\b\d{3,}\b/g, '');
    s = s.replace(/\b(CA|NY|TX|FL|WA|IL|OH|GA|NC|NJ|US|USA)\b/g, '');
    s = s.replace(/[^A-Z0-9\s\.\*\-\&]/g, ' ');
    s = s.replace(/\s+/g, ' ').trim();

    if (s.length === 0) s = raw.trim();

    return s.toLowerCase().split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
  }

  // Auto-Categorizer
  function categorizeTransaction(cleanName, raw, amount, isInflow) {
    if (isInflow) {
      return { category: 'INFLOW / DEPOSITS', bucket: 'Inflow', color: '#10b981' };
    }

    const testStr = (cleanName + ' ' + raw).toLowerCase();
    for (const [catName, meta] of Object.entries(CATEGORY_MAP)) {
      if (catName === 'INFLOW / DEPOSITS') continue;
      for (const kw of meta.keywords) {
        if (testStr.includes(kw)) {
          return { category: catName, bucket: meta.bucket, color: meta.color };
        }
      }
    }

    return { category: 'MISCELLANEOUS', bucket: '30% Wants', color: '#64748b' };
  }

  // Process Ingested Array
  function processRawItems(items) {
    parsedTransactions = items.map((item, idx) => {
      const cleanName = cleanMerchantName(item.raw);
      const cat = categorizeTransaction(cleanName, item.raw, item.amount, item.isInflow);
      return {
        id: idx,
        date: item.date,
        raw: item.raw,
        merchant: cleanName,
        amount: Math.abs(item.amount),
        isInflow: item.isInflow,
        category: cat.category,
        bucket: cat.bucket,
        color: cat.color
      };
    });

    renderAll();
  }

  // Render Full Suite
  function renderAll() {
    document.getElementById('results-container').classList.remove('hidden');
    renderHealthScore();
    renderKPIs();
    renderBudgetBar();
    renderCharts();
    renderInsights();
    renderMerchantPareto();
    renderTable();

    document.getElementById('results-container').scrollIntoView({ behavior: 'smooth' });
  }

  // 1. Executive Financial Health Score (0-100)
  function renderHealthScore() {
    let totalOutflow = 0;
    let totalInflow = 0;
    let needs = 0;
    let wants = 0;
    let subs = 0;

    parsedTransactions.forEach(t => {
      if (t.isInflow) {
        totalInflow += t.amount;
      } else {
        totalOutflow += t.amount;
        if (t.bucket === '50% Needs') needs += t.amount;
        else if (t.bucket === '30% Wants') wants += t.amount;
        if (t.category === 'SUBSCRIPTIONS') subs += t.amount;
      }
    });

    const netFlow = totalInflow - totalOutflow;
    const savingsRate = totalInflow > 0 ? Math.max(0, netFlow / totalInflow) : 0;
    const pNeeds = totalOutflow > 0 ? needs / totalOutflow : 0;
    const pWants = totalOutflow > 0 ? wants / totalOutflow : 0;
    const subRatio = totalOutflow > 0 ? subs / totalOutflow : 0;

    // Sub-Scores
    let savingsScore = Math.min(40, Math.round(savingsRate * 100 * 0.8));
    let needsScore = pNeeds <= 0.50 ? 30 : Math.max(10, Math.round(30 - (pNeeds - 0.50) * 60));
    let wantsScore = pWants <= 0.30 ? 20 : Math.max(5, Math.round(20 - (pWants - 0.30) * 50));
    let subsScore = subRatio <= 0.05 ? 10 : Math.max(2, Math.round(10 - (subRatio - 0.05) * 80));

    const totalScore = Math.min(100, Math.max(20, savingsScore + needsScore + wantsScore + subsScore));

    document.getElementById('health-score-num').textContent = totalScore;
    document.getElementById('health-score-circle').setAttribute('stroke-dasharray', `${totalScore}, 100`);

    document.getElementById('score-savings-rate').textContent = `${savingsScore}/40 pts`;
    document.getElementById('score-needs-ratio').textContent = `${needsScore}/30 pts`;
    document.getElementById('score-wants-ratio').textContent = `${wantsScore}/20 pts`;
    document.getElementById('score-subs-ratio').textContent = `${subsScore}/10 pts`;

    const badge = document.getElementById('health-grade-badge');
    const title = document.getElementById('health-status-title');
    const desc = document.getElementById('health-status-desc');

