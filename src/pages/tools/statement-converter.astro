  document.addEventListener('DOMContentLoaded', () => {
    initLicense();

    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const loader = document.getElementById('parse-loader');

    ['dragenter', 'dragover'].forEach(eName => {
      dropZone.addEventListener(eName, (e) => {
        e.preventDefault();
        dropZone.classList.add('border-emerald-400', 'bg-emerald-950/20');
      });
    });

    ['dragleave', 'drop'].forEach(eName => {
      dropZone.addEventListener(eName, (e) => {
        e.preventDefault();
        dropZone.classList.remove('border-emerald-400', 'bg-emerald-950/20');
      });
    });

    dropZone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      const files = dt.files;
      if (files.length > 0) handleFile(files[0]);
    });

    document.getElementById('btn-browse-file').addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length > 0) handleFile(fileInput.files[0]);
    });

    document.getElementById('btn-load-sample').addEventListener('click', (e) => {
      e.stopPropagation();
      loader.classList.remove('hidden');
      setTimeout(() => {
        loader.classList.add('hidden');
        showToast('⚡ Sample Chase/Amex 24-transaction profile loaded!');
        processRawItems(SAMPLE_STATEMENT);
      }, 400);
    });

    async function handleFile(file) {
      loader.classList.remove('hidden');
      try {
        if (file.type === 'application/pdf' || file.name.endsWith('.pdf')) {
          await parsePDF(file);
        } else {
          const text = await file.text();
          parseCSV(text);
        }
      } catch (err) {
        console.error(err);
        showToast('⚠️ Parser error. Loading demo statement.');
        processRawItems(SAMPLE_STATEMENT);
      } finally {
        loader.classList.add('hidden');
      }
    }

    document.getElementById('btn-verify-license').addEventListener('click', () => {
      const val = document.getElementById('license-key-input').value;
      if (val) verifyKey(val);
    });

    document.getElementById('btn-trigger-license-modal').addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
      document.getElementById('license-key-input').focus();
    });

    document.getElementById('btn-copy-vault').addEventListener('click', copyVaultFormat);
    document.getElementById('btn-download-csv').addEventListener('click', downloadCSV);
    document.getElementById('btn-print-pdf').addEventListener('click', printPDFReport);
    document.getElementById('btn-download-json').addEventListener('click', downloadJSON);

    document.getElementById('table-search').addEventListener('input', renderTable);

    document.querySelectorAll('.pill-filter').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.pill-filter').forEach(b => {
          b.className = 'pill-filter px-3 py-1 rounded-lg text-xs font-bold bg-slate-800 text-slate-300 hover:bg-slate-700 transition-colors';
        });
        btn.className = 'pill-filter px-3 py-1 rounded-lg text-xs font-bold bg-emerald-500 text-slate-950 transition-colors';
        activeFilter = btn.getAttribute('data-filter');
        renderTable();
      });
    });
  });
</script>
