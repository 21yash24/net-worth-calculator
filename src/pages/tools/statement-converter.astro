  function renderBudgetBar() {
    let needs = 0;
    let wants = 0;
    let wealth = 0;
    let totalOutflow = 0;

    parsedTransactions.forEach(t => {
      if (!t.isInflow) {
        totalOutflow += t.amount;
        if (t.bucket === '50% Needs') needs += t.amount;
        else if (t.bucket === '30% Wants') wants += t.amount;
        else if (t.bucket === '20% Wealth') wealth += t.amount;
      }
    });

    if (totalOutflow === 0) return;

    const pNeeds = Math.round((needs / totalOutflow) * 100);
    const pWants = Math.round((wants / totalOutflow) * 100);
    const pWealth = Math.max(0, 100 - (pNeeds + pWants));

    const bNeeds = document.getElementById('bar-needs');
    const bWants = document.getElementById('bar-wants');
    const bWealth = document.getElementById('bar-wealth');

    bNeeds.style.width = pNeeds + '%';
    bNeeds.textContent = `Needs ${pNeeds}%`;

    bWants.style.width = pWants + '%';
    bWants.textContent = `Wants ${pWants}%`;

    bWealth.style.width = pWealth + '%';
    bWealth.textContent = `Wealth ${pWealth}%`;

    const verdictEl = document.getElementById('budget-verdict');
    if (pNeeds <= 50 && pWants <= 30) {
      verdictEl.innerHTML = `<strong>Institutional Health: Exceptional!</strong> Your essential Needs are tightly capped at <strong>${pNeeds}%</strong> (Benchmark: &lt;50%), and Wants are disciplined at <strong>${pWants}%</strong>. You have high wealth acceleration capacity.`;
    } else if (pWants > 35) {
      verdictEl.innerHTML = `<strong>Cash Flow Warning:</strong> Discretionary Wants accounted for <strong>${pWants}%</strong> of this statement (Target: &lt;30%). Trimming $${Math.round(wants - (totalOutflow * 0.3)).toLocaleString()} into your investments would instantly balance your budget.`;
    } else {
      verdictEl.innerHTML = `<strong>Healthy Cash Flow:</strong> Needs are <strong>${pNeeds}%</strong> and Wants are <strong>${pWants}%</strong>. Review the detected subscriptions below to reclaim guaranteed recurring surplus.`;
    }
  }

