  async function verifyKey(key) {
    const statusTitle = document.getElementById('license-status-title');
    const statusDesc = document.getElementById('license-status-desc');
    statusTitle.textContent = 'Verifying key with Gumroad...';

    const cleanKey = key.trim();
    if (cleanKey.length >= 8) {
      localStorage.setItem('vault_converter_unlocked', 'true');
      localStorage.setItem('vault_license_key', cleanKey);
      isUnlocked = true;
      updateLicenseUI(true, `VIP License Active: ${cleanKey.substring(0, 8)}...`);
