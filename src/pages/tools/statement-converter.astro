  // Check License On Mount
  function initLicense() {
    const params = new URLSearchParams(window.location.search);
    const queryKey = params.get('license') || params.get('key');
    const stored = localStorage.getItem('vault_converter_unlocked');

    if (queryKey && queryKey.trim() !== '') {
      verifyKey(queryKey.trim());
