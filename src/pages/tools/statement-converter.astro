---
import Layout from '../../layouts/Layout.astro';
import product from '../../data/product.json';

const title = "Bank Statement PDF to Excel & Expense Intelligence Converter | 100% Private";
const description = "Instantly convert PDF and CSV bank statements from Chase, BoA, Amex, Wells Fargo, and Apple Card into clean categorized transactions with automated 50/30/20 budget analytics and 1-click export for your Wealth Vault. 100% private in-browser parsing.";

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "GetNetWorth Bank Statement & Expense Intelligence Terminal",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All (Web Browser)",
  "offers": {
    "@type": "Offer",
    "price": "4.00",
    "priceCurrency": "USD"
  },
  "description": description
};

const checkoutUrl = (product.checkoutUrl && product.checkoutUrl.startsWith("http"))
  ? product.checkoutUrl 
  : "https://yashjha22.gumroad.com/l/vxdzfq";
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  <script is:inline src="https://gumroad.com/js/gumroad.js"></script>
  <!-- Client-side PDF.js (Mozilla) & Chart.js for Zero-Server Processing -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    @media print {
      header, nav, footer, #drop-zone, #license-banner, #category-filter-pills, #table-search, .no-print, button {
        display: none !important;
      }
      body, main {
        background: #ffffff !important;
        color: #0f172a !important;
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
      }
      .print-report-header {
        display: block !important;
      }
      .bg-slate-900, .bg-slate-900\/80, .bg-slate-900\/90, .bg-slate-950, .bg-slate-950\/60 {
        background: #f8fafc !important;
        border-color: #cbd5e1 !important;
        color: #0f172a !important;
      }
      .text-white {
        color: #0f172a !important;
      }
      .text-slate-300, .text-slate-400, .text-slate-500 {
        color: #475569 !important;
      }
      #table-paywall-overlay {
        display: none !important;
      }
      table {
        border-collapse: collapse !important;
        width: 100% !important;
      }
      th, td {
        border: 1px solid #cbd5e1 !important;
        color: #0f172a !important;
      }
    }
  </style>

  <main class="max-w-6xl mx-auto px-4 py-10 md:py-16 space-y-12">

    <!-- Print Report Header (Visible Only in Print Mode) -->
    <div class="hidden print-report-header text-center pb-6 border-b border-slate-300 space-y-1">
      <h1 class="text-2xl font-black text-slate-900">Official Monthly Statement &amp; Expense Intelligence Diagnostic</h1>
      <p class="text-xs text-slate-600">Generated locally via GetNetWorthCalculator.com • 100% Client-Side Privacy</p>
    </div>

    <!-- Header Section -->
    <header class="text-center space-y-4 max-w-3xl mx-auto no-print">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-xs font-black tracking-wider uppercase">
        <span class="w-2 h-2 rounded-full bg-emerald-500 dark:bg-emerald-400 animate-pulse"></span>
        <span>100% Client-Side Privacy • Zero Server Uploads</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Bank Statement <span class="text-emerald-600 dark:text-emerald-400">Expense Intelligence</span> Terminal
      </h1>

      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        Transform messy PDF or CSV bank statements into clean, structured ledgers with <strong>automated 50/30/20 budget categorization</strong>, subscription leak detection, and <strong>1-click export for the Master Wealth Vault</strong>.
      </p>

      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2 text-xs text-slate-600 dark:text-slate-400">
        <span class="flex items-center gap-1.5 bg-white dark:bg-slate-900/80 px-3 py-1 rounded-lg border border-slate-200 dark:border-slate-800 shadow-sm">
          🔒 Runs 100% In Browser Memory
        </span>
        <span class="flex items-center gap-1.5 bg-white dark:bg-slate-900/80 px-3 py-1 rounded-lg border border-slate-200 dark:border-slate-800 shadow-sm">
          🏦 Chase • Amex • BoA • Wells • Apple Card
        </span>
        <span class="flex items-center gap-1.5 bg-white dark:bg-slate-900/80 px-3 py-1 rounded-lg border border-slate-200 dark:border-slate-800 shadow-sm">
          ⚡ 1-Click Vault Clipboard Copy
        </span>
      </div>
    </header>

    <!-- License Verification Bar -->
    <div id="license-banner" class="no-print bg-gradient-to-r from-slate-100 via-white to-emerald-50 dark:from-slate-900 dark:via-slate-950 dark:to-emerald-950/40 border border-slate-200 dark:border-slate-800 rounded-2xl p-4 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-md dark:shadow-xl">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-lg">
          🔑
        </div>
        <div>
          <div class="text-xs font-bold text-slate-900 dark:text-slate-200" id="license-status-title">Free Preview Mode (First 5 Transactions)</div>
          <div class="text-[11px] text-slate-600 dark:text-slate-400" id="license-status-desc">Enter your Gumroad PRO License Key for unlimited exports and full analytics.</div>
        </div>
      </div>
      <div class="flex items-center gap-2 w-full sm:w-auto" id="license-action-area">
        <input 
          type="text" 
          id="license-key-input" 
          placeholder="Enter Gumroad License Key..." 
          class="px-3.5 py-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-300 dark:border-slate-700 text-xs text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:border-emerald-500 flex-1 sm:w-60 shadow-sm"
        />
        <button 
          id="btn-verify-license" 
          class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-bold transition-all shadow-md active:scale-95 whitespace-nowrap"
        >
          Verify Key
        </button>
      </div>
    </div>

    <!-- Main Ingestion Drop-Zone -->
    <section class="no-print relative rounded-3xl border-2 border-dashed border-slate-300 dark:border-slate-700/80 hover:border-emerald-500/60 transition-all bg-white dark:bg-slate-900/40 backdrop-blur-md p-8 sm:p-12 text-center group cursor-pointer shadow-lg dark:shadow-none" id="drop-zone">
      <input type="file" id="file-input" accept=".pdf,.csv,.txt" class="hidden" />

      <div class="max-w-md mx-auto space-y-4 pointer-events-none">
        <div class="w-16 h-16 mx-auto rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform">
          📄
        </div>
        <div class="space-y-1">
          <div class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
            Drop Bank Statement PDF or CSV Here
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400">
            Supports official PDF e-statements &amp; CSV downloads from all major US, UK, Canadian &amp; Global banks.
          </p>
        </div>
        <div class="pt-2 flex items-center justify-center gap-3 pointer-events-auto">
          <button 
            type="button" 
            id="btn-browse-file" 
            class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-black shadow-lg shadow-emerald-500/20 transition-all"
          >
            Browse Document
          </button>
          <span class="text-xs text-slate-500">or</span>
          <button 
            type="button" 
            id="btn-load-sample" 
            class="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-emerald-700 dark:text-emerald-400 text-xs font-bold border border-slate-300 dark:border-slate-700 transition-all"
          >
            ⚡ Test Drive Demo Statement
          </button>
        </div>
      </div>

      <!-- Parsing Spinner & Progress Overlay -->
      <div id="parse-loader" class="hidden absolute inset-0 bg-white/95 dark:bg-slate-950/90 backdrop-blur-sm rounded-3xl flex flex-col items-center justify-center space-y-3 z-20">
        <div class="w-10 h-10 border-4 border-emerald-500/30 border-t-emerald-500 dark:border-t-emerald-400 rounded-full animate-spin"></div>
        <div class="text-sm font-bold text-slate-900 dark:text-white" id="loader-status">Parsing bank statement locally in browser memory...</div>
        <div class="text-xs text-slate-500 dark:text-slate-400">100% private • No data leaves your machine</div>
      </div>
    </section>

    <!-- Workspace & Results Hub (Hidden Until Ingestion) -->
    <div id="results-container" class="hidden space-y-10">

      <!-- NEW: Executive Financial Health Score & Diagnosis Hub -->
      <section class="bg-gradient-to-r from-white via-slate-50 to-emerald-50/30 dark:from-slate-900 dark:via-slate-900 dark:to-slate-950 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          
          <!-- Score Dial & Tier Badge -->
          <div class="flex items-center gap-5">
            <div class="relative w-24 h-24 flex items-center justify-center flex-shrink-0">
              <svg class="w-full h-full transform -rotate-90" viewBox="0 0 36 36">
                <path
                  class="text-slate-200 dark:text-slate-800"
                  stroke-width="3.5"
                  stroke="currentColor"
                  fill="none"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                />
                <path
                  id="health-score-circle"
                  class="text-emerald-500 dark:text-emerald-400 transition-all duration-1000 ease-out"
                  stroke-dasharray="88, 100"
                  stroke-width="3.5"
                  stroke-linecap="round"
                  stroke="currentColor"
                  fill="none"
                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
                />
              </svg>
              <div class="absolute flex flex-col items-center justify-center">
                <span class="text-2xl font-black text-slate-900 dark:text-white" id="health-score-num">88</span>
                <span class="text-[9px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">/ 100</span>
              </div>
            </div>

            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Statement Health Score</span>
                <span class="px-2 py-0.5 rounded text-[10px] font-black bg-emerald-500/15 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30" id="health-grade-badge">GRADE A+</span>
              </div>
              <h3 class="text-lg sm:text-xl font-black text-slate-900 dark:text-white" id="health-status-title">Elite Wealth Accumulator</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 max-w-sm" id="health-status-desc">
                High savings velocity and disciplined spending ratios relative to Federal Reserve benchmark microdata.
              </p>
            </div>
          </div>

          <!-- Diagnostic Metrics Sub-Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 w-full md:w-auto">
            <div class="bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 p-3 rounded-2xl text-center shadow-sm">
              <div class="text-[10px] font-bold text-slate-500 uppercase">Savings Index</div>
              <div class="text-sm font-black text-emerald-600 dark:text-emerald-400 mt-1" id="score-savings-rate">38/40 pts</div>
            </div>
            <div class="bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 p-3 rounded-2xl text-center shadow-sm">
              <div class="text-[10px] font-bold text-slate-500 uppercase">Needs Ratio</div>
              <div class="text-sm font-black text-blue-600 dark:text-blue-400 mt-1" id="score-needs-ratio">28/30 pts</div>
            </div>
            <div class="bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 p-3 rounded-2xl text-center shadow-sm">
              <div class="text-[10px] font-bold text-slate-500 uppercase">Wants Discipline</div>
              <div class="text-sm font-black text-amber-600 dark:text-amber-400 mt-1" id="score-wants-ratio">18/20 pts</div>
            </div>
            <div class="bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 p-3 rounded-2xl text-center shadow-sm">
              <div class="text-[10px] font-bold text-slate-500 uppercase">Vampire Leaks</div>
              <div class="text-sm font-black text-rose-600 dark:text-rose-400 mt-1" id="score-subs-ratio">4/10 pts</div>
            </div>
          </div>

        </div>
      </section>

      <!-- Executive KPI Cards -->
      <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-md relative overflow-hidden">
          <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Outflows (Spend)</div>
          <div class="text-2xl sm:text-3xl font-black text-rose-600 dark:text-rose-400 mt-2" id="kpi-outflow">$0.00</div>
          <div class="text-[11px] text-slate-500 mt-1" id="kpi-tx-count">0 debits categorized</div>
          <div class="absolute top-3 right-3 text-rose-500/20 text-2xl font-black">💸</div>
        </div>

        <div class="bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-md relative overflow-hidden">
          <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Inflows (Deposits)</div>
          <div class="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400 mt-2" id="kpi-inflow">$0.00</div>
          <div class="text-[11px] text-slate-500 mt-1">Salary &amp; incoming transfers</div>
          <div class="absolute top-3 right-3 text-emerald-500/20 text-2xl font-black">💰</div>
        </div>

        <div class="bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-md relative overflow-hidden">
          <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Net Cash Flow (Surplus)</div>
          <div class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white mt-2" id="kpi-netflow">$0.00</div>
          <div class="text-[11px] text-emerald-600 dark:text-emerald-400 mt-1 font-semibold" id="kpi-net-status">Positive Monthly Savings</div>
          <div class="absolute top-3 right-3 text-cyan-500/20 text-2xl font-black">📈</div>
        </div>

        <div class="bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 shadow-md relative overflow-hidden">
          <div class="text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Savings Rate</div>
          <div class="text-2xl sm:text-3xl font-black text-amber-600 dark:text-amber-400 mt-2" id="kpi-savings-rate">0%</div>
          <div class="text-[11px] text-slate-500 mt-1">Retained toward Net Worth</div>
          <div class="absolute top-3 right-3 text-amber-500/20 text-2xl font-black">🎯</div>
        </div>
      </section>

      <!-- 50/30/20 Cash Flow Gauge Bar -->
      <section class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 shadow-xl space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <h2 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>⚖️ Actual 50/30/20 Budget Breakdown</span>
            </h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Classified automatically based on merchant descriptions</p>
          </div>
          <div class="flex items-center gap-4 text-xs text-slate-700 dark:text-slate-300">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-blue-500 inline-block"></span> Needs (50%)</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-500 inline-block"></span> Wants (30%)</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-500 inline-block"></span> Wealth (20%)</span>
          </div>
        </div>

        <!-- Progress Bar Track -->
        <div class="h-6 w-full rounded-xl bg-slate-100 dark:bg-slate-950 overflow-hidden flex border border-slate-200 dark:border-slate-800 text-[10px] font-bold text-white leading-6 text-center shadow-inner">
          <div id="bar-needs" class="bg-blue-500 transition-all duration-700 flex items-center justify-center" style="width: 50%;">50%</div>
          <div id="bar-wants" class="bg-amber-500 transition-all duration-700 flex items-center justify-center" style="width: 30%;">30%</div>
          <div id="bar-wealth" class="bg-emerald-500 transition-all duration-700 flex items-center justify-center" style="width: 20%;">20%</div>
        </div>

        <!-- Metric Analysis Text -->
        <div class="text-xs text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-950/60 p-3.5 rounded-xl border border-slate-200 dark:border-slate-800/80 flex items-start gap-2.5">
          <span class="text-base">💡</span>
          <p id="budget-verdict">Analyzing your cash flow distribution...</p>
        </div>
      </section>

      <!-- Visual Charts Grid (Category Donut, Daily Timeline & Merchant Pareto) -->
      <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Chart 1: Category Outflow -->
        <div class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 shadow-md dark:shadow-xl space-y-4">
          <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>📊 Outflow By Category</span>
          </h2>
          <div class="h-64 relative flex items-center justify-center">
            <canvas id="categoryChart"></canvas>
          </div>
        </div>

        <!-- Chart 2: Daily Outflow Velocity -->
        <div class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 shadow-md dark:shadow-xl space-y-4">
          <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
            <span>📈 Daily Outflow Velocity</span>
          </h2>
          <div class="h-64 relative flex items-center justify-center">
            <canvas id="dailyChart"></canvas>
          </div>
        </div>

        <!-- NEW: Merchant Pareto Concentration -->
        <div class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 shadow-md dark:shadow-xl space-y-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <span>🏢 Top 5 Outflow Merchants</span>
              </h2>
              <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono uppercase">Pareto 80/20</span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">Concentration of where your cash flows:</p>
            <div id="merchant-pareto-list" class="space-y-2 mt-3"></div>
          </div>
          <div class="text-[11px] text-slate-600 dark:text-slate-400 bg-slate-50 dark:bg-slate-950/60 p-2.5 rounded-xl border border-slate-200 dark:border-slate-800/80" id="merchant-concentration-note">
            Calculating merchant concentration...
          </div>
        </div>
      </section>

      <!-- Vampire Subscriptions & Top Outlier Section -->
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Subscriptions Card -->
        <div class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 shadow-md dark:shadow-xl space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🧛 Detected Recurring Subscriptions</span>
            </h2>
            <span class="text-xs px-2.5 py-1 rounded-full bg-rose-100 text-rose-700 dark:bg-rose-500/20 dark:text-rose-300 font-bold" id="badge-sub-cost">$0/mo</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400">Fixed digital &amp; recurring charges automatically isolated from this statement:</p>
          <div id="subs-list" class="space-y-2 max-h-48 overflow-y-auto pr-1"></div>
          <div class="text-[11px] text-emerald-800 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/40 p-2.5 rounded-xl font-medium" id="subs-compound-calc">
            💡 Canceling these saves +$0/yr (+ $0 invested over 10 years at 8%).
          </div>
        </div>

        <!-- Top Outliers Card -->
        <div class="bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 shadow-md dark:shadow-xl space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <span>🚀 Top 5 Largest Outflows</span>
            </h2>
            <span class="text-xs text-slate-500 dark:text-slate-400">Discretionary peaks</span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-400">Single biggest transactions flagged for discretionary review:</p>
          <div id="outliers-list" class="space-y-2 max-h-48 overflow-y-auto pr-1"></div>
          <div class="text-[11px] text-slate-600 dark:text-slate-400 bg-slate-50 dark:bg-slate-950/60 p-2.5 rounded-xl border border-slate-200 dark:border-slate-800/80">
            💡 The largest 5 transactions often represent over 60% of total non-housing expenses.
          </div>
        </div>
      </section>

      <!-- Action Export Hub -->
      <section class="no-print bg-gradient-to-r from-emerald-50 via-slate-50 to-white dark:from-emerald-950/40 dark:via-slate-900 dark:to-slate-950 border border-emerald-500/30 rounded-3xl p-6 sm:p-8 shadow-xl dark:shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-1 text-center md:text-left">
          <h2 class="text-xl font-black text-slate-900 dark:text-white">Export &amp; Extract Full Expense Data</h2>
          <p class="text-xs text-slate-600 dark:text-slate-300">
            Extract into your Master Wealth Vault, download clean CSV, print executive PDF audit, or export JSON.
          </p>
        </div>
