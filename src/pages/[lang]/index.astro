	<script is:inline define:vars={{ fedData }}>
		function calculatePercentile(age, nw) {
			let bracket = "under35";
			if (age >= 35 && age <= 44) bracket = "35_44";
			else if (age >= 45 && age <= 54) bracket = "45_54";
			else if (age >= 55 && age <= 64) bracket = "55_64";
			else if (age >= 65 && age <= 74) bracket = "65_74";
			else if (age >= 75) bracket = "75plus";

			const data = fedData.age_brackets[bracket];
			if (!data) return 50;

			const percentiles = [10, 20, 25, 30, 40, 50, 60, 70, 75, 80, 85, 90, 95, 99];
			const values = [
				data.p10, data.p20, data.p25, data.p30, data.p40, data.p50,
				data.p60, data.p70, data.p75, data.p80, data.p85, data.p90,
				data.p95, data.p99
			];

			if (nw <= values[0]) return 10;
			if (nw >= values[values.length - 1]) return 99;

			for (let i = 0; i < values.length - 1; i++) {
				if (nw >= values[i] && nw <= values[i + 1]) {
					const ratio = (nw - values[i]) / (values[i + 1] - values[i]);
					return Math.round(percentiles[i] + ratio * (percentiles[i + 1] - percentiles[i]));
				}
			}
			return 50;
		}

		function updateCalculator() {
			const age = parseInt(document.getElementById('age-input').value) || 32;
			const nw = parseFloat(document.getElementById('nw-number-input').value) || 0;

			document.getElementById('age-display').innerText = age;
			
			const pct = calculatePercentile(age, nw);
			const topPct = 100 - pct;

			document.getElementById('percentile-badge').innerText = topPct <= 1 ? "Top 1%" : `Top ${topPct}%`;
			document.getElementById('percentile-progress').style.width = `${pct}%`;
			document.getElementById('comparison-summary').innerText = `You have more wealth than ${pct}% of people in your age group (${age} years).`;
		}

		document.getElementById('age-input')?.addEventListener('input', updateCalculator);
		document.getElementById('nw-number-input')?.addEventListener('input', (e) => {
			document.getElementById('nw-slider-input').value = e.target.value;
			updateCalculator();
		});
		document.getElementById('nw-slider-input')?.addEventListener('input', (e) => {
			document.getElementById('nw-number-input').value = e.target.value;
			updateCalculator();
		});

		updateCalculator();
	</script>
