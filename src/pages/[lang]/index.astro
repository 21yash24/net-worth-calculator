---
import Layout from '../../layouts/Layout.astro';
import languages from '../../data/languages.json';
import fedData from '../../data/fedData.json';

export async function getStaticPaths() {
  return languages.map((lang) => ({
    params: { lang: lang.code },
    props: { lang }
  }));
}

const { lang } = Astro.props;

const localizedGuides: Record<string, {
  tableHeading: string;
  tableDesc: string;
  colAge: string;
  colMedian: string;
  colAverage: string;
  colTop10: string;
  colTop1: string;
  sec1Title: string;
  sec1P1: string;
  sec1P2: string;
  sec2Title: string;
  sec2P1: string;
  sec2P2: string;
  sec3Title: string;
  sec3P1: string;
  sec3P2: string;
  faqTitle: string;
  faqs: { q: string; a: string }[];
}> = {
  es: {
    tableHeading: "Tabla Oficial de Patrimonio Neto por Edad (2026)",
    tableDesc: "Valores actualizados basados en la Encuesta Oficial de Finanzas del Consumidor (SCF) y estadísticas de riqueza de los hogares.",
    colAge: "Grupo de Edad",
    colMedian: "Patrimonio Mediano (50%)",
    colAverage: "Patrimonio Medio (Promedio)",
    colTop10: "Top 10% (Percentil 90)",
    colTop1: "Top 1% (Percentil 99)",
    sec1Title: "1. ¿Qué es el Patrimonio Neto y Cómo se Calcula?",
    sec1P1: "El patrimonio neto es la métrica más precisa para medir tu salud financiera y progreso hacia la libertad económica. Se calcula restando todos tus pasivos (deudas) del valor total de todos tus activos financieros y materiales.",
    sec1P2: "Fórmula Fundamental: Patrimonio Neto = (Ahorros + Inversiones + Bienes Inmuebles + Cuentas de Jubilación + Negocios) - (Hipotecas + Préstamos Personales + Préstamos Estudiantiles + Deuda de Tarjetas de Crédito).",
    sec2Title: "2. Mediana vs. Promedio: ¿Cuál Deberías Mirar?",
    sec2P1: "El promedio suele estar muy inflado por los multimillonarios y personas de patrimonio ultra-alto. Por ejemplo, en el grupo de 35 a 44 años, el patrimonio promedio es superior a $500,000, pero el patrimonio mediano es de ~$135,600.",
    sec2P2: "La mediana es el verdadero punto medio exacto: el 50% de las familias tiene más y el 50% tiene menos. Para saber si estás en una buena posición financiera, debes compararte siempre con la Mediana de tu grupo de edad.",
    sec3Title: "3. Hitos de Ahorro y Riqueza Recomendados por Edad",
    sec3P1: "A los 30 años: Tener acumulado el equivalente a 1 vez tu salario anual en patrimonio neto.",
    sec3P2: "A los 40 años: 3 veces tu salario anual. A los 50 años: 6 veces tu salario anual. A los 60 años: Entre 8 y 10 veces tu salario anual para asegurar una jubilación holgada sin preocupaciones.",
    faqTitle: "Preguntas Frecuentes sobre el Patrimonio Neto por Edad",
    faqs: [
      {
        q: "¿Qué patrimonio neto te coloca en el Top 10% según tu edad?",
        a: "Para menores de 35 años, un patrimonio superior a $340,000 te sitúa en el Top 10%. Para personas de 35 a 44 años, el umbral del Top 10% supera los $850,000, y para personas de 45 a 54 años se sitúa en torno a $1,500,000."
      },
      {
        q: "¿Debo incluir el valor de mi vivienda habitual en el cálculo?",
        a: "Sí, para el patrimonio neto total se incluye el valor neto de la vivienda (valor de mercado actual menos la hipoteca pendiente). Sin embargo, para el patrimonio neto líquido (fondos para invertir o jubilarte) se excluye la vivienda principal."
      },
      {
        q: "¿Cómo influyen los vehículos y coches en el patrimonio neto?",
        a: "Los vehículos son activos depreciables que pierden entre el 15% y 20% de su valor cada año. Debes incluir su valor de reventa actual en el mercado, no el precio original de compra."
      },
      {
        q: "¿Qué es la fórmula de riqueza de Thomas Stanley (The Millionaire Next Door)?",
        a: "La fórmula de Stanley establece que tu Patrimonio Neto Esperado = (Edad × Ingreso Anual Bruto del Hogar) / 10. Si tu patrimonio real es el doble de esta cifra, eres un 'Prodigious Accumulator of Wealth' (Acumulador Prodigioso de Riqueza)."
      },
      {
        q: "¿Cuánto patrimonio necesito para alcanzar la libertad financiera (FIRE)?",
        a: "Según la regla del 4% (Estudio Trinity), necesitas acumular 25 veces tus gastos anuales para jubilarte de forma sostenible. Por ejemplo, si tus gastos anuales son de $40,000, necesitas un patrimonio neto invertido de $1,000,000."
      }
    ]
  },
  pt: {
    tableHeading: "Tabela Oficial de Patrimônio Líquido por Idade (2026)",
    tableDesc: "Estatísticas financeiras baseadas em dados oficiais de riqueza das famílias e distribuição de renda.",
    colAge: "Faixa Etária",
    colMedian: "Patrimônio Mediano (50%)",
    colAverage: "Patrimônio Médio",
    colTop10: "Top 10% (Percentil 90)",
    colTop1: "Top 1% (Percentil 99)",
    sec1Title: "1. O que é Patrimônio Líquido e Como Calcular?",
    sec1P1: "Patrimônio líquido é a soma de todos os seus bens e direitos financeiros menos todas as suas dívidas e obrigações. É a medida mais confiável de enriquecimento real ao longo da vida.",
    sec1P2: "Fórmula de Cálculo: Patrimônio Líquido = (Poupança + Investimentos em Ações/Fundos + Imóveis + Previdência Privada + Veículos) - (Financiamentos Imobiliários + Empréstimos + Dívidas de Cartão).",
    sec2Title: "2. Mediana vs. Média: Qual Métrica é Mais Realista?",
    sec2P1: "A média aritmética é distorcida para cima pela presença de bilionários. Por isso, a mediana representa com muito mais precisão o padrão de vida real das pessoas na sua faixa etária.",
    sec2P2: "Se o seu patrimônio líquido está acima da mediana da sua idade, você já está financeiramente à frente de metade da população da mesma idade.",
    sec3Title: "3. Metas de Patrimônio Líquido Recomendadas por Idade",
    sec3P1: "Aos 30 anos: Ter acumulado o equivalente a 1 vez a sua renda anual bruta.",
    sec3P2: "Aos 40 anos: 3 vezes a sua renda anual. Aos 50 anos: 6 vezes a sua renda anual. Aos 60 anos: De 8 a 10 vezes a sua renda anual para garantir uma aposentadoria tranquila.",
    faqTitle: "Perguntas Frequentes sobre Patrimônio Líquido por Idade",
    faqs: [
      {
        q: "Qual patrimônio coloca uma pessoa no Top 10% por idade?",
        a: "Para pessoas com menos de 35 anos, ter mais de R$ 1.500.000 (ou $340.000 dólares) coloca você no Top 10% mais rico. Entre 35 e 44 anos, o valor ultrapassa R$ 3.500.000."
      },
      {
        q: "Devo incluir a casa própria no cálculo do patrimônio?",
        a: "Sim, para o patrimônio total você deve incluir o valor de mercado do imóvel menos o saldo devedor do financiamento. Para cálculo de patrimônio líquido investível, a casa própria é desconsiderada."
      },
      {
        q: "Como os carros e veículos afetam o patrimônio?",
        a: "Veículos depreciam rapidamente. Considere apenas o valor atual da Tabela FIPE menos qualquer financiamento pendente."
      },
      {
        q: "O que é a Fórmula da Riqueza de Thomas Stanley?",
        a: "A fórmula de Stanley define que o Patrimônio Esperado = (Sua Idade × Sua Renda Anual Bruta) / 10. Se seu patrimônio for o dobro disso, você é um acumulador de riqueza de elite."
      },
      {
        q: "Quanto dinheiro preciso para alcançar a independência financeira?",
        a: "Pela Regra dos 4% (Estudo Trinity), você precisa acumular 25 vezes seus gastos anuais para viver de renda passiva indefinidamente."
      }
    ]
  },
  de: {
    tableHeading: "Offizielle Tabelle: Nettovermögen nach Alter (2026)",
    tableDesc: "Vergleichswerte basierend auf offiziellen Erhebungen über Vermögen und Finanzen der privaten Haushalte.",
    colAge: "Altersgruppe",
    colMedian: "Median-Vermögen (50%)",
    colAverage: "Durchschnitts-Vermögen",
    colTop10: "Top 10% (90. Perzentil)",
    colTop1: "Top 1% (99. Perzentil)",
    sec1Title: "1. Was ist das Nettovermögen und wie wird es berechnet?",
    sec1P1: "Das Nettovermögen ist der Gesamtwert aller Vermögenswerte abzüglich sämtlicher Verbindlichkeiten und Schulden. Es ist der wichtigste Indikator für finanzielle Unabhängigkeit.",
    sec1P2: "Berechnungsformel: Nettovermögen = (Bankguthaben + Aktien/ETFs + Immobilienwert + Altersvorsorge) - (Hypotheken + Kredite + Kreditkartenschulden).",
    sec2Title: "2. Median vs. Durchschnitt: Welcher Wert zählt?",
    sec2P1: "Der statistische Durchschnitt wird durch Superreiche stark nach oben verzerrt. Der Median hingegen teilt die Bevölkerung in zwei Hälften: 50% haben mehr, 50% haben weniger.",
    sec2P2: "Um Ihre finanzielle Position realistisch zu beurteilen, sollten Sie sich stets am Median Ihrer Altersgruppe orientieren.",
    sec3Title: "3. Faustformeln für den Vermögensaufbau nach Alter",
    sec3P1: "Mit 30 Jahren: Etwa 1 Bruttojahresgehalt an Nettovermögen angespart.",
    sec3P2: "Mit 40 Jahren: 3 Jahresgehälter. Mit 50 Jahren: 6 Jahresgehälter. Mit 65 Jahren: 8 bis 10 Jahresgehälter für einen sorgenfreien Ruhestand.",
    faqTitle: "Häufig gestellte Fragen zum Nettovermögen nach Alter",
    faqs: [
      {
        q: "Ab welchem Vermögen gehört man zu den Top 10%?",
        a: "Unter 35 Jahren liegt die Top-10%-Schwelle bei ca. 300.000 €. In der Altersgruppe 35–44 Jahre bei ca. 750.000 €, und zwischen 45 und 54 Jahren bei über 1,2 Millionen Euro."
      },
      {
        q: "Zählt die selbstgenutzte Immobilie zum Nettovermögen?",
        a: "Ja, der aktuelle Marktwert abzüglich der verbleibenden Restschuld zählt zum Gesamtnettovermögen."
      },
      {
        q: "Wie werden Autos im Vermögen bewertet?",
        a: "Autos verlieren jährlich an Wert. Setzen Sie stets den aktuellen Zeitwert (Händlerverkaufswert) abzüglich Autokrediten an."
      },
      {
        q: "Was ist die Vermögensformel nach Thomas Stanley?",
        a: "Erwartetes Vermögen = (Alter × Bruttojahreseinkommen) / 10. Wer doppelt so viel besitzt, gilt als überdurchschnittlicher Vermögensbildner."
      },
      {
        q: "Wie viel Vermögen benötigt man für die finanzielle Freiheit (FIRE)?",
        a: "Nach der 4%-Regel benötigt man das 25-Fache der jährlichen Lebenshaltungskosten, um dauerhaft von Erträgen leben zu können."
      }
    ]
  },
  fr: {
    tableHeading: "Tableau Officiel du Patrimoine Net par Âge (2026)",
    tableDesc: "Statistiques patrimoniales basées sur les enquêtes financières officielles des ménages.",
    colAge: "Tranche d'Âge",
    colMedian: "Patrimoine Médian (50%)",
    colAverage: "Patrimoine Moyen",
    colTop10: "Top 10% (90e Centile)",
    colTop1: "Top 1% (99e Centile)",
    sec1Title: "1. Qu'est-ce que la Valeur Nette et Comment la Calculer ?",
    sec1P1: "Le patrimoine net représente la valeur totale de ce que vous possédez moins l'ensemble de vos dettes. C'est l'indicateur universel de solvabilité et de richesse personnelle.",
    sec1P2: "Formule : Valeur Nette = (Épargne + Placements Boursiers/Assurance-Vie + Biens Immobiliers + Retraite) - (Crédits Immobiliers + Prêts Personnels + Dettes).",
    sec2Title: "2. Médiane vs Moyenne : Quelle Mesure Regarder ?",
    sec2P1: "La moyenne est tirée vers le haut par les grandes fortunes. La médiane reflète fidèlement la situation du citoyen moyen : 50 % des ménages ont plus, 50 % ont moins.",
    sec2P2: "Si votre patrimoine dépasse la médiane de votre tranche d'âge, vous vous situez dans la moitié supérieure de la population.",
    sec3Title: "3. Objectifs d'Épargne Recommandés par Âge",
    sec3P1: "À 30 ans : Avoir accumulé l'équivalent de 1 an de salaire brut.",
    sec3P2: "À 40 ans : 3 ans de salaire. À 50 ans : 6 ans de salaire. À 65 ans : 8 à 10 ans de salaire pour garantir une retraite confortable.",
    faqTitle: "Foire Aux Questions sur le Patrimoine Net",
    faqs: [
      {
        q: "Quel patrimoine faut-il pour être dans le Top 10% ?",
        a: "Avant 35 ans, un patrimoine supérieur à 300 000 € vous place dans le Top 10 %. Entre 35 et 44 ans, le seuil s'élève à environ 750 000 €."
      },
      {
        q: "Faut-il inclure sa résidence principale dans le calcul ?",
        a: "Oui, la valeur vénale nette de la résidence principale (valeur du bien moins le capital restant dû du prêt) fait partie intégrante du patrimoine net."
      },
      {
        q: "Comment comptabiliser les véhicules ?",
        a: "Les véhicules sont des actifs dépréciatifs. Utilisez la cote argus actuelle moins les encours de crédit ou LOA."
      },
      {
        q: "Quelle est la formule de richesse de Thomas Stanley ?",
        a: "Patrimoine Net Attendu = (Âge × Revenu Annuel Brut) / 10. Si votre patrimoine réel dépasse le double, vous êtes un épargnant d'élite."
      },
      {
        q: "Combien faut-il pour être financièrement indépendant (FIRE) ?",
        a: "Selon la règle des 4 %, il faut accumuler 25 fois ses dépenses annuelles pour pouvoir vivre de ses rentes."
      }
    ]
  },
  it: {
    tableHeading: "Tabella Ufficiale Patrimonio Netto per Età (2026)",
    tableDesc: "Dati patrimoniali aggiornati ricavati dalle indagini ufficiali sui bilanci delle famiglie.",
    colAge: "Fascia d'Età",
    colMedian: "Patrimonio Mediano (50%)",
    colAverage: "Patrimonio Medio",
    colTop10: "Top 10% (90° Percentile)",
    colTop1: "Top 1% (99° Percentile)",
    sec1Title: "1. Cos'è il Patrimonio Netto e Come si Calcola?",
    sec1P1: "Il patrimonio netto è la misura reale della tua ricchezza finanziaria. Si ottiene sottraendo tutti i debiti e mutui dal valore complessivo di tutti i beni e risparmi.",
    sec1P2: "Formula: Patrimonio Netto = (Conti Correnti + Titoli/Azioni + Valore Immobili + Fondi Pensione) - (Mutui + Prestiti + Debiti Carte).",
    sec2Title: "2. Mediana vs Media: Quale Valore è Più Accurato?",
    sec2P1: "La media matematica è fortemente influenzata dai grandi patrimoni. La mediana rappresenta l'esatto punto centrale della popolazione reale.",
    sec2P2: "Confrontare la propria situazione con il patrimonio mediano della propria fascia d'età fornisce il quadro più onesto ed equo.",
    sec3Title: "3. Obiettivi di Risparmio e Patrimonio per Età",
    sec3P1: "A 30 anni: Avere accumulato 1 volta il proprio reddito annuo lordo.",
    sec3P2: "A 40 anni: 3 volte il reddito annuo. A 50 anni: 6 volte il reddito annuo. A 65 anni: 8-10 volte per una pensione serena.",
    faqTitle: "Domande Frequenti sul Patrimonio Netto per Età",
    faqs: [
      {
        q: "Quale patrimonio serve per rientrare nel Top 10%?",
        a: "Sotto i 35 anni, un patrimonio superiore a 300.000 € ti inserisce nel Top 10%. Nella fascia 35–44 anni, la soglia sale a oltre 700.000 €."
      },
      {
        q: "La prima casa va inclusa nel patrimonio netto?",
        a: "Sì, il valore di mercato attuale dell'immobile meno il debito residuo del mutuo fa parte del patrimonio totale."
      },
      {
        q: "Come vanno calcolate le automobili?",
        a: "Le auto perdono valore rapidamente. Va inserito solo il valore di mercato attuale di realizzo meno eventuali finanziamenti residui."
      },
      {
        q: "Cos'è la formula della ricchezza di Thomas Stanley?",
        a: "Patrimonio Atteso = (Età × Reddito Annuo Lordo) / 10. Chi possiede il doppio di questa cifra è un accumulatore eccellente di ricchezza."
      },
      {
        q: "Quanto patrimonio serve per raggiungere l'indipendenza finanziaria (FIRE)?",
        a: "Secondo la regola del 4% (Trinity Study), occorre accumulare 25 volte le proprie spese annue per vivere di rendita."
      }
    ]
  }
};

const guide = localizedGuides[lang.code] || localizedGuides.es;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": lang.title,
  "url": `https://getnetworthcalculator.com/${lang.code}`,
  "description": lang.metaDesc,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": guide.faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
};
---

<Layout title={lang.title} description={lang.metaDesc}>
	<!-- JSON-LD Schema Scripts -->
	<script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<main class="max-w-4xl mx-auto px-6 py-10 md:py-16">
		<header class="text-center mb-12 space-y-4">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 dark:text-emerald-300 text-xs font-bold">
				<span>{lang.flag}</span>
				<span>{lang.heroTag} ({lang.name})</span>
			</div>
			
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight" set:html={lang.heroTitle}></h1>
			
			<p class="text-slate-800 dark:text-slate-300 text-base md:text-lg max-w-xl mx-auto font-normal leading-relaxed">
				{lang.heroSub}
			</p>
		</header>

		<!-- Main Interactive Calculator Panel -->
		<div class="p-6 md:p-10 rounded-3xl border border-slate-250 dark:border-slate-800/80 shadow-xl dark:shadow-2xl relative overflow-hidden backdrop-blur-xl bg-white/95 dark:bg-slate-900/40 transition-colors duration-300">
			
			<div class="space-y-8">
				<!-- Input 1: Age Slider -->
				<div class="space-y-3">
					<div class="flex justify-between items-center">
						<label id="age-label-id" for="age-input" class="text-base font-bold text-slate-800 dark:text-slate-200">
							{lang.ageLabel}
						</label>
						<span id="age-display" class="text-xl font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-950 px-4 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800">
							32
						</span>
					</div>
					<input type="range" id="age-input" min="18" max="80" value="32" class="w-full h-2 bg-slate-200 dark:bg-slate-950 rounded-lg appearance-none cursor-pointer accent-emerald-700 dark:accent-emerald-500 border border-slate-300 dark:border-slate-800" aria-label="Age">
					<div class="flex justify-between text-xs text-slate-750 dark:text-slate-400 font-bold px-1">
						<span>18</span>
						<span>30</span>
						<span>40</span>
						<span>50</span>
						<span>60</span>
						<span>70</span>
						<span>80</span>
					</div>
				</div>

				<!-- Input 2: Net Worth Input & Slider -->
				<div class="space-y-3">
					<div class="flex justify-between items-center flex-wrap gap-3">
						<label id="nw-label-id" for="nw-number-input" class="text-base font-bold text-slate-800 dark:text-slate-200">
							{lang.netWorthLabel}
						</label>
						<div class="relative">
							<input type="number" id="nw-number-input" value="120000" step="5000" class="bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-emerald-700 dark:text-emerald-400 text-lg font-bold rounded-xl px-4 py-2.5 w-48 focus:ring-1 focus:ring-emerald-500 outline-none" aria-label="Net Worth">
						</div>
					</div>
					<input type="range" id="nw-slider-input" min="-20000" max="2000000" step="5000" value="120000" class="w-full h-2 bg-slate-200 dark:bg-slate-950 rounded-lg appearance-none cursor-pointer accent-emerald-700 dark:accent-emerald-500 border border-slate-300 dark:border-slate-800" aria-label="Net Worth Slider">
					<div class="flex justify-between text-xs text-slate-750 dark:text-slate-400 font-bold px-1">
						<span>-20k</span>
						<span>100k</span>
						<span>500k</span>
						<span>1M</span>
						<span>2M+</span>
					</div>
				</div>
			</div>

			<!-- Dynamic Percentile Results Display -->
			<div class="mt-10 pt-8 border-t border-slate-200 dark:border-slate-800/80 space-y-6">
				<div class="text-center space-y-2">
					<span class="text-xs font-bold uppercase tracking-wider text-slate-755 dark:text-slate-400">Percentile Result</span>
					<div id="percentile-badge" class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
						Top 28%
					</div>
					<p id="comparison-summary" class="text-slate-800 dark:text-slate-300 text-base max-w-lg mx-auto font-normal">
						Comparison calculated against official household wealth surveys.
					</p>
				</div>

				<!-- Progress Bar -->
				<div class="space-y-2 max-w-lg mx-auto">
					<div class="h-4 bg-slate-200 dark:bg-slate-950 rounded-full overflow-hidden p-0.5 border border-slate-300 dark:border-slate-800">
						<div id="percentile-progress" class="h-full bg-gradient-to-r from-emerald-600 to-teal-400 rounded-full transition-all duration-500" style="width: 72%;"></div>
					</div>
				</div>
			</div>
		</div>

		<!-- Deep Financial Data Table Section (High Word Count & EEAT Depth) -->
		<div class="mt-16 space-y-12">
			
			<!-- Table Container -->
			<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 md:p-8 space-y-4 shadow-sm">
				<h2 class="text-2xl font-bold text-slate-900 dark:text-white">{guide.tableHeading}</h2>
				<p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{guide.tableDesc}</p>
				
				<div class="overflow-x-auto pt-2">
					<table class="w-full text-left text-sm border-collapse">
						<thead>
							<tr class="border-b border-slate-200 dark:border-slate-800 text-xs font-bold uppercase text-slate-500 dark:text-slate-400">
								<th class="py-3 px-4">{guide.colAge}</th>
								<th class="py-3 px-4 text-emerald-600 dark:text-emerald-400">{guide.colMedian}</th>
								<th class="py-3 px-4">{guide.colAverage}</th>
								<th class="py-3 px-4">{guide.colTop10}</th>
								<th class="py-3 px-4">{guide.colTop1}</th>
							</tr>
						</thead>
