---
import Layout from '../layouts/Layout.astro';

const title = "About & Data Methodology | Get Net Worth Calculator";
const description = "Learn about the data methodology, official government sources, E-E-A-T editorial standards, and privacy guarantees behind GetNetWorthCalculator.com.";
---

<Layout title={title} description={description}>
	<main class="max-w-4xl mx-auto px-6 py-12 md:py-20">
		<header class="text-center mb-12 space-y-3">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
				<span>🛡️ 📊</span>
				<span>Transparency &amp; Data Rigor</span>
			</div>
			<h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
				About &amp; Data Methodology
			</h1>
			<p class="text-slate-700 dark:text-slate-400 text-base md:text-lg max-w-xl mx-auto font-normal">
				Official government data sources, mathematical precision, and privacy guarantees.
			</p>
		</header>

		<div class="p-8 md:p-12 rounded-3xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/60 shadow-xl backdrop-blur-xl text-slate-800 dark:text-slate-300 space-y-8 font-normal leading-relaxed">
			
			<!-- Entity & Publishing Transparency (E-E-A-T) -->
			<section class="space-y-3">
				<h2 class="text-2xl font-bold text-slate-900 dark:text-white">Editorial Team &amp; Publishing Entity</h2>
				<p>
					<strong>GetNetWorthCalculator.com</strong> is an independent financial data publishing platform maintained by the <em>GetNetWorth Analytics Team</em>. Our mission is to democratize institutional wealth benchmarking, empowering individuals in the US, Canada, UK, Australia, India, and New Zealand to evaluate their financial progress against verified central bank datasets without paywalls, email collection, or privacy trade-offs.
				</p>
			</section>

			<section class="space-y-3">
				<h2 class="text-2xl font-bold text-slate-900 dark:text-white">Official Government Datasets Used</h2>
				<p>
					Unlike personal finance blogs that rely on unverified estimates, all calculations across our 27 static tools are benchmarked against official triennial and annual government surveys:
				</p>
				<ul class="list-disc pl-5 space-y-2 text-sm">
					<li><strong>United States:</strong> Board of Governors of the Federal Reserve System — <em>Survey of Consumer Finances (SCF 2022 dataset)</em>.</li>
					<li><strong>United Kingdom:</strong> Office for National Statistics (ONS) — <em>Wealth and Assets Survey (WAS Round 7)</em>.</li>
					<li><strong>Canada:</strong> Statistics Canada (StatsCan) — <em>Survey of Financial Security (SFS)</em>.</li>
					<li><strong>Australia:</strong> Australian Bureau of Statistics (ABS) &amp; Reserve Bank of Australia (RBA) — <em>Household Finances &amp; Superannuation Reports</em>.</li>
					<li><strong>New Zealand:</strong> Statistics New Zealand (Stats NZ) — <em>Household Economic Survey (HES)</em>.</li>
					<li><strong>India:</strong> Reserve Bank of India (RBI) &amp; Ministry of Finance — <em>All India Debt &amp; Investment Survey (AIDIS)</em>.</li>
				</ul>
			</section>

			<section class="space-y-3">
				<h2 class="text-2xl font-bold text-slate-900 dark:text-white">Median vs. Average Net Worth</h2>
				<p>
					Many financial news outlets report "Average Net Worth", which is heavily distorted upward by ultra-high-net-worth billionaires (top 0.1%). We emphasize <strong>Median Net Worth (50th Percentile)</strong> and granular percentile bands (10th, 25th, 50th, 75th, 90th, 95th, 99th) to give you an accurate, real-world comparison for your specific age group.
				</p>
			</section>

			<section class="space-y-3">
				<h2 class="text-2xl font-bold text-slate-900 dark:text-white">100% Client-Side Privacy Guarantee</h2>
				<p>
					We do not store your financial data, collect email addresses, or transmit your net worth numbers to external servers. All math occurs 100% inside your Web browser memory.
				</p>
			</section>

			<section class="space-y-2 border-t border-slate-200 dark:border-slate-800 pt-6 text-xs text-slate-500 dark:text-slate-400">
				<h3 class="font-bold text-slate-700 dark:text-slate-300">Disclaimer &amp; Non-Affiliation Notice</h3>
				<p>
					GetNetWorthCalculator.com is an independent financial education tool. We are not affiliated with, endorsed by, sponsored by, or connected to the Board of Governors of the Federal Reserve System, the UK Office for National Statistics (ONS), Statistics Canada, Stats NZ, or any other government agency. All public datasets are used for educational and benchmarking purposes only under open government data licenses.
				</p>
			</section>
		</div>
	</main>
</Layout>
