---
import Layout from '../layouts/Layout.astro';

const title = "San Francisco Net Worth Benchmark (2026 Bay Area Data)";
const description = "Compare your net worth to San Francisco and Bay Area benchmarks. Schwab Modern Wealth Survey and Census data for Silicon Valley and SF.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the average net worth in San Francisco?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "According to the Schwab Modern Wealth Survey, the average net worth required to be considered 'financially comfortable' in San Francisco is $1.7 million, while being considered 'wealthy' requires a net worth of $4.7 million."
      }
    },
    {
      "@type": "Question",
      "name": "What net worth is considered top 10% in San Francisco?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In the San Francisco-Oakland-Hayward metro area, a household net worth of approximately $3.2 million puts you in the top 10%, compared to $1.95 million nationally."
      }
    },
    {
      "@type": "Question",
      "name": "Why is net worth benchmark so high in San Francisco and Silicon Valley?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "San Francisco's high net worth benchmarks are driven by high median housing costs (median home value >$1.3M), tech equity compensation (RSUs and stock options), and elevated living expenses."
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="max-w-4xl mx-auto px-6 py-10 md:py-16">
    
    <!-- Hero Header -->
    <header class="text-center mb-12 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
        <span>🌉</span>
        <span>Bay Area & HCOL Wealth Benchmarks (2026)</span>
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        San Francisco Net Worth <span class="text-emerald-600 dark:text-emerald-400">Benchmark</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
        Living in a High Cost of Living (HCOL) area changes everything. See how your net worth compares in San Francisco, Silicon Valley, and the Bay Area.
      </p>
    </header>

    <!-- Quick Answer Box (Snippet Bait) -->
    <div class="bg-gradient-to-r from-emerald-950/20 to-slate-900/40 border-2 border-emerald-500/40 rounded-2xl p-6 md:p-8 mb-12 shadow-lg">
      <div class="text-xs font-extrabold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-2">⚡ Quick Benchmark Answer (San Francisco & Bay Area)</div>
      <h2 class="text-xl md:text-2xl font-bold text-slate-900 dark:text-white mb-3">What is a Good Net Worth in San Francisco?</h2>
      <p class="text-sm md:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
        • <strong>Financially Comfortable:</strong> $1.7 Million – $2.2 Million<br />
        • <strong>Considered Wealthy:</strong> $4.7 Million – $5.2 Million<br />
        • <strong>Top 10% in SF Metro:</strong> $3.2 Million+<br />
        • <strong>Top 1% in SF Metro:</strong> $12.5 Million+<br />
        <em>(Data Source: Schwab Modern Wealth Survey & US Census Bureau SF-Oakland Metro Area Data)</em>
      </p>
    </div>

    <!-- San Francisco Net Worth by Age Table -->
    <section class="space-y-6 mb-14">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white">San Francisco Net Worth Percentiles by Age (2026)</h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">
        Due to tech equity compensation (RSUs/Options) and high real estate appreciation, Bay Area net worth benchmarks are roughly <strong>2.5x to 3x higher</strong> than national US averages:
      </p>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 shadow-md">
        <table class="w-full text-sm text-left">
          <thead class="bg-emerald-700 dark:bg-emerald-800 text-white font-bold text-xs uppercase">
            <tr>
              <th class="px-5 py-4">Age Group</th>
              <th class="px-5 py-4">SF Median Net Worth</th>
              <th class="px-5 py-4">SF Top 25%</th>
              <th class="px-5 py-4 text-emerald-200">SF Top 10%</th>
              <th class="px-5 py-4 text-amber-200">SF Top 1%</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-slate-900/60 divide-y divide-slate-200 dark:divide-slate-800 text-slate-800 dark:text-slate-200">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-5 py-4 font-bold">Under 35</td>
              <td class="px-5 py-4">$185,000</td>
              <td class="px-5 py-4">$450,000</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">$1,100,000</td>
              <td class="px-5 py-4 font-bold text-amber-500">$3,800,000</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 bg-slate-50/50 dark:bg-slate-900/20">
              <td class="px-5 py-4 font-bold">Ages 35–44</td>
              <td class="px-5 py-4">$520,000</td>
              <td class="px-5 py-4">$1,450,000</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">$3,200,000</td>
              <td class="px-5 py-4 font-bold text-amber-500">$9,500,000</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-5 py-4 font-bold">Ages 45–54</td>
              <td class="px-5 py-4">$1,150,000</td>
              <td class="px-5 py-4">$2,800,000</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">$5,800,000</td>
              <td class="px-5 py-4 font-bold text-amber-500">$16,200,000</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 bg-slate-50/50 dark:bg-slate-900/20">
              <td class="px-5 py-4 font-bold">Ages 55–64</td>
              <td class="px-5 py-4">$1,680,000</td>
              <td class="px-5 py-4">$3,900,000</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">$8,100,000</td>
              <td class="px-5 py-4 font-bold text-amber-500">$22,500,000</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-5 py-4 font-bold">Ages 65+</td>
              <td class="px-5 py-4">$1,950,000</td>
              <td class="px-5 py-4">$4,500,000</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">$9,800,000</td>
              <td class="px-5 py-4 font-bold text-amber-500">$25,000,000</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Why San Francisco Benchmarks Are Unique -->
    <section class="space-y-6 mb-14">
      <h2 class="text-2xl md:text-3xl font-bold text-slate-900 dark:text-white">3 Factors Distorting Bay Area Wealth Benchmarks</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-2">
          <div class="text-2xl">🏡</div>
          <h3 class="font-bold text-slate-900 dark:text-white text-base">1. Real Estate Concentration</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            With median home prices in San Francisco surpassing $1.3 million, a significant portion of Bay Area household net worth is tied up in primary residence home equity.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-2">
          <div class="text-2xl">📈</div>
          <h3 class="font-bold text-slate-900 dark:text-white text-base">2. Tech Stock RSUs & Equity</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Restricted Stock Units (RSUs) from big tech companies (Google, Apple, Meta, Nvidia) cause sudden wealth leaps during market rallies that don't occur in non-tech regions.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-2">
          <div class="text-2xl">💸</div>
          <h3 class="font-bold text-slate-900 dark:text-white text-base">3. High Living Costs & Taxes</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            California's 13.3% top marginal state income tax rate and high childcare costs mean higher liquid savings are required for financial independence.
          </p>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="p-8 rounded-3xl bg-emerald-700 text-white text-center space-y-4 shadow-xl">
      <h2 class="text-2xl md:text-3xl font-extrabold">Calculate Your Exact National & Age Percentile</h2>
      <p class="text-sm md:text-base text-emerald-100 max-w-xl mx-auto">
        Test your net worth against official US Federal Reserve data with our free 100% private interactive calculator.
      </p>
      <a href="/" class="inline-block px-6 py-3 bg-white text-emerald-800 font-extrabold text-sm rounded-xl hover:bg-emerald-50 transition-all shadow-md">
        Launch Net Worth Calculator →
      </a>
    </section>

    <!-- FAQs Section -->
    <section class="mt-16 space-y-6">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <details class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer group">
          <summary class="font-bold text-slate-900 dark:text-white list-none flex justify-between items-center">
            <span>What is the average net worth in San Francisco?</span>
            <span class="group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            According to the Schwab Modern Wealth Survey, San Francisco residents report needing $1.7 million to feel financially comfortable and $4.7 million to be considered wealthy.
          </p>
        </details>

        <details class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer group">
          <summary class="font-bold text-slate-900 dark:text-white list-none flex justify-between items-center">
            <span>What net worth makes you top 10% in San Francisco?</span>
            <span class="group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            In the SF Bay Area metro region, a household net worth of approximately $3.2 million puts you in the top 10%, compared to $1.95 million nationally.
          </p>
        </details>
      </div>
    </section>

  </main>
</Layout>
