---
import Layout from '../../layouts/Layout.astro';
import states from '../../data/statesData.json';

export async function getStaticPaths() {
  return states.map((s) => ({
    params: { state: s.id },
    props: { stateData: s },
  }));
}

const { stateData } = Astro.props;

const title = `Net Worth in ${stateData.name} (2026): Median & Top 10% Wealth Benchmarks`;
const description = `What is a good net worth in ${stateData.name}? Median household wealth is $${stateData.median.toLocaleString()} (Top 10%: $${(stateData.median * 8).toLocaleString()}). Compare your percentiles.`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://getnetworthcalculator.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Net Worth by State",
      "item": "https://getnetworthcalculator.com/net-worth-by-state/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": stateData.name,
      "item": `https://getnetworthcalculator.com/state/${stateData.id}`
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the average net worth in ${stateData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The median household net worth in ${stateData.name} is approximately $${stateData.median.toLocaleString()}, compared to the national US median of $192,700.`
      }
    },
    {
      "@type": "Question",
      "name": `What net worth is top 10% in ${stateData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `In ${stateData.name}, a household net worth of approximately $${(stateData.median * 7.5).toLocaleString()} puts you in the top 10% percentile.`
      }
    },
    {
      "@type": "Question",
      "name": `How does median home price affect net worth in ${stateData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `With median home prices in ${stateData.name} at $${stateData.home.toLocaleString()}, primary residence home equity represents over 45% of total wealth for homeowners in this state.`
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="max-w-4xl mx-auto px-6 py-10 md:py-16">
    
    <!-- Hero Header -->
    <header class="text-center mb-10 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
        <span>📍</span>
        <span>{stateData.name} Household Wealth Benchmarks (2026)</span>
      </div>

      <h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {stateData.name} Net Worth <span class="text-emerald-600 dark:text-emerald-400">Percentiles</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-base md:text-lg max-w-2xl mx-auto leading-relaxed">
        Compare your household net worth in {stateData.name} against state-specific Federal Reserve and US Census economic survey data.
      </p>
    </header>

    <!-- Data Methodology Disclaimer -->
    <div class="mb-10 p-4 rounded-2xl bg-slate-100 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
      <strong class="text-slate-900 dark:text-white font-bold block mb-1">Data Methodology</strong>
      Percentiles shown for {stateData.name} are <em>derived estimates</em> based on the US Federal Reserve Survey of Consumer Finances (SCF) national age benchmarks scaled to {stateData.name}'s reported median household net worth (${stateData.median.toLocaleString()}), median home price (${stateData.home.toLocaleString()}), and cost-of-living index. They are an approximation, not an official state statistical release. For authoritative figures, refer to the Federal Reserve SCF and US Census data.
    </div>

    <!-- Snippet Bait Quick Answer -->
    <div class="bg-gradient-to-r from-emerald-950/20 to-slate-900/40 border-2 border-emerald-500/40 rounded-2xl p-6 md:p-8 mb-10 shadow-lg">
      <div class="text-xs font-extrabold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-2">⚡ {stateData.name} Wealth Summary</div>
      <p class="text-sm md:text-base text-slate-700 dark:text-slate-300 leading-relaxed">
        • <strong>{stateData.name} Median Net Worth:</strong> ${stateData.median.toLocaleString()}<br />
        • <strong>{stateData.name} Top 25%:</strong> ${(stateData.median * 2.6).toLocaleString()}+<br />
        • <strong>{stateData.name} Top 10%:</strong> ${(stateData.median * 7.5).toLocaleString()}+<br />
        • <strong>{stateData.name} Top 1%:</strong> ${(stateData.median * 30).toLocaleString()}+<br />
        • <strong>Median Single-Family Home Price:</strong> ${stateData.home.toLocaleString()}<br />
        • <strong>Cost of Living Index:</strong> {stateData.col > 0 ? `+${stateData.col}% above US average` : `${stateData.col}% below US average`}
      </p>
    </div>

    <!-- Percentile Table for Age Groups in State -->
    <section class="space-y-6 mb-12">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{stateData.name} Net Worth Benchmarks by Age</h2>
      
      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <table class="w-full text-sm text-left">
          <thead class="bg-emerald-700 text-white font-bold text-xs uppercase">
            <tr>
              <th class="px-5 py-4">Age Group</th>
              <th class="px-5 py-4">{stateData.name} Median</th>
              <th class="px-5 py-4 text-emerald-200">Top 10%</th>
              <th class="px-5 py-4 text-amber-200">Top 1%</th>
              <th class="px-5 py-4 text-right">Age Breakdown Guide</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-slate-900/60 divide-y divide-slate-200 dark:divide-slate-800 text-slate-800 dark:text-slate-200">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-5 py-4 font-bold">Under 35</td>
              <td class="px-5 py-4">${Math.round(stateData.median * 0.28).toLocaleString()}</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">${Math.round(stateData.median * 2.4).toLocaleString()}</td>
              <td class="px-5 py-4 font-bold text-amber-500">${Math.round(stateData.median * 9.5).toLocaleString()}</td>
              <td class="px-5 py-4 text-right">
                <a href={`/net-worth-at-under-35-in-${stateData.id}`} class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">Under 35 Guide →</a>
              </td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 bg-slate-50/50 dark:bg-slate-900/20">
              <td class="px-5 py-4 font-bold">Ages 35–44</td>
              <td class="px-5 py-4">${Math.round(stateData.median * 0.85).toLocaleString()}</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">${Math.round(stateData.median * 6.2).toLocaleString()}</td>
              <td class="px-5 py-4 font-bold text-amber-500">${Math.round(stateData.median * 25).toLocaleString()}</td>
              <td class="px-5 py-4 text-right">
                <a href={`/net-worth-at-35-to-44-in-${stateData.id}`} class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">35–44 Guide →</a>
              </td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-5 py-4 font-bold">Ages 45–54</td>
              <td class="px-5 py-4">${Math.round(stateData.median * 1.55).toLocaleString()}</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">${Math.round(stateData.median * 12.2).toLocaleString()}</td>
              <td class="px-5 py-4 font-bold text-amber-500">${Math.round(stateData.median * 48).toLocaleString()}</td>
              <td class="px-5 py-4 text-right">
                <a href={`/net-worth-at-45-to-54-in-${stateData.id}`} class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">45–54 Guide →</a>
              </td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 bg-slate-50/50 dark:bg-slate-900/20">
              <td class="px-5 py-4 font-bold">Ages 55–64</td>
              <td class="px-5 py-4">${Math.round(stateData.median * 2.15).toLocaleString()}</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">${Math.round(stateData.median * 16.5).toLocaleString()}</td>
              <td class="px-5 py-4 font-bold text-amber-500">${Math.round(stateData.median * 65).toLocaleString()}</td>
              <td class="px-5 py-4 text-right">
                <a href={`/net-worth-at-55-to-64-in-${stateData.id}`} class="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline">55–64 Guide →</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Deep Educational Guide Section -->
    <section class="space-y-6 mb-12 text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Factors Shaping Wealth in {stateData.name}</h2>
      
      <p>
        Building wealth in <strong>{stateData.name}</strong> presents unique opportunities and trade-offs. With a cost of living index standing at <strong>{stateData.col > 0 ? `+${stateData.col}% above` : `${stateData.col}% below`} the US national average</strong>, residents must balance property accumulation against liquid investments.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
        <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-2">
          <h3 class="font-bold text-slate-900 dark:text-white text-base">🏡 Real Estate & Equity</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            The median single-family home price in {stateData.name} is <strong>${stateData.home.toLocaleString()}</strong>. Real estate equity forms over 50% of net worth for homeowning families in this state.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-2">
          <h3 class="font-bold text-slate-900 dark:text-white text-base">📈 Tax Strategy & Retirement Accounts</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Utilizing tax-advantaged accounts like 401(k)s, Roth IRAs, and HSAs provides maximum tax efficiency, protecting compounding capital from state tax drag.
          </p>
        </div>
      </div>
    </section>

    <!-- Cross-Link: Related State Guides -->
    <section class="space-y-4 mb-12">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">More Net Worth by State Guides</h2>
      <div class="flex flex-wrap gap-2">
        {states
          .filter((s) => s.id !== stateData.id)
          .map((s) => (
            <a
              href={`/state/${s.id}`}
              class="px-3.5 py-2 rounded-lg bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-700 dark:text-slate-300 hover:bg-emerald-500/10 hover:text-emerald-600 dark:hover:text-emerald-400 hover:border-emerald-500/30 transition-all"
            >
              {s.name}
            </a>
          ))}
      </div>
    </section>

    <div class="text-center pt-4">
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-700 text-white font-bold text-sm hover:bg-emerald-600 transition-all shadow-md">
        <span>Launch Interactive Percentile Calculator →</span>
      </a>
    </div>

  </main>
</Layout>
