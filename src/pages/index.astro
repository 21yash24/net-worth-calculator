---
import Layout from '../layouts/Layout.astro';
import fedData from '../data/fedData.json';
import careers from '../data/careerData.json';
import milestones from '../data/milestoneData.json';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Net Worth Percentile Calculator by Age (2026)",
  "url": "https://getnetworthcalculator.com",
  "description": "Calculate your exact net worth percentile by age benchmarked against official US Federal Reserve Survey of Consumer Finances (SCF) data.",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the average net worth by age in the US?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "According to the US Federal Reserve Survey of Consumer Finances (SCF), median household net worth varies significantly by age: Under 35 is ~$39,000; 35-44 is ~$135,600; 45-54 is ~$247,200; 55-64 is ~$364,500; and 65-74 is ~$409,900."
      }
    },
    {
      "@type": "Question",
      "name": "How does the household net worth calculator work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The household net worth calculator takes your total assets (savings, 401k, home equity, investments) minus liabilities (mortgages, student loans, credit cards) and maps your financial position against official Federal Reserve SCF population benchmarks."
      }
    },
    {
      "@type": "Question",
      "name": "What net worth makes you top 10% by age 30?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For Americans under age 35, a household net worth of approximately $340,000 puts you in the top 10th percentile according to Federal Reserve data."
      }
    },
    {
      "@type": "Question",
      "name": "What is a good benchmark net worth in San Francisco and HCOL cities?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In San Francisco and the Bay Area, median net worth is ~$1.7 million to $2.2 million, and a net worth of $4.7 million+ is considered wealthy due to high real estate and tech equity values."
      }
    },
    {
      "@type": "Question",
      "name": "Should I include primary residence home equity in my net worth?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Total net worth includes home equity (home value minus mortgage balance). However, liquid net worth excludes primary residence home equity to focus on cash, investments, and retirement accounts. Our calculator includes a toggle so you can test both."
      }
    }
  ]
};
---

<Layout title="Net Worth Percentile Calculator (2026) – Are You Top 10% for Your Age?" description="Calculate your exact net worth percentile in America benchmarked against official US Federal Reserve data. Generate shareable wealth cards, career comparisons & FIRE milestones.">
	
	<!-- JSON-LD Schema Scripts -->
	<script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<main class="max-w-4xl mx-auto px-6 py-10 md:py-16">
		<header class="text-center mb-12 space-y-4">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
				<span>🇺🇸</span>
				<span>Official US Federal Reserve SCF Wealth Data (2026)</span>
			</div>
			
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight">
				Net Worth Calculator <span class="text-slate-600 dark:text-slate-400 font-normal">by Age</span>
			</h1>
			<p class="text-slate-800 dark:text-slate-300 text-base md:text-lg max-w-xl mx-auto font-normal leading-relaxed">
				Discover your exact wealth percentile in America, download your private Wealth Scorecard, and benchmark your progress toward financial freedom.
			</p>
		</header>

		<!-- Quick Reference Snippet Box -->
		<div class="bg-emerald-950/20 border border-emerald-500/30 rounded-2xl p-5 md:p-6 mb-8 text-left space-y-2">
			<div class="text-[11px] font-extrabold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">⚡ Federal Reserve Net Worth Benchmarks by Age (2026)</div>
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-slate-800 dark:text-slate-200 font-semibold pt-1">
				<div>Under 35: <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">$39,000</span></div>
				<div>35–44: <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">$135,600</span></div>
				<div>45–54: <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">$247,200</span></div>
				<div>55–64: <span class="text-emerald-600 dark:text-emerald-400 font-extrabold">$364,500</span></div>
			</div>
		</div>

		<!-- Main Interactive Calculator Panel -->
		<div class="p-6 md:p-10 rounded-3xl border border-slate-250 dark:border-slate-800/80 shadow-xl dark:shadow-2xl relative overflow-hidden backdrop-blur-xl bg-white/95 dark:bg-slate-900/40 transition-colors duration-300">
			
			<div class="space-y-8">
				<!-- Top Controls Bar: Currency Selector & Options -->
				<div class="flex items-center justify-between flex-wrap gap-4 pb-4 border-b border-slate-200 dark:border-slate-800/80">
					<div class="flex items-center gap-2">
						<label for="currency-select" class="text-xs font-bold uppercase tracking-wider text-slate-750 dark:text-slate-300">Currency (USD):</label>
						<select id="currency-select" class="bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-white text-xs font-bold rounded-lg px-3 py-1.5 outline-none focus:ring-1 focus:ring-emerald-500 cursor-pointer">
							<option value="USD" data-symbol="$">USD ($) — US Fed Data</option>
						</select>
					</div>

					<!-- Option Toggle: Home Equity -->
					<div class="flex items-center gap-3">
						<label for="home-equity-toggle" class="text-xs font-bold text-slate-750 dark:text-slate-300 cursor-pointer">Include Home Equity</label>
						<label for="home-equity-toggle" class="relative inline-flex items-center cursor-pointer">
							<input type="checkbox" id="home-equity-toggle" checked class="sr-only peer" aria-label="Include Home Equity">
							<div class="w-9 h-5 bg-slate-300 dark:bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600"></div>
						</label>
					</div>
				</div>

				<!-- Input 1: Age Slider -->
				<div class="space-y-3">
					<div class="flex justify-between items-center">
						<label id="age-label-id" for="age-input" class="text-base font-bold text-slate-800 dark:text-slate-200">
							Your Age
						</label>
						<span id="age-display" class="text-xl font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-950 px-4 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800">
							32 years
						</span>
					</div>
					<input type="range" id="age-input" min="18" max="80" value="32" class="w-full h-2 bg-slate-200 dark:bg-slate-950 rounded-lg appearance-none cursor-pointer accent-emerald-700 dark:accent-emerald-500 border border-slate-300 dark:border-slate-800" aria-label="Your Age" title="Your Age">
					<div class="flex justify-between text-xs text-slate-750 dark:text-slate-400 font-bold px-1">
						<span>18</span>
						<span>30</span>
						<span>40</span>
						<span>50</span>
						<span>60</span>
						<span>70</span>
						<span>80</span>
					</div>
				</div>

				<!-- Input 2: Net Worth Input & Slider -->
				<div class="space-y-3">
					<div class="flex justify-between items-center flex-wrap gap-3">
						<label id="nw-label-id" for="nw-number-input" class="text-base font-bold text-slate-800 dark:text-slate-200">
							Total Net Worth (<span class="curr-symbol">$</span>)
						</label>
						<div class="relative">
							<span class="curr-symbol absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-750 dark:text-slate-405 font-bold">$</span>
							<input type="number" id="nw-number-input" value="120000" step="5000" class="bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-emerald-700 dark:text-emerald-400 text-lg font-bold rounded-xl pl-8 pr-4 py-2.5 w-48 focus:ring-1 focus:ring-emerald-500 outline-none" aria-label="Total Net Worth">
						</div>
					</div>
					<label for="nw-slider-input" class="sr-only">Total Net Worth</label>
					<input type="range" id="nw-slider-input" min="-20000" max="2000000" step="5000" value="120000" class="w-full h-2 bg-slate-200 dark:bg-slate-950 rounded-lg appearance-none cursor-pointer accent-emerald-700 dark:accent-emerald-500 border border-slate-300 dark:border-slate-800" aria-label="Total Net Worth" title="Total Net Worth">
					<div class="flex justify-between text-xs text-slate-750 dark:text-slate-400 font-bold px-1">
						<span>-<span class="curr-symbol">$</span>20k</span>
						<span><span class="curr-symbol">$</span>100k</span>
						<span><span class="curr-symbol">$</span>500k</span>
						<span><span class="curr-symbol">$</span>1M</span>
						<span><span class="curr-symbol">$</span>2M+</span>
					</div>
				</div>
			</div>

			<!-- Dynamic Percentile Results Display -->
			<div class="mt-10 pt-8 border-t border-slate-200 dark:border-slate-800/80 space-y-6">
				<div class="text-center space-y-2">
					<span class="text-xs font-bold uppercase tracking-wider text-slate-755 dark:text-slate-400">Wealth Percentile Benchmark</span>
					<div id="percentile-badge" class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
						Top 28% Percentile
					</div>
					<p id="comparison-summary" class="text-slate-800 dark:text-slate-300 text-base max-w-lg mx-auto font-normal">
						At age <span class="text-slate-900 dark:text-white font-semibold">32</span> with <span class="text-emerald-700 dark:text-emerald-400 font-semibold"><span class="curr-symbol">$</span>120,000</span> net worth, you have more wealth than <span class="text-emerald-750 dark:text-emerald-400 font-semibold">72%</span> of Americans in your age group.
					</p>
				</div>

				<!-- Interactive Visual Wealth Bell Curve SVG -->
				<div class="p-4 rounded-2xl bg-slate-100/70 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 space-y-2">
					<div class="flex justify-between text-xs font-bold text-slate-755 dark:text-slate-400">
						<span>US Population Wealth Distribution Curve</span>
						<span id="curve-marker-text" class="text-emerald-700 dark:text-emerald-400 font-bold">You are at 72%</span>
					</div>
					<div class="relative w-full h-24">
						<svg class="w-full h-full overflow-visible" viewBox="0 0 400 80" preserveAspectRatio="none" role="img" aria-label="Interactive Wealth Distribution Curve Chart">
							<!-- Bell Curve Path -->
							<path d="M 0,75 Q 100,75 160,55 T 200,10 T 240,55 Q 300,75 400,75" fill="none" stroke="currentColor" class="text-slate-450 dark:text-slate-800" stroke-width="3"/>
							<!-- Shaded Area Under Curve -->
							<path id="curve-fill-path" d="M 0,75 Q 100,75 160,55 T 200,10 T 240,55 Q 300,75 400,75 L 400,80 L 0,80 Z" class="fill-emerald-500/20"/>
							<!-- Active Dot Marker -->
							<circle id="curve-dot" cx="288" cy="62" r="7" class="fill-emerald-600 stroke-white dark:stroke-slate-950" stroke-width="2.5"/>
						</svg>
					</div>
				</div>

				<!-- Benchmarks Matrix Grid -->
				<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-755 dark:text-slate-400 block mb-1 font-bold">Median (50th)</span>
						<span id="bm-p50" class="text-base font-bold text-slate-900 dark:text-white">$39,000</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-755 dark:text-slate-400 block mb-1 font-bold">Top 25% (75th)</span>
						<span id="bm-p75" class="text-base font-bold text-slate-750 dark:text-slate-200">$145,000</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-755 dark:text-slate-400 block mb-1 font-bold">Top 10% (90th)</span>
						<span id="bm-p90" class="text-base font-bold text-emerald-700 dark:text-emerald-400">$340,000</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-755 dark:text-slate-400 block mb-1 font-bold">Top 1% (99th)</span>
						<span id="bm-p99" class="text-base font-bold text-amber-700 dark:text-amber-400">$1,400,000</span>
					</div>
				</div>

				<!-- Age-Based Ideal Asset Allocation Benchmark Card -->
				<div class="p-5 rounded-2xl bg-slate-100/90 dark:bg-slate-950 border border-slate-200 dark:border-slate-800/80 space-y-3">
					<div class="flex items-center justify-between">
						<span class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider">Recommended Asset Allocation for Age <span id="asset-age-label">32</span></span>
						<span class="text-xs text-slate-755 dark:text-slate-400 font-bold">Benchmark Model</span>
					</div>
					<div id="asset-breakdown-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
						<!-- Populated via JS -->
					</div>
				</div>

				<!-- Next Milestone Compound Growth Action Engine -->
				<div class="p-5 rounded-2xl bg-emerald-950/20 border border-emerald-500/30 space-y-3">
					<div class="flex items-center justify-between">
						<span class="text-xs font-extrabold text-emerald-400 uppercase tracking-wider">🎯 Roadmap to Next Wealth Tier</span>
						<span class="text-[11px] text-slate-400 font-mono">Assumes 8% Annual Compound Return</span>
					</div>
					<p id="milestone-text" class="text-sm text-slate-200 leading-relaxed">
						To reach the <strong class="text-emerald-400 font-bold">Top 10%</strong> for your age group, you need an additional <strong class="text-white">$220,000</strong>.
					</p>
					<div id="compound-projection" class="p-3 bg-slate-900/60 rounded-xl border border-slate-800 text-xs text-slate-300">
						Investing <strong class="text-emerald-400 font-bold">$650/month</strong> reaches this next benchmark in approximately <strong class="text-white font-bold">8.4 years</strong>.
					</div>
				</div>

				<!-- Viral Wealth Scorecard Sharing & Export Bar -->
				<div class="p-5 rounded-2xl bg-slate-900/70 border border-slate-800 space-y-3">
					<div class="flex items-center justify-between flex-wrap gap-2">
						<span class="text-xs font-bold uppercase tracking-wider text-slate-300">⚡ Share or Export Your Scorecard</span>
						<span class="text-[11px] text-emerald-400 font-semibold">100% Anonymous & Private</span>
					</div>

					<div class="flex flex-wrap items-center gap-2.5">
						<button id="download-card-btn" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs flex items-center gap-2 transition-all shadow-md">
							<span>📸 Save Scorecard (PNG)</span>
						</button>
						<button id="copy-reddit-btn" class="px-3.5 py-2.5 rounded-xl bg-orange-600/90 hover:bg-orange-500 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm">
							<span>🔥 Copy for Reddit (r/Fire)</span>
						</button>
						<button id="share-twitter-btn" class="px-3.5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm">
							<span>𝕏 Share</span>
						</button>
						<button id="share-wa-btn" class="px-3.5 py-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-600 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm">
							<span>💬 WhatsApp</span>
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- New Hub Section 1: Career Wealth Benchmarks -->
		<section class="mt-16 space-y-5">
			<div class="flex items-center justify-between">
				<div>
					<h2 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">💼 Career & Profession Wealth Benchmarks</h2>
					<p class="text-xs text-slate-600 dark:text-slate-400 mt-1">See how equity, bonuses, and specialization impact net worth percentiles by profession.</p>
				</div>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
				{careers.map((c) => (
					<a href={`/career/${c.slug}`} class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 hover:border-indigo-500/50 hover:shadow-lg transition-all group">
						<div class="text-xs font-bold text-indigo-400 uppercase tracking-wide mb-1">{c.profession}</div>
						<div class="text-base font-bold text-white group-hover:text-indigo-300 transition-colors">{c.title}</div>
						<div class="text-xs text-slate-400 mt-2 flex justify-between">
							<span>Avg Salary: <strong class="text-white">${c.avgSalary.toLocaleString()}</strong></span>
							<span class="text-indigo-400">View →</span>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- New Hub Section 2: Key Wealth Milestones -->
		<section class="mt-14 space-y-5">
			<div>
				<h2 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">🏆 Wealth Milestones: Are You on Track?</h2>
				<p class="text-xs text-slate-600 dark:text-slate-400 mt-1">Explore what percentage of Americans achieve $100k, $500k, $1M, and $2M by each age.</p>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
				<a href="/net-worth/100k-at-30" class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all group">
					<div class="text-xs font-bold text-emerald-400 uppercase tracking-wide mb-1">First Major Milestone</div>
					<div class="text-base font-bold text-white group-hover:text-emerald-300 transition-colors">$100k Net Worth at Age 30</div>
					<div class="text-xs text-slate-400 mt-2">68th Percentile (Top 32% Nationally) →</div>
				</a>
				<a href="/net-worth/500k-at-35" class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all group">
					<div class="text-xs font-bold text-emerald-400 uppercase tracking-wide mb-1">Coast FIRE Tier</div>
					<div class="text-base font-bold text-white group-hover:text-emerald-300 transition-colors">$500k Net Worth at Age 35</div>
					<div class="text-xs text-slate-400 mt-2">81st Percentile (Top 19% Nationally) →</div>
				</a>
				<a href="/net-worth/1-million-at-40" class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all group">
					<div class="text-xs font-bold text-amber-400 uppercase tracking-wide mb-1">Millionaire Club</div>
					<div class="text-base font-bold text-white group-hover:text-amber-300 transition-colors">$1 Million Net Worth at Age 40</div>
					<div class="text-xs text-slate-400 mt-2">84th Percentile (Top 16% Nationally) →</div>
				</a>
			</div>
		</section>

		<!-- AI Overview & Featured Snippet Callout Box -->
		<section class="mt-14 p-6 md:p-8 rounded-3xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/30 space-y-3">
			<div class="flex items-center gap-2 text-xs font-bold text-emerald-700 dark:text-emerald-400 uppercase tracking-wider">
				<span>⚡</span> <span>Quick Answer: US Net Worth Benchmarks by Age (2026)</span>
			</div>
			<h2 class="text-xl font-bold text-slate-900 dark:text-white">What is the Average Net Worth by Age in America?</h2>
			<p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
				According to the latest Federal Reserve Survey of Consumer Finances (SCF), median household net worth in the US is: <strong>Under 35 ($39,000)</strong>, <strong>35–44 ($135,600)</strong>, <strong>45–54 ($247,200)</strong>, <strong>55–64 ($364,500)</strong>, and <strong>65–74 ($409,900)</strong>. Median net worth represents the exact 50th percentile midpoint, eliminating billionaire distortion caused by mean average figures.
			</p>
		</section>

		<!-- Embed This Calculator Section (Backlink Magnet) -->
		<section class="mt-14 max-w-3xl mx-auto">
			<div class="p-6 md:p-8 rounded-3xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-950/70 space-y-4">
				<div class="flex items-center gap-3">
					<div class="w-8 h-8 rounded-lg bg-emerald-500/10 dark:bg-slate-800 border border-emerald-500/30 dark:border-slate-700 flex items-center justify-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
						</svg>
					</div>
					<div>
						<h3 class="text-base font-bold text-slate-900 dark:text-white">Embed This Calculator On Your Website / Blog</h3>
						<p class="text-xs text-slate-700 dark:text-slate-400">100% Free interactive widget for finance blogs, Substack, and forums.</p>
					</div>
				</div>
				<div class="relative">
					<code id="embed-code-block" class="block w-full p-4 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-xs text-slate-800 dark:text-slate-300 font-mono break-all select-all leading-relaxed">
						{`<iframe src="https://getnetworthcalculator.com" width="100%" height="700" frameborder="0" style="border-radius:16px;border:1px solid #10b981;" title="Net Worth Percentile Calculator by Age | Federal Reserve Data" loading="lazy"></iframe><p style="font-size:11px;color:#94a3b8;margin-top:4px;">Powered by <a href="https://getnetworthcalculator.com" target="_blank" style="color:#10b981;">GetNetWorthCalculator.com</a></p>`}
					</code>
					<button id="copy-embed-btn" onclick="navigator.clipboard.writeText(document.getElementById('embed-code-block').textContent.trim()); this.textContent='Copied!'; setTimeout(()=>this.textContent='Copy Embed Code',2000);" class="mt-3 px-4 py-2 rounded-lg bg-emerald-700 hover:bg-emerald-600 text-white font-bold text-xs transition-all">
						Copy Embed Code
					</button>
				</div>
			</div>
		</section>

		<!-- SEO-Optimized Accordion FAQ Section -->
		<section class="mt-14 max-w-3xl mx-auto">
			<h2 class="text-2xl font-bold text-center text-slate-900 dark:text-white mb-6">Frequently Asked Questions</h2>
			
			<div class="space-y-3">
				<details class="p-5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
					<summary class="text-base font-semibold text-slate-900 dark:text-white flex justify-between items-center list-none">
						<span>What is the average net worth by age in the US?</span>
						<span class="text-slate-700 dark:text-slate-400 group-open:rotate-180 transition-transform" aria-hidden="true">▼</span>
					</summary>
					<p class="text-slate-750 dark:text-slate-400 mt-3 text-sm leading-relaxed">
						According to the Federal Reserve, median net worth by age is: Under 35 (~$39,000); 35-44 (~$135,600); 45-54 (~$247,200); 55-64 (~$364,500); 65-74 (~$409,900).
					</p>
				</details>

				<details class="p-5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
					<summary class="text-base font-semibold text-slate-900 dark:text-white flex justify-between items-center list-none">
						<span>Should I include primary residence home equity in my net worth?</span>
						<span class="text-slate-700 dark:text-slate-400 group-open:rotate-180 transition-transform" aria-hidden="true">▼</span>
					</summary>
					<p class="text-slate-705 dark:text-slate-400 mt-3 text-sm leading-relaxed">
						Total net worth includes home equity (home value minus mortgage). Liquid net worth excludes primary residence home equity to focus strictly on cash and liquid investments. Our tool allows you to toggle both.
					</p>
				</details>

				<details class="p-5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
					<summary class="text-base font-semibold text-slate-900 dark:text-white flex justify-between items-center list-none">
						<span>What net worth puts you in the top 10% under age 35?</span>
						<span class="text-slate-700 dark:text-slate-400 group-open:rotate-180 transition-transform" aria-hidden="true">▼</span>
					</summary>
					<p class="text-slate-705 dark:text-slate-400 mt-3 text-sm leading-relaxed">
						For Americans under age 35, a net worth of approximately $340,000 puts you in the 90th percentile (top 10%).
					</p>
				</details>
			</div>
		</section>
	</main>
</Layout>

<script is:inline>
	const scfBrackets = {
		under_35: { p10: -5000, p25: 3200, p50: 39000, p75: 145000, p90: 340000, p95: 580000, p99: 1400000 },
		b35_44:   { p10: -12000, p25: 24000, p50: 135600, p75: 410000, p90: 980000, p95: 1850000, p99: 4500000 },
		b45_54:   { p10: -8000, p25: 48000, p50: 247200, p75: 780000, p90: 1950000, p95: 3800000, p99: 9200000 },
		b55_64:   { p10: -2000, p25: 65000, p50: 364500, p75: 1150000, p90: 2800000, p95: 5400000, p99: 14500000 },
		b65_74:   { p10: 2000, p25: 82000, p50: 409900, p75: 1380000, p90: 3400000, p95: 6800000, p99: 17800000 },
		b75_plus: { p10: 5000, p25: 75000, p50: 335600, p75: 1100000, p90: 2900000, p95: 5900000, p99: 15200000 }
	};

	let currentSymbol = '$';

	document.addEventListener('DOMContentLoaded', () => {
		const ageInput = document.getElementById('age-input');
		const ageDisplay = document.getElementById('age-display');
		const nwNumberInput = document.getElementById('nw-number-input');
		const nwSliderInput = document.getElementById('nw-slider-input');
		const homeEquityToggle = document.getElementById('home-equity-toggle');
		const currencySelect = document.getElementById('currency-select');
		
		const percentileBadge = document.getElementById('percentile-badge');
		const comparisonSummary = document.getElementById('comparison-summary');
		const curveDot = document.getElementById('curve-dot');
		const curveMarkerText = document.getElementById('curve-marker-text');
		const milestoneText = document.getElementById('milestone-text');
		const compoundProjection = document.getElementById('compound-projection');
		const assetAgeLabel = document.getElementById('asset-age-label');
		const assetBreakdownGrid = document.getElementById('asset-breakdown-grid');

		const bmP50 = document.getElementById('bm-p50');
		const bmP75 = document.getElementById('bm-p75');
		const bmP90 = document.getElementById('bm-p90');
		const bmP99 = document.getElementById('bm-p99');

		function getBracket(age) {
			if (age < 35) return scfBrackets.under_35;
			if (age <= 44) return scfBrackets.b35_44;
			if (age <= 54) return scfBrackets.b45_54;
			if (age <= 64) return scfBrackets.b55_64;
			if (age <= 74) return scfBrackets.b65_74;
			return scfBrackets.b75_plus;
		}

		function formatCurrency(val) {
			const absVal = Math.abs(val).toLocaleString();
			return (val < 0 ? '-' : '') + currentSymbol + absVal;
		}

		function calculatePercentile(nw, b) {
			if (nw < b.p10) return 5;
			if (nw < b.p25) return Math.round(10 + (nw - b.p10) / (b.p25 - b.p10) * 15);
			if (nw < b.p50) return Math.round(25 + (nw - b.p25) / (b.p50 - b.p25) * 25);
			if (nw < b.p75) return Math.round(50 + (nw - b.p50) / (b.p75 - b.p50) * 25);
			if (nw < b.p90) return Math.round(75 + (nw - b.p75) / (b.p90 - b.p75) * 15);
			if (nw < b.p95) return Math.round(90 + (nw - b.p90) / (b.p95 - b.p90) * 5);
			if (nw < b.p99) return Math.round(95 + (nw - b.p95) / (b.p99 - b.p95) * 4);
			return 99;
		}

		function updateAssetBreakdown(age) {
			if (!assetAgeLabel || !assetBreakdownGrid) return;
			assetAgeLabel.textContent = age;

			let equities = '70%', realEstate = '15%', cash = '10%', alt = '5%';
			if (age >= 50) {
				equities = '50%'; realEstate = '25%'; cash = '20%'; alt = '5%';
			} else if (age >= 40) {
				equities = '60%'; realEstate = '20%'; cash = '15%'; alt = '5%';
			}

			assetBreakdownGrid.innerHTML = `
				<div class="p-2.5 rounded-lg bg-slate-200/60 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-center">
					<span class="text-slate-655 dark:text-slate-400 block text-[10px] font-bold">Equities / Stocks</span>
					<strong class="text-slate-900 dark:text-white text-sm">${equities}</strong>
				</div>
				<div class="p-2.5 rounded-lg bg-slate-200/60 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-center">
					<span class="text-slate-655 dark:text-slate-400 block text-[10px] font-bold">Real Estate / Home</span>
					<strong class="text-slate-900 dark:text-white text-sm">${realEstate}</strong>
				</div>
				<div class="p-2.5 rounded-lg bg-slate-200/60 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-center">
					<span class="text-slate-655 dark:text-slate-400 block text-[10px] font-bold">Cash / HYSA</span>
					<strong class="text-slate-900 dark:text-white text-sm">${cash}</strong>
				</div>
				<div class="p-2.5 rounded-lg bg-slate-200/60 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-center">
					<span class="text-slate-655 dark:text-slate-400 block text-[10px] font-bold">Alternatives</span>
					<strong class="text-slate-900 dark:text-white text-sm">${alt}</strong>
				</div>
			`;
		}

		function updateCalculator() {
			const age = parseInt(ageInput.value);
			let nw = parseFloat(nwNumberInput.value) || 0;
			const includeHomeEquity = homeEquityToggle.checked;

			if (!includeHomeEquity) {
				nw = nw * 0.75;
			}

			ageDisplay.textContent = age + ' years';
			
			const b = getBracket(age);

			bmP50.textContent = formatCurrency(b.p50);
			bmP75.textContent = formatCurrency(b.p75);
			bmP90.textContent = formatCurrency(b.p90);
			bmP99.textContent = formatCurrency(b.p99);

			const p = calculatePercentile(nw, b);
			const topPercent = 100 - p;

			const dotX = Math.min(390, Math.max(10, (p / 100) * 400));
			if (curveDot) curveDot.setAttribute('cx', dotX.toString());
			if (curveMarkerText) curveMarkerText.textContent = `You are at ${p}%`;

			if (p >= 90) {
				percentileBadge.textContent = 'Top ' + (topPercent <= 1 ? '1%' : topPercent + '%') + ' Percentile';
				percentileBadge.className = 'text-4xl md:text-5xl font-extrabold text-amber-500 dark:text-amber-400 tracking-tight';
			} else if (p >= 50) {
				percentileBadge.textContent = 'Top ' + topPercent + '% Percentile';
				percentileBadge.className = 'text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight';
			} else {
				percentileBadge.textContent = p + 'th Percentile';
				percentileBadge.className = 'text-4xl md:text-5xl font-extrabold text-slate-700 dark:text-slate-300 tracking-tight';
			}

			comparisonSummary.innerHTML = `At age <span class="text-slate-900 dark:text-white font-semibold">${age}</span> with <span class="text-emerald-600 dark:text-emerald-400 font-semibold">${formatCurrency(nw)}</span> net worth, you have more wealth than <span class="text-emerald-600 dark:text-emerald-400 font-semibold">${p}%</span> of Americans in your age group.`;

			let diff = 0;
			let nextTier = "Top 10%";
			if (nw < b.p50) {
				diff = b.p50 - nw;
				nextTier = "50th Percentile (Median)";
			} else if (nw < b.p75) {
				diff = b.p75 - nw;
				nextTier = "Top 25%";
			} else if (nw < b.p90) {
				diff = b.p90 - nw;
				nextTier = "Top 10%";
			} else if (nw < b.p99) {
				diff = b.p99 - nw;
				nextTier = "Top 1%";
			}

			if (diff > 0) {
				milestoneText.innerHTML = `To reach the <strong class="text-emerald-400 font-bold">${nextTier}</strong> for your age group, you need an additional <strong class="text-white">${formatCurrency(diff)}</strong>.`;
				const monthlySaving = Math.max(250, Math.round(diff / 120));
				const yearsToGoal = (diff / (monthlySaving * 12 * 1.5)).toFixed(1);
				compoundProjection.innerHTML = `Investing <strong class="text-emerald-400 font-bold">$${monthlySaving.toLocaleString()}/month</strong> at 8% average return reaches this benchmark in approximately <strong class="text-white font-bold">${yearsToGoal} years</strong>.`;
			} else {
				milestoneText.innerHTML = `🏆 <strong class="text-amber-400 font-bold">Elite Standing!</strong> You are in the Top 1% of wealth for your age group in America.`;
				compoundProjection.innerHTML = `Your assets are in peak compounding mode, generating significant perpetual returns under the 4% safe withdrawal rule.`;
			}

			updateAssetBreakdown(age);
		}

		// Downloadable Canvas Scorecard Generator
		function generateScorecardImage() {
			const age = ageInput.value;
			const nw = formatCurrency(parseFloat(nwNumberInput.value) || 0);
			const badge = percentileBadge.textContent.trim();

			const canvas = document.createElement('canvas');
			canvas.width = 1200;
			canvas.height = 630;
			const ctx = canvas.getContext('2d');

			// Background
			const grad = ctx.createLinearGradient(0, 0, 1200, 630);
			grad.addColorStop(0, '#090d16');
			grad.addColorStop(1, '#0f172a');
			ctx.fillStyle = grad;
			ctx.fillRect(0, 0, 1200, 630);

			// Decorative Border
			ctx.strokeStyle = '#10b981';
			ctx.lineWidth = 4;
			ctx.strokeRect(30, 30, 1140, 570);

			// Watermark / Brand Header
			ctx.fillStyle = '#10b981';
			ctx.font = 'bold 28px -apple-system, BlinkMacSystemFont, sans-serif';
			ctx.fillText('🇺🇸 US FEDERAL RESERVE BENCHMARK (2026)', 60, 90);

			// Title
			ctx.fillStyle = '#ffffff';
			ctx.font = 'bold 52px -apple-system, BlinkMacSystemFont, sans-serif';
			ctx.fillText(`Net Worth Scorecard • Age ${age}`, 60, 170);

			// Big Percentile Highlight Box
			ctx.fillStyle = '#0f291e';
			ctx.fillRect(60, 220, 1080, 200);
			ctx.strokeStyle = '#10b981';
			ctx.lineWidth = 2;
			ctx.strokeRect(60, 220, 1080, 200);

			ctx.fillStyle = '#34d399';
			ctx.font = 'bold 76px -apple-system, BlinkMacSystemFont, sans-serif';
			ctx.fillText(badge, 90, 330);

			ctx.fillStyle = '#cbd5e1';
			ctx.font = '32px -apple-system, BlinkMacSystemFont, sans-serif';
			ctx.fillText(`Verified Wealth Balance: ${nw}`, 90, 390);

			// Footer branding
			ctx.fillStyle = '#64748b';
			ctx.font = 'bold 26px -apple-system, BlinkMacSystemFont, sans-serif';
			ctx.fillText('Calculated Privately at GetNetWorthCalculator.com', 60, 540);

			// Trigger Download
			const link = document.createElement('a');
			link.download = `net-worth-scorecard-age-${age}.png`;
			link.href = canvas.toDataURL('image/png');
			link.click();
		}

		document.getElementById('download-card-btn')?.addEventListener('click', generateScorecardImage);

		document.getElementById('copy-reddit-btn')?.addEventListener('click', () => {
			const age = ageInput.value;
			const nw = formatCurrency(parseFloat(nwNumberInput.value) || 0);
			const badge = percentileBadge.textContent.trim();
			const text = `**Net Worth Progress Update (Fed SCF Benchmark):**\n* **Age:** ${age}\n* **Net Worth:** ${nw}\n* **Percentile Standing:** ${badge}\n* **Source:** [GetNetWorthCalculator.com](https://getnetworthcalculator.com)`;
			navigator.clipboard.writeText(text);
			alert('Reddit Markdown copied to clipboard! Paste it into r/Fire or r/personalfinance.');
		});

		document.getElementById('share-twitter-btn')?.addEventListener('click', () => {
			const age = ageInput.value;
			const text = encodeURIComponent(`I'm in the ${percentileBadge.textContent} for net worth at age ${age} in the US (Federal Reserve Benchmark) 🚀 Check your wealth percentile:`);
			const url = encodeURIComponent('https://getnetworthcalculator.com');
			window.open(`https://twitter.com/intent/tweet?text=${text}&url=${url}`, '_blank');
		});

		document.getElementById('share-wa-btn')?.addEventListener('click', () => {
			const age = ageInput.value;
			const text = encodeURIComponent(`I just checked my net worth percentile rank at age ${age}: I'm in the ${percentileBadge.textContent}! Check yours here: https://getnetworthcalculator.com`);
			window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
		});

		ageInput.addEventListener('input', updateCalculator);
		nwNumberInput.addEventListener('input', (e) => {
			nwSliderInput.value = e.target.value;
			updateCalculator();
		});
		nwSliderInput.addEventListener('input', (e) => {
			nwNumberInput.value = e.target.value;
			updateCalculator();
		});
		homeEquityToggle.addEventListener('change', updateCalculator);

		updateCalculator();
	});
</script>
