<script is:inline>
	const scfBrackets = {
		under_35: { p10: -5000, p25: 3200, p50: 39000, p75: 145000, p90: 340000, p95: 580000, p99: 1400000 },
		b35_44:   { p10: -12000, p25: 24000, p50: 135600, p75: 410000, p90: 980000, p95: 1850000, p99: 4500000 },
		b45_54:   { p10: -8000, p25: 48000, p50: 247200, p75: 780000, p90: 1950000, p95: 3800000, p99: 9200000 },
		b55_64:   { p10: -2000, p25: 65000, p50: 364500, p75: 1150000, p90: 2800000, p95: 5400000, p99: 14500000 },
		b65_74:   { p10: 2000, p25: 82000, p50: 409900, p75: 1380000, p90: 3400000, p95: 6800000, p99: 17800000 },
		b75_plus: { p10: 5000, p25: 75000, p50: 335600, p75: 1100000, p90: 2900000, p95: 5900000, p99: 15200000 }
	};

	let currentSymbol = '$';

	document.addEventListener('DOMContentLoaded', () => {
		const ageInput = document.getElementById('age-input');
		const ageDisplay = document.getElementById('age-display');
		const nwNumberInput = document.getElementById('nw-number-input');
		const nwSliderInput = document.getElementById('nw-slider-input');
		const homeEquityToggle = document.getElementById('home-equity-toggle');
		const currencySelect = document.getElementById('currency-select');
		
		const percentileBadge = document.getElementById('percentile-badge');
		const comparisonSummary = document.getElementById('comparison-summary');
		const curveDot = document.getElementById('curve-dot');
		const curveMarkerText = document.getElementById('curve-marker-text');
		const milestoneText = document.getElementById('milestone-text');
		const compoundProjection = document.getElementById('compound-projection');
		const assetAgeLabel = document.getElementById('asset-age-label');
		const assetBreakdownGrid = document.getElementById('asset-breakdown-grid');

		const bmP50 = document.getElementById('bm-p50');
		const bmP75 = document.getElementById('bm-p75');
		const bmP90 = document.getElementById('bm-p90');
		const bmP99 = document.getElementById('bm-p99');

		function getBracket(age) {
			if (age < 35) return scfBrackets.under_35;
			if (age <= 44) return scfBrackets.b35_44;
			if (age <= 54) return scfBrackets.b45_54;
			if (age <= 64) return scfBrackets.b55_64;
			if (age <= 74) return scfBrackets.b65_74;
			return scfBrackets.b75_plus;
		}

		function formatCurrency(val) {
			const absVal = Math.abs(val).toLocaleString();
			return (val < 0 ? '-' : '') + currentSymbol + absVal;
		}

		function calculatePercentile(nw, b) {
			if (nw < b.p10) return 5;
			if (nw < b.p25) return Math.round(10 + (nw - b.p10) / (b.p25 - b.p10) * 15);
			if (nw < b.p50) return Math.round(25 + (nw - b.p25) / (b.p50 - b.p25) * 25);
			if (nw < b.p75) return Math.round(50 + (nw - b.p50) / (b.p75 - b.p50) * 25);
			if (nw < b.p90) return Math.round(75 + (nw - b.p75) / (b.p90 - b.p75) * 15);
			if (nw < b.p95) return Math.round(90 + (nw - b.p90) / (b.p95 - b.p90) * 5);
			if (nw < b.p99) return Math.round(95 + (nw - b.p95) / (b.p99 - b.p95) * 4);
			return 99;
		}

		function updateAssetBreakdown(age) {
			if (!assetAgeLabel || !assetBreakdownGrid) return;
			assetAgeLabel.textContent = age;

			let equities = '70%', realEstate = '15%', cash = '10%', alt = '5%';
			if (age >= 50) {
				equities = '50%'; realEstate = '25%'; cash = '20%'; alt = '5%';
			} else if (age >= 40) {
				equities = '60%'; realEstate = '20%'; cash = '15%'; alt = '5%';
			}

			assetBreakdownGrid.innerHTML = `
				<div class="p-2.5 rounded-lg bg-slate-200/60 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-center">
					<span class="text-slate-655 dark:text-slate-400 block text-[10px] font-bold">Equities / Stocks</span>
					<strong class="text-slate-900 dark:text-white text-sm">${equities}</strong>
				</div>
				<div class="p-2.5 rounded-lg bg-slate-200/60 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-center">
					<span class="text-slate-655 dark:text-slate-400 block text-[10px] font-bold">Real Estate / Home</span>
					<strong class="text-slate-900 dark:text-white text-sm">${realEstate}</strong>
				</div>
				<div class="p-2.5 rounded-lg bg-slate-200/60 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-center">
					<span class="text-slate-655 dark:text-slate-400 block text-[10px] font-bold">Cash / HYSA</span>
					<strong class="text-slate-900 dark:text-white text-sm">${cash}</strong>
				</div>
				<div class="p-2.5 rounded-lg bg-slate-200/60 dark:bg-slate-900 border border-slate-300 dark:border-slate-800 text-center">
					<span class="text-slate-655 dark:text-slate-400 block text-[10px] font-bold">Alternatives</span>
					<strong class="text-slate-900 dark:text-white text-sm">${alt}</strong>
				</div>
			`;
		}

		function updateCalculator() {
			const age = parseInt(ageInput.value);
			let nw = parseFloat(nwNumberInput.value) || 0;
			const includeHomeEquity = homeEquityToggle.checked;

			if (!includeHomeEquity) {
				nw = nw * 0.75;
			}

			ageDisplay.textContent = age + ' years';
			
			const b = getBracket(age);

			bmP50.textContent = formatCurrency(b.p50);
			bmP75.textContent = formatCurrency(b.p75);
			bmP90.textContent = formatCurrency(b.p90);
			bmP99.textContent = formatCurrency(b.p99);

			const p = calculatePercentile(nw, b);
			const topPercent = 100 - p;

			const dotX = Math.min(390, Math.max(10, (p / 100) * 400));
			if (curveDot) curveDot.setAttribute('cx', dotX.toString());
			if (curveMarkerText) curveMarkerText.textContent = `You are at ${p}%`;

			if (p >= 90) {
				percentileBadge.textContent = 'Top ' + (topPercent <= 1 ? '1%' : topPercent + '%') + ' Percentile';
				percentileBadge.className = 'text-4xl md:text-5xl font-extrabold text-amber-500 dark:text-amber-400 tracking-tight';
			} else if (p >= 50) {
				percentileBadge.textContent = 'Top ' + topPercent + '% Percentile';
				percentileBadge.className = 'text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight';
			} else {
				percentileBadge.textContent = p + 'th Percentile';
				percentileBadge.className = 'text-4xl md:text-5xl font-extrabold text-slate-700 dark:text-slate-300 tracking-tight';
			}

			comparisonSummary.innerHTML = `At age <span class="text-slate-900 dark:text-white font-semibold">${age}</span> with <span class="text-emerald-800 dark:text-emerald-300 font-bold">${formatCurrency(nw)}</span> net worth, you have more wealth than <span class="text-emerald-800 dark:text-emerald-300 font-bold">${p}%</span> of Americans in your age group.`;

			let diff = 0;
			let nextTier = "Top 10%";
			if (nw < b.p50) {
				diff = b.p50 - nw;
				nextTier = "50th Percentile (Median)";
			} else if (nw < b.p75) {
				diff = b.p75 - nw;
				nextTier = "Top 25%";
			} else if (nw < b.p90) {
				diff = b.p90 - nw;
				nextTier = "Top 10%";
			} else if (nw < b.p99) {
				diff = b.p99 - nw;
				nextTier = "Top 1%";
			}

			if (diff > 0) {
				milestoneText.innerHTML = `To reach the <strong class="text-emerald-800 dark:text-emerald-300 font-bold">${nextTier}</strong> for your age group, you need an additional <strong class="text-slate-900 dark:text-white font-bold">${formatCurrency(diff)}</strong>.`;
				const monthlySaving = Math.max(250, Math.round(diff / 120));
				const yearsToGoal = (diff / (monthlySaving * 12 * 1.5)).toFixed(1);
				compoundProjection.innerHTML = `Investing <strong class="text-emerald-800 dark:text-emerald-300 font-bold">$${monthlySaving.toLocaleString()}/month</strong> at 8% average return reaches this benchmark in approximately <strong class="text-slate-900 dark:text-white font-bold">${yearsToGoal} years</strong>.`;
			} else {
				milestoneText.innerHTML = `🏆 <strong class="text-amber-700 dark:text-amber-300 font-bold">Elite Standing!</strong> You are in the Top 1% of wealth for your age group in America.`;
				compoundProjection.innerHTML = `Your assets are in peak compounding mode, generating significant perpetual returns under the 4% safe withdrawal rule.`;
			}

			updateAssetBreakdown(age);
		}

		// Downloadable Canvas Scorecard Generator
		function generateScorecardImage() {
			const age = ageInput.value;
			const nw = formatCurrency(parseFloat(nwNumberInput.value) || 0);
			const badge = percentileBadge.textContent.trim();

			const canvas = document.createElement('canvas');
			canvas.width = 1200;
			canvas.height = 630;
			const ctx = canvas.getContext('2d');

			// Background
			const grad = ctx.createLinearGradient(0, 0, 1200, 630);
			grad.addColorStop(0, '#090d16');
			grad.addColorStop(1, '#0f172a');
			ctx.fillStyle = grad;
			ctx.fillRect(0, 0, 1200, 630);

			// Decorative Border
			ctx.strokeStyle = '#10b981';
			ctx.lineWidth = 4;
			ctx.strokeRect(30, 30, 1140, 570);

			// Watermark / Brand Header
			ctx.fillStyle = '#10b981';
			ctx.font = 'bold 28px -apple-system, BlinkMacSystemFont, sans-serif';
			ctx.fillText('🇺🇸 US FEDERAL RESERVE BENCHMARK (2026)', 60, 90);

			// Title
			ctx.fillStyle = '#ffffff';
			ctx.font = 'bold 52px -apple-system, BlinkMacSystemFont, sans-serif';
			ctx.fillText(`Net Worth Scorecard • Age ${age}`, 60, 170);

			// Big Percentile Highlight Box
			ctx.fillStyle = '#0f291e';
			ctx.fillRect(60, 220, 1080, 200);
			ctx.strokeStyle = '#10b981';
			ctx.lineWidth = 2;
			ctx.strokeRect(60, 220, 1080, 200);

			ctx.fillStyle = '#34d399';
			ctx.font = 'bold 76px -apple-system, BlinkMacSystemFont, sans-serif';
			ctx.fillText(badge, 90, 330);

			ctx.fillStyle = '#cbd5e1';
			ctx.font = '32px -apple-system, BlinkMacSystemFont, sans-serif';
			ctx.fillText(`Verified Wealth Balance: ${nw}`, 90, 390);

			// Footer branding
			ctx.fillStyle = '#64748b';
			ctx.font = 'bold 26px -apple-system, BlinkMacSystemFont, sans-serif';
			ctx.fillText('Calculated Privately at GetNetWorthCalculator.com', 60, 540);

			// Trigger Download
			const link = document.createElement('a');
			link.download = `net-worth-scorecard-age-${age}.png`;
			link.href = canvas.toDataURL('image/png');
			link.click();
		}

		document.getElementById('download-card-btn')?.addEventListener('click', generateScorecardImage);

		document.getElementById('copy-reddit-btn')?.addEventListener('click', () => {
			const age = ageInput.value;
			const nw = formatCurrency(parseFloat(nwNumberInput.value) || 0);
			const badge = percentileBadge.textContent.trim();
			const text = `**Net Worth Progress Update (Fed SCF Benchmark):**\n* **Age:** ${age}\n* **Net Worth:** ${nw}\n* **Percentile Standing:** ${badge}\n* **Source:** [GetNetWorthCalculator.com](https://getnetworthcalculator.com)`;
			navigator.clipboard.writeText(text);
			alert('Reddit Markdown copied to clipboard! Paste it into r/Fire or r/personalfinance.');
		});

		document.getElementById('share-twitter-btn')?.addEventListener('click', () => {
			const age = ageInput.value;
			const text = encodeURIComponent(`I'm in the ${percentileBadge.textContent} for net worth at age ${age} in the US (Federal Reserve Benchmark) 🚀 Check your wealth percentile:`);
			const url = encodeURIComponent('https://getnetworthcalculator.com');
			window.open(`https://twitter.com/intent/tweet?text=${text}&url=${url}`, '_blank');
		});

		document.getElementById('share-wa-btn')?.addEventListener('click', () => {
			const age = ageInput.value;
			const text = encodeURIComponent(`I just checked my net worth percentile rank at age ${age}: I'm in the ${percentileBadge.textContent}! Check yours here: https://getnetworthcalculator.com`);
			window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
		});

		ageInput.addEventListener('input', updateCalculator);
		nwNumberInput.addEventListener('input', (e) => {
			nwSliderInput.value = e.target.value;
			updateCalculator();
		});
		nwSliderInput.addEventListener('input', (e) => {
			nwNumberInput.value = e.target.value;
			updateCalculator();
		});
		homeEquityToggle.addEventListener('change', updateCalculator);

		updateCalculator();
	});
</script>
