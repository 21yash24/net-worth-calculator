---
import Layout from '../layouts/Layout.astro';
import fedData from '../data/fedData.json';
import careers from '../data/careerData.json';
import milestones from '../data/milestoneData.json';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Net Worth Percentile Calculator by Age (2026)",
  "url": "https://getnetworthcalculator.com",
  "description": "Calculate your exact net worth percentile by age benchmarked against official US Federal Reserve Survey of Consumer Finances (SCF) data.",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the average net worth by age in the US?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "According to the US Federal Reserve Survey of Consumer Finances (SCF), median household net worth varies significantly by age: Under 35 is ~$39,000; 35-44 is ~$135,600; 45-54 is ~$247,200; 55-64 is ~$364,500; and 65-74 is ~$409,900."
      }
    },
    {
      "@type": "Question",
      "name": "How does the household net worth calculator work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The household net worth calculator takes your total assets (savings, 401k, home equity, investments) minus liabilities (mortgages, student loans, credit cards) and maps your financial position against official Federal Reserve SCF population benchmarks."
      }
    },
    {
      "@type": "Question",
      "name": "What net worth makes you top 10% by age 30?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For Americans under age 35, a household net worth of approximately $340,000 puts you in the top 10th percentile according to Federal Reserve data."
      }
    },
    {
      "@type": "Question",
      "name": "What is a good benchmark net worth in San Francisco and HCOL cities?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In San Francisco and the Bay Area, median net worth is ~$1.7 million to $2.2 million, and a net worth of $4.7 million+ is considered wealthy due to high real estate and tech equity values."
      }
    },
    {
      "@type": "Question",
      "name": "Should I include primary residence home equity in my net worth?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Total net worth includes home equity (home value minus mortgage balance). However, liquid net worth excludes primary residence home equity to focus on cash, investments, and retirement accounts. Our calculator includes a toggle so you can test both."
      }
    }
  ]
};
---

<Layout title="Net Worth Percentile Calculator (2026) – Are You Top 10% for Your Age?" description="Calculate your exact net worth percentile in America benchmarked against official US Federal Reserve data. Generate shareable wealth cards, career comparisons & FIRE milestones.">
	
	<!-- JSON-LD Schema Scripts -->
	<script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<main class="max-w-4xl mx-auto px-6 py-10 md:py-16">
		<header class="text-center mb-12 space-y-4">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-800 dark:text-emerald-300 text-xs font-bold">
				<span>🇺🇸</span>
				<span>Official US Federal Reserve SCF Wealth Data (2026)</span>
			</div>
			
			<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight">
				Net Worth Calculator <span class="text-slate-600 dark:text-slate-400 font-normal">by Age</span>
			</h1>
			<p class="text-slate-800 dark:text-slate-300 text-base md:text-lg max-w-xl mx-auto font-normal leading-relaxed">
				Discover your exact wealth percentile in America, download your private Wealth Scorecard, and benchmark your progress toward financial freedom.
			</p>
		</header>

		<!-- Quick Reference Snippet Box -->
		<div class="bg-emerald-950/10 dark:bg-emerald-950/20 border border-emerald-500/30 rounded-2xl p-5 md:p-6 mb-8 text-left space-y-2">
			<div class="text-[11px] font-extrabold uppercase tracking-wider text-emerald-800 dark:text-emerald-300">⚡ Federal Reserve Net Worth Benchmarks by Age (2026)</div>
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-slate-900 dark:text-slate-200 font-bold pt-1">
				<div>Under 35: <span class="text-emerald-800 dark:text-emerald-300 font-extrabold">$39,000</span></div>
				<div>35–44: <span class="text-emerald-800 dark:text-emerald-300 font-extrabold">$135,600</span></div>
				<div>45–54: <span class="text-emerald-800 dark:text-emerald-300 font-extrabold">$247,200</span></div>
				<div>55–64: <span class="text-emerald-800 dark:text-emerald-300 font-extrabold">$364,500</span></div>
			</div>
		</div>

		<!-- Main Interactive Calculator Panel -->
		<div class="p-6 md:p-10 rounded-3xl border border-slate-250 dark:border-slate-800/80 shadow-xl dark:shadow-2xl relative overflow-hidden backdrop-blur-xl bg-white/95 dark:bg-slate-900/40 transition-colors duration-300">
			
			<div class="space-y-8">
				<!-- Top Controls Bar: Currency Selector & Options -->
				<div class="flex items-center justify-between flex-wrap gap-4 pb-4 border-b border-slate-200 dark:border-slate-800/80">
					<div class="flex items-center gap-2">
						<label for="currency-select" class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">Currency (USD):</label>
						<select id="currency-select" class="bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-white text-xs font-bold rounded-lg px-3 py-1.5 outline-none focus:ring-1 focus:ring-emerald-500 cursor-pointer">
							<option value="USD" data-symbol="$">USD ($) — US Fed Data</option>
						</select>
					</div>

					<!-- Option Toggle: Home Equity -->
					<div class="flex items-center gap-3">
						<label for="home-equity-toggle" class="text-xs font-bold text-slate-800 dark:text-slate-200 cursor-pointer">Include Home Equity</label>
						<span class="relative inline-flex items-center cursor-pointer">
							<input type="checkbox" id="home-equity-toggle" checked class="sr-only peer" aria-label="Include Home Equity">
							<div class="w-9 h-5 bg-slate-300 dark:bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-600"></div>
						</span>
					</div>
				</div>

				<!-- Input 1: Age Slider -->
				<div class="space-y-3">
					<div class="flex justify-between items-center">
						<label id="age-label-id" for="age-input" class="text-base font-bold text-slate-800 dark:text-slate-200">
							Your Age
						</label>
						<span id="age-display" class="text-xl font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-950 px-4 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800">
							32 years
						</span>
					</div>
					<input type="range" id="age-input" min="18" max="80" value="32" class="w-full h-2 bg-slate-200 dark:bg-slate-950 rounded-lg appearance-none cursor-pointer accent-emerald-700 dark:accent-emerald-500 border border-slate-300 dark:border-slate-800" aria-label="Your Age" title="Your Age">
					<div class="flex justify-between text-xs text-slate-750 dark:text-slate-400 font-bold px-1">
						<span>18</span>
						<span>30</span>
						<span>40</span>
						<span>50</span>
						<span>60</span>
						<span>70</span>
						<span>80</span>
					</div>
				</div>

				<!-- Input 2: Net Worth Input & Slider -->
				<div class="space-y-3">
					<div class="flex justify-between items-center flex-wrap gap-3">
						<label id="nw-label-id" for="nw-number-input" class="text-base font-bold text-slate-800 dark:text-slate-200">
							Total Net Worth (<span class="curr-symbol">$</span>)
						</label>
						<div class="relative">
							<span class="curr-symbol absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-750 dark:text-slate-405 font-bold">$</span>
							<input type="number" id="nw-number-input" value="120000" step="5000" class="bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-emerald-700 dark:text-emerald-400 text-lg font-bold rounded-xl pl-8 pr-4 py-2.5 w-48 focus:ring-1 focus:ring-emerald-500 outline-none" aria-label="Total Net Worth">
						</div>
					</div>
					<label for="nw-slider-input" class="sr-only">Total Net Worth</label>
					<input type="range" id="nw-slider-input" min="-20000" max="2000000" step="5000" value="120000" class="w-full h-2 bg-slate-200 dark:bg-slate-950 rounded-lg appearance-none cursor-pointer accent-emerald-700 dark:accent-emerald-500 border border-slate-300 dark:border-slate-800" aria-label="Total Net Worth" title="Total Net Worth">
					<div class="flex justify-between text-xs text-slate-750 dark:text-slate-400 font-bold px-1">
						<span>-<span class="curr-symbol">$</span>20k</span>
						<span><span class="curr-symbol">$</span>100k</span>
						<span><span class="curr-symbol">$</span>500k</span>
						<span><span class="curr-symbol">$</span>1M</span>
						<span><span class="curr-symbol">$</span>2M+</span>
					</div>
				</div>
			</div>

			<!-- Dynamic Percentile Results Display -->
			<div class="mt-10 pt-8 border-t border-slate-200 dark:border-slate-800/80 space-y-6">
				<div class="text-center space-y-2">
					<span class="text-xs font-bold uppercase tracking-wider text-slate-755 dark:text-slate-400">Wealth Percentile Benchmark</span>
					<div id="percentile-badge" class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
						Top 28% Percentile
					</div>
					<p id="comparison-summary" class="text-slate-800 dark:text-slate-300 text-base max-w-lg mx-auto font-normal">
						At age <span class="text-slate-900 dark:text-white font-semibold">32</span> with <span class="text-emerald-700 dark:text-emerald-400 font-semibold"><span class="curr-symbol">$</span>120,000</span> net worth, you have more wealth than <span class="text-emerald-750 dark:text-emerald-400 font-semibold">72%</span> of Americans in your age group.
					</p>
				</div>

				<!-- Interactive Visual Wealth Bell Curve SVG -->
				<div class="p-4 rounded-2xl bg-slate-100/70 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 space-y-2">
					<div class="flex justify-between text-xs font-bold text-slate-755 dark:text-slate-400">
						<span>US Population Wealth Distribution Curve</span>
						<span id="curve-marker-text" class="text-emerald-700 dark:text-emerald-400 font-bold">You are at 72%</span>
					</div>
					<div class="relative w-full h-24">
						<svg class="w-full h-full overflow-visible" viewBox="0 0 400 80" preserveAspectRatio="none" role="img" aria-label="Interactive Wealth Distribution Curve Chart">
							<!-- Bell Curve Path -->
							<path d="M 0,75 Q 100,75 160,55 T 200,10 T 240,55 Q 300,75 400,75" fill="none" stroke="currentColor" class="text-slate-450 dark:text-slate-800" stroke-width="3"/>
							<!-- Shaded Area Under Curve -->
							<path id="curve-fill-path" d="M 0,75 Q 100,75 160,55 T 200,10 T 240,55 Q 300,75 400,75 L 400,80 L 0,80 Z" class="fill-emerald-500/20"/>
							<!-- Active Dot Marker -->
							<circle id="curve-dot" cx="288" cy="62" r="7" class="fill-emerald-600 stroke-white dark:stroke-slate-950" stroke-width="2.5"/>
						</svg>
					</div>
				</div>

				<!-- Benchmarks Matrix Grid -->
				<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
					<div class="p-4 rounded-xl bg-slate-100/90 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-700 dark:text-slate-300 block mb-1 font-bold">Median (50th)</span>
						<span id="bm-p50" class="text-base font-bold text-slate-900 dark:text-white">$39,000</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/90 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-700 dark:text-slate-300 block mb-1 font-bold">Top 25% (75th)</span>
						<span id="bm-p75" class="text-base font-bold text-slate-900 dark:text-slate-200">$145,000</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/90 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-700 dark:text-slate-300 block mb-1 font-bold">Top 10% (90th)</span>
						<span id="bm-p90" class="text-base font-bold text-emerald-800 dark:text-emerald-300">$340,000</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/90 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-700 dark:text-slate-300 block mb-1 font-bold">Top 1% (99th)</span>
						<span id="bm-p99" class="text-base font-bold text-amber-800 dark:text-amber-300">$1,400,000</span>
					</div>
				</div>

				<!-- Age-Based Ideal Asset Allocation Benchmark Card -->
				<div class="p-5 rounded-2xl bg-slate-100/90 dark:bg-slate-950 border border-slate-200 dark:border-slate-800/80 space-y-3">
					<div class="flex items-center justify-between">
						<span class="text-xs font-bold text-slate-900 dark:text-white uppercase tracking-wider">Recommended Asset Allocation for Age <span id="asset-age-label">32</span></span>
						<span class="text-xs text-slate-700 dark:text-slate-300 font-bold">Benchmark Model</span>
					</div>
					<div id="asset-breakdown-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
						<!-- Populated via JS -->
					</div>
				</div>

				<!-- Next Milestone Compound Growth Action Engine -->
				<div class="p-5 rounded-2xl bg-emerald-500/10 dark:bg-emerald-950/20 border border-emerald-500/20 dark:border-emerald-500/30 space-y-3">
					<div class="flex items-center justify-between">
						<span class="text-xs font-extrabold text-emerald-800 dark:text-emerald-300 uppercase tracking-wider">🎯 Roadmap to Next Wealth Tier</span>
						<span class="text-[11px] text-slate-700 dark:text-slate-300 font-mono">Assumes 8% Annual Compound Return</span>
					</div>
					<p id="milestone-text" class="text-sm text-slate-800 dark:text-slate-200 leading-relaxed">
						To reach the <strong class="text-emerald-800 dark:text-emerald-300 font-bold">Top 10%</strong> for your age group, you need an additional <strong class="text-slate-900 dark:text-white font-bold">$220,000</strong>.
					</p>
					<div id="compound-projection" class="p-3 bg-white/90 dark:bg-slate-900/60 rounded-xl border border-emerald-500/20 dark:border-slate-800 text-xs text-slate-700 dark:text-slate-300">
						Investing <strong class="text-emerald-800 dark:text-emerald-300 font-bold">$650/month</strong> reaches this next benchmark in approximately <strong class="text-slate-900 dark:text-white font-bold">8.4 years</strong>.
					</div>
				</div>

				<!-- Viral Wealth Scorecard Sharing & Export Bar -->
				<div class="p-5 rounded-2xl bg-slate-100/90 dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 space-y-3">
					<div class="flex items-center justify-between flex-wrap gap-2">
						<span class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">⚡ Share or Export Your Scorecard</span>
						<span class="text-[11px] text-emerald-800 dark:text-emerald-300 font-bold">100% Anonymous & Private</span>
					</div>

					<div class="flex flex-wrap items-center gap-2.5">
						<button id="download-card-btn" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-700 to-teal-700 hover:from-emerald-600 hover:to-teal-600 text-white font-bold text-xs flex items-center gap-2 transition-all shadow-md">
							<span>📸 Save Scorecard (PNG)</span>
						</button>
						<button id="copy-reddit-btn" class="px-3.5 py-2.5 rounded-xl bg-orange-700 hover:bg-orange-600 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm">
							<span>🔥 Copy for Reddit (r/Fire)</span>
						</button>
						<button id="share-twitter-btn" class="px-3.5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm">
							<span>𝕏 Share</span>
						</button>
						<button id="share-wa-btn" class="px-3.5 py-2.5 rounded-xl bg-emerald-800 hover:bg-emerald-700 text-white font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm">
							<span>💬 WhatsApp</span>
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- New Hub Section 1: Career Wealth Benchmarks -->
		<section class="mt-16 space-y-5">
			<div class="flex items-center justify-between">
				<div>
					<h2 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">💼 Career & Profession Wealth Benchmarks</h2>
					<p class="text-xs text-slate-700 dark:text-slate-300 mt-1 font-medium">See how equity, bonuses, and specialization impact net worth percentiles by profession.</p>
				</div>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
				{careers.map((c) => (
					<a href={`/career/${c.slug}`} class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 hover:border-indigo-500/50 hover:shadow-lg transition-all group">
						<div class="text-xs font-bold text-indigo-700 dark:text-indigo-300 uppercase tracking-wide mb-1">{c.profession}</div>
						<div class="text-base font-bold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-300 transition-colors">{c.title}</div>
						<div class="text-xs text-slate-700 dark:text-slate-300 mt-2 flex justify-between">
							<span>Avg Salary: <strong class="text-slate-900 dark:text-white">${c.avgSalary.toLocaleString()}</strong></span>
							<span class="text-indigo-700 dark:text-indigo-300 font-bold">View →</span>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- New Hub Section 2: Key Wealth Milestones -->
		<section class="mt-14 space-y-5">
			<div>
				<h2 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">🏆 Wealth Milestones: Are You on Track?</h2>
				<p class="text-xs text-slate-700 dark:text-slate-300 mt-1 font-medium">Explore what percentage of Americans achieve $100k, $500k, $1M, and $2M by each age.</p>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
				<a href="/net-worth/100k-at-30" class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all group">
					<div class="text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase tracking-wide mb-1">First Major Milestone</div>
					<div class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-300 transition-colors">$100k Net Worth at Age 30</div>
					<div class="text-xs text-slate-700 dark:text-slate-300 mt-2 font-medium">68th Percentile (Top 32% Nationally) →</div>
				</a>
				<a href="/net-worth/500k-at-35" class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all group">
					<div class="text-xs font-bold text-emerald-800 dark:text-emerald-300 uppercase tracking-wide mb-1">Coast FIRE Tier</div>
					<div class="text-base font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-300 transition-colors">$500k Net Worth at Age 35</div>
					<div class="text-xs text-slate-700 dark:text-slate-300 mt-2 font-medium">81st Percentile (Top 19% Nationally) →</div>
				</a>
				<a href="/net-worth/1-million-at-40" class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all group">
					<div class="text-xs font-bold text-amber-800 dark:text-amber-300 uppercase tracking-wide mb-1">Millionaire Club</div>
					<div class="text-base font-bold text-slate-900 dark:text-white group-hover:text-amber-600 dark:group-hover:text-amber-300 transition-colors">$1 Million Net Worth at Age 40</div>
					<div class="text-xs text-slate-700 dark:text-slate-300 mt-2 font-medium">84th Percentile (Top 16% Nationally) →</div>
				</a>
			</div>
		</section>

		<!-- Comprehensive Editorial Guide (1500+ Words for E-E-A-T & AdSense Compliance) -->
		<article class="mt-16 space-y-12 text-slate-800 dark:text-slate-200 leading-relaxed max-w-4xl mx-auto border-t border-slate-200 dark:border-slate-800 pt-12">
			
			<!-- Section 1: Executive Overview -->
			<section class="space-y-4">
				<h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
					How US Household Net Worth is Distributed in 2026: The Comprehensive Analysis
				</h2>
				<p class="text-base text-slate-700 dark:text-slate-300">
					Understanding your financial standing requires measuring your assets and liabilities against verified empirical data rather than social media anecdotes. In the United States, the benchmark gold standard for household wealth is the <strong>Federal Reserve Board’s Survey of Consumer Finances (SCF)</strong>. Released every three years and adjusted for inflation, this survey evaluates over 6,000 statistically representative American families to construct a complete map of assets, liabilities, retirement savings, real estate equity, and consumer obligations.
				</p>
				<p class="text-base text-slate-700 dark:text-slate-300">
					Net worth is defined mathematically as <strong>Total Assets minus Total Liabilities</strong>. While simple in concept, how wealth accumulates across different decades of life reveals dramatic exponential compounding, shifts in asset allocation, and the critical distinction between liquid investable wealth and illiquid primary home equity.
				</p>
			</section>

			<!-- Section 2: Mean vs Median -->
			<section class="space-y-4 p-8 rounded-3xl bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
				<h3 class="text-2xl font-bold text-slate-900 dark:text-white">
					The Statistical Mirage: Why Average (Mean) Net Worth is Misleading
				</h3>
				<p class="text-sm text-slate-700 dark:text-slate-300">
