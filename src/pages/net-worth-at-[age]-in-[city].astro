---
import Layout from '../layouts/Layout.astro';
import cities from '../data/citiesData.json';

export async function getStaticPaths() {
  const ageBrackets = [
    { id: "under-35", label: "Under 35", ageNum: 30, mult: 0.28, stage: "Early Career & Savings Accumulation Stage" },
    { id: "35-to-44", label: "Ages 35 to 44", ageNum: 40, mult: 0.85, stage: "Home Equity & Career Advancement Stage" },
    { id: "45-to-54", label: "Ages 45 to 54", ageNum: 50, mult: 1.55, stage: "Peak Income & Investment Growth Stage" },
    { id: "55-to-64", label: "Ages 55 to 64", ageNum: 60, mult: 2.15, stage: "Pre-Retirement Wealth Consolidation Stage" },
  ];

  const paths = [];
  for (const c of cities) {
    for (const a of ageBrackets) {
      paths.push({
        params: { age: a.id, city: c.id },
        props: { cityData: c, ageData: a },
      });
    }
  }
  return paths;
}

const { cityData, ageData } = Astro.props;

const medianNW = Math.round(cityData.median * ageData.mult);
const top25NW = Math.round(cityData.median * ageData.mult * 2.8);
const top10NW = Math.round(cityData.median * ageData.mult * 8);
const top1NW = Math.round(cityData.median * ageData.mult * 32);

const stateDisp = cityData.state === 'District of Columbia' ? 'DC' : cityData.state;
const title = `Net Worth at ${ageData.label} in ${cityData.name}, ${stateDisp}: Top 10% & Median [2026]`;
const description = `What is the median net worth for ${ageData.label} in ${cityData.name}, ${stateDisp}? Explore median ($${medianNW.toLocaleString()}), top 10% ($${top10NW.toLocaleString()}), and top 1% wealth benchmarks.`;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://getnetworthcalculator.com"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": cityData.name,
      "item": `https://getnetworthcalculator.com/state/${cityData.state.toLowerCase().replace(/ /g, '-')}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": `${ageData.label} in ${cityData.name}`,
      "item": `https://getnetworthcalculator.com/net-worth-at-${ageData.id}-in-${cityData.id}`
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the average net worth for ${ageData.label} in ${cityData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The median net worth for households ${ageData.label} in ${cityData.name} is approximately $${medianNW.toLocaleString()}.`
      }
    },
    {
      "@type": "Question",
      "name": `What net worth puts you in the top 10% for ${ageData.label} in ${cityData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `In ${cityData.name}, a net worth of $${top10NW.toLocaleString()} puts a household in the top 10% for the ${ageData.label} age group.`
      }
    },
    {
      "@type": "Question",
      "name": `How does housing cost affect net worth benchmarks in ${cityData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `With median home prices in ${cityData.name} around $${cityData.home.toLocaleString()}, primary real estate home equity accounts for a major portion of total net worth.`
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="max-w-4xl mx-auto px-6 py-10 md:py-16">
    
    <!-- Hero Header -->
    <header class="text-center mb-10 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
        <span>🏙️</span>
        <span>{cityData.name}, {cityData.state} • {ageData.label} (2026)</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Net Worth <span class="text-emerald-600 dark:text-emerald-400">{ageData.label}</span> in {cityData.name}
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-base max-w-xl mx-auto leading-relaxed">
        City-level wealth benchmarks and cost-of-living adjusted economic analysis for {ageData.label} in {cityData.name}.
      </p>
    </header>

    <!-- Data Methodology Disclaimer -->
    <div class="mb-10 p-4 rounded-2xl bg-slate-100 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
      <strong class="text-slate-900 dark:text-white font-bold block mb-1">Data Methodology</strong>
      Figures on this page are <em>derived estimates</em>. {cityData.name}'s median household net worth of ${cityData.median.toLocaleString()} (median home ${cityData.home.toLocaleString()}, cost of living {cityData.col > 0 ? `+${cityData.col}%` : `${cityData.col}%`} vs the US average) is scaled to the {ageData.label} age cohort using US Federal Reserve SCF age-wealth ratios. These are approximations for comparison, not an official city statistic. Source: Federal Reserve SCF + US Census.
    </div>

    <!-- Quick Answer Box -->
    <div class="bg-slate-100 dark:bg-slate-900/80 rounded-3xl p-6 md:p-8 mb-10 shadow-lg border border-slate-200 dark:border-slate-800 space-y-5">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <span class="text-xs font-extrabold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">⚡ City Benchmark: {ageData.label} in {cityData.name}</span>
        <span class="text-[11px] text-slate-500 dark:text-slate-400 font-mono">2026 SCF Derived Benchmark</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center text-xs">
        <div class="p-4 bg-white dark:bg-slate-950/80 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <span class="block text-slate-500 dark:text-slate-400 text-[11px] uppercase font-bold mb-1">City Median (50th)</span>
          <strong class="text-slate-900 dark:text-white text-lg font-extrabold">${medianNW.toLocaleString()}</strong>
        </div>
        <div class="p-4 bg-white dark:bg-slate-950/80 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <span class="block text-slate-500 dark:text-slate-400 text-[11px] uppercase font-bold mb-1">Top 25% (75th)</span>
          <strong class="text-slate-900 dark:text-slate-200 text-lg font-extrabold">${top25NW.toLocaleString()}</strong>
        </div>
        <div class="p-4 bg-white dark:bg-slate-950/80 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <span class="block text-slate-500 dark:text-slate-400 text-[11px] uppercase font-bold mb-1">Top 10% (90th)</span>
          <strong class="text-emerald-600 dark:text-emerald-400 text-lg font-extrabold">${top10NW.toLocaleString()}</strong>
        </div>
        <div class="p-4 bg-white dark:bg-slate-950/80 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
          <span class="block text-slate-500 dark:text-slate-400 text-[11px] uppercase font-bold mb-1">Top 1% (99th)</span>
          <strong class="text-amber-600 dark:text-amber-400 text-lg font-extrabold">${top1NW.toLocaleString()}</strong>
        </div>
      </div>

      <!-- On-Page Interactive Calculator Widget -->
      <div class="p-5 bg-white dark:bg-slate-950 rounded-2xl border border-slate-200 dark:border-slate-800 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <label for="city-calc-input" class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">
            🧮 Check Your Exact Percentile in {cityData.name} ({ageData.label})
          </label>
          <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-semibold">100% Anonymous &amp; Instant</span>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <div class="relative flex-grow">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-sm">$</span>
            <input
              type="number"
              id="city-calc-input"
              placeholder={`e.g. ${medianNW}`}
              value={medianNW}
              class="w-full pl-8 pr-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-bold text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>
          <button
            id="city-calc-btn"
            class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-bold text-xs transition-all shadow-md flex items-center justify-center gap-1.5 whitespace-nowrap"
          >
            <span>Calculate My Rank</span>
          </button>
        </div>

        <!-- Real-time dynamic output -->
        <div id="city-calc-output" class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs space-y-1">
          <p class="text-slate-800 dark:text-slate-200">
            With <strong class="text-emerald-700 dark:text-emerald-400 font-bold" id="cres-val">${medianNW.toLocaleString()}</strong>, you rank at the <strong class="text-emerald-700 dark:text-emerald-400 font-extrabold text-sm" id="cres-pct">50th Percentile</strong> in {cityData.name} for {ageData.label}.
          </p>
          <p class="text-slate-600 dark:text-slate-400 text-[11px]" id="cres-desc">
            You match the median baseline for households in your age cohort in {cityData.name}.
          </p>
        </div>
      </div>
    </div>

    <!-- Deep Analytical Content Section 1: Financial Life Stage in City -->
    <section class="space-y-6 mb-12 text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Living in {cityData.name}: Wealth &amp; Cost of Living</h2>
      
      <p>
        For households <strong>{ageData.label}</strong> living in <strong>{cityData.name}, {cityData.state}</strong>, economic conditions are heavily shaped by local housing markets and local industry salaries. In this area, cost of living index is <strong>{cityData.col > 0 ? `+${cityData.col}% higher` : `${cityData.col}% lower`} than the US national average</strong>.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
        <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-2">
          <h3 class="font-bold text-slate-900 dark:text-white text-base">🏠 {cityData.name} Median Home Price</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            The median single-family home price in {cityData.name} is <strong>${cityData.home.toLocaleString()}</strong>. Real estate equity forms the largest individual component of total net worth for resident homeowners.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-2">
          <h3 class="font-bold text-slate-900 dark:text-white text-base">💼 Local Earning Power</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            High local salaries in tech, healthcare, or corporate sectors allow faster accumulation of tax-advantaged retirement accounts (401k &amp; IRAs), offsetting elevated local housing costs.
          </p>
        </div>
      </div>
    </section>

    <!-- Deep Analytical Content Section 2: Wealth Milestones Table -->
    <section class="space-y-6 mb-12">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{cityData.name} Wealth Percentile Tiers ({ageData.label})</h2>
      
      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <table class="w-full text-sm text-left">
          <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-bold text-xs uppercase border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th class="px-5 py-4">Percentile Tier</th>
              <th class="px-5 py-4">Required Net Worth ({cityData.name})</th>
              <th class="px-5 py-4 text-emerald-600 dark:text-emerald-400">Financial Benchmark Status</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-slate-900/60 divide-y divide-slate-200 dark:divide-slate-800 text-slate-800 dark:text-slate-200">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-5 py-4 font-bold">50th Percentile (Median)</td>
              <td class="px-5 py-4 font-bold text-slate-900 dark:text-white">${medianNW.toLocaleString()}</td>
              <td class="px-5 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400">Typical Middle Class Baseline</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 bg-slate-50/50 dark:bg-slate-900/20">
              <td class="px-5 py-4 font-bold">75th Percentile (Top 25%)</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">${top25NW.toLocaleString()}</td>
              <td class="px-5 py-4 text-xs font-semibold text-emerald-600 dark:text-emerald-400">Upper Middle Class Tier</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-5 py-4 font-bold">90th Percentile (Top 10%)</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">${top10NW.toLocaleString()}</td>
              <td class="px-5 py-4 text-xs font-semibold text-emerald-600 dark:text-emerald-400">High Net Worth Tier</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 bg-slate-50/50 dark:bg-slate-900/20">
              <td class="px-5 py-4 font-bold">99th Percentile (Top 1%)</td>
              <td class="px-5 py-4 font-bold text-amber-600 dark:text-amber-400">${top1NW.toLocaleString()}</td>
              <td class="px-5 py-4 text-xs font-semibold text-amber-600 dark:text-amber-400">Very High / Elite Wealth Tier</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Interactive CTA to Main Tool -->
    <div class="p-8 rounded-3xl bg-slate-900 text-white text-center space-y-4 shadow-xl border border-slate-800 mb-12">
      <h2 class="text-2xl md:text-3xl font-extrabold">Calculate Your Exact Percentile Rank in {cityData.name}</h2>
      <p class="text-xs md:text-sm text-slate-300 max-w-xl mx-auto">
        Input your exact net worth figure into our free client-side calculator to see where you rank in {cityData.name} and across the US.
      </p>
      <a href="/" class="inline-block px-6 py-3 bg-emerald-500 text-slate-950 font-extrabold text-sm rounded-xl hover:bg-emerald-400 transition-all shadow-md">
        Launch Calculator →
      </a>
    </div>

    <!-- Deep Analytical Content Section 3: Metro Dynamics & Inflation -->
    <section class="space-y-4 mb-12 text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Metro Wealth Dynamics: {cityData.name} vs. National Benchmarks</h2>
      <p>
        Accumulating wealth in <strong>{cityData.name}</strong> operates under distinct economic pressures compared to broader national averages. In metropolitan hubs where the cost of living index sits at <strong>{cityData.col > 0 ? `+${cityData.col}%` : `${cityData.col}%`}</strong>, households in the <strong>{ageData.label}</strong> demographic must navigate higher monthly baseline expenses for housing, transportation, and local municipal taxes.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 text-xs">
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 space-y-1.5">
          <strong class="text-slate-900 dark:text-white font-bold block text-sm">Housing Equity &amp; Property Values</strong>
          <p class="text-slate-600 dark:text-slate-400">
            With median residential real estate values in {cityData.name} priced at approximately <strong>${cityData.home.toLocaleString()}</strong>, early homeowners frequently experience faster nominal net worth growth due to leveraged property appreciation compared to lower-cost rural markets.
          </p>
        </div>
        <div class="p-4 rounded-2xl bg-white dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 space-y-1.5">
          <strong class="text-slate-900 dark:text-white font-bold block text-sm">Liquid Independence &amp; Cash Flow</strong>
          <p class="text-slate-600 dark:text-slate-400">
            Financial planners emphasize maintaining adequate liquid reserves (equities, index funds, HYSAs) equal to at least 6–12 months of local living expenses in {cityData.name} to hedge against industry-specific layoffs and localized inflation.
          </p>
        </div>
      </div>
    </section>

    <!-- Compare Across Other Top US Cities Grid (Internal Mesh Architecture) -->
    <section class="space-y-4 mb-12">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Compare {ageData.label} Net Worth Across Other US Cities</h2>
      <p class="text-xs text-slate-600 dark:text-slate-400">Explore how {ageData.label} benchmarks compare in other major metropolitan areas:</p>
      
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 text-xs">
        {cities.filter(c => c.id !== cityData.id).slice(0, 12).map(c => {
          const cMed = Math.round(c.median * ageData.mult);
          return (
            <a href={`/net-worth-at-${ageData.id}-in-${c.id}`} class="p-3.5 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all group block shadow-sm">
              <span class="font-bold text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 block">{c.name}</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400 mt-1 block">Median: <strong class="text-slate-700 dark:text-slate-300">${cMed.toLocaleString()}</strong></span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- FAQs Section -->
    <section class="space-y-6 mb-12">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white text-center">Frequently Asked Questions: {cityData.name}</h2>
      <div class="space-y-4">
        <details class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
          <summary class="font-bold text-slate-900 dark:text-white list-none flex justify-between items-center">
            <span>What is the median net worth for {ageData.label} in {cityData.name}?</span>
            <span class="group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            The median household net worth for {ageData.label} in {cityData.name} is approximately <strong>${medianNW.toLocaleString()}</strong>.
          </p>
        </details>

        <details class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
          <summary class="font-bold text-slate-900 dark:text-white list-none flex justify-between items-center">
            <span>What net worth puts you in the top 10% for {ageData.label} in {cityData.name}?</span>
            <span class="group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            In {cityData.name}, a total household net worth of <strong>${top10NW.toLocaleString()}</strong> places you in the top 10% (90th percentile) for the {ageData.label} demographic group.
          </p>
        </details>

        <details class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
          <summary class="font-bold text-slate-900 dark:text-white list-none flex justify-between items-center">
            <span>Does this figure include primary residence equity in {cityData.name}?</span>
            <span class="group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Yes. Total net worth accounts for home market value minus outstanding mortgage balances. On our main homepage calculator, you can toggle between total and liquid net worth to exclude home equity.
          </p>
        </details>
      </div>
    </section>

    <!-- Related Tools & National Benchmark Hubs -->
    <section class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">Explore Related Wealth Tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <a href="/wealth-class-calculator" class="p-4 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all block shadow-sm">
          <strong class="text-slate-900 dark:text-white block font-bold">Am I Rich? Class Tool</strong>
          <span class="text-slate-500 dark:text-slate-400 mt-1 block">Middle class vs upper middle vs rich brackets.</span>
        </a>
        <a href="/net-worth-by-income" class="p-4 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all block shadow-sm">
          <strong class="text-slate-900 dark:text-white block font-bold">Salary Wealth Multiplier</strong>
          <span class="text-slate-500 dark:text-slate-400 mt-1 block">Calculate expected net worth by annual earnings.</span>
        </a>
        <a href="/coast-fire-calculator" class="p-4 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all block shadow-sm">
          <strong class="text-slate-900 dark:text-white block font-bold">Coast FIRE Milestone Tool</strong>
          <span class="text-slate-500 dark:text-slate-400 mt-1 block">Check when compounding takes over retirement savings.</span>
        </a>
      </div>
    </section>

  </main>

  <script is:inline define:vars={{ medianNW, top25NW, top10NW, top1NW, cityName: cityData.name, ageLabel: ageData.label }}>
    document.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('city-calc-input');
      const btn = document.getElementById('city-calc-btn');
      const resVal = document.getElementById('cres-val');
      const resPct = document.getElementById('cres-pct');
      const resDesc = document.getElementById('cres-desc');

      function calculate() {
        const val = parseFloat(input.value) || 0;
        let pct = 50;
        let tier = 'Middle Class';

        if (val < medianNW * 0.2) {
          pct = 15;
          tier = 'Emerging Wealth Tier';
        } else if (val < medianNW) {
          pct = Math.round(15 + (val / medianNW) * 35);
          tier = 'Lower Middle Class';
        } else if (val < top25NW) {
          pct = Math.round(50 + ((val - medianNW) / (top25NW - medianNW)) * 25);
          tier = 'Middle Class';
        } else if (val < top10NW) {
          pct = Math.round(75 + ((val - top25NW) / (top10NW - top25NW)) * 15);
          tier = 'Upper Middle Class';
        } else if (val < top1NW) {
          pct = Math.round(90 + ((val - top10NW) / (top1NW - top10NW)) * 9);
          tier = 'High Net Worth (Top 10%)';
        } else {
          pct = 99;
          tier = 'Top 1% Elite Wealth';
        }

        resVal.textContent = '$' + Math.round(val).toLocaleString();
        resPct.textContent = pct + 'th Percentile';
        resDesc.textContent = `You rank higher than ${pct}% of ${ageLabel} households in ${cityName} (${tier}).`;
      }

      btn?.addEventListener('click', calculate);
      input?.addEventListener('input', calculate);
    });
  </script>
</Layout>
