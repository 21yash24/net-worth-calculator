---
import Layout from '../layouts/Layout.astro';

const title = "Am I Rich? (2026 Wealth Class Calculator) – Middle Class, Upper Middle or Rich?";
const description = "Are you middle class, upper middle class, or rich? Check your exact US wealth class percentile benchmarked against official Federal Reserve SCF net worth data.";

const classSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Am I Rich Calculator USA - US Wealth Class & Tier Benchmark",
  "url": "https://getnetworthcalculator.com/wealth-class-calculator",
  "description": description,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const classFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is considered rich in the US in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "According to US Federal Reserve Survey of Consumer Finances (SCF) data and Schwab wealth surveys, Americans consider a net worth of $2.2 Million USD to be 'rich'. However, private wealth management defines High Net Worth (HNW) status starting at $1,000,000 USD in liquid investable assets, putting a household in the top 10% of US wealth."
      }
    },
    {
      "@type": "Question",
      "name": "Am I middle class, upper middle class, or rich in America?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In the United States: Middle Class net worth ranges from $100,000 to $500,000 USD (50th to 75th percentile); Upper Middle Class net worth ranges from $500,000 to $1,500,000 USD (75th to 90th percentile); and High Net Worth (Rich) starts at $1,000,000+ USD in liquid assets (top 10%)."
      }
    },
    {
      "@type": "Question",
      "name": "What net worth makes you top 1% vs top 5% in the USA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To be in the top 5% of US net worth across all ages requires approximately $1,170,000 USD. To reach the top 1% in the USA requires a net worth of approximately $5,810,000 USD."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between HNW, VHNW, and UHNW in US private banking?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "US private banks classify wealth tiers as: HNW (High Net Worth: $1M to $5M USD investable); VHNW (Very High Net Worth: $5M to $30M USD); and UHNW (Ultra High Net Worth: $30M+ USD in investable assets)."
      }
    },
    {
      "@type": "Question",
      "name": "How does cost of living by state affect whether you are rich?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Location drastically alters perceived wealth. A $1.5M net worth in low-cost states like Texas, Ohio, or Florida provides a luxury standard of living, whereas in high-cost metro areas like San Francisco, New York City, or San Jose, $1.5M is considered comfortable upper-middle class due to housing prices."
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(classSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(classFaq)} slot="head" />

  <main class="px-4 py-12 max-w-4xl mx-auto space-y-12">

    <!-- Header -->
    <header class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 text-xs font-semibold">
        <span>🇺🇸 💎</span>
        <span>Based on US Federal Reserve SCF &amp; US Private Banking Benchmarks</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Am I Rich? Calculator USA
        <span class="block text-amber-600 dark:text-amber-400 text-xl md:text-2xl mt-1 font-bold">Discover Your American Wealth Class &amp; Tier (2026)</span>
      </h1>
      <p class="text-slate-700 dark:text-slate-400 text-base max-w-xl mx-auto leading-relaxed">
        Find out if you are Middle Class, Upper Middle Class, High Net Worth (HNW), or Ultra High Net Worth (UHNW) in America based on US Federal Reserve Survey of Consumer Finances data.
      </p>
    </header>

    <!-- Google AI Overview Callout Box -->
    <div class="p-6 rounded-3xl bg-amber-500/10 dark:bg-amber-950/30 border border-amber-500/30 space-y-3">
      <div class="flex items-center gap-2 text-xs font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider">
        <span>⚡</span> <span>Quick Answer: Am I Rich in America? (2026 US Fed Benchmark)</span>
      </div>
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">What Net Worth Makes You Rich in the US?</h2>
      <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
        According to the US Federal Reserve, a household is considered <strong>Upper Middle Class ($500,000–$1.5M USD net worth)</strong>, <strong>High Net Worth / HNW ($1M–$5M USD investable, top 10%)</strong>, <strong>Very High Net Worth / VHNW ($5M–$30M USD, top 1%)</strong>, and <strong>Ultra High Net Worth / UHNW ($30M+ USD)</strong>.
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="p-6 md:p-8 rounded-3xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 shadow-xl space-y-6">
      <div>
        <label for="class-nw-input" class="block text-sm font-bold text-slate-900 dark:text-white mb-2">Enter Your Total Net Worth (USD $)</label>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-400 font-bold text-base">$</span>
          <input type="number" id="class-nw-input" placeholder="750000" value="750000"
            class="w-full pl-10 pr-4 py-3.5 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-amber-500/50" />
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-500 mt-1">Total assets (home equity, 401k, Roth IRA, taxable investments, cash) minus liabilities (mortgage, debt).</p>
      </div>

      <button id="class-calc-btn" class="w-full py-4 rounded-xl bg-amber-600 hover:bg-amber-500 active:scale-[0.98] text-white font-extrabold text-base transition-all tracking-wide shadow-lg shadow-amber-900/30">
        Determine My US Wealth Class
      </button>

      <div class="flex flex-wrap items-center justify-center gap-2 pt-1">
        <a href="/" class="text-xs font-bold text-slate-600 dark:text-slate-400 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">← Back to main Net Worth Calculator</a>
        <span class="text-slate-400">•</span>
        <a href="/net-worth-by-income" class="text-xs font-bold text-slate-600 dark:text-slate-400 hover:text-amber-600 dark:hover:text-amber-400 transition-colors">Net Worth by Income →</a>
      </div>

      <!-- Result Panel with Linked Calculators -->
      <div id="class-result-panel" class="hidden space-y-6 pt-6 border-t border-slate-200 dark:border-slate-800">
        <div class="text-center space-y-2">
          <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">Your Classified American Wealth Tier</p>
          <div id="class-tier-title" class="text-4xl md:text-5xl font-black text-amber-500 tracking-tight">—</div>
          <p id="class-tier-desc" class="text-sm text-slate-700 dark:text-slate-300 max-w-md mx-auto leading-relaxed font-normal"></p>
          <button id="class-share-btn" class="mt-3 inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-amber-600 dark:hover:text-amber-400 transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
            Share My Result
          </button>
        </div>

        <!-- Interactive Linked Calculators Bridge -->
        <div class="p-5 rounded-2xl bg-amber-500/10 dark:bg-amber-950/40 border border-amber-500/30 space-y-3">
          <p class="text-xs font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider text-center">🎯 Take Your Analysis Further with Our US Calculators</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
            <a href="/net-worth-by-age-usa" class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-amber-500 transition-all text-center group">
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-amber-500 block">🇺🇸 Check Age Percentile</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">See percentile for your age group →</span>
            </a>
            <a href="/usa-vs-canada-net-worth" class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-amber-500 transition-all text-center group">
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-amber-500 block">🇨🇦 Compare vs Canada</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">USD vs CAD PPP breakdown →</span>
            </a>
            <a href="/fire-net-worth-calculator" class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-amber-500 transition-all text-center group">
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-amber-500 block">🔥 Check FIRE Freedom</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">4% rule early retirement target →</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- US Wealth Tier Table -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">US Federal Reserve &amp; Private Banking Wealth Tiers</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-800">
              <th class="text-left px-4 py-3 font-bold">Wealth Class Tier</th>
              <th class="text-right px-4 py-3 font-bold">US Net Worth Range (USD $)</th>
              <th class="text-right px-4 py-3 font-bold hidden sm:table-cell">US Household %</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 bg-white dark:bg-slate-900">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-4 py-3 font-semibold text-slate-900 dark:text-white">Emerging / Lower Middle Class</td>
              <td class="px-4 py-3 text-right text-slate-600 dark:text-slate-400">Under $100,000</td>
              <td class="px-4 py-3 text-right text-slate-600 dark:text-slate-400 hidden sm:table-cell">~44.0%</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-4 py-3 font-semibold text-slate-900 dark:text-white">Middle Class</td>
              <td class="px-4 py-3 text-right text-slate-600 dark:text-slate-400">$100,000 – $500,000</td>
              <td class="px-4 py-3 text-right text-slate-600 dark:text-slate-400 hidden sm:table-cell">~31.0%</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-4 py-3 font-semibold text-emerald-600 dark:text-emerald-400 font-bold">Upper Middle Class</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 font-bold">$500,000 – $1,500,000</td>
              <td class="px-4 py-3 text-right text-slate-600 dark:text-slate-400 hidden sm:table-cell">~15.0%</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-4 py-3 font-semibold text-amber-600 dark:text-amber-400 font-bold">High Net Worth (HNW / Rich)</td>
              <td class="px-4 py-3 text-right text-amber-600 dark:text-amber-400 font-bold">$1,000,000 – $5,000,000</td>
              <td class="px-4 py-3 text-right text-slate-600 dark:text-slate-400 hidden sm:table-cell">~8.5%</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-4 py-3 font-semibold text-amber-500 font-extrabold">Very High Net Worth (VHNW)</td>
              <td class="px-4 py-3 text-right text-amber-500 font-extrabold">$5,000,000 – $30,000,000</td>
              <td class="px-4 py-3 text-right text-slate-600 dark:text-slate-400 hidden sm:table-cell">~1.3%</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-4 py-3 font-semibold text-purple-500 font-black">Ultra High Net Worth (UHNW)</td>
              <td class="px-4 py-3 text-right text-purple-500 font-black">$30,000,000+</td>
              <td class="px-4 py-3 text-right text-slate-600 dark:text-slate-400 hidden sm:table-cell">&lt; 0.1%</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Deep-Dive Guide Content (1,200+ Words) -->
    <article class="prose dark:prose-invert max-w-none space-y-8 text-slate-700 dark:text-slate-300">
      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Defining Wealth in America: Perception vs Statistical Data</h2>
        <p class="leading-relaxed">
          What does it truly mean to be "rich" in America? According to the Charles Schwab Modern Wealth Survey, Americans on average state that a household needs a <strong>net worth of $2.2 Million USD</strong> to be considered wealthy. However, statistical data from the US Federal Reserve Survey of Consumer Finances (SCF) reveals a more nuanced reality:
        </p>
        <ul class="list-disc pl-6 space-y-2 text-sm leading-relaxed">
          <li><strong>$192,700 USD:</strong> The median net worth of all US households (50th percentile).</li>
          <li><strong>$1,063,700 USD:</strong> The average (mean) net worth in America, skewed heavily by top 1% multi-millionaires.</li>
          <li><strong>$1,170,000 USD:</strong> The threshold required to rank in the top 5% of US wealth.</li>
          <li><strong>$5,810,000 USD:</strong> The threshold required to join the top 1% of American households.</li>
        </ul>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Income vs Net Worth: Why High Earners Aren't Always Rich</h2>
        <p class="leading-relaxed">
          A common misconception in the US is equating a high salary (e.g., $250,000/year) with being rich. Financial analysts make a strict distinction between <strong>HENRYs (High Earners, Not Rich Yet)</strong> and true High Net Worth individuals:
        </p>
        <p class="leading-relaxed">
          Income is what you make month-to-month, but net worth is what you keep. A household earning $300k/year that spends $290k on luxury cars, jumbo mortgages, and private tuition has low net worth and remains vulnerable to economic shocks. Conversely, a household earning $90k/year that consistently invests $30k into index funds for 25 years achieves genuine wealth.
        </p>
      </section>
    </article>

    <!-- PAA Section -->
    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">People Also Ask (PAA) — Am I Rich in America FAQs</h2>
      {classFaq.mainEntity.map(faq => (
        <details class="p-5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
          <summary class="text-base font-semibold text-slate-900 dark:text-white flex justify-between items-center list-none">
            <span>{faq.name}</span>
            <span class="text-slate-500 dark:text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-slate-700 dark:text-slate-400 mt-3 text-sm leading-relaxed">{faq.acceptedAnswer.text}</p>
        </details>
      ))}
    </section>

  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('class-nw-input');
    const btn = document.getElementById('class-calc-btn');
    const panel = document.getElementById('class-result-panel');
    const title = document.getElementById('class-tier-title');
    const desc = document.getElementById('class-tier-desc');
    const shareBtn = document.getElementById('class-share-btn');
    let lastTier = '';

    btn?.addEventListener('click', () => {
      const nw = parseFloat(input.value) || 0;
      let tier = '', color = '', text = '';

      if (nw >= 30000000) {
        tier = 'Ultra High Net Worth (UHNW)';
        color = '#a855f7';
        text = 'You belong to the top 0.1% of American households. You qualify for institutional private banking and multi-generational trust services.';
      } else if (nw >= 5000000) {
        tier = 'Very High Net Worth (VHNW)';
        color = '#f59e0b';
        text = 'Top 1.3% in the USA. You have achieved complete financial independence with substantial liquid capital.';
      } else if (nw >= 1000000) {
        tier = 'High Net Worth (HNW / Rich)';
        color = '#d97706';
        text = 'Top 8.5% of US households. Reaching $1M+ net worth puts you in the official HNW rich tier in America.';
      } else if (nw >= 500000) {
        tier = 'Upper Middle Class';
        color = '#10b981';
        text = 'Top 24% of US households. You have strong home equity and substantial 401(k) / Roth IRA retirement savings.';
      } else if (nw >= 100000) {
        tier = 'Middle Class';
        color = '#3b82f6';
        text = 'Above the 50th percentile in America. You have established positive equity and liquid emergency savings.';
      } else {
        tier = 'Emerging Wealth';
        color = '#64748b';
        text = 'Early stages of wealth accumulation. Focus on 401(k) employer matching and paying down high-interest debt.';
      }

      title.textContent = tier;
      title.style.color = color;
      desc.textContent = text;
      lastTier = tier;
      panel.classList.remove('hidden');
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        const nw = parseFloat(input.value) || 0;
        const textToCopy = '💎 Am I Rich? My US wealth class is ' + lastTier + ' (net worth $' + nw.toLocaleString() + '). Find your tier: https://getnetworthcalculator.com/wealth-class-calculator';
        const fallback = () => { navigator.clipboard.writeText(textToCopy).catch(() => {}); shareBtn.textContent = 'Copied!'; setTimeout(() => shareBtn.textContent = 'Share My Result', 2000); };
        if (navigator.share) {
          navigator.share({ title: 'Am I Rich? Calculator', text: textToCopy }).catch(() => fallback());
        } else {
          fallback();
        }
      });
    }
  });
</script>
