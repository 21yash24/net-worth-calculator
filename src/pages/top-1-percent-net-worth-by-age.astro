---
import Layout from '../layouts/Layout.astro';

const title = "Top 1% Net Worth by Age (2026) | What You Need to Be in the Top 1%";
const description = "What net worth makes you top 1% by age? Official US Federal Reserve Survey of Consumer Finances (SCF) data thresholds for ages 25 to 75+.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What net worth is top 1% in the US?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To be in the overall top 1% of US households regardless of age, you need a net worth of approximately $13.7 Million or more. By age group, the top 1% threshold ranges from ~$3.5 Million (under 35) to ~$17 Million (ages 65-74)."
      }
    },
    {
      "@type": "Question",
      "name": "What is the top 1% net worth at age 30?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For Americans under age 35, the top 1% net worth threshold is approximately $3,500,000. Reaching this milestone usually requires successful business ownership, high-tech equity, or significant inheritance."
      }
    },
    {
      "@type": "Question",
      "name": "What is the top 1% net worth at age 40?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For the 35-44 age bracket, the top 1% net worth threshold is approximately $6,800,000."
      }
    },
    {
      "@type": "Question",
      "name": "What is the top 1% net worth at age 50?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For the 45-54 age bracket, the top 1% net worth threshold is approximately $11,000,000."
      }
    }
  ]
};

const dataByAge = [
  { bracket: "Under 35", median: "$39,000", top10: "$490,000", top5: "$950,000", top1: "$3,500,000" },
  { bracket: "35 – 44", median: "$135,600", top10: "$980,000", top5: "$1,900,000", top1: "$6,800,000" },
  { bracket: "45 – 54", median: "$247,200", top10: "$1,710,000", top5: "$3,300,000", top1: "$11,000,000" },
  { bracket: "55 – 64", median: "$364,500", top10: "$2,800,000", top5: "$5,100,000", top1: "$16,000,000" },
  { bracket: "65 – 74", median: "$409,900", top10: "$2,850,000", top5: "$5,400,000", top1: "$17,000,000" },
  { bracket: "75+", median: "$335,600", top10: "$2,400,000", top5: "$4,700,000", top1: "$14,000,000" },
];
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <main class="max-w-4xl mx-auto px-4 py-12 space-y-14">
    <section>
      <div class="inline-flex items-center gap-2 bg-amber-50 dark:bg-amber-900/20 text-amber-700 dark:text-amber-400 text-xs font-semibold px-3 py-1.5 rounded-full mb-5 border border-amber-200 dark:border-amber-800">
        🏆 US Federal Reserve SCF 2022 Benchmark
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white leading-tight mb-5">
        Top 1% Net Worth by Age <span class="text-amber-500">(2026)</span>
      </h1>
      <p class="text-lg text-slate-700 dark:text-slate-400 leading-relaxed max-w-3xl">
        How much wealth does it take to enter America's elite 1% wealth tier at your age? Here are the exact numbers based on the Federal Reserve Survey of Consumer Finances.
      </p>
    </section>

    <div class="bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent border-l-4 border-amber-500 rounded-r-2xl p-6">
      <div class="text-xs font-bold text-amber-600 dark:text-amber-400 uppercase tracking-widest mb-2">⚡ Top 1% Summary</div>
      <p class="text-slate-800 dark:text-slate-200 font-semibold text-lg leading-relaxed">
        Overall US Top 1% Threshold: <strong class="text-amber-500 text-2xl">$13,700,000+</strong><br/>
        Under 35: <strong class="text-amber-500">$3.5M</strong> | 35–44: <strong class="text-amber-500">$6.8M</strong> | 45–54: <strong class="text-amber-500">$11.0M</strong> | 55–64: <strong class="text-amber-500">$16.0M</strong>
      </p>
    </div>

    <section>
      <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white mb-4">Top 1% Net Worth Table by Age</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
        <table class="w-full text-sm">
          <thead class="bg-slate-100 dark:bg-slate-800/60">
            <tr>
              <th class="px-4 py-3 text-left font-bold text-slate-900 dark:text-white">Age Bracket</th>
              <th class="px-4 py-3 text-left font-bold text-slate-500">Median</th>
              <th class="px-4 py-3 text-left font-bold text-slate-600 dark:text-slate-400">Top 10%</th>
              <th class="px-4 py-3 text-left font-bold text-orange-600 dark:text-orange-400">Top 5%</th>
              <th class="px-4 py-3 text-left font-bold text-amber-500">🏆 Top 1%</th>
            </tr>
          </thead>
          <tbody>
            {dataByAge.map((row, i) => (
              <tr class={`border-t border-slate-200 dark:border-slate-800 ${i % 2 === 1 ? 'bg-slate-50 dark:bg-slate-900/40' : ''}`}>
                <td class="px-4 py-3 font-bold text-slate-900 dark:text-white">{row.bracket}</td>
                <td class="px-4 py-3 text-slate-500 dark:text-slate-400">{row.median}</td>
                <td class="px-4 py-3 text-slate-700 dark:text-slate-300">{row.top10}</td>
                <td class="px-4 py-3 text-orange-600 dark:text-orange-400 font-semibold">{row.top5}</td>
                <td class="px-4 py-3 font-bold text-amber-500 text-base">{row.top1}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white mb-6">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map(faq => (
          <div class="bg-white dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-2xl p-5">
            <h3 class="font-bold text-slate-900 dark:text-white mb-2">Q: {faq.name}</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{faq.acceptedAnswer.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-slate-50 dark:bg-slate-900/40 rounded-2xl p-6 border border-slate-200 dark:border-slate-800">
      <h3 class="font-bold text-slate-900 dark:text-white mb-4">🔗 Related Benchmarks &amp; Calculators</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="/top-10-percent-net-worth-by-age" class="flex items-center gap-3 p-3 rounded-xl bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 hover:border-amber-500/50 transition-all">
          <span class="text-amber-500 text-lg">🏆</span>
          <div>
            <div class="text-sm font-bold text-slate-900 dark:text-white">Top 10% Net Worth by Age</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">What net worth puts you in the top 10%?</div>
          </div>
        </a>
        <a href="/wealth-class-calculator" class="flex items-center gap-3 p-3 rounded-xl bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 hover:border-amber-500/50 transition-all">
          <span class="text-amber-500 text-lg">💎</span>
          <div>
            <div class="text-sm font-bold text-slate-900 dark:text-white">Am I Rich? Calculator</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">Discover your American wealth class tier.</div>
          </div>
        </a>
        <a href="/" class="flex items-center gap-3 p-3 rounded-xl bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 hover:border-emerald-500/50 transition-all">
          <span class="text-emerald-500 text-lg">🧮</span>
          <div>
            <div class="text-sm font-bold text-slate-900 dark:text-white">Net Worth Calculator by Age</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">Find your exact percentile rank.</div>
          </div>
        </a>
        <a href="/average-net-worth-by-age" class="flex items-center gap-3 p-3 rounded-xl bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 hover:border-emerald-500/50 transition-all">
          <span class="text-emerald-500 text-lg">📊</span>
          <div>
            <div class="text-sm font-bold text-slate-900 dark:text-white">Average Net Worth by Age</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">Complete Federal Reserve data table.</div>
          </div>
        </a>
        <a href="/net-worth-percentile" class="flex items-center gap-3 p-3 rounded-xl bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 hover:border-emerald-500/50 transition-all">
          <span class="text-emerald-500 text-lg">🏆</span>
          <div>
            <div class="text-sm font-bold text-slate-900 dark:text-white">Net Worth Percentile Ranking</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">Where do you actually stand?</div>
          </div>
        </a>
        <a href="/median-vs-average-net-worth" class="flex items-center gap-3 p-3 rounded-xl bg-white dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 hover:border-emerald-500/50 transition-all">
          <span class="text-emerald-500 text-lg">⚖️</span>
          <div>
            <div class="text-sm font-bold text-slate-900 dark:text-white">Median vs Average Net Worth</div>
            <div class="text-xs text-slate-500 dark:text-slate-400">Why the "average" statistic lies.</div>
          </div>
        </a>
      </div>
    </section>

    <!-- Educational Content: What Does Top 1% Actually Mean? -->
    <section class="space-y-4 text-slate-700 dark:text-slate-300 leading-relaxed">
      <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white">What Does "Top 1%" Actually Mean?</h2>
      <p>
        The top 1% wealth threshold represents the entry point into America's wealthiest households. According to the Federal Reserve's Survey of Consumer Finances, this elite tier requires total net worth (assets minus liabilities) that vastly exceeds median household wealth. For context, a household in the top 1% for the under-35 age bracket holds approximately <strong class="text-slate-900 dark:text-white">90x the median net worth</strong> of their peers.
      </p>
      <p>
        It's important to distinguish between <strong class="text-slate-900 dark:text-white">net worth percentiles by age</strong> and overall net worth percentiles. A $3.5M net worth puts you in the top 1% for under-35s, but the same amount would not reach the top 1% for ages 55–64, where the threshold is $16M. This is because older households have had decades of compound growth, home equity appreciation, and retirement account accumulation.
      </p>
      <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 space-y-3">
        <h3 class="font-bold text-slate-900 dark:text-white text-base">Key Differences Between Wealth Tiers</h3>
        <ul class="space-y-2 text-sm">
          <li><strong class="text-slate-900 dark:text-white">Top 10% (Affluent):</strong> Requires $340K–$2.85M depending on age. Achievable through consistent 401(k) contributions, home equity, and index fund investing over 15–20 years.</li>
          <li><strong class="text-slate-900 dark:text-white">Top 5% (High Net Worth):</strong> Requires $950K–$5.4M. Typically requires dual high incomes, significant equity compensation (RSUs), or business ownership.</li>
          <li><strong class="text-slate-900 dark:text-white">Top 1% (Ultra High Net Worth):</strong> Requires $3.5M–$17M. Usually requires business equity, large stock portfolios, or generational wealth transfer.</li>
        </ul>
      </div>
      <p>
        If your goal is to reach the top 1%, focus on <strong class="text-slate-900 dark:text-white">equity compensation</strong> (tech RSUs, startup equity), <strong class="text-slate-900 dark:text-white">real estate investment properties</strong>, and <strong class="text-slate-900 dark:text-white">business ownership</strong> — the three primary wealth accelerators that separate the top 1% from the top 10%.
      </p>
    </section>
  </main>
</Layout>
