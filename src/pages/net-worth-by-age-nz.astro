      <!-- Result -->
      <div id="nz-result-panel" class="hidden space-y-5">
        <div class="h-px bg-slate-200 dark:bg-slate-800"></div>
        <div class="text-center space-y-2">
          <p class="text-sm font-semibold text-slate-600 dark:text-slate-400">Your New Zealand Net Worth Percentile</p>
          <div class="text-6xl font-black tracking-tighter" id="nz-percentile-display">—</div>
          <p id="nz-result-summary" class="text-sm text-slate-700 dark:text-slate-400 leading-relaxed max-w-sm mx-auto"></p>
        </div>

        <!-- Benchmark Grid -->
        <div>
          <p class="text-xs font-bold text-slate-500 dark:text-slate-500 uppercase tracking-widest mb-3">🇳🇿 NZ Benchmarks for Your Age Group</p>
          <div id="nz-benchmark-grid" class="grid grid-cols-2 gap-3"></div>
        </div>
      </div>
    </div>

    <!-- Data Table Section -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Net Worth Distribution in New Zealand by Age</h2>
      <p class="text-slate-700 dark:text-slate-400 leading-relaxed">
        The Statistics New Zealand (Stats NZ) Household Economic Survey provides comprehensive measurements of Kiwi household wealth. Median net worth across all New Zealand households is approximately <strong class="text-slate-900 dark:text-white">NZD $340,000</strong>, though wealth varies significantly based on homeownership status and KiwiSaver accumulation.
      </p>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
