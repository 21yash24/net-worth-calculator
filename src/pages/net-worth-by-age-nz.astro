---
import Layout from '../layouts/Layout.astro';

const title = "Net Worth by Age in New Zealand (2026): Stats NZ Wealth Benchmarks [NZ$]";
const description = "What is the average net worth by age in New Zealand? Explore official Stats NZ Household Economic Survey benchmarks, medians, and top 10% in NZD.";

const nzSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Net Worth Percentile Calculator New Zealand (Stats NZ Data)",
  "url": "https://getnetworthcalculator.com/net-worth-by-age-nz/",
  "description": description,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "NZD" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the average net worth by age in New Zealand?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "According to Statistics New Zealand (Stats NZ HES survey data): Under 35 median net worth is NZD $42,000; ages 35-44 is $215,000; ages 45-54 is $480,000; ages 55-64 is $720,000; and ages 65-74 is $640,000. Figures include KiwiSaver savings, residential property equity, and liquid funds."
      }
    },
    {
      "@type": "Question",
      "name": "What net worth puts you in the top 1% in New Zealand?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To be in the top 1% (99th percentile) of net worth in New Zealand across all age groups, a household needs approximately NZD $4.2 Million. For ages 55-64, the top 1% threshold is around NZD $6.5 Million."
      }
    },
    {
      "@type": "Question",
      "name": "Does New Zealand net worth include KiwiSaver and property equity?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Stats NZ calculates household net worth by summing all physical and financial assets (primary residence, KiwiSaver balances, investment property, shares, bank deposits) minus all liabilities (mortgages, personal loans, student loans)."
      }
    },
    {
      "@type": "Question",
      "name": "What is a good net worth at age 30 in New Zealand?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In New Zealand, a net worth of NZD $42,000 at age 30 puts you at the median (50th percentile). Reaching $120,000+ puts you in the top 25%, while $280,000+ places you in the top 10% for your age group."
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(nzSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

  <main class="px-4 py-12 max-w-4xl mx-auto space-y-12">

    <!-- Header -->
    <header class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-600 dark:text-blue-400 text-xs font-semibold">
        <span>🇳🇿</span>
        <span>Based on Statistics New Zealand (Stats NZ HES) Dataset</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Net Worth by Age in New Zealand
        <span class="block text-emerald-600 dark:text-emerald-400 text-xl md:text-2xl mt-1 font-bold">Wealth Percentile Calculator (NZD $)</span>
      </h1>
      <p class="text-slate-700 dark:text-slate-400 text-base max-w-xl mx-auto leading-relaxed">
        Enter your age and net worth in New Zealand dollars to see your exact percentile benchmark compared to Kiwi households — using real Stats NZ data.
      </p>
    </header>

    <!-- Google AI Overview Callout Box -->
    <div class="p-6 rounded-3xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/30 space-y-3">
      <div class="flex items-center gap-2 text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">
        <span>⚡</span> <span>Quick Answer: Median Net Worth in New Zealand by Age (2026)</span>
      </div>
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">What is the Average Net Worth by Age in NZ?</h2>
      <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
        According to Stats NZ Household Economic Survey data, median net worth by age is: <strong>Under 35 (NZD $42,000)</strong>, <strong>35–44 ($215,000)</strong>, <strong>45–54 ($480,000)</strong>, <strong>55–64 ($720,000)</strong>, and <strong>65–74 ($640,000)</strong>. Figures include KiwiSaver funds and home equity minus debts.
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="p-6 md:p-8 rounded-3xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 shadow-xl space-y-6">

      <!-- Age Input -->
      <div>
        <div class="flex justify-between items-center mb-2">
          <label for="nz-age-slider" class="text-sm font-bold text-slate-900 dark:text-white">Your Age</label>
          <span id="nz-age-display" class="text-sm font-bold text-emerald-700 dark:text-emerald-400">35 years old</span>
        </div>
        <input type="range" id="nz-age-slider" min="18" max="85" value="35" step="1"
          class="w-full h-2 rounded-full appearance-none accent-emerald-600 bg-slate-200 dark:bg-slate-800 cursor-pointer" />
        <div class="flex justify-between text-xs text-slate-500 dark:text-slate-500 mt-1">
          <span>18</span><span>85+</span>
        </div>
      </div>

      <!-- Net Worth Input -->
      <div>
        <label for="nz-networth-input" class="block text-sm font-bold text-slate-900 dark:text-white mb-2">Your Net Worth (NZD $)</label>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-400 font-bold text-sm">NZ$</span>
          <input type="number" id="nz-networth-input" placeholder="215000" value="215000"
            class="w-full pl-14 pr-4 py-3.5 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-semibold text-base focus:outline-none focus:ring-2 focus:ring-emerald-500/50" />
        </div>
        <p class="text-xs text-slate-500 dark:text-slate-500 mt-1.5">Total assets minus total liabilities. Include primary home equity, KiwiSaver, investments, savings.</p>
      </div>

      <button id="nz-calculate-btn" class="w-full py-4 rounded-xl bg-emerald-700 hover:bg-emerald-600 active:scale-[0.98] text-white font-extrabold text-base transition-all tracking-wide shadow-lg shadow-emerald-900/30">
        Calculate My NZ Percentile
