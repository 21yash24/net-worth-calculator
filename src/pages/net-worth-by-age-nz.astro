              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$45,000</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$110,000</td>
              <td class="px-4 py-3 text-right text-amber-600 dark:text-amber-400 font-bold">NZ$450,000</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors bg-emerald-500/5">
              <td class="px-4 py-3 font-semibold text-slate-900 dark:text-white">25–34 (Young Professionals)</td>
              <td class="px-4 py-3 text-right text-emerald-600 dark:text-emerald-400 font-bold">NZ$68,000</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$185,000</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$390,000</td>
              <td class="px-4 py-3 text-right text-amber-600 dark:text-amber-400 font-bold">NZ$1,250,000</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
              <td class="px-4 py-3 font-semibold text-slate-900 dark:text-white">35–44</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">NZ$215,000</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$540,000</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$1,100,000</td>
