              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">NZ$480,000</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$1,050,000</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$2,100,000</td>
              <td class="px-4 py-3 text-right text-amber-600 dark:text-amber-400 font-bold">NZ$5,200,000</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
              <td class="px-4 py-3 font-semibold text-slate-900 dark:text-white">55–64</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">NZ$720,000</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$1,550,000</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$3,200,000</td>
              <td class="px-4 py-3 text-right text-amber-600 dark:text-amber-400 font-bold">NZ$6,800,000</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
              <td class="px-4 py-3 font-semibold text-slate-900 dark:text-white">65–74</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">NZ$640,000</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$1,350,000</td>
              <td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300 hidden sm:table-cell">NZ$2,800,000</td>
              <td class="px-4 py-3 text-right text-amber-600 dark:text-amber-400 font-bold">NZ$5,900,000</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Specific Age 25-34 & KiwiSaver Insights -->
      <div class="p-6 rounded-2xl bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 space-y-3">
        <h3 class="text-base font-bold text-slate-900 dark:text-white flex items-center gap-2">
          <span>📊</span> <span>Statistics NZ Household Economic Survey (Age 25–34 Focus)</span>
        </h3>
        <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
          For Kiwis aged <strong>25 to 34</strong>, median individual net worth is <strong>NZD $68,000</strong>. Key wealth drivers in this cohort include:
        </p>
        <ul class="text-xs text-slate-600 dark:text-slate-300 space-y-1.5 list-disc list-inside">
          <li><strong>Average KiwiSaver Balance:</strong> NZ$28,500 for age 25–34 contributors.</li>
          <li><strong>Homeownership Impact:</strong> Kiwis in this age bracket with a first home have a median net worth of NZ$195,000, compared to NZ$32,000 for non-homeowners.</li>
          <li><strong>Top 10% (90th Percentile) Threshold:</strong> Reaching <strong>NZD $390,000</strong> before turning 35 places you in the top decile of young New Zealanders.</li>
        </ul>
      </div>
    </section>

    <!-- Related Calculators & Guides -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-4">Compare Net Worth Across Countries</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/net-worth-by-age-australia" class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all">
          <div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wide mb-1">🇦🇺 Australia</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">Australia Net Worth Calculator (AUD)</h3>
          <p class="text-xs text-slate-700 dark:text-slate-400 mt-1">Benchmark against ABS Survey of Income &amp; Housing.</p>
        </a>
        <a href="/net-worth-by-age-canada" class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all">
          <div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wide mb-1">🇨🇦 Canada</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">Canada Net Worth Calculator (CAD)</h3>
          <p class="text-xs text-slate-700 dark:text-slate-400 mt-1">Benchmark against Statistics Canada SFS data.</p>
        </a>
        <a href="/net-worth-by-age-uk" class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all">
          <div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wide mb-1">🇬🇧 United Kingdom</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">UK Net Worth Calculator (GBP)</h3>
          <p class="text-xs text-slate-700 dark:text-slate-400 mt-1">Benchmark against ONS Wealth &amp; Assets Survey data.</p>
        </a>
        <a href="/net-worth-by-age-india" class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all">
          <div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wide mb-1">🇮🇳 India</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">India Net Worth Calculator (₹)</h3>
          <p class="text-xs text-slate-700 dark:text-slate-400 mt-1">Benchmark in lakhs &amp; crores for Indian households.</p>
        </a>
      </div>
    </section>

    <!-- FAQ PAA Section -->
    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">People Also Ask (PAA) — New Zealand Net Worth FAQs</h2>
      {faqSchema.mainEntity.map(faq => (
        <details class="p-5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
          <summary class="text-base font-semibold text-slate-900 dark:text-white flex justify-between items-center list-none">
            <span>{faq.name}</span>
            <span class="text-slate-500 dark:text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-slate-700 dark:text-slate-400 mt-3 text-sm leading-relaxed">{faq.acceptedAnswer.text}</p>
        </details>
      ))}
    </section>

  </main>
</Layout>

<script is:inline>
  const nzBrackets = {
    under_35: { p10: -4000, p25: 12000, p50: 42000, p75: 120000, p90: 280000, p99: 1200000 },
    b35_44:   { p10: 5000,  p25: 65000, p50: 215000, p75: 540000, p90: 1100000, p99: 3800000 },
    b45_54:   { p10: 25000, p25: 160000, p50: 480000, p75: 1050000, p90: 2100000, p99: 5500000 },
    b55_64:   { p10: 45000, p25: 220000, p50: 720000, p75: 1550000, p90: 3200000, p99: 6500000 },
    b65_plus: { p10: 35000, p25: 190000, p50: 640000, p75: 1350000, p90: 2800000, p99: 5800000 }
  };

  function getBracketNZ(age) {
    if (age < 35) return { key: 'under_35', label: 'Under 35' };
    if (age < 45) return { key: 'b35_44', label: '35–44' };
    if (age < 55) return { key: 'b45_54', label: '45–54' };
    if (age < 65) return { key: 'b55_64', label: '55–64' };
    return { key: 'b65_plus', label: '65+' };
  }

  function estimatePercentileNZ(nw, brackets) {
    const pts = [
      [0, brackets.p10], [10, brackets.p10], [25, brackets.p25],
      [50, brackets.p50], [75, brackets.p75], [90, brackets.p90],
      [99, brackets.p99], [100, brackets.p99 * 3]
    ];
    for (let i = 1; i < pts.length; i++) {
      if (nw <= pts[i][1]) {
        const [p1, v1] = pts[i-1], [p2, v2] = pts[i];
        if (v2 === v1) return p1;
        return Math.round(p1 + (p2 - p1) * (nw - v1) / (v2 - v1));
      }
    }
    return 99;
  }

  function fmtNZ(n) {
    if (Math.abs(n) >= 1e6) return 'NZ$' + (n/1e6).toFixed(1) + 'M';
    if (Math.abs(n) >= 1e3) return 'NZ$' + Math.round(n/1000) + 'k';
    return 'NZ$' + n.toLocaleString();
  }

  document.addEventListener('DOMContentLoaded', () => {
    const ageSlider = document.getElementById('nz-age-slider');
    const ageDisplay = document.getElementById('nz-age-display');
    const nwInput = document.getElementById('nz-networth-input');
    const calcBtn = document.getElementById('nz-calculate-btn');
    const resultPanel = document.getElementById('nz-result-panel');
    const percentileDisplay = document.getElementById('nz-percentile-display');
    const resultSummary = document.getElementById('nz-result-summary');
    const benchmarkGrid = document.getElementById('nz-benchmark-grid');

    ageSlider?.addEventListener('input', () => {
      ageDisplay.textContent = ageSlider.value + ' years old';
    });

    calcBtn?.addEventListener('click', () => {
      const age = parseInt(ageSlider.value);
      const nw = parseFloat(nwInput.value) || 0;
      const bracket = getBracketNZ(age);
      const b = nzBrackets[bracket.key];
      const pct = estimatePercentileNZ(nw, b);

      let color = pct >= 90 ? '#059669' : pct >= 75 ? '#10b981' : pct >= 50 ? '#3b82f6' : pct >= 25 ? '#f59e0b' : '#ef4444';
      percentileDisplay.textContent = pct + 'th';
      percentileDisplay.style.color = color;

      let msg = pct >= 99 ? 'You are in the top 1% of Kiwi wealth for your age. Exceptional.' :
                pct >= 90 ? 'Top 10% in New Zealand for your age group. Financially very strong.' :
                pct >= 75 ? 'Top 25% of Kiwis your age. Above average wealth.' :
                pct >= 50 ? 'Above the median New Zealander for your age.' :
                'Below the 50th percentile — earlier stages of wealth building.';
      resultSummary.textContent = msg;

      const bmarks = [
        { label: 'Bottom 25%', val: b.p25, pct: 25 },
        { label: 'Median (50%)', val: b.p50, pct: 50 },
        { label: 'Top 25%', val: b.p75, pct: 75 },
        { label: 'Top 10%', val: b.p90, pct: 90 }
      ];
      benchmarkGrid.innerHTML = bmarks.map(bm => {
        const isHighlighted = pct >= bm.pct;
        return `<div class="p-3 rounded-xl border ${isHighlighted ? 'border-emerald-500/50 bg-emerald-50 dark:bg-emerald-900/10' : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40'}">
          <div class="text-xs font-bold ${isHighlighted ? 'text-emerald-700 dark:text-emerald-400' : 'text-slate-500 dark:text-slate-500'} uppercase tracking-wide">${bm.label}</div>
          <div class="text-base font-black mt-0.5 text-slate-900 dark:text-white">${fmtNZ(bm.val)}</div>
        </div>`;
      }).join('');

      resultPanel.classList.remove('hidden');
      resultPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
</script>
