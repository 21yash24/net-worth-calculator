---
import Layout from '../../layouts/Layout.astro';
import milestones from '../../data/milestoneData.json';

export async function getStaticPaths() {
  const paths = [];
  for (const m of milestones) {
    for (const ap of m.agePercentiles) {
      paths.push({
        params: { milestone: m.slug, age: ap.age.toString() },
        props: { milestoneData: m, ageData: ap },
      });
    }
  }
  return paths;
}

const { milestoneData, ageData } = Astro.props;

const title = `Is ${milestoneData.label} Net Worth Good at Age ${ageData.age}? (2026 Percentile Benchmark)`;
const description = `Having ${milestoneData.label} net worth at age ${ageData.age} puts you in the ${ageData.status} (${ageData.percentile}th percentile) in the United States. View exact breakdown & Fed SCF benchmarks.`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Is having ${milestoneData.label} net worth good at age ${ageData.age}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. Having a net worth of ${milestoneData.label} at age ${ageData.age} places you at approximately the ${ageData.percentile}th percentile of all American households in that age bracket, categorized as "${ageData.status}".`
      }
    },
    {
      "@type": "Question",
      "name": `What percentage of ${ageData.age}-year-olds have ${milestoneData.label} net worth?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `According to Federal Reserve Survey of Consumer Finances (SCF) benchmarks, approximately ${(100 - ageData.percentile).toFixed(1)}% of households aged ${ageData.age} have attained ${milestoneData.label} or more in total net worth.`
      }
    },
    {
      "@type": "Question",
      "name": `How long does it take to double ${milestoneData.label}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Using the Rule of 72, an investment of ${milestoneData.label} at a historical 8% average stock market return will double to $${(milestoneData.amount * 2).toLocaleString()} in approximately 9 years without adding another dollar.`
      }
    },
    {
      "@type": "Question",
      "name": `What is the 4% safe withdrawal annual income from ${milestoneData.label}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Under the Trinity Study 4% rule, a portfolio of ${milestoneData.label} generates an annual passive income of $${(milestoneData.amount * 0.04).toLocaleString()} adjusted annually for inflation.`
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="max-w-4xl mx-auto px-6 py-10 md:py-16">
    <header class="text-center mb-10 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-semibold">
        <span>🏆</span>
        <span>Wealth Milestone & Demographic Benchmark (2026)</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {milestoneData.label} Net Worth at <span class="text-emerald-500 dark:text-emerald-400 font-normal">Age {ageData.age}</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-base md:text-lg max-w-2xl mx-auto">
        {ageData.context}
      </p>
    </header>

    <!-- Percentile Rank Hero Card -->
    <div class="bg-gradient-to-br from-emerald-950/40 via-slate-900 to-slate-950 border border-emerald-500/30 rounded-3xl p-8 mb-10 text-center relative overflow-hidden">
      <div class="text-xs uppercase font-extrabold tracking-widest text-emerald-400 mb-2">National Wealth Standing</div>
      <div class="text-5xl md:text-7xl font-black text-white tracking-tight">
        {ageData.percentile}<span class="text-2xl md:text-3xl text-emerald-400 font-bold">th</span>
      </div>
      <div class="text-base md:text-lg font-bold text-slate-200 mt-2">
        Percentile for Americans Age {ageData.age}
      </div>
      <div class="inline-block mt-3 px-4 py-1.5 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-extrabold">
        Rank: {ageData.status}
      </div>

      <!-- Live Progress Bar -->
      <div class="max-w-md mx-auto mt-6">
        <div class="w-full bg-slate-800 rounded-full h-3.5 p-0.5 overflow-hidden">
          <div class="bg-gradient-to-r from-emerald-500 to-teal-400 h-full rounded-full transition-all duration-1000" style={`width: ${ageData.percentile}%`}></div>
        </div>
        <div class="flex justify-between text-[11px] text-slate-500 font-mono mt-1.5">
          <span>0% (Lowest)</span>
          <span>50% (Median)</span>
          <span>100% (Top 1%)</span>
        </div>
      </div>
    </div>

    <!-- Deep Analysis / Insight Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-10">
      <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6 space-y-3">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>💡</span> Key Milestone Insight
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          {milestoneData.description}
        </p>
        <div class="pt-2 text-xs font-semibold text-emerald-400">
          Difficulty Tier: {milestoneData.difficulty}
        </div>
      </div>

      <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6 space-y-3">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>⚡</span> The Compounding Power of {milestoneData.label}
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          At an 8% average annual return, <strong class="text-white">{milestoneData.label}</strong> generates approximately <strong class="text-emerald-400">${(milestoneData.amount * 0.08).toLocaleString()}/year</strong> completely passively without liquidating any principal capital.
        </p>
        <div class="text-xs text-slate-400">
          In 10 years at 8%, this milestone compounds to <strong class="text-white">${(milestoneData.amount * Math.pow(1.08, 10)).toLocaleString(undefined, {maximumFractionDigits: 0})}</strong>.
        </div>
      </div>
    </div>

    <!-- Deep Guide on Achieving & Protecting This Milestone -->
    <article class="bg-slate-900/40 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-6 text-slate-300 text-sm leading-relaxed mb-10">
      <h2 class="text-2xl font-bold text-white">Strategic Roadmap: How to Capitalize on {milestoneData.label} at Age {ageData.age}</h2>
      
      <p>
        Reaching <strong>{milestoneData.label}</strong> at <strong>age {ageData.age}</strong> places you squarely in the <strong>{ageData.status}</strong> category. At this stage of wealth accumulation, the dynamics of personal finance shift from pure labor-driven savings to capital efficiency and tax preservation.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 my-4">
        <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2">
          <div class="text-xs font-bold text-emerald-400 uppercase">4% Safe Withdrawal</div>
          <div class="text-xl font-extrabold text-white">${(milestoneData.amount * 0.04).toLocaleString()}/yr</div>
          <div class="text-[11px] text-slate-400">Perpetual inflation-adjusted annual cashflow.</div>
        </div>

        <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2">
          <div class="text-xs font-bold text-teal-400 uppercase">Rule of 72 Doubling Time</div>
          <div class="text-xl font-extrabold text-white">~9.0 Years</div>
          <div class="text-[11px] text-slate-400">Grows to ${(milestoneData.amount * 2).toLocaleString()} at 8% compound return.</div>
        </div>

        <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2">
          <div class="text-xs font-bold text-indigo-400 uppercase">Coast FIRE Horizon</div>
          <div class="text-xl font-extrabold text-white">{ageData.age <= 35 ? "Achieved / On Track" : "Mature Foundation"}</div>
          <div class="text-[11px] text-slate-400">Projected traditional retirement readiness.</div>
        </div>
      </div>

      <h3 class="text-lg font-bold text-white pt-2">Recommended Financial Priorities for This Bracket</h3>
      <ul class="list-disc pl-5 space-y-2 text-xs text-slate-300">
        <li><strong>Automate Investment Buckets:</strong> Ensure maximum contributions to tax-advantaged accounts (401k, Backdoor Roth, HSA) before funding taxable brokerage accounts.</li>
        <li><strong>Maintain Liquid Buffer:</strong> Keep 3 to 6 months of essential living expenses in a High-Yield Savings Account (HYSA) or short-term Treasury bills to prevent premature liquidation of equities during market drawdowns.</li>
        <li><strong>Avoid Lifestyle Inflation:</strong> As investment returns begin matching or exceeding salary income, maintain consistent spending habits to allow compound growth to accelerate exponentially.</li>
      </ul>
    </article>

    <!-- Compare Across Other Ages Table -->
    <div class="bg-slate-900/50 border border-slate-800 rounded-2xl p-6 mb-10">
      <h3 class="text-lg font-bold text-white mb-2">How {milestoneData.label} Ranks Across Different Age Groups</h3>
      <p class="text-xs text-slate-400 mb-4">Federal Reserve Survey of Consumer Finances (SCF) population percentile breakdown.</p>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-800 text-slate-400 text-xs uppercase tracking-wider">
              <th class="pb-3 pr-4">Age</th>
              <th class="pb-3 px-4">Percentile</th>
              <th class="pb-3 px-4">Classification</th>
              <th class="pb-3 pl-4">Explore</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 font-mono text-xs">
            {milestoneData.agePercentiles.map((ap) => (
              <tr class={`hover:bg-slate-800/30 transition-colors ${ap.age === ageData.age ? 'bg-emerald-500/10' : ''}`}>
                <td class="py-3.5 pr-4 font-sans font-bold text-white">Age {ap.age}</td>
                <td class="py-3.5 px-4 text-emerald-400 font-bold">{ap.percentile}th Percentile</td>
                <td class="py-3.5 px-4 font-sans text-slate-300">{ap.status}</td>
                <td class="py-3.5 pl-4 font-sans">
                  <a href={`/net-worth/${milestoneData.slug}-at-${ap.age}`} class="text-emerald-400 hover:text-emerald-300 underline font-semibold">
                    View Benchmark →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Live Interactive Calculator CTA -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 text-center space-y-4">
      <h3 class="text-2xl font-extrabold text-white">Check Your Custom Number</h3>
      <p class="text-slate-300 text-sm max-w-lg mx-auto">
        Have a different age or exact net worth? Use our full official Federal Reserve calculator to see where you rank.
      </p>
      <a href="/" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl shadow-lg transition-all transform hover:-translate-y-0.5">
        <span>⚡ Open Full Net Worth Calculator</span>
      </a>
    </div>
  </main>
</Layout>
