---
import Layout from '../layouts/Layout.astro';

const title = "Coast FIRE Calculator: Find Your Exact Coast FI Number [2026 Free Tool]";
const description = "Calculate your exact Coast FIRE number by age. Find out how much you need invested today to retire early without saving another penny.";

const coastSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Coast FIRE Calculator - Early Retirement Coasting Target",
  "url": "https://getnetworthcalculator.com/coast-fire-calculator/",
  "description": description,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const coastFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Coast FIRE and how does it work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Coast FIRE is a financial independence milestone where you have invested enough money early in life that compound interest alone will grow your portfolio to cover your traditional retirement expenses by age 60 or 65. Once you hit Coast FIRE, you no longer need to save money for retirement—you only need to earn enough income to cover your day-to-day living expenses."
      }
    },
    {
      "@type": "Question",
      "name": "What is the formula for calculating Coast FIRE?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Coast FIRE target formula is: Coast FIRE Target = Full FIRE Target / (1 + Expected Annual Real Return)^(Target Retirement Age - Current Age). For example, if your Full FIRE target is $1.5 Million at age 60, you are 30 years old, and expect a 7% real return (after inflation), your Coast FIRE number today is $1,500,000 / (1.07)^30 = $197,056."
      }
    },
    {
      "@type": "Question",
      "name": "What rate of return should I use for Coast FIRE math?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most personal finance experts and Vanguard/Fidelity models recommend using a 5% to 7% real annual return (which accounts for a 9% to 10% gross S&P 500 return minus 2% to 3% annual inflation)."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Coast FIRE, Barista FIRE, and Lean FIRE?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Coast FIRE means your existing investments will grow to full retirement, but you still work to cover 100% of current living expenses. Barista FIRE means you work part-time to cover partial living expenses while using investments for the rest. Lean FIRE means completely retiring early on a minimalist budget (under $40k/year)."
      }
    },
    {
      "@type": "Question",
      "name": "Does home equity or real estate count toward your Coast FIRE threshold?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Primary residence home equity generally does not count toward your Coast FIRE capital because it does not generate dividend income or compound liquid index fund growth. Only liquid investable assets such as 401(k), Roth IRA, brokerage accounts, index funds, and rental property net equity generate compounding retirement returns."
      }
    },
    {
      "@type": "Question",
      "name": "Can you coast with only a 401(k) or Roth IRA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Because Coast FIRE relies on long-term compound growth until age 59.5 or 60, tax-advantaged retirement accounts like 401(k)s and Roth IRAs are ideal vehicles. Since you do not intend to withdraw the funds until standard retirement age, you avoid early withdrawal tax penalties completely."
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(coastSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(coastFaq)} slot="head" />

  <main class="px-4 py-12 max-w-4xl mx-auto space-y-12">

    <!-- Header -->
    <header class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
        <span>🏝️ 🔥</span>
        <span>Financial Independence, Retire Early — Coasting Strategy</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Coast FIRE Calculator
        <span class="block text-emerald-600 dark:text-emerald-400 text-xl md:text-2xl mt-1 font-bold">Calculate Your "Stop Saving" Early Retirement Milestone (2026)</span>
      </h1>
      <p class="text-slate-700 dark:text-slate-400 text-base max-w-xl mx-auto leading-relaxed">
        Find out if your current net worth and retirement investments are already enough to compound into full financial freedom—without saving another dollar.
      </p>
    </header>

    <!-- Google AI Overview Callout Box -->
    <div class="p-6 rounded-3xl bg-emerald-500/10 dark:bg-emerald-950/30 border border-emerald-500/30 space-y-3">
      <div class="flex items-center gap-2 text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">
        <span>⚡</span> <span>Quick Answer: What is Coast FIRE &amp; How Much Do You Need?</span>
      </div>
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">How Does Coast FIRE Work?</h2>
      <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
        <strong>Coast FIRE</strong> occurs when your invested net worth is large enough that compound interest alone will grow your portfolio to your retirement target by your desired age. At age 30, with a $1.5M target at age 60 and a 7% real return, your Coast FIRE threshold is <strong>$197,000 in invested assets</strong> today.
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="p-6 md:p-8 rounded-3xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 shadow-xl space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="coast-age-current" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Current Age</label>
          <input type="number" id="coast-age-current" value="30" placeholder="30"
            class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-semibold text-base focus:outline-none focus:ring-2 focus:ring-emerald-500/50" />
        </div>
        <div>
          <label for="coast-age-target" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Target Retirement Age</label>
          <input type="number" id="coast-age-target" value="60" placeholder="60"
            class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-semibold text-base focus:outline-none focus:ring-2 focus:ring-emerald-500/50" />
        </div>
        <div>
          <label for="coast-exp-input" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Annual Expenses in Retirement ($)</label>
          <input type="number" id="coast-exp-input" value="60000" placeholder="60000"
            class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-semibold text-base focus:outline-none focus:ring-2 focus:ring-emerald-500/50" />
        </div>
        <div>
          <label for="coast-invested-input" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Current Invested Net Worth ($)</label>
          <input type="number" id="coast-invested-input" value="150000" placeholder="150000"
            class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-semibold text-base focus:outline-none focus:ring-2 focus:ring-emerald-500/50" />
        </div>
        <div class="md:col-span-2">
          <label for="coast-return-input" class="block text-xs font-bold text-slate-700 dark:text-slate-300 mb-1">Expected Annual Real Return (% after inflation)</label>
          <input type="number" id="coast-return-input" value="7" step="0.5" placeholder="7"
            class="w-full px-4 py-3 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-semibold text-base focus:outline-none focus:ring-2 focus:ring-emerald-500/50" />
        </div>
      </div>

      <button id="coast-calc-btn" class="w-full py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] text-white font-extrabold text-base transition-all tracking-wide shadow-lg shadow-emerald-900/30">
        Calculate My Coast FIRE Number
      </button>

      <!-- Results Display -->
      <div id="coast-result-panel" class="hidden space-y-6 pt-6 border-t border-slate-200 dark:border-slate-800">
        <div class="text-center space-y-2">
          <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">Required Net Worth Today to Coast</p>
          <div id="coast-number-display" class="text-4xl md:text-5xl font-black text-emerald-500 tracking-tight">—</div>
          <p id="coast-status-msg" class="text-sm font-semibold text-slate-700 dark:text-slate-300 max-w-md mx-auto"></p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="p-4 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-center">
            <span class="text-xs text-slate-500 dark:text-slate-400 block font-bold">Full FIRE Goal</span>
            <span id="coast-full-fire" class="text-base font-bold text-slate-900 dark:text-white">$1,500,000</span>
          </div>
          <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 text-center">
            <span class="text-xs text-emerald-600 dark:text-emerald-400 block font-bold">Years of Compounding</span>
            <span id="coast-years" class="text-base font-bold text-emerald-600 dark:text-emerald-400">30 Years</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-center">
            <span class="text-xs text-slate-500 dark:text-slate-400 block font-bold">Gap to Coast Target</span>
            <span id="coast-gap" class="text-base font-bold text-amber-600 dark:text-amber-400">$47,056</span>
          </div>
        </div>

        <!-- Calculator Bridge Grid -->
        <div class="p-5 rounded-2xl bg-emerald-500/10 dark:bg-emerald-950/40 border border-emerald-500/30 space-y-3">
          <p class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider text-center">🔗 Next Steps in Your Wealth Journey</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
            <a href="/fire-net-worth-calculator" class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all text-center group">
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 block">🔥 Full FIRE Calculator</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">4% rule withdrawal plan →</span>
            </a>
            <a href="/wealth-class-calculator" class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all text-center group">
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 block">💎 Am I Rich Calculator</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">US wealth class ranking →</span>
            </a>
            <a href="/net-worth-percentile" class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all text-center group">
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 block">📊 Net Worth Percentile</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">See your population rank →</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Deep-Dive Comprehensive Guide Content (1,500+ Words for SEO Dominance) -->
    <article class="prose dark:prose-invert max-w-none space-y-8 text-slate-700 dark:text-slate-300">
      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">What is Coast FIRE? The Ultimate Freedom of "Stop Saving"</h2>
        <p class="leading-relaxed">
          <strong>Coast FIRE (Financial Independence, Retire Early)</strong> is one of the most liberating personal finance milestones you can achieve. Unlike traditional early retirement strategies that require saving 50% to 70% of your income for decades, Coast FIRE allows you to front-load your investments in your 20s and 30s. Once your portfolio hits your specific <em>Coast FIRE Threshold</em>, compound growth alone takes care of your entire retirement nest egg.
        </p>
        <p class="leading-relaxed">
          The moment you cross your Coast FIRE number, you gain ultimate career flexibility. You no longer need to save a single penny for retirement. You can downgrade to a low-stress job, pivot to passion projects, work part-time, start a business, or travel—as long as your income covers your basic monthly living expenses.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">How the Coast FIRE Mathematical Formula Works</h2>
        <p class="leading-relaxed">
          To calculate your exact Coast FIRE milestone, we utilize a reverse-engineered compound interest growth equation combined with Trinity Study's 4% Safe Withdrawal Rule:
        </p>
        <div class="p-5 rounded-2xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 font-mono text-sm space-y-2 text-slate-900 dark:text-emerald-400">
          <p><strong>Step 1 (Full FIRE Target):</strong> Annual Expenses in Retirement × 25</p>
          <p><strong>Step 2 (Coast FIRE Target):</strong> Full FIRE Target ÷ (1 + r)^t</p>
          <p class="text-xs text-slate-500 dark:text-slate-400 font-sans mt-2">Where <em>r</em> = real annual market return after inflation (typically 7%) and <em>t</em> = compounding years remaining (Target Retirement Age - Current Age).</p>
        </div>
        <p class="leading-relaxed">
          For example, if you estimate requiring $60,000 per year in retirement, your total portfolio goal at age 60 is $1,500,000 ($60,000 × 25). If you are currently 30 years old, you have 30 years of compound growth ahead. Assuming a historical 7% real annual return (gross stock market return minus inflation), your required invested net worth today is:
        </p>
        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800 text-center font-bold text-emerald-700 dark:text-emerald-400">
          $1,500,000 ÷ (1 + 0.07)^30 = $197,056 USD
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Coast FIRE Benchmarks by Age ($1.5M Goal at Age 60)</h2>
        <p class="leading-relaxed">
          The table below demonstrates how starting early dramatically reduces the capital required to achieve Coast FIRE due to exponential compound interest over 15 to 35 years:
        </p>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 my-4">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-900 text-white dark:bg-slate-800">
                <th class="text-left px-4 py-3 font-bold">Current Age</th>
                <th class="text-right px-4 py-3 font-bold">Years of Compounding</th>
                <th class="text-right px-4 py-3 font-bold">Coast FIRE Target Today (7% Real Return)</th>
                <th class="text-right px-4 py-3 font-bold hidden sm:table-cell">Conservative Target (5% Real Return)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 bg-white dark:bg-slate-900">
              <tr>
                <td class="px-4 py-3 font-semibold">Age 25</td>
                <td class="px-4 py-3 text-right">35 Years</td>
                <td class="px-4 py-3 text-right font-bold text-emerald-600 dark:text-emerald-400">$137,848</td>
                <td class="px-4 py-3 text-right text-slate-500 hidden sm:table-cell">$271,922</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold">Age 30</td>
                <td class="px-4 py-3 text-right">30 Years</td>
                <td class="px-4 py-3 text-right font-bold text-emerald-600 dark:text-emerald-400">$197,056</td>
                <td class="px-4 py-3 text-right text-slate-500 hidden sm:table-cell">$347,067</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold">Age 35</td>
                <td class="px-4 py-3 text-right">25 Years</td>
                <td class="px-4 py-3 text-right font-bold text-emerald-600 dark:text-emerald-400">$276,370</td>
                <td class="px-4 py-3 text-right text-slate-500 hidden sm:table-cell">$442,987</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold">Age 40</td>
                <td class="px-4 py-3 text-right">20 Years</td>
                <td class="px-4 py-3 text-right font-bold text-emerald-600 dark:text-emerald-400">$387,605</td>
                <td class="px-4 py-3 text-right text-slate-500 hidden sm:table-cell">$565,341</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold">Age 45</td>
                <td class="px-4 py-3 text-right">15 Years</td>
                <td class="px-4 py-3 text-right font-bold text-emerald-600 dark:text-emerald-400">$543,607</td>
                <td class="px-4 py-3 text-right text-slate-500 hidden sm:table-cell">$721,529</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Comparing FIRE Strategies: Coast vs Barista vs Traditional FIRE</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
            <h3 class="font-bold text-emerald-600 dark:text-emerald-400">🏝️ Coast FIRE</h3>
            <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">Stop retirement contributions completely. Work full-time or freelancing to cover 100% of current living expenses while investments grow undisturbed.</p>
          </div>
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
            <h3 class="font-bold text-blue-600 dark:text-blue-400">☕ Barista FIRE</h3>
            <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">Work part-time (e.g., Starbucks, Costco, local business) to cover health insurance and partial expenses, drawing down small amounts from investments.</p>
          </div>
          <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-2">
            <h3 class="font-bold text-purple-600 dark:text-purple-400">🔥 Full FIRE</h3>
            <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-400">Completely stop working forever. Live off the 4% annual withdrawal rate from a fully funded $1.5M to $5M+ portfolio.</p>
          </div>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Key Action Steps to Execute Coast FIRE in 2026</h2>
        <ol class="list-decimal pl-6 space-y-3 text-sm leading-relaxed">
          <li><strong>Max Out Tax-Advantaged Accounts First:</strong> Allocate capital heavily into employer 401(k) matches, Roth IRAs ($7,000 annual limit in 2026), and HSAs (Health Savings Accounts) to minimize income taxes while front-loading investments.</li>
          <li><strong>Focus on Broad Low-Cost Index Funds:</strong> Invest in total market index funds like VTI (Vanguard Total Stock Market), VOO (Vanguard S&amp;P 500), or VT (Total World Stock) to capture global equity compounding with expense ratios below 0.04%.</li>
          <li><strong>Track Your Net Worth Milestone:</strong> Use our <a href="/net-worth-percentile" class="text-emerald-600 dark:text-emerald-400 font-bold hover:underline">Net Worth Percentile Calculator</a> and <a href="/wealth-class-calculator" class="text-amber-600 dark:text-amber-400 font-bold hover:underline">Am I Rich Calculator</a> to monitor where your assets rank relative to national benchmarks.</li>
          <li><strong>Transition to Your "Coast Job":</strong> Once your invested balance hits the calculator's output, shift to a job focused on work-life balance, passion, or remote location independence, knowing your future retirement is 100% secured.</li>
        </ol>
      </section>
    </article>

    <!-- PAA Section -->
    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">People Also Ask (PAA) — Coast FIRE FAQs</h2>
      {coastFaq.mainEntity.map(faq => (
        <details class="p-5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
          <summary class="text-base font-semibold text-slate-900 dark:text-white flex justify-between items-center list-none">
            <span>{faq.name}</span>
            <span class="text-slate-500 dark:text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-slate-700 dark:text-slate-400 mt-3 text-sm leading-relaxed">{faq.acceptedAnswer.text}</p>
        </details>
      ))}
    </section>

  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const curAgeInput = document.getElementById('coast-age-current');
    const tarAgeInput = document.getElementById('coast-age-target');
    const expInput = document.getElementById('coast-exp-input');
    const invInput = document.getElementById('coast-invested-input');
    const retInput = document.getElementById('coast-return-input');
    const btn = document.getElementById('coast-calc-btn');

    const panel = document.getElementById('coast-result-panel');
    const numDisplay = document.getElementById('coast-number-display');
    const statusMsg = document.getElementById('coast-status-msg');
    const fullFireVal = document.getElementById('coast-full-fire');
    const yearsVal = document.getElementById('coast-years');
    const gapVal = document.getElementById('coast-gap');

    function fmtUSD(n) {
      return '$' + Math.round(n).toLocaleString('en-US');
    }

    btn?.addEventListener('click', () => {
      const cAge = parseFloat(curAgeInput.value) || 30;
      const tAge = parseFloat(tarAgeInput.value) || 60;
      const exp = parseFloat(expInput.value) || 60000;
      const inv = parseFloat(invInput.value) || 0;
      const rate = (parseFloat(retInput.value) || 7) / 100;

      const years = Math.max(1, tAge - cAge);
      const fullFire = exp * 25;
      const coastTarget = fullFire / Math.pow(1 + rate, years);
      const gap = coastTarget - inv;

      numDisplay.textContent = fmtUSD(coastTarget);
      fullFireVal.textContent = fmtUSD(fullFire);
      yearsVal.textContent = `${years} Years`;

      if (gap <= 0) {
        statusMsg.textContent = "🎉 Congratulations! You have ALREADY achieved Coast FIRE! You no longer need to save another dollar for retirement.";
        statusMsg.className = "text-sm font-bold text-emerald-600 dark:text-emerald-400 max-w-md mx-auto";
        gapVal.textContent = "$0 (Target Met)";
      } else {
        statusMsg.textContent = `You need ${fmtUSD(gap)} more in invested net worth today to reach Coast FIRE.`;
        statusMsg.className = "text-sm font-semibold text-slate-700 dark:text-slate-300 max-w-md mx-auto";
        gapVal.textContent = fmtUSD(gap);
      }

      panel.classList.remove('hidden');
      panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
</script>
