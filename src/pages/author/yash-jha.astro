---
import Layout from '../../layouts/Layout.astro';

const title = "Yash Jha — Founder & Lead Financial Analyst | GetNetWorthCalculator";
const description = "Author profile, quantitative research credentials, and editorial methodology of Yash Jha, founder of GetNetWorthCalculator.com.";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Yash Jha",
  "jobTitle": "Founder & Lead Financial Analyst",
  "worksFor": {
    "@type": "Organization",
    "name": "GetNetWorthCalculator",
    "url": "https://getnetworthcalculator.com"
  },
  "url": "https://getnetworthcalculator.com/author/yash-jha",
  "description": "Quantitative financial researcher and software architect specializing in macroeconomic household wealth distributions, Federal Reserve SCF microdata, and financial independence modeling.",
  "knowsAbout": [
    "Household Wealth Distribution",
    "Federal Reserve Survey of Consumer Finances (SCF)",
    "Wealth Percentiles & Gini Coefficients",
    "Financial Independence Retire Early (FIRE) Mathematics",
    "Macroeconomic Asset Valuation",
    "Empirical Financial Modeling"
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <main class="max-w-4xl mx-auto px-6 py-12 md:py-20">
    <!-- Header Card -->
    <div class="p-8 md:p-12 rounded-3xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/60 shadow-xl backdrop-blur-xl space-y-8">
      
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 text-center sm:text-left">
        <!-- Monogram Avatar -->
        <div class="relative shrink-0">
          <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl bg-gradient-to-br from-emerald-500 via-teal-600 to-slate-900 flex items-center justify-center text-white font-black text-4xl shadow-xl border-4 border-emerald-400/30">
            YJ
          </div>
          <div class="absolute -bottom-1 -right-1 w-8 h-8 rounded-full bg-emerald-500 border-2 border-white dark:border-slate-900 flex items-center justify-center text-white text-sm" title="Verified Author">
            ✓
          </div>
        </div>

        <div class="space-y-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-bold">
            <span>🛡️ Verified Author &amp; Data Modeler</span>
          </div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            Yash Jha
          </h1>
          <p class="text-sm md:text-base font-semibold text-emerald-600 dark:text-emerald-400">
            Founder &amp; Lead Quantitative Analyst • GetNetWorthCalculator.com
          </p>
          <p class="text-xs text-slate-500 dark:text-slate-400 max-w-xl">
            Focus: Macroeconomic wealth distribution, central bank microdata analysis, and privacy-first algorithmic financial tools.
          </p>
        </div>
      </div>

      <!-- Bio Overview -->
      <section class="space-y-4 text-slate-700 dark:text-slate-300 text-sm md:text-base leading-relaxed border-t border-slate-200 dark:border-slate-800 pt-6">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Professional Background &amp; Research Focus</h2>
        <p>
          Yash Jha is the founder and lead quantitative modeler at <strong>GetNetWorthCalculator.com</strong>. His work focuses on transforming complex, multi-gigabyte macroeconomic microdata files into interactive, transparent, and lightning-fast financial benchmarking instruments for everyday consumers.
        </p>
        <p>
          Frustrated by mainstream personal finance articles that cite unverified hearsay, sponsored surveys, or heavily skewed mathematical means (where ultra-wealthy outliers distort averages for everyone else), Yash architected GetNetWorthCalculator to champion the <strong>Median (50th percentile)</strong> and exact percentile distributions across all age, income, and geographical cohorts.
        </p>
      </section>

      <!-- Editorial & Data Verification Principles -->
      <section class="space-y-4 border-t border-slate-200 dark:border-slate-800 pt-6">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Our 4 Core Editorial Principles</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200/80 dark:border-slate-800/80 space-y-1.5">
            <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">1. 100% Primary Sources</div>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              We only cite official central bank and statistical agencies: US Federal Reserve SCF, UK ONS, Statistics Canada, ABS Australia, and RBI India. No commercial survey estimates.
            </p>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200/80 dark:border-slate-800/80 space-y-1.5">
            <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">2. Zero Data Harvesting</div>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Your financial inputs never leave your device. All computations execute locally in your client browser memory using static JavaScript.
            </p>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200/80 dark:border-slate-800/80 space-y-1.5">
            <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">3. Median-Centric Rigor</div>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              We present both mean and median net worth, explicitly highlighting why the median provides an honest, actionable benchmark uncorrupted by billionaires.
            </p>
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 dark:bg-slate-950 border border-slate-200/80 dark:border-slate-800/80 space-y-1.5">
            <div class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">4. Independent Editorial Integrity</div>
            <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
              Affiliate book recommendations or financial software mentions never influence benchmark calculations or mathematical percentile curves.
            </p>
          </div>
        </div>
      </section>

      <!-- Published Financial Models & Calculators -->
      <section class="space-y-4 border-t border-slate-200 dark:border-slate-800 pt-6">
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">Calculators &amp; Research Authored by Yash Jha</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <a href="/wealth-class-calculator" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all group">
            <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 block">💎 Wealth Class Calculator (Am I Rich?)</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Classifies net worth into Middle Class, HNW, VHNW, and UHNW tiers.</span>
          </a>
          <a href="/" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all group">
            <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 block">📊 US Net Worth Calculator by Age</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Exact percentile matching against Federal Reserve SCF microdata.</span>
          </a>
          <a href="/prodigious-accumulator-of-wealth-calculator" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all group">
            <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 block">📈 PAW Accumulator Calculator</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Thomas J. Stanley's Millionaire Next Door formula applied to 2026.</span>
          </a>
          <a href="/coast-fire-calculator" class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all group">
            <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-emerald-500 block">🏖️ Coast FIRE Calculator</span>
            <span class="text-xs text-slate-500 dark:text-slate-400">Calculates required retirement principal compound growth milestone.</span>
          </a>
        </div>
      </section>

      <!-- Direct Contact & Editorial Inquiry -->
      <section class="border-t border-slate-200 dark:border-slate-800 pt-6 text-xs text-slate-500 dark:text-slate-400 flex flex-wrap items-center justify-between gap-4">
        <div>
          <span class="font-bold text-slate-800 dark:text-slate-200">Have a data suggestion or correction?</span>
          <p class="mt-0.5">We welcome peer review from economists, researchers, and financial analysts.</p>
        </div>
        <a href="/contact" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-bold hover:border-emerald-500 transition-colors">
          Contact Editorial Team →
        </a>
      </section>

    </div>
  </main>
</Layout>
