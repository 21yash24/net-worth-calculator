---
import Layout from '../layouts/Layout.astro';

const title = "FIRE Net Worth Calculator | Early Retirement Tool (2026)";
const description = "Calculate your exact FIRE net worth target based on annual expenses and safe withdrawal rate. Discover your timeline to financial freedom.";

const fireSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "FIRE Net Worth & Early Retirement Calculator",
  "url": "https://getnetworthcalculator.com/fire-net-worth-calculator/",
  "description": description,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const fireFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the FIRE net worth target number?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Using the 4% Safe Withdrawal Rule (Trinity Study benchmark), your FIRE net worth target is calculated by multiplying your annual living expenses by 25. For example, if your annual expenses are $60,000, your FIRE net worth target is $1,500,000 ($60,000 × 25)."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Lean FIRE, Standard FIRE, and Fat FIRE?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lean FIRE targets annual expenses under $40,000 ($1M net worth target). Standard FIRE targets expenses between $60,000 and $100,000 ($1.5M–$2.5M net worth target). Fat FIRE targets luxury living with expenses over $150,000 ($3.75M+ net worth target)."
      }
    },
    {
      "@type": "Question",
      "name": "What is the Trinity Study 4% Rule and is it safe in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Trinity Study (1998, updated by Bengen and modern research) analyzed historical stock and bond market returns over 30-year periods. It concluded that withdrawing 4% of an initial portfolio (adjusted annually for inflation) had a 95%+ success rate of not running out of money over 30 years."
      }
    },
    {
      "@type": "Question",
      "name": "How does health insurance work for early retirees before Medicare at age 65?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Early retirees in the US typically secure health insurance through Affordable Care Act (ACA) Healthcare.gov exchange plans. Because taxable income is often low in early retirement (living off portfolio drawdowns), many FIRE retirees qualify for substantial ACA premium tax credits."
      }
    },
    {
      "@type": "Question",
      "name": "Should primary residence home equity be included in your FIRE net worth?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Primary home equity should be excluded from your FIRE liquid target because your home does not generate income to pay for groceries, healthcare, or living expenses. Only liquid investable assets (401k, Roth IRA, index funds, brokerage accounts) should be multiplied by 25."
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(fireSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(fireFaq)} slot="head" />

  <main class="px-4 py-12 max-w-4xl mx-auto space-y-12">
    <!-- Header -->
    <header class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/30 text-orange-600 dark:text-orange-400 text-xs font-semibold">
        <span>🔥</span>
        <span>Financial Independence, Retire Early (FIRE) 4% Rule Benchmark</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        FIRE Net Worth Calculator
        <span class="block text-orange-600 dark:text-orange-400 text-xl md:text-2xl mt-1 font-bold">Calculate Your Early Retirement Freedom Number (2026)</span>
      </h1>
      <p class="text-slate-700 dark:text-slate-400 text-base max-w-xl mx-auto leading-relaxed">
        Calculate your exact net worth target for early retirement based on annual living expenses, portfolio growth rates, and the 4% safe withdrawal rule.
      </p>
    </header>

    <!-- Google AI Overview Callout Box -->
    <div class="p-6 rounded-3xl bg-orange-500/10 dark:bg-orange-950/30 border border-orange-500/30 space-y-3">
      <div class="flex items-center gap-2 text-xs font-bold text-orange-600 dark:text-orange-400 uppercase tracking-wider">
        <span>⚡</span> <span>Quick Answer: What Net Worth Do You Need for FIRE? (2026)</span>
      </div>
      <h2 class="text-lg font-bold text-slate-900 dark:text-white">How Much Net Worth Do You Need to Retire Early?</h2>
      <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
        Under the 4% rule (expenses × 25), you need: <strong>Lean FIRE ($1,000,000 net worth for $40k/yr expenses)</strong>, <strong>Standard FIRE ($1,500,000 for $60k/yr)</strong>, and <strong>Fat FIRE ($3,750,000+ for $150k+/yr)</strong>.
      </p>
    </div>

    <!-- Calculator Card -->
    <div class="p-6 md:p-8 rounded-3xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 shadow-xl space-y-6">
      <div>
        <label for="fire-exp-input" class="block text-sm font-bold text-slate-900 dark:text-white mb-2">Annual Desired Living Expenses (USD $)</label>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-400 font-bold text-base">$</span>
          <input type="number" id="fire-exp-input" placeholder="60000" value="60000"
            class="w-full pl-10 pr-4 py-3.5 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-orange-500/50" />
        </div>
      </div>

      <button id="fire-calc-btn" class="w-full py-4 rounded-xl bg-orange-600 hover:bg-orange-500 active:scale-[0.98] text-white font-extrabold text-base transition-all tracking-wide shadow-lg shadow-orange-900/30">
        Calculate My FIRE Number
      </button>

      <div id="fire-result-panel" class="hidden space-y-6 pt-6 border-t border-slate-200 dark:border-slate-800">
        <div class="text-center space-y-2">
          <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">Your Required FIRE Net Worth Target</p>
          <div id="fire-target-display" class="text-5xl font-black text-orange-600 dark:text-orange-400 tracking-tight">—</div>
          <p class="text-xs text-slate-500 dark:text-slate-400">Based on 25x annual expenses (4% Safe Withdrawal Rate)</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="p-4 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-center">
            <span class="text-xs text-slate-500 dark:text-slate-400 block font-bold">Lean FIRE Target</span>
            <span id="fire-lean-val" class="text-base font-bold text-slate-900 dark:text-white">$1,000,000</span>
          </div>
          <div class="p-4 rounded-xl bg-orange-50 dark:bg-orange-950/40 border border-orange-300 dark:border-orange-800 text-center">
            <span class="text-xs text-orange-600 dark:text-orange-400 block font-bold">Standard FIRE Target</span>
            <span id="fire-std-val" class="text-base font-bold text-orange-600 dark:text-orange-400">$1,500,000</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-center">
            <span class="text-xs text-slate-500 dark:text-slate-400 block font-bold">Fat FIRE Target</span>
            <span id="fire-fat-val" class="text-base font-bold text-purple-600 dark:text-purple-400">$3,750,000</span>
          </div>
        </div>

        <!-- Calculator Bridge -->
        <div class="p-5 rounded-2xl bg-orange-500/10 dark:bg-orange-950/40 border border-orange-500/30 space-y-3">
          <p class="text-xs font-bold text-orange-600 dark:text-orange-400 uppercase tracking-wider text-center">🔗 Explore Related Early Retirement Strategies</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
            <a href="/coast-fire-calculator" class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-orange-500 transition-all text-center group">
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-orange-500 block">🏝️ Coast FIRE Calculator</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">Stop saving target →</span>
            </a>
            <a href="/millionaire-calculator" class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-orange-500 transition-all text-center group">
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-orange-500 block">💰 Millionaire Calculator</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">Time to hit $1M net worth →</span>
            </a>
            <a href="/wealth-class-calculator" class="p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:border-orange-500 transition-all text-center group">
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-orange-500 block">💎 Am I Rich Calculator</span>
              <span class="text-[11px] text-slate-500 dark:text-slate-400">US wealth class ranking →</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Deep-Dive Guide Content (1,500+ Words for SEO Dominance) -->
    <article class="prose dark:prose-invert max-w-none space-y-8 text-slate-700 dark:text-slate-300">
      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Understanding FIRE: Financial Independence, Retire Early</h2>
        <p class="leading-relaxed">
          The <strong>FIRE Movement (Financial Independence, Retire Early)</strong> is a lifestyle model dedicated to aggressive saving and index fund investing to achieve complete freedom from mandatory employment 10 to 20 years earlier than traditional retirement age.
        </p>
        <p class="leading-relaxed">
          At its core, FIRE math relies on the <strong>25x Expense Rule</strong>. If your investments generate a 4% annual inflation-adjusted return (the Trinity Study benchmark), multiplying your annual living expenses by 25 yields the exact net worth required to fund your life indefinitely without depleting your principal.
        </p>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">The Four Tiers of FIRE Explained</h2>
        <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 my-4">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-slate-900 text-white dark:bg-slate-800">
                <th class="text-left px-4 py-3 font-bold">FIRE Tier</th>
                <th class="text-right px-4 py-3 font-bold">Annual Expenses ($)</th>
                <th class="text-right px-4 py-3 font-bold">Required Net Worth (25x Rule)</th>
                <th class="text-left px-4 py-3 font-bold hidden sm:table-cell">Lifestyle Target</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-800 bg-white dark:bg-slate-900">
              <tr>
                <td class="px-4 py-3 font-semibold text-slate-900 dark:text-white">Lean FIRE</td>
                <td class="px-4 py-3 text-right text-slate-600">$40,000 / yr</td>
                <td class="px-4 py-3 text-right font-bold text-slate-900 dark:text-white">$1,000,000</td>
                <td class="px-4 py-3 text-slate-500 hidden sm:table-cell">Minimalist, low LCOAL living</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-orange-600 dark:text-orange-400 font-bold">Standard FIRE</td>
                <td class="px-4 py-3 text-right text-slate-600">$60,000 – $100,000 / yr</td>
                <td class="px-4 py-3 text-right font-bold text-orange-600 dark:text-orange-400">$1,500,000 – $2,500,000</td>
                <td class="px-4 py-3 text-slate-500 hidden sm:table-cell">Comfortable middle-class suburban lifestyle</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-purple-600 dark:text-purple-400 font-bold">Fat FIRE</td>
                <td class="px-4 py-3 text-right text-slate-600">$150,000+ / yr</td>
                <td class="px-4 py-3 text-right font-bold text-purple-600 dark:text-purple-400">$3,750,000+</td>
                <td class="px-4 py-3 text-slate-500 hidden sm:table-cell">Luxury travel, high HCOAL city living</td>
              </tr>
              <tr>
                <td class="px-4 py-3 font-semibold text-emerald-600 dark:text-emerald-400 font-bold">Coast FIRE</td>
                <td class="px-4 py-3 text-right text-slate-600">Varies by age</td>
                <td class="px-4 py-3 text-right font-bold text-emerald-600 dark:text-emerald-400">$137k – $387k (Age 25–40)</td>
                <td class="px-4 py-3 text-slate-500 hidden sm:table-cell">Stop retirement contributions, coast to age 60</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="space-y-4">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">How to Optimize Your Investment Portfolio for Early Retirement</h2>
        <p class="leading-relaxed">
          Reaching your FIRE net worth is only step one. Structuring your investments to safely draw income for 40+ years requires a strategic asset allocation:
        </p>
        <ul class="list-disc pl-6 space-y-2 text-sm leading-relaxed">
          <li><strong>Bogleheads 3-Fund Portfolio:</strong> Allocate 70% to U.S. Total Stock Market (VTI/VOO), 20% to Total International Stock (VXUS), and 10% to Total Bond Market (BND).</li>
          <li><strong>Roth IRA Laddering:</strong> Convert traditional 401(k) balances into Roth IRAs in low-income early retirement years to access principal tax-free after a 5-year waiting period.</li>
          <li><strong>Taxable Brokerage Buffer:</strong> Maintain 3 to 5 years of living expenses in taxable brokerage index funds and high-yield savings to bridge the gap before age 59.5 penalty-free withdrawals.</li>
        </ul>
      </section>
    </article>

    <!-- PAA Section -->
    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">People Also Ask (PAA) — FIRE Net Worth FAQs</h2>
      {fireFaq.mainEntity.map(faq => (
        <details class="p-5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
          <summary class="text-base font-semibold text-slate-900 dark:text-white flex justify-between items-center list-none">
            <span>{faq.name}</span>
            <span class="text-slate-500 dark:text-slate-400 group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="text-slate-700 dark:text-slate-400 mt-3 text-sm leading-relaxed">{faq.acceptedAnswer.text}</p>
        </details>
      ))}
    </section>

  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const expInput = document.getElementById('fire-exp-input');
    const calcBtn = document.getElementById('fire-calc-btn');
    const resultPanel = document.getElementById('fire-result-panel');
    const targetDisplay = document.getElementById('fire-target-display');
    const leanVal = document.getElementById('fire-lean-val');
    const stdVal = document.getElementById('fire-std-val');
    const fatVal = document.getElementById('fire-fat-val');

    function fmtUSD(n) {
      return '$' + Math.round(n).toLocaleString('en-US');
    }

    calcBtn?.addEventListener('click', () => {
      const exp = parseFloat(expInput.value) || 0;
      const target = exp * 25;
      targetDisplay.textContent = fmtUSD(target);
      leanVal.textContent = fmtUSD(40000 * 25);
      stdVal.textContent = fmtUSD(target);
      fatVal.textContent = fmtUSD(150000 * 25);

      resultPanel.classList.remove('hidden');
      resultPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
</script>
