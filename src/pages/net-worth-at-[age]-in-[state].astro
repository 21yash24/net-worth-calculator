---
import Layout from '../layouts/Layout.astro';
import states from '../data/statesData.json';

export async function getStaticPaths() {
  const ageBrackets = [
    { id: "under-35", label: "Under 35", ageNum: 30, mult: 0.28, stage: "Career Foundation & Debt Payoff Stage" },
    { id: "35-to-44", label: "Ages 35 to 44", ageNum: 40, mult: 0.85, stage: "Home Equity & Asset Acceleration Stage" },
    { id: "45-to-54", label: "Ages 45 to 54", ageNum: 50, mult: 1.55, stage: "Peak Earning & Compound Expansion Stage" },
    { id: "55-to-64", label: "Ages 55 to 64", ageNum: 60, mult: 2.15, stage: "Pre-Retirement Capital Preservation Stage" },
    { id: "65-to-74", label: "Ages 65 to 74", ageNum: 70, mult: 2.45, stage: "Retirement Distribution & Decumulation Stage" },
    { id: "75-plus", label: "Ages 75 and Older", ageNum: 78, mult: 2.10, stage: "Wealth Preservation & Estate Planning Stage" },
  ];

  const paths = [];
  for (const s of states) {
    for (const a of ageBrackets) {
      paths.push({
        params: { age: a.id, state: s.id },
        props: { stateData: s, ageData: a },
      });
    }
  }
  return paths;
}

const { stateData, ageData } = Astro.props;

const medianNW = Math.round(stateData.median * ageData.mult);
const top25NW = Math.round(stateData.median * ageData.mult * 2.8);
const top10NW = Math.round(stateData.median * ageData.mult * 8);
const top1NW = Math.round(stateData.median * ageData.mult * 32);

const title = `Net Worth ${ageData.label} in ${stateData.name} (2026)`;
const description = `Explore net worth benchmarks for ${ageData.label} in ${stateData.name}. Median household net worth is $${medianNW.toLocaleString()} with top 10% ($${top10NW.toLocaleString()}) percentiles.`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the average net worth for ${ageData.label} in ${stateData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The median net worth for households ${ageData.label} in ${stateData.name} is approximately $${medianNW.toLocaleString()}, compared to national US age benchmarks.`
      }
    },
    {
      "@type": "Question",
      "name": `What net worth puts you in the top 10% for ${ageData.label} in ${stateData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `In ${stateData.name}, a net worth of $${top10NW.toLocaleString()} puts a household in the top 10% for the ${ageData.label} age bracket.`
      }
    },
    {
      "@type": "Question",
      "name": `How does home equity affect net worth in ${stateData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `With median home prices in ${stateData.name} around $${stateData.home.toLocaleString()}, primary residence home equity accounts for 40% to 60% of overall net worth for households in this age cohort.`
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="max-w-4xl mx-auto px-6 py-10 md:py-16">
    
    <!-- Hero Header -->
    <header class="text-center mb-10 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
        <span>📊</span>
        <span>{stateData.name} • {ageData.label} Wealth Analysis (2026)</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Net Worth <span class="text-emerald-600 dark:text-emerald-400">{ageData.label}</span> in {stateData.name}
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-base max-w-xl mx-auto leading-relaxed">
        Comprehensive Federal Reserve and Census economic analysis for households {ageData.label} living in {stateData.name}.
      </p>
    </header>

    <!-- Data Methodology Disclaimer -->
    <div class="mb-10 p-4 rounded-2xl bg-slate-100 dark:bg-slate-900/50 border border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
      <strong class="text-slate-900 dark:text-white font-bold block mb-1">Data Methodology</strong>
      Figures on this page are <em>derived estimates</em>. {stateData.name}'s median household net worth of ${stateData.median.toLocaleString()} (median home ${stateData.home.toLocaleString()}, cost of living {stateData.col > 0 ? `+${stateData.col}%` : `${stateData.col}%`} vs the US average) is scaled to the {ageData.label} age cohort using US Federal Reserve SCF age-wealth ratios. These are approximations for comparison, not an official state statistic. Source: Federal Reserve SCF + US Census.
    </div>

    <!-- Quick Answer Snippet Box -->
    <div class="bg-slate-900 text-white rounded-2xl p-6 md:p-8 mb-12 shadow-xl border border-slate-800 space-y-4">
      <div class="text-xs font-extrabold uppercase tracking-wider text-emerald-400">⚡ Benchmark Summary: {ageData.label} in {stateData.name}</div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center text-xs pt-1">
        <div class="p-3.5 bg-slate-800/80 rounded-xl border border-slate-700">
          <span class="block text-slate-400 text-[10px] uppercase font-bold mb-1">State Median (50th)</span>
          <strong class="text-emerald-400 text-base">${medianNW.toLocaleString()}</strong>
        </div>
        <div class="p-3.5 bg-slate-800/80 rounded-xl border border-slate-700">
          <span class="block text-slate-400 text-[10px] uppercase font-bold mb-1">Top 25% (75th)</span>
          <strong class="text-emerald-400 text-base">${top25NW.toLocaleString()}</strong>
        </div>
        <div class="p-3.5 bg-slate-800/80 rounded-xl border border-slate-700">
          <span class="block text-slate-400 text-[10px] uppercase font-bold mb-1">Top 10% (90th)</span>
          <strong class="text-emerald-400 text-base">${top10NW.toLocaleString()}</strong>
        </div>
        <div class="p-3.5 bg-slate-800/80 rounded-xl border border-slate-700">
          <span class="block text-slate-400 text-[10px] uppercase font-bold mb-1">Top 1% (99th)</span>
          <strong class="text-amber-400 text-base">${top1NW.toLocaleString()}</strong>
        </div>
      </div>
      <p class="text-xs text-slate-400 pt-2 leading-relaxed">
        <em>Note: Figures represent total household net worth (all financial assets + primary residence home equity minus total liabilities) adjusted for {stateData.name}'s economic parameters.</em>
      </p>
    </div>

    <!-- Deep Analytical Content Section 1: Financial Life Stage -->
    <section class="space-y-6 mb-12 text-slate-700 dark:text-slate-300 leading-relaxed text-sm">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Understanding Wealth Building for {ageData.label}</h2>
      
      <p>
        Households in the <strong>{ageData.label}</strong> age bracket in <strong>{stateData.name}</strong> are typically navigating the <em>{ageData.stage}</em>. At this point in life, financial priorities balance active income generation, long-term equity growth (via 401k/IRA investments), and real estate equity accumulation.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">
        <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-2">
          <h3 class="font-bold text-slate-900 dark:text-white text-base">🏡 Real Estate Impact in {stateData.name}</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            With median home values in {stateData.name} at approximately <strong>${stateData.home.toLocaleString()}</strong>, home equity represents a substantial portion of overall wealth. In high cost-of-living environments, homeowners often see higher nominal net worths due to property appreciation.
          </p>
        </div>

        <div class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-2">
          <h3 class="font-bold text-slate-900 dark:text-white text-base">📈 Liquid vs. Total Net Worth</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            While total net worth includes primary home equity, liquid net worth (cash + brokerage + retirement accounts minus debt) determines immediate financial resilience and retirement readiness. Financial advisors recommend keeping at least 40% of net worth liquid.
          </p>
        </div>
      </div>
    </section>

    <!-- Deep Analytical Content Section 2: Wealth Milestones Table -->
    <section class="space-y-6 mb-12">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{stateData.name} Net Worth Breakdown for {ageData.label}</h2>
      
      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <table class="w-full text-sm text-left">
          <thead class="bg-emerald-700 text-white font-bold text-xs uppercase">
            <tr>
              <th class="px-5 py-4">Percentile Rank</th>
              <th class="px-5 py-4">Required Net Worth ({stateData.name})</th>
              <th class="px-5 py-4 text-emerald-200">Financial Classification</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-slate-900/60 divide-y divide-slate-200 dark:divide-slate-800 text-slate-800 dark:text-slate-200">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-5 py-4 font-bold">50th Percentile (Median)</td>
              <td class="px-5 py-4 font-bold text-slate-900 dark:text-white">${medianNW.toLocaleString()}</td>
              <td class="px-5 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400">Typical Middle Class Baseline</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 bg-slate-50/50 dark:bg-slate-900/20">
              <td class="px-5 py-4 font-bold">75th Percentile (Top 25%)</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">${top25NW.toLocaleString()}</td>
              <td class="px-5 py-4 text-xs font-semibold text-emerald-600 dark:text-emerald-400">Upper Middle Class Tier</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
              <td class="px-5 py-4 font-bold">90th Percentile (Top 10%)</td>
              <td class="px-5 py-4 font-bold text-emerald-600 dark:text-emerald-400">${top10NW.toLocaleString()}</td>
              <td class="px-5 py-4 text-xs font-semibold text-emerald-600 dark:text-emerald-400">High Net Worth Tier</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40 bg-slate-50/50 dark:bg-slate-900/20">
              <td class="px-5 py-4 font-bold">99th Percentile (Top 1%)</td>
              <td class="px-5 py-4 font-bold text-amber-500">${top1NW.toLocaleString()}</td>
              <td class="px-5 py-4 text-xs font-semibold text-amber-500">Very High / Elite Wealth Tier</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Interactive CTA to Main Tool -->
    <div class="p-8 rounded-3xl bg-slate-900 text-white text-center space-y-4 shadow-xl border border-slate-800 mb-12">
      <h2 class="text-2xl md:text-3xl font-extrabold">Calculate Your Exact National & State Percentile</h2>
      <p class="text-xs md:text-sm text-slate-300 max-w-xl mx-auto">
        Compare your exact net worth against Federal Reserve age benchmarks with our 100% private, client-side calculator.
      </p>
      <a href="/" class="inline-block px-6 py-3 bg-emerald-500 text-slate-950 font-extrabold text-sm rounded-xl hover:bg-emerald-400 transition-all shadow-md">
        Launch Calculator →
      </a>
    </div>

    <!-- FAQs Section -->
    <section class="space-y-6">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white text-center">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <details class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer group">
          <summary class="font-bold text-slate-900 dark:text-white list-none flex justify-between items-center">
            <span>What is the average net worth for {ageData.label} in {stateData.name}?</span>
            <span class="group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            The median net worth for households {ageData.label} in {stateData.name} is approximately ${medianNW.toLocaleString()}.
          </p>
        </details>

        <details class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer group">
          <summary class="font-bold text-slate-900 dark:text-white list-none flex justify-between items-center">
            <span>What net worth puts you in the top 10% for {ageData.label} in {stateData.name}?</span>
            <span class="group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            In {stateData.name}, a household net worth of ${top10NW.toLocaleString()} puts you in the top 10% for the {ageData.label} age bracket.
          </p>
        </details>
      </div>
    </section>

    <!-- Related Tools & National Benchmark Hubs -->
    <section class="space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">Explore More Wealth Benchmarks</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
        <a href="/wealth-class-calculator" class="p-4 rounded-xl bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all block">
          <strong class="text-slate-900 dark:text-white block font-bold">Am I Rich? Class Calculator</strong>
          <span class="text-slate-500 dark:text-slate-400 mt-1 block">Middle class vs upper middle vs rich thresholds.</span>
        </a>
        <a href="/net-worth-by-income" class="p-4 rounded-xl bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all block">
          <strong class="text-slate-900 dark:text-white block font-bold">Net Worth by Salary & Income</strong>
          <span class="text-slate-500 dark:text-slate-400 mt-1 block">Calculate expected net worth by annual earnings.</span>
        </a>
        <a href="/coast-fire-calculator" class="p-4 rounded-xl bg-slate-100 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 hover:border-emerald-500 transition-all block">
          <strong class="text-slate-900 dark:text-white block font-bold">Coast FIRE Milestone Tool</strong>
          <span class="text-slate-500 dark:text-slate-400 mt-1 block">Check when compounding takes over retirement savings.</span>
        </a>
      </div>
    </section>

  </main>
</Layout>
