---
import Layout from '../layouts/Layout.astro';
import states from '../data/statesData.json';

export async function getStaticPaths() {
  const ageBrackets = [
    { id: "under-35", label: "Under 35", ageNum: 30, mult: 0.28 },
    { id: "35-to-44", label: "Ages 35 to 44", ageNum: 40, mult: 0.85 },
    { id: "45-to-54", label: "Ages 45 to 54", ageNum: 50, mult: 1.55 },
    { id: "55-to-64", label: "Ages 55 to 64", ageNum: 60, mult: 2.15 },
    { id: "65-to-74", label: "Ages 65 to 74", ageNum: 70, mult: 2.45 },
    { id: "75-plus", label: "Ages 75 and Older", ageNum: 78, mult: 2.10 },
  ];

  const paths = [];
  for (const s of states) {
    for (const a of ageBrackets) {
      paths.push({
        params: { age: a.id, state: s.id },
        props: { stateData: s, ageData: a },
      });
    }
  }
  return paths;
}

const { stateData, ageData } = Astro.props;

const title = `Net Worth ${ageData.label} in ${stateData.name} (2026) | Median & Top 10%`;
const description = `What is a good net worth for ${ageData.label} in ${stateData.name}? Median household net worth ($${Math.round(stateData.median * ageData.mult).toLocaleString()}), top 10%, and top 1% percentiles.`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `What is the average net worth for ${ageData.label} in ${stateData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The median net worth for households ${ageData.label} in ${stateData.name} is approximately $${Math.round(stateData.median * ageData.mult).toLocaleString()}.`
      }
    },
    {
      "@type": "Question",
      "name": `What net worth puts you in the top 10% for ${ageData.label} in ${stateData.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `In ${stateData.name}, a net worth of $${Math.round(stateData.median * ageData.mult * 8).toLocaleString()} puts you in the top 10% for the ${ageData.label} age group.`
      }
    }
  ]
};
---

<Layout title={`${title} | Net Worth Calculator`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="max-w-4xl mx-auto px-6 py-10 md:py-16">
    
    <header class="text-center mb-10 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
        <span>📊</span>
        <span>{stateData.name} • {ageData.label} Benchmarks (2026)</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Net Worth <span class="text-emerald-600 dark:text-emerald-400">{ageData.label}</span> in {stateData.name}
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-base max-w-xl mx-auto leading-relaxed">
        Compare your wealth for {ageData.label} living in {stateData.name} using official Federal Reserve and state survey benchmarks.
      </p>
    </header>

    <!-- Quick Answer Box -->
    <div class="bg-slate-900 text-white rounded-2xl p-6 md:p-8 mb-10 shadow-xl border border-slate-800 space-y-3">
      <div class="text-xs font-extrabold uppercase tracking-wider text-emerald-400">⚡ Benchmark Summary: {ageData.label} in {stateData.name}</div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center text-xs pt-1">
        <div class="p-3 bg-slate-800/80 rounded-xl border border-slate-700">
          <span class="block text-slate-400 text-[10px] uppercase font-bold">State Median</span>
          <strong class="text-emerald-400 text-sm">${Math.round(stateData.median * ageData.mult).toLocaleString()}</strong>
        </div>
        <div class="p-3 bg-slate-800/80 rounded-xl border border-slate-700">
          <span class="block text-slate-400 text-[10px] uppercase font-bold">Top 25%</span>
          <strong class="text-emerald-400 text-sm">${Math.round(stateData.median * ageData.mult * 2.8).toLocaleString()}</strong>
        </div>
        <div class="p-3 bg-slate-800/80 rounded-xl border border-slate-700">
          <span class="block text-slate-400 text-[10px] uppercase font-bold">Top 10%</span>
          <strong class="text-emerald-400 text-sm">${Math.round(stateData.median * ageData.mult * 8).toLocaleString()}</strong>
        </div>
        <div class="p-3 bg-slate-800/80 rounded-xl border border-slate-700">
          <span class="block text-slate-400 text-[10px] uppercase font-bold">Top 1%</span>
          <strong class="text-amber-400 text-sm">${Math.round(stateData.median * ageData.mult * 32).toLocaleString()}</strong>
        </div>
      </div>
    </div>

    <!-- CTA to Main Calculator -->
    <div class="p-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-center space-y-3">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">Calculate Your Exact Percentile Rank</h2>
      <p class="text-xs text-slate-600 dark:text-slate-400 max-w-lg mx-auto">
        Input your exact net worth figure into our free client-side calculator to see where you rank in {stateData.name} and across the US.
      </p>
      <a href="/" class="inline-block px-5 py-2.5 rounded-xl bg-emerald-700 text-white font-bold text-xs hover:bg-emerald-600 transition-all shadow-md">
        Launch Net Worth Calculator →
      </a>
    </div>

  </main>
</Layout>
