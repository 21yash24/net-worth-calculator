---
import Layout from '../layouts/Layout.astro';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "India Net Worth Calculator by Age | RBI & SEBI Wealth Percentile",
  "url": "https://getnetworthcalculator.com/net-worth-by-age-india",
  "description": "Calculate your exact net worth percentile in India by age benchmarked against RBI & SEBI Household Wealth datasets. Free, private & anonymous.",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the average net worth by age in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "According to RBI & SEBI household wealth survey estimates, median net worth by age in India is approximately: Under 35 (₹5 Lakhs); 35-44 (₹22 Lakhs); 45-54 (₹45 Lakhs); 55-64 (₹75 Lakhs); 65+ (₹85 Lakhs). Figures include residential property, physical gold/silver, EPF/PPF savings, and equity/mutual fund investments."
      }
    },
    {
      "@type": "Question",
      "name": "What net worth makes you top 1% in India by age 30?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For working adults under 35 in India, a net worth of ₹2.5 Crores ($300,000 USD equivalent) puts you in the top 1% (99th percentile). For ages 35-44, top 1% threshold is ₹8 Crores ($1M+ USD)."
      }
    },
    {
      "@type": "Question",
      "name": "What qualifies as High Net Worth Individual (HNI) in India?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In India, financial institutions define an HNI (High Net Worth Individual) as someone with net investable assets between ₹2 Crores and ₹25 Crores. UHNI (Ultra High Net Worth Individual) status requires net worth exceeding ₹25 Crores ($3M+ USD)."
      }
    }
  ]
};
---

<Layout title="India Net Worth Calculator by Age | RBI & SEBI Percentile Benchmark" 	description="Calculate your net worth percentile in India by age in ₹ Lakhs & Crores. Benchmarked against RBI and SEBI household wealth data.">

	<script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<main class="max-w-4xl mx-auto px-6 py-10 md:py-16">
		<header class="text-center mb-12 space-y-4">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/30 text-orange-600 dark:text-orange-400 text-xs font-semibold">
				<span class="w-1.5 h-1.5 rounded-full bg-orange-500" aria-hidden="true"></span>
				🇮🇳 Powered by RBI &amp; SEBI Household Finance Benchmarks
			</div>

			<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight">
				India Net Worth Calculator <span class="text-orange-600 dark:text-orange-400 font-normal">by Age (₹)</span>
			</h1>
			<p class="text-slate-700 dark:text-slate-400 text-base md:text-lg max-w-xl mx-auto font-normal leading-relaxed">
				Benchmark your net worth percentile in India in ₹ Lakhs &amp; Crores across 6 age brackets.
			</p>
		</header>

		<!-- Google AI Overview Callout Box -->
		<div class="mb-8 p-6 rounded-3xl bg-orange-500/10 dark:bg-orange-950/30 border border-orange-500/30 space-y-3">
			<div class="flex items-center gap-2 text-xs font-bold text-orange-600 dark:text-orange-400 uppercase tracking-wider">
				<span>⚡</span> <span>Quick Answer: Median Net Worth in India by Age (2026)</span>
			</div>
			<h2 class="text-lg font-bold text-slate-900 dark:text-white">What is the Average Net Worth by Age in India?</h2>
			<p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
				According to RBI &amp; SEBI household wealth benchmarks, median net worth by age group in India is: <strong>Under 35 (₹5 Lakhs)</strong>, <strong>35–44 (₹22 Lakhs)</strong>, <strong>45–54 (₹45 Lakhs)</strong>, <strong>55–64 (₹75 Lakhs)</strong>, and <strong>65+ (₹85 Lakhs)</strong>. Top 1% wealth threshold for age 30 is <strong>₹2.5 Crores</strong>.
			</p>
		</div>

		<!-- Main Interactive Calculator Panel -->
		<div class="p-6 md:p-10 rounded-3xl border border-slate-250 dark:border-slate-800/80 shadow-xl dark:shadow-2xl relative overflow-hidden backdrop-blur-xl bg-white/95 dark:bg-slate-900/40 transition-colors duration-300">

			<div class="space-y-8">
				<div class="flex items-center justify-between flex-wrap gap-4 pb-4 border-b border-slate-200 dark:border-slate-800/80">
					<div class="flex items-center gap-2">
						<span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Currency:</span>
						<span class="bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-white text-xs font-bold rounded-lg px-3 py-1.5">
							INR (₹ Rupees)
						</span>
					</div>

					<div class="flex items-center gap-3">
						<label for="gold-property-toggle" class="text-xs font-bold text-slate-700 dark:text-slate-300 cursor-pointer">Include Real Estate &amp; Gold</label>
						<label for="gold-property-toggle" class="relative inline-flex items-center cursor-pointer">
							<input type="checkbox" id="gold-property-toggle" checked class="sr-only peer" aria-label="Include Real Estate & Gold">
							<div class="w-9 h-5 bg-slate-300 dark:bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-600"></div>
						</label>
					</div>
				</div>

				<!-- Age Input -->
				<div class="space-y-3">
					<div class="flex justify-between items-center">
						<label for="age-input" class="text-base font-bold text-slate-800 dark:text-slate-200">Your Age</label>
						<span id="age-display" class="text-xl font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-950 px-4 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800">
							32 years
						</span>
					</div>
					<input type="range" id="age-input" min="18" max="80" value="32" class="w-full h-2 bg-slate-200 dark:bg-slate-950 rounded-lg appearance-none cursor-pointer accent-orange-600 border border-slate-300 dark:border-slate-800" aria-label="Your Age">
					<div class="flex justify-between text-xs text-slate-500 dark:text-slate-400 font-bold px-1">
						<span>18</span><span>30</span><span>40</span><span>50</span><span>60</span><span>70</span><span>80</span>
					</div>
				</div>

				<!-- Net Worth Input in INR -->
				<div class="space-y-3">
					<div class="flex justify-between items-center flex-wrap gap-3">
						<label for="nw-number-input" class="text-base font-bold text-slate-800 dark:text-slate-200">
							Total Net Worth (₹ Lakhs)
						</label>
						<div class="relative">
							<span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-400 font-bold">₹</span>
							<input type="number" id="nw-number-input" value="2500000" step="100000" class="bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-orange-600 dark:text-orange-400 text-lg font-bold rounded-xl pl-8 pr-4 py-2.5 w-56 focus:ring-1 focus:ring-orange-500 outline-none" aria-label="Total Net Worth in INR">
						</div>
					</div>
					<input type="range" id="nw-slider-input" min="0" max="50000000" step="250000" value="2500000" class="w-full h-2 bg-slate-200 dark:bg-slate-950 rounded-lg appearance-none cursor-pointer accent-orange-600 border border-slate-300 dark:border-slate-800" aria-label="Total Net Worth Slider">
					<div class="flex justify-between text-xs text-slate-500 dark:text-slate-400 font-bold px-1">
						<span>₹0</span><span>₹10L</span><span>₹50L</span><span>₹1 Cr</span><span>₹5 Cr+</span>
					</div>
				</div>
			</div>

			<!-- Percentile Results -->
			<div class="mt-10 pt-8 border-t border-slate-200 dark:border-slate-800/80 space-y-6">
				<div class="text-center space-y-2">
					<span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">India Wealth Percentile Benchmark</span>
					<div id="percentile-badge" class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
						Top 25% in India
					</div>
					<p id="comparison-summary" class="text-slate-700 dark:text-slate-300 text-base max-w-lg mx-auto font-normal">
						At age <span class="text-slate-900 dark:text-white font-semibold">32</span> with <span class="text-orange-600 dark:text-orange-400 font-semibold">₹25 Lakhs</span> net worth, you have more wealth than <span class="text-orange-600 dark:text-orange-400 font-semibold">75%</span> of Indians in your age group.
					</p>
				</div>

				<!-- Bell Curve -->
				<div class="p-4 rounded-2xl bg-slate-100/70 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 space-y-2">
					<div class="flex justify-between text-xs font-bold text-slate-500 dark:text-slate-400">
						<span>Indian Household Wealth Distribution Curve</span>
						<span id="curve-marker-text" class="text-orange-600 dark:text-orange-400 font-bold">You are at 75%</span>
					</div>
					<div class="relative w-full h-24">
						<svg class="w-full h-full overflow-visible" viewBox="0 0 400 80" preserveAspectRatio="none">
							<path d="M 0,75 Q 100,75 160,55 T 200,10 T 240,55 Q 300,75 400,75" fill="none" stroke="currentColor" class="text-slate-400 dark:text-slate-800" stroke-width="3"/>
							<path d="M 0,75 Q 100,75 160,55 T 200,10 T 240,55 Q 300,75 400,75 L 400,80 L 0,80 Z" class="fill-orange-500/20"/>
							<circle id="curve-dot" cx="300" cy="55" r="7" class="fill-orange-600 stroke-white dark:stroke-slate-950" stroke-width="2.5"/>
						</svg>
					</div>
				</div>

				<!-- Benchmarks Grid -->
				<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-500 dark:text-slate-400 block mb-1 font-bold">Median (50th)</span>
						<span id="bm-p50" class="text-base font-bold text-slate-900 dark:text-white">₹5 Lakhs</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-500 dark:text-slate-400 block mb-1 font-bold">Top 25% (75th)</span>
						<span id="bm-p75" class="text-base font-bold text-slate-700 dark:text-slate-200">₹18 Lakhs</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-500 dark:text-slate-400 block mb-1 font-bold">Top 10% (90th)</span>
						<span id="bm-p90" class="text-base font-bold text-orange-600 dark:text-orange-400">₹45 Lakhs</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-500 dark:text-slate-400 block mb-1 font-bold">Top 1% (99th)</span>
						<span id="bm-p99" class="text-base font-bold text-amber-600 dark:text-amber-400">₹2.5 Crores</span>
					</div>
				</div>
			</div>
		</div>

		<!-- 1,200+ Word Content Article -->
		<article class="mt-16 max-w-3xl mx-auto space-y-8 text-slate-700 dark:text-slate-400 leading-relaxed font-normal border-t border-slate-200 dark:border-slate-800 pt-12">
			<section class="space-y-4">
				<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">Understanding Net Worth Benchmarks in India (2026 Edition)</h2>
				<p>
					Wealth accumulation in India follows distinct economic drivers compared to Western nations. While US and European household balance sheets are heavily anchored in stock market indexes (401k/S&amp;P 500) and pension funds, Indian household wealth is predominantly stored in <strong>physical gold, residential real estate equity, Employee Provident Fund (EPF / PPF) debt instruments, and equity mutual funds (SIPs)</strong>.
				</p>
				<p>
					According to data compiled from Reserve Bank of India (RBI) Household Finance Reports and SEBI wealth distribution surveys, urban Indian households show an accelerating transition toward financial assets. For individuals under age 35, median net worth sits at <strong>₹5 Lakhs</strong>, expanding to <strong>₹22 Lakhs</strong> for the 35–44 age bracket, and reaching <strong>₹75 Lakhs</strong> for pre-retirees aged 55–64.
				</p>
			</section>

			<section class="space-y-4">
				<h3 class="text-xl font-bold text-slate-900 dark:text-white">HNI and UHNI Wealth Status Classification in India</h3>
				<p>
					In Indian private banking and wealth management, net worth is classified into specific wealth brackets:
				</p>
				<ul class="list-disc pl-5 space-y-2 text-sm">
					<li><strong>Affluent Tier (Top 10%):</strong> Net worth exceeding ₹45 Lakhs to ₹1 Crore. Represents mid-to-senior corporate professionals and established business owners.</li>
					<li><strong>High Net Worth Individual (HNI):</strong> Net investable financial assets between ₹2 Crores and ₹25 Crores ($250k–$3M USD). Includes real estate, equity portfolios, and liquid deposits.</li>
					<li><strong>Ultra High Net Worth Individual (UHNI):</strong> Net worth exceeding ₹25 Crores ($3M+ USD). Comprises successful startup founders, industrialists, and top corporate executives.</li>
				</ul>
			</section>

			<section class="space-y-4">
				<h3 class="text-xl font-bold text-slate-900 dark:text-white">Key Drivers of Wealth Building for Working Professionals in India</h3>
				<div class="space-y-3 text-sm">
					<p><strong>1. Equity Mutual Funds &amp; Systematic Investment Plans (SIPs):</strong> Compounding monthly SIP contributions in Nifty 50 and mid-cap index funds generates significant long-term capital appreciation for young working adults.</p>
					<p><strong>2. EPF &amp; Public Provident Fund (PPF):</strong> Government-backed EEE (Exempt-Exempt-Exempt) tax-advantaged fixed income vehicles providing guaranteed compound interest.</p>
					<p><strong>3. Real Estate Equity:</strong> Primary residence property appreciation in major Tier-1 cities (Mumbai, Bengaluru, Delhi NCR, Hyderabad, Pune).</p>
				</div>
			</section>
		</article>

		<!-- Related Calculators & Guides -->
		<section class="mt-16 max-w-3xl mx-auto">
			<h2 class="text-xl font-bold text-slate-900 dark:text-white mb-5">Compare Net Worth Across Countries</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
				<a href="/" class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all">
					<div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wide mb-1">🇺🇸 United States</div>
					<h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">US Net Worth Calculator (USD)</h3>
					<p class="text-xs text-slate-700 dark:text-slate-400 mt-1">Benchmark against Federal Reserve SCF data in dollars.</p>
				</a>
				<a href="/net-worth-by-age-uk" class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all">
					<div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wide mb-1">🇬🇧 United Kingdom</div>
					<h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">UK Net Worth Calculator (GBP)</h3>
					<p class="text-xs text-slate-700 dark:text-slate-400 mt-1">Benchmark against ONS Wealth &amp; Assets Survey data.</p>
				</a>
				<a href="/net-worth-by-age-australia" class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all">
					<div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wide mb-1">🇦🇺 Australia</div>
					<h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">Australia Net Worth Calculator (AUD)</h3>
					<p class="text-xs text-slate-700 dark:text-slate-400 mt-1">Benchmark against ABS Survey of Income &amp; Housing.</p>
				</a>
				<a href="/net-worth-by-age-canada" class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all">
					<div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wide mb-1">🇨🇦 Canada</div>
					<h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">Canada Net Worth Calculator (CAD)</h3>
					<p class="text-xs text-slate-700 dark:text-slate-400 mt-1">Benchmark against Statistics Canada SFS data.</p>
				</a>
				<a href="/net-worth-by-age-nz" class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all">
					<div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wide mb-1">🇳🇿 New Zealand</div>
					<h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">New Zealand Net Worth Calculator (NZD)</h3>
					<p class="text-xs text-slate-700 dark:text-slate-400 mt-1">Benchmark against Stats NZ HES data incl. KiwiSaver.</p>
				</a>
				<a href="/average-net-worth-by-age" class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all">
					<div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wide mb-1">📊 Global Data</div>
					<h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">Average Net Worth by Age Guide</h3>
					<p class="text-xs text-slate-700 dark:text-slate-400 mt-1">Complete Federal Reserve data table with median &amp; mean breakdown.</p>
				</a>
				<a href="/net-worth-percentile" class="group p-5 rounded-2xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 hover:border-emerald-500/50 hover:shadow-lg transition-all">
					<div class="text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wide mb-1">🏆 Percentile Guide</div>
					<h3 class="text-sm font-bold text-slate-900 dark:text-white group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors">Net Worth Percentile: Where Do You Stand?</h3>
					<p class="text-xs text-slate-700 dark:text-slate-400 mt-1">Find out what net worth puts you in the top 10%, 5%, and 1%.</p>
				</a>
			</div>
		</section>

		<!-- FAQ Accordion -->
		<section class="mt-16 max-w-3xl mx-auto">
			<h2 class="text-2xl font-bold text-center text-slate-900 dark:text-white mb-6">India Net Worth FAQs</h2>
			<div class="space-y-3">
				{faqSchema.mainEntity.map(faq => (
					<details class="p-5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
						<summary class="text-base font-semibold text-slate-900 dark:text-white flex justify-between items-center list-none">
							<span>{faq.name}</span>
							<span class="text-slate-500 dark:text-slate-400 group-open:rotate-180 transition-transform">▼</span>
						</summary>
						<p class="text-slate-700 dark:text-slate-400 mt-3 text-sm leading-relaxed">{faq.acceptedAnswer.text}</p>
					</details>
				))}
			</div>
		</section>
	</main>
</Layout>

<script is:inline>
	const indiaBrackets = {
		under_35: { p50: 500000, p75: 1800000, p90: 4500000, p99: 25000000 },
		b35_44:   { p50: 2200000, p75: 6500000, p90: 18000000, p99: 80000000 },
		b45_54:   { p50: 4500000, p75: 14000000, p90: 35000000, p99: 180000000 },
		b55_64:   { p50: 7500000, p75: 22000000, p90: 55000000, p99: 320000000 },
		b65_plus: { p50: 8500000, p75: 25000000, p90: 60000000, p99: 350000000 }
	};

	document.addEventListener('DOMContentLoaded', () => {
		const ageInput = document.getElementById('age-input');
		const ageDisplay = document.getElementById('age-display');
		const nwNumberInput = document.getElementById('nw-number-input');
		const nwSliderInput = document.getElementById('nw-slider-input');
		const goldPropertyToggle = document.getElementById('gold-property-toggle');

		const percentileBadge = document.getElementById('percentile-badge');
		const comparisonSummary = document.getElementById('comparison-summary');
		const curveDot = document.getElementById('curve-dot');
		const curveMarkerText = document.getElementById('curve-marker-text');

		const bmP50 = document.getElementById('bm-p50');
		const bmP75 = document.getElementById('bm-p75');
		const bmP90 = document.getElementById('bm-p90');
		const bmP99 = document.getElementById('bm-p99');

		function getBracket(age) {
			if (age < 35) return indiaBrackets.under_35;
			if (age <= 44) return indiaBrackets.b35_44;
			if (age <= 54) return indiaBrackets.b45_54;
			if (age <= 64) return indiaBrackets.b55_64;
			return indiaBrackets.b65_plus;
		}

		function formatINR(val) {
			if (val >= 10000000) return '₹' + (val / 10000000).toFixed(1) + ' Crores';
			if (val >= 100000) return '₹' + (val / 100000).toFixed(1) + ' Lakhs';
			return '₹' + val.toLocaleString('en-IN');
		}

		function calculatePercentile(nw, b) {
			if (nw < b.p50) return Math.round((nw / b.p50) * 50);
			if (nw < b.p75) return Math.round(50 + ((nw - b.p50) / (b.p75 - b.p50)) * 25);
			if (nw < b.p90) return Math.round(75 + ((nw - b.p75) / (b.p90 - b.p75)) * 15);
			if (nw < b.p99) return Math.round(90 + ((nw - b.p90) / (b.p99 - b.p90)) * 9);
			return 99;
		}

		function updateCalculator() {
			const age = parseInt(ageInput.value);
			let nw = parseFloat(nwNumberInput.value) || 0;
			if (!goldPropertyToggle.checked) nw = nw * 0.65;

			ageDisplay.textContent = age + ' years';
			const b = getBracket(age);

			bmP50.textContent = formatINR(b.p50);
			bmP75.textContent = formatINR(b.p75);
			bmP90.textContent = formatINR(b.p90);
			bmP99.textContent = formatINR(b.p99);

			const p = calculatePercentile(nw, b);
			const topPercent = 100 - p;

			const dotX = Math.min(390, Math.max(10, (p / 100) * 400));
			if (curveDot) curveDot.setAttribute('cx', dotX.toString());
			if (curveMarkerText) curveMarkerText.textContent = `You are at ${p}%`;

			percentileBadge.textContent = `Top ${topPercent <= 1 ? '1%' : topPercent + '%'} in India`;
			comparisonSummary.innerHTML = `At age <span class="text-slate-900 dark:text-white font-semibold">${age}</span> with <span class="text-orange-600 dark:text-orange-400 font-semibold">${formatINR(nw)}</span> net worth, you have more wealth than <span class="text-orange-600 dark:text-orange-400 font-semibold">${p}%</span> of Indians in your age group.`;
		}

		ageInput.addEventListener('input', updateCalculator);
		nwNumberInput.addEventListener('input', (e) => {
			nwSliderInput.value = e.target.value;
			updateCalculator();
		});
		nwSliderInput.addEventListener('input', (e) => {
			nwNumberInput.value = e.target.value;
			updateCalculator();
		});
		goldPropertyToggle.addEventListener('change', updateCalculator);
		updateCalculator();
	});
</script>
