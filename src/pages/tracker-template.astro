          </div>
        </div>
      </div>
    </section>

    <!-- Visual Interactive Tab Showcase (SEE EXACTLY WHAT YOU ARE GETTING) -->
    <section class="space-y-6">
      <div class="text-center space-y-2 max-w-2xl mx-auto">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-xs font-bold uppercase tracking-wider">
          <span>👀 Interactive Preview</span>
        </div>
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Look Inside The Spreadsheet
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          Click through the interactive tabs below to see how clean, visual, and simple each screen is designed.
        </p>
      </div>

      <!-- Interactive Tab Buttons -->
      <div class="flex items-center justify-center flex-wrap gap-2 pt-2" id="preview-tab-buttons">
        <button data-tab="tab-quick" class="tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-emerald-600 text-white shadow-md">
          ⚡ 2-Min Check-In
        </button>
        <button data-tab="tab-dashboard" class="tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300">
          📊 Bloomberg Dashboard
        </button>
        <button data-tab="tab-budget" class="tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300">
          💸 Guilt-Free Budget
        </button>
        <button data-tab="tab-sinking" class="tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300">
          🎯 Sinking Funds Shield
        </button>
        <button data-tab="tab-fire" class="tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300">
          🔥 FIRE Freedom Clock
        </button>
        <button data-tab="tab-paw" class="tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300">
          🏆 PAW Wealth Class
        </button>
        <button data-tab="tab-state" class="tab-btn px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-300">
          📍 50 States Index
