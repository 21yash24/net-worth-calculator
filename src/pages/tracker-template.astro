            </div>
          </div>
        </div>

        <!-- Tab 4: Sinking Funds Mockup -->
        <div id="mock-tab-sinking" class="tab-panel space-y-3 hidden">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <div>
              <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block">Tab 4: Irregular Expense Defense</span>
