            🔒 100% Client-Side • Nothing Leaves Your Phone
          </span>
        </div>

        <!-- Simulator Grid: Left Inputs / Right Real-Time Output -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <!-- Left: 4 Quick Inputs -->
          <div class="lg:col-span-6 space-y-3.5 bg-slate-950/80 p-5 rounded-2xl border border-slate-800">
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block">1. Fill Your 4 Monthly Numbers (Green Cells)</span>
            
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="text-[11px] font-bold text-slate-400 block mb-1">Your Age Group</label>
                <select id="sim-age" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs font-bold text-white focus:outline-none focus:border-emerald-500">
                  <option value="under35" selected>Under 35</option>
                  <option value="35to44">35 - 44</option>
                  <option value="45to54">45 - 54</option>
                  <option value="55to64">55 - 64</option>
                  <option value="65to74">65 - 74</option>
                </select>
              </div>

              <div>
                <label class="text-[11px] font-bold text-slate-400 block mb-1">💵 Cash &amp; Savings</label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-xs text-slate-400">$</span>
                  <input type="number" id="sim-cash" value="25000" class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-7 pr-3 py-2 text-xs font-bold text-white focus:outline-none focus:border-emerald-500" />
                </div>
              </div>

              <div>
                <label class="text-[11px] font-bold text-slate-400 block mb-1">📈 Invested Portfolio</label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-xs text-slate-400">$</span>
                  <input type="number" id="sim-invest" value="185000" class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-7 pr-3 py-2 text-xs font-bold text-white focus:outline-none focus:border-emerald-500" />
                </div>
              </div>

              <div>
                <label class="text-[11px] font-bold text-slate-400 block mb-1">🏠 Property / Assets</label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-xs text-slate-400">$</span>
                  <input type="number" id="sim-prop" value="350000" class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-7 pr-3 py-2 text-xs font-bold text-white focus:outline-none focus:border-emerald-500" />
                </div>
              </div>

              <div>
                <label class="text-[11px] font-bold text-slate-400 block mb-1">💳 Total Debts</label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-xs text-slate-400">$</span>
                  <input type="number" id="sim-debt" value="245000" class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-7 pr-3 py-2 text-xs font-bold text-white focus:outline-none focus:border-emerald-500" />
                </div>
              </div>

              <div>
                <label class="text-[11px] font-bold text-slate-400 block mb-1">📥 Monthly Take-Home</label>
                <div class="relative">
                  <span class="absolute left-3 top-2 text-xs text-slate-400">$</span>
                  <input type="number" id="sim-income" value="6500" class="w-full bg-slate-900 border border-slate-700 rounded-xl pl-7 pr-3 py-2 text-xs font-bold text-white focus:outline-none focus:border-emerald-500" />
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Real-Time Calculated Dashboard Output (Signature Website Engine) -->
          <div class="lg:col-span-6 space-y-3">
            <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block">2. Real-Time Master Vault Calculation Engine</span>
            
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
              <!-- Card 1: Total Net Worth -->
              <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 space-y-0.5">
                <span class="text-[9px] text-slate-400 uppercase font-bold block">TOTAL NET WORTH</span>
                <span id="sim-out-nw" class="text-xl sm:text-2xl font-black text-white">$315,000</span>
                <span class="text-[9px] text-emerald-400 block font-bold">▲ All Assets - Debt</span>
              </div>

              <!-- Card 2: Liquid Net Worth -->
              <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 space-y-0.5">
                <span class="text-[9px] text-slate-400 uppercase font-bold block">💧 LIQUID NET WORTH</span>
                <span id="sim-out-liq" class="text-xl sm:text-2xl font-black text-emerald-400">$210,000</span>
                <span id="sim-out-liq-ratio" class="text-[9px] text-slate-300 block">66.7% Liquid Assets</span>
              </div>

              <!-- Card 3: Stanley & Danko PAW Class -->
              <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 space-y-0.5">
                <span class="text-[9px] text-slate-400 uppercase font-bold block">STANLEY &amp; DANKO CLASS</span>
                <span id="sim-out-paw" class="text-sm sm:text-base font-black text-amber-400">🏆 PAW (Top 10%)</span>
                <span id="sim-out-paw-mul" class="text-[9px] text-slate-300 block">2.92x Multiplier</span>
              </div>

              <!-- Card 4: Fed SCF Benchmark -->
              <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 space-y-0.5">
                <span class="text-[9px] text-slate-400 uppercase font-bold block">FED SCF BENCHMARK</span>
                <span id="sim-out-fed" class="text-xl sm:text-2xl font-black text-amber-400">Top 12%</span>
                <span class="text-[9px] text-slate-400 block">US Central Bank Microdata</span>
              </div>

              <!-- Card 5: Daily Safe-to-Spend -->
              <div class="p-3 rounded-xl bg-purple-950/40 border border-purple-500/30 space-y-0.5">
                <span class="text-[9px] text-purple-300 uppercase font-bold block">DAILY SAFE-TO-SPEND</span>
                <span id="sim-out-spend" class="text-xl sm:text-2xl font-black text-purple-300">$65 / day</span>
                <span class="text-[9px] text-slate-300 block">30% Guilt-Free Buffer</span>
              </div>

              <!-- Card 6: Coast FIRE Status -->
              <div class="p-3 rounded-xl bg-emerald-950/40 border border-emerald-500/30 space-y-0.5">
                <span class="text-[9px] text-emerald-300 uppercase font-bold block">COAST FIRE STATUS</span>
                <span id="sim-out-fire" class="text-sm sm:text-base font-black text-emerald-300">✅ ACHIEVED</span>
                <span class="text-[9px] text-slate-300 block">Compounds by age 60</span>
              </div>
            </div>

            <div class="pt-2">
              <a 
                href={buyUrl} 
                download={!isLiveCheckout ? "NetWorth_FIRE_Master_Vault_2026.xlsx" : undefined}
                target={isLiveCheckout ? "_blank" : undefined}
                rel={isLiveCheckout ? "noopener noreferrer" : undefined}
                class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-5 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-extrabold text-sm transition-all shadow-lg active:scale-95"
