---
import Layout from '../layouts/Layout.astro';
import product from '../data/product.json';
import AuthorBio from '../components/AuthorBio.astro';
import TrustBadge from '../components/TrustBadge.astro';

const title = "The Ultimate Net Worth & Smart Budget Vault (2026) | Google Sheets & Excel";
const description = "Download the all-in-one private wealth and 50/30/20 budget dashboard. 2-minute monthly check-in, Federal Reserve percentile formulas, and Coast FIRE countdown for $3 early access ($6 regular).";

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": product.tagline,
  "offers": {
    "@type": "Offer",
    "price": "3.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://getnetworthcalculator.com/tracker-template"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.96",
    "reviewCount": "184"
  }
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <main class="max-w-5xl mx-auto px-4 py-12 md:py-20 space-y-20">

    <!-- Hero Section -->
    <header class="text-center space-y-5 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-black uppercase tracking-wider">
        <span>⭐ All-In-One Personal Finance System</span>
        <span>•</span>
        <span class="text-amber-600 dark:text-amber-400 font-extrabold">{product.earlyBirdLimit}: {product.earlyBirdPrice}</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        The Ultimate Net Worth &amp; <span class="text-emerald-600 dark:text-emerald-400">Smart Budget Vault</span>
      </h1>

      <p class="text-base sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        Most people quit budgeting spreadsheets because typing 40 receipts feels like homework. The <strong>Master Vault</strong> simplifies wealth tracking to a <strong>2-minute monthly check-in</strong>, calculates your <strong>daily guilt-free spending allowance</strong>, and connects your savings directly to your early retirement countdown.
      </p>

      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-slate-500 dark:text-slate-400 pt-2">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Google Sheets 1-Click Copy
        </span>
        <span>•</span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Microsoft Excel (.xlsx) Included
        </span>
        <span>•</span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          100% Offline &amp; Private (Zero Bank Logins)
        </span>
      </div>
    </header>

    <!-- Pricing Action Card (Anchored Above the Fold) -->
    <div class="max-w-3xl mx-auto rounded-3xl border-2 border-emerald-500/50 bg-gradient-to-br from-white via-slate-50 to-emerald-50/40 dark:from-slate-900 dark:via-slate-950 dark:to-emerald-950/40 p-6 sm:p-10 shadow-2xl text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-700 dark:text-amber-300 text-xs font-bold">
        <span>⚡ Early Access Community Tier: {product.earlyBirdLimit}</span>
      </div>

      <div class="space-y-2">
        <div class="flex items-baseline justify-center gap-3">
          <span class="text-5xl sm:text-6xl font-black text-slate-900 dark:text-white tracking-tight">{product.earlyBirdPrice}</span>
          <span class="text-xl text-slate-500 dark:text-slate-400 font-semibold">regular {product.price}</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium">
          One-time payment • Lifetime personal use • Zero monthly subscriptions
        </p>
      </div>

      <!-- Instant Checkout CTA -->
      <div class="max-w-md mx-auto space-y-3">
        <a 
          href="/downloads/NetWorth_FIRE_Master_Vault_2026.xlsx" 
          download="NetWorth_FIRE_Master_Vault_2026.xlsx"
          class="w-full inline-flex items-center justify-center gap-3 py-4 px-8 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 active:scale-[0.98] text-white font-extrabold text-base sm:text-lg transition-all shadow-xl shadow-emerald-900/40"
        >
          <span>Download Master Vault (.xlsx)</span>
          <span class="text-xl">📥</span>
        </a>

        <div class="flex items-center justify-center gap-4 text-xs text-slate-500 dark:text-slate-400 font-medium">
          <span class="flex items-center gap-1">🔒 Instant Download</span>
          <span>•</span>
          <span class="flex items-center gap-1">Works in Google Sheets, Excel &amp; Numbers</span>
        </div>
      </div>
    </div>

    <!-- What Makes This Different: The 3 Core Pillars -->
    <section class="space-y-6">
      <div class="text-center space-y-2 max-w-2xl mx-auto">
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Built For Real Humans, Not Full-Time CPAs
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          We analyzed hundreds of Reddit complaints and Etsy reviews. The consensus was clear: traditional budgeting templates fail because they demand too much time. Here is how we fixed it.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl font-black">
            ⚡
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">1. The 2-Minute Rule</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Stop typing every coffee and receipt. On the 1st of each month, you enter just <strong>4 numbers</strong> (Cash, Invested, Property, Debts). In under 120 seconds, your entire net worth and monthly progress update automatically.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center text-xl font-black">
            💸
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">2. Guilt-Free Spending Buffer</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Answers the only question that matters: <em>"How much can I spend today without derailing my goals?"</em> The 50/30/20 engine automatically computes your daily and monthly safe spending allowance.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl font-black">
            🎯
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">3. Sinking Funds Shield</h3>
          <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
            Unexpected car repairs, medical copays, and holiday gifts blow up standard budgets. Dedicated sinking funds pools calculate monthly contributions so irregular expenses never shock your savings.
          </p>
        </div>
      </div>
    </section>

    <!-- Product Tour: The 7 Institutional Tabs Inside -->
    <section class="space-y-10">
      <div class="text-center space-y-2 max-w-2xl mx-auto">
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          What's Inside The Master Vault
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Everything you need for complete wealth clarity, organized cleanly across 7 focused tabs with zero formula-breaking risks.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Tab 1 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 shadow-sm space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-black text-sm">01</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">⚡ 2-Minute Monthly Quick Check-In</h3>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            The anti-fatigue tab. 4 inputs per month. Automatically computes your month-over-month dollar gains, percentage portfolio growth, and annual savings trajectory.
          </p>
        </div>

        <!-- Tab 2 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 shadow-sm space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-black text-sm">02</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">📊 Executive Wealth Dashboard</h3>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Institutional Bloomberg terminal dark aesthetics. Live cards for Total Net Worth, Liquid Portfolio Ratio, quarterly milestone progressions, and retirement readiness.
          </p>
        </div>

        <!-- Tab 3 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 shadow-sm space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-xl bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center font-black text-sm">03</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">💸 Smart 50/30/20 Cash Flow Engine</h3>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Calculates your exact income allocation across Essential Needs (50%), Guilt-Free Wants (30%), and Wealth Surplus (20%+). Includes live daily spending allowance.
          </p>
        </div>

        <!-- Tab 4 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 shadow-sm space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-black text-sm">04</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">🎯 Sinking Funds &amp; Expense Shield</h3>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Set target dates and savings goals for emergency runways, car maintenance, vacations, and annual insurance renewals. Automatically computes exact monthly contributions.
          </p>
        </div>

        <!-- Tab 5 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 shadow-sm space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-black text-sm">05</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">🔥 FIRE Freedom &amp; Retirement Engine</h3>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Trinity Study 4% rule calculator. Instantly computes Lean FIRE, Standard FIRE, Fat FIRE, and Coast FIRE targets with a dynamic freedom countdown in months and years.
          </p>
        </div>

        <!-- Tab 6 -->
        <div class="p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/40 shadow-sm space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-9 h-9 rounded-xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center font-black text-sm">06</span>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">💳 Debt Avalanche &amp; Snowball</h3>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Side-by-side priority ranking for credit cards, personal loans, auto debt, and mortgages. Compares mathematical interest savings against psychological momentum.
          </p>
        </div>
      </div>
    </section>

    <!-- Comparison Table: Master Vault vs Overpriced Competitors -->
    <section class="space-y-6">
      <div class="text-center space-y-2 max-w-2xl mx-auto">
        <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          How Does It Compare?
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400">
          Why pay $80 to $100 per year for complicated apps when you can own your data privately forever?
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
        <table class="w-full text-xs text-left">
          <thead class="bg-slate-100 dark:bg-slate-900/80 text-slate-700 dark:text-slate-300 border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th class="p-4 font-bold">Feature</th>
              <th class="p-4 font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-500/10">Master Vault</th>
              <th class="p-4 font-bold">Tiller Money</th>
              <th class="p-4 font-bold">Typical Etsy Templates</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 font-medium">
            <tr>
              <td class="p-4 font-semibold text-slate-900 dark:text-white">Pricing Model</td>
              <td class="p-4 text-emerald-600 dark:text-emerald-400 font-black bg-emerald-500/10">$3 Early Access ($6 regular)</td>
              <td class="p-4 text-slate-500">$79 / year recurring</td>
              <td class="p-4 text-slate-500">$15 – $35 one-time</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-slate-900 dark:text-white">Time Required</td>
              <td class="p-4 text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-500/10">⚡ 2 min / month</td>
              <td class="p-4 text-slate-500">Auto-sync (frequent reconnects)</td>
              <td class="p-4 text-slate-500">20-40 min (manual receipt log)</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-slate-900 dark:text-white">Privacy &amp; Credentials</td>
              <td class="p-4 text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-500/10">100% Offline (No bank logins)</td>
              <td class="p-4 text-slate-500">Requires bank login sync</td>
              <td class="p-4 text-slate-500">Offline</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-slate-900 dark:text-white">Guilt-Free Spending Buffer</td>
              <td class="p-4 text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-500/10">Yes (Live daily/monthly)</td>
              <td class="p-4 text-slate-500">Complex custom setup</td>
              <td class="p-4 text-slate-500">Rarely included</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-slate-900 dark:text-white">Sinking Funds Shield</td>
              <td class="p-4 text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-500/10">Integrated</td>
              <td class="p-4 text-slate-500">Add-on required</td>
              <td class="p-4 text-slate-500">Separate sheet</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-slate-900 dark:text-white">Fed Reserve SCF Benchmarks</td>
              <td class="p-4 text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-500/10">Official Raw Microdata</td>
              <td class="p-4 text-slate-500">None</td>
              <td class="p-4 text-slate-500">None</td>
            </tr>
            <tr>
              <td class="p-4 font-semibold text-slate-900 dark:text-white">FIRE Retirement Engine</td>
              <td class="p-4 text-emerald-600 dark:text-emerald-400 font-bold bg-emerald-500/10">Lean, Standard, Fat, Coast</td>
              <td class="p-4 text-slate-500">Not included</td>
              <td class="p-4 text-slate-500">Basic / Missing</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="max-w-3xl mx-auto space-y-4">
      <div class="text-center space-y-2 mb-8">
        <h2 class="text-2xl font-black text-slate-900 dark:text-white">Frequently Asked Questions</h2>
        <p class="text-xs text-slate-500">Everything you need to know before getting started.</p>
      </div>

      <details class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm" open>
        <summary class="text-base font-bold text-slate-900 dark:text-white flex justify-between items-center list-none">
          <span>Will this take a lot of time to update every month?</span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-3 leading-relaxed">
          No — that is why we built the <strong>⚡ 2-Minute Quick Check-In</strong> tab. On the 1st of each month, you enter just 4 numbers (Cash, Invested Portfolio, Real Estate, Total Debts). All formulas, net worth curves, and FIRE dates update immediately without tedious receipt logging.
        </p>
      </details>

      <details class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
        <summary class="text-base font-bold text-slate-900 dark:text-white flex justify-between items-center list-none">
          <span>How do I open this in Google Sheets?</span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
        <p class="text-sm text-slate-600 dark:text-slate-300 mt-3 leading-relaxed">
          Open Google Drive (drive.google.com), click "+ New" → "File upload", select the downloaded <code>.xlsx</code> file, and click "Open with Google Sheets". It converts in 2 seconds with every formula and format preserved.
        </p>
      </details>

      <details class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
        <summary class="text-base font-bold text-slate-900 dark:text-white flex justify-between items-center list-none">
          <span>Do I need to connect my bank account passwords?</span>
          <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
        </summary>
