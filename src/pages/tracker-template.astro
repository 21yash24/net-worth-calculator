              </thead>
              <tbody class="divide-y divide-slate-800/60 bg-slate-950">
                <tr>
                  <td class="p-2.5 text-left font-bold text-slate-300">Jan 2026</td>
                  <td class="p-2.5 bg-emerald-950/30 text-emerald-400">$25,000</td>
                  <td class="p-2.5 bg-emerald-950/30 text-emerald-400">$185,000</td>
                  <td class="p-2.5 bg-emerald-950/30 text-emerald-400">$350,000</td>
                  <td class="p-2.5 bg-emerald-950/30 text-emerald-400">$245,000</td>
                  <td class="p-2.5 font-extrabold text-white">$315,000</td>
                  <td class="p-2.5 text-slate-400">Baseline</td>
                </tr>
                <tr class="bg-slate-900/40">
                  <td class="p-2.5 text-left font-bold text-slate-300">Feb 2026</td>
                  <td class="p-2.5 bg-emerald-950/30 text-emerald-400">$26,200</td>
                  <td class="p-2.5 bg-emerald-950/30 text-emerald-400">$189,500</td>
                  <td class="p-2.5 bg-emerald-950/30 text-emerald-400">$350,000</td>
                  <td class="p-2.5 bg-emerald-950/30 text-emerald-400">$243,800</td>
                  <td class="p-2.5 font-extrabold text-emerald-400">$321,900</td>
                  <td class="p-2.5 text-emerald-400 font-bold">▲ +$6,900 (+2.2%)</td>
                </tr>
                <tr>
                  <td class="p-2.5 text-left font-bold text-slate-300">Mar 2026</td>
