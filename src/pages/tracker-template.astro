              <thead class="bg-slate-900 text-slate-300 border-b border-slate-800">
                <tr>
                  <th class="p-2.5 text-left font-sans">Month</th>
                  <th class="p-2.5 bg-emerald-900/40 text-emerald-300 font-sans">💵 Cash (Input)</th>
                  <th class="p-2.5 bg-emerald-900/40 text-emerald-300 font-sans">📈 Invested (Input)</th>
                  <th class="p-2.5 bg-emerald-900/40 text-emerald-300 font-sans">🏠 Property (Input)</th>
