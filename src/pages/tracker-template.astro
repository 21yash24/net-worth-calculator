      </div>

      <!-- Interactive Mock Displays -->
      <div class="rounded-3xl bg-slate-950 border border-slate-800 p-5 sm:p-7 shadow-2xl text-white font-sans space-y-4">
        
        <!-- Tab 1: Quick Check-in Mockup -->
        <div id="mock-tab-quick" class="tab-panel space-y-3">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <div>
              <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block">Tab 1: Anti-Fatigue Routine</span>
              <span class="text-base sm:text-lg font-black text-white">⚡ 2-Minute Monthly Quick Check-In</span>
            </div>
            <span class="text-[11px] px-2.5 py-1 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold">Takes 90s on the 1st</span>
          </div>
          <p class="text-xs text-slate-400">
            Green cells are the <strong>only cells you ever touch</strong>. Everything else (Net Worth, MoM Dollar Change, Percentage Growth) is automated.
          </p>
          <div class="overflow-x-auto rounded-xl border border-slate-800">
            <table class="w-full text-xs font-mono text-center">
              <thead class="bg-slate-900 text-slate-300 border-b border-slate-800">
                <tr>
                  <th class="p-2.5 text-left font-sans">Month</th>
                  <th class="p-2.5 bg-emerald-900/40 text-emerald-300 font-sans">💵 Cash (Input)</th>
                  <th class="p-2.5 bg-emerald-900/40 text-emerald-300 font-sans">📈 Invested (Input)</th>
                  <th class="p-2.5 bg-emerald-900/40 text-emerald-300 font-sans">🏠 Property (Input)</th>
                  <th class="p-2.5 bg-emerald-900/40 text-emerald-300 font-sans">💳 Debts (Input)</th>
                  <th class="p-2.5 font-bold font-sans">🏛️ NET WORTH</th>
