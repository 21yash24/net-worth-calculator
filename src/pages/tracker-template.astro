              <span class="text-[10px] text-slate-400 font-bold block uppercase">FED SCF BENCHMARK</span>
              <span class="text-2xl font-black text-amber-400">Top 12%</span>
              <span class="text-xs text-slate-400 block">Age Cohort 30 - 34</span>
            </div>
          </div>
        </div>

        <!-- Tab 3: Budget Mockup -->
        <div id="mock-tab-budget" class="tab-panel space-y-3 hidden">
          <div class="flex items-center justify-between pb-3 border-b border-slate-800">
            <div>
              <span class="text-xs font-bold text-purple-400 uppercase tracking-wider block">Tab 3: Cash Flow Engine</span>
