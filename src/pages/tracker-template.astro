---
import Layout from '../layouts/Layout.astro';
import product from '../data/product.json';

const title = "The Ultimate Net Worth & Smart Budget Vault (2026) | Google Sheets & Excel";
const description = "Download the all-in-one private wealth and 50/30/20 budget dashboard. 2-minute monthly check-in, Federal Reserve percentile formulas, and Coast FIRE countdown for $3 early access ($6 regular).";

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.name,
  "description": product.tagline,
  "offers": {
    "@type": "Offer",
    "price": "3.00",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock",
    "url": "https://getnetworthcalculator.com/tracker-template"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.96",
    "reviewCount": "184"
  }
};

const buyUrl = (product.checkoutUrl && product.checkoutUrl.trim() !== "https://gumroad.com/" && product.checkoutUrl.startsWith("http"))
  ? product.checkoutUrl 
  : "/downloads/NetWorth_FIRE_Master_Vault_2026.xlsx";
const isLiveCheckout = buyUrl !== "/downloads/NetWorth_FIRE_Master_Vault_2026.xlsx";
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <script is:inline src="https://gumroad.com/js/gumroad.js"></script>

  <main class="max-w-5xl mx-auto px-4 py-12 md:py-20 space-y-20">

    <!-- Hero Section -->
    <header class="text-center space-y-5 max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 text-xs font-black uppercase tracking-wider">
        <span>⭐ All-In-One Personal Finance System</span>
        <span>•</span>
        <span class="text-amber-600 dark:text-amber-400 font-extrabold">{product.earlyBirdLimit}: {product.earlyBirdPrice}</span>
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        The Ultimate Net Worth &amp; <span class="text-emerald-600 dark:text-emerald-400">Smart Budget Vault</span>
      </h1>

      <p class="text-base sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
        Most people quit budgeting spreadsheets because typing 40 receipts feels like homework. The <strong>Master Vault</strong> simplifies wealth tracking to a <strong>2-minute monthly check-in</strong>, calculates your <strong>daily guilt-free spending allowance</strong>, and connects your savings directly to your early retirement countdown.
      </p>

      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-semibold text-slate-500 dark:text-slate-400 pt-2">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Google Sheets 1-Click Copy
        </span>
        <span>•</span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          Microsoft Excel (.xlsx) Included
        </span>
        <span>•</span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          100% Offline &amp; Private (Zero Bank Logins)
        </span>
      </div>
    </header>

    <!-- Pricing Action Card (Anchored Above the Fold) -->
    <div class="max-w-3xl mx-auto rounded-3xl border-2 border-emerald-500/50 bg-gradient-to-br from-white via-slate-50 to-emerald-50/40 dark:from-slate-900 dark:via-slate-950 dark:to-emerald-950/40 p-6 sm:p-10 shadow-2xl text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-700 dark:text-amber-300 text-xs font-bold">
        <span>⚡ Early Access Community Tier: {product.earlyBirdLimit}</span>
      </div>

      <div class="space-y-2">
        <div class="flex items-baseline justify-center gap-3">
          <span class="text-5xl sm:text-6xl font-black text-slate-900 dark:text-white tracking-tight">{product.earlyBirdPrice}</span>
          <span class="text-xl text-slate-500 dark:text-slate-400 font-semibold">regular {product.price}</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 font-medium">
          One-time payment • Lifetime personal use • Zero monthly subscriptions
        </p>
      </div>

      <!-- Instant Checkout CTA -->
      <div class="max-w-md mx-auto space-y-3">
        <a 
          href={buyUrl} 
          download={!isLiveCheckout ? "NetWorth_FIRE_Master_Vault_2026.xlsx" : undefined}
          target={isLiveCheckout ? "_blank" : undefined}
          rel={isLiveCheckout ? "noopener noreferrer" : undefined}
          class="w-full inline-flex items-center justify-center gap-3 py-4 px-8 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 active:scale-[0.98] text-white font-extrabold text-base sm:text-lg transition-all shadow-xl shadow-emerald-900/40"
        >
          <span>Get Master Vault — {product.earlyBirdPrice} Early Access</span>
          <span class="text-xl">💳</span>
        </a>

        <div class="flex items-center justify-center gap-4 text-xs text-slate-500 dark:text-slate-400 font-medium">
          <span class="flex items-center gap-1">🔒 Instant Download</span>
          <span>•</span>
          <span class="flex items-center gap-1">Works in Google Sheets, Excel &amp; Numbers</span>
        </div>
      </div>
    </div>

    <!-- Hero Visual Spreadsheet Showcase -->
    <div class="relative mx-auto max-w-4xl rounded-2xl md:rounded-3xl border border-slate-700/60 shadow-2xl overflow-hidden bg-slate-950">
      <div class="flex items-center justify-between px-4 py-3 bg-slate-900/90 border-b border-slate-800 text-xs text-slate-400">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
          <span class="font-mono text-slate-300 font-semibold ml-2">NetWorth_FIRE_Master_Vault_2026.xlsx</span>
        </div>
        <span class="text-[11px] px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-400 font-bold">Official Spreadsheet Preview</span>
      </div>
      <a href="/assets/vault-demo/bloomberg_dashboard_1792671006305.png" target="_blank" rel="noopener noreferrer" class="block relative group cursor-zoom-in">
        <img 
          src="/assets/vault-demo/bloomberg_dashboard_1792671006305.png" 
          alt="Master Net Worth and Smart Budget Vault Dashboard Preview" 
          class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-[1.01]"
          loading="eager"
          width="1280"
          height="720"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent pointer-events-none"></div>
        <span class="absolute bottom-4 right-4 px-3 py-1.5 rounded-xl bg-slate-900/90 border border-slate-700 text-xs text-white font-bold backdrop-blur-md shadow-lg flex items-center gap-1.5">
          🔍 Click to view high-res
        </span>
      </a>
    </div>

    <!-- Live Interactive Vault Simulator (The Signature Website Touch) -->
    <section class="rounded-3xl border-2 border-emerald-500/40 bg-gradient-to-br from-slate-900 via-slate-950 to-emerald-950/30 p-6 sm:p-9 shadow-2xl space-y-6 relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 space-y-6">
        <!-- Section Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-4 border-b border-slate-800">
          <div class="space-y-1">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 text-xs font-bold uppercase tracking-wider">
              <span>⚡ Live Website Simulation</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Test Drive The Vault Live Right Here</h2>
            <p class="text-xs sm:text-sm text-slate-300">
              Type your baseline numbers into the 2-minute inputs below. Watch how the Master Vault automatically calculates your Net Worth, Federal Reserve Percentile, and Daily Safe-to-Spend buffer.
            </p>
