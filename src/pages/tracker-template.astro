            <div>
              <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block">Tab 2: Command Center</span>
              <span class="text-base sm:text-lg font-black text-white">📊 Executive Wealth Dashboard</span>
            </div>
            <span class="text-[11px] px-2.5 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold">Bloomberg Dark Theme</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
