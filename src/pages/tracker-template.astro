  <!-- Client-side Interactive Tab Switcher Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const tabButtons = document.querySelectorAll('#preview-tab-buttons .tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab');

          // Update active button state
          tabButtons.forEach(b => {
            b.classList.remove('bg-emerald-600', 'text-white', 'shadow-md');
            b.classList.add('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
          });
          btn.classList.add('bg-emerald-600', 'text-white', 'shadow-md');
          btn.classList.remove('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');

          // Show targeted mock tab
          tabPanels.forEach(panel => {
            if (panel.id === `mock-${target}`) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });
        });
      });
    });
  </script>
