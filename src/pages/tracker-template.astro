  <!-- Client-side Interactive Tab Switcher & Simulator Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Tab Switcher
      const tabButtons = document.querySelectorAll('#preview-tab-buttons .tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');

      tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-tab');

          tabButtons.forEach(b => {
            b.classList.remove('bg-emerald-600', 'text-white', 'shadow-md');
            b.classList.add('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');
          });
          btn.classList.add('bg-emerald-600', 'text-white', 'shadow-md');
          btn.classList.remove('bg-slate-200', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300');

          tabPanels.forEach(panel => {
            if (panel.id === `mock-${target}`) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          });
        });
      });

      // 2. Live Vault Simulator Engine
      const simAge = document.getElementById('sim-age');
      const simCash = document.getElementById('sim-cash');
      const simInvest = document.getElementById('sim-invest');
      const simProp = document.getElementById('sim-prop');
      const simDebt = document.getElementById('sim-debt');
      const simIncome = document.getElementById('sim-income');

      const outNW = document.getElementById('sim-out-nw');
      const outLiq = document.getElementById('sim-out-liq');
      const outLiqRatio = document.getElementById('sim-out-liq-ratio');
      const outPaw = document.getElementById('sim-out-paw');
      const outPawMul = document.getElementById('sim-out-paw-mul');
      const outFed = document.getElementById('sim-out-fed');
      const outSpend = document.getElementById('sim-out-spend');
      const outFire = document.getElementById('sim-out-fire');

      const fedBenchmarks = {
        under35: { age: 30, p99: 2800000, p90: 380000, p75: 145000, p50: 39000, coast: 185000 },
        '35to44': { age: 40, p99: 5500000, p90: 980000, p75: 420000, p50: 135600, coast: 320000 },
        '45to54': { age: 50, p99: 10200000, p90: 1950000, p75: 780000, p50: 247200, coast: 580000 },
        '55to64': { age: 60, p99: 14500000, p90: 2800000, p75: 1150000, p50: 364500, coast: 950000 },
        '65to74': { age: 70, p99: 16800000, p90: 3200000, p75: 1350000, p50: 409900, coast: 1200000 }
      };

      function updateSimulator() {
        const ageCohort = simAge ? simAge.value : 'under35';
        const cash = parseFloat(simCash ? simCash.value : 0) || 0;
        const invest = parseFloat(simInvest ? simInvest.value : 0) || 0;
        const prop = parseFloat(simProp ? simProp.value : 0) || 0;
        const debt = parseFloat(simDebt ? simDebt.value : 0) || 0;
        const income = parseFloat(simIncome ? simIncome.value : 0) || 0;

        const nw = (cash + invest + prop) - debt;
        if (outNW) {
          outNW.textContent = '$' + Math.round(nw).toLocaleString('en-US');
          outNW.className = nw >= 0 ? 'text-xl sm:text-2xl font-black text-white' : 'text-xl sm:text-2xl font-black text-rose-400';
        }

        // 1. Liquid Net Worth & Ratio
        const liquidNW = cash + invest;
        if (outLiq) {
          outLiq.textContent = '$' + Math.round(liquidNW).toLocaleString('en-US');
        }
        if (outLiqRatio) {
          const ratio = nw > 0 ? ((liquidNW / nw) * 100).toFixed(1) : '0.0';
          outLiqRatio.textContent = `${ratio}% Liquid Assets`;
        }

        // 2. Stanley & Danko PAW / UAW Wealth Class Formula
        const bm = fedBenchmarks[ageCohort] || fedBenchmarks.under35;
        const estimatedAnnualPreTax = income * 12 * 1.35; // Estimated gross pre-tax income
        const expectedNW = Math.max(1000, (bm.age * estimatedAnnualPreTax) / 10);
        const pawMultiplier = expectedNW > 0 ? (nw / expectedNW) : 0;

        if (outPaw) {
          if (pawMultiplier >= 2.0) {
            outPaw.textContent = '🏆 PAW (Top 10%)';
            outPaw.className = 'text-sm sm:text-base font-black text-amber-400';
          } else if (pawMultiplier >= 1.0) {
            outPaw.textContent = '⚡ AAW (On Track)';
            outPaw.className = 'text-sm sm:text-base font-black text-emerald-400';
          } else {
            outPaw.textContent = '⚠️ UAW (Under)';
            outPaw.className = 'text-sm sm:text-base font-black text-rose-400';
          }
        }
        if (outPawMul) {
          outPawMul.textContent = `${pawMultiplier.toFixed(2)}x Multiplier`;
        }

        // 3. Fed Percentile calculation
        let rank = 'Top 50%';
        if (nw >= bm.p99) rank = 'Top 1% 👑';
        else if (nw >= bm.p90) rank = 'Top 10% ⭐';
        else if (nw >= bm.p75) rank = 'Top 25%';
        else if (nw >= bm.p50) rank = 'Top 50%';
        else rank = 'Building (<50%)';

        if (outFed) outFed.textContent = rank;

        // 4. Daily Safe-to-Spend (30% Wants / 30 days)
        const dailySafe = Math.max(0, Math.round((income * 0.30) / 30));
        if (outSpend) outSpend.textContent = `$${dailySafe} / day`;

        // 5. Coast FIRE status
        if (outFire) {
          if (invest >= bm.coast) {
            outFire.textContent = '✅ ACHIEVED';
            outFire.className = 'text-sm sm:text-base font-black text-emerald-300';
          } else {
            const gap = bm.coast - invest;
            outFire.textContent = `Gap: $${Math.round(gap).toLocaleString('en-US')}`;
            outFire.className = 'text-sm sm:text-base font-black text-amber-300';
          }
        }
      }

      [simAge, simCash, simInvest, simProp, simDebt, simIncome].forEach(input => {
        if (input) {
          input.addEventListener('input', updateSimulator);
          input.addEventListener('change', updateSimulator);
        }
      });

      updateSimulator();
    });
  </script>
</Layout>
