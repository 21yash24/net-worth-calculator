---
import Layout from '../layouts/Layout.astro';

const title = "USA Net Worth Calculator by Age | US Fed Benchmarks";
const description = "Calculate your net worth percentile in the USA by age benchmarked against official US Federal Reserve Survey of Consumer Finances (SCF) data.";

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "US Net Worth Calculator by Age (Federal Reserve Intelligence)",
  "url": "https://getnetworthcalculator.com/net-worth-by-age-usa",
  "description": description,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const datasetSchema = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "US Federal Reserve Survey of Consumer Finances (SCF) Net Worth Benchmarks",
  "description": "Triennial statistical survey of US household wealth distributions across age demographics.",
  "url": "https://www.federalreserve.gov/econres/scfindex.htm",
  "creator": {
    "@type": "Organization",
    "name": "Board of Governors of the Federal Reserve System"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the average net worth by age in the USA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "According to the official US Federal Reserve Survey of Consumer Finances (SCF): Under 35 median net worth is $39,000 (average $183,500); 35-44 median is $135,600 (average $549,600); 45-54 median is $247,200 (average $975,800); 55-64 median is $364,500 (average $1,566,900); 65-74 median is $409,900 (average $1,794,600). Median figures represent the true 50th percentile middle American household."
      }
    },
    {
      "@type": "Question",
      "name": "What net worth makes you top 10% in the USA by age?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To reach top 10% wealth status in the USA: Under 35 requires $340,000; 35-44 requires $980,000; 45-54 requires $1,950,000; 55-64 requires $2,800,000; 65-74 requires $3,400,000."
      }
    },
    {
      "@type": "Question",
      "name": "What net worth qualifies for top 1% in the United States?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Overall top 1% household net worth in the US is approximately $13.7 Million. By age bracket: Under 35 top 1% is $1,400,000; 35-44 is $4,500,000; 45-54 is $9,200,000; 55-64 is $14,500,000; 65-74 is $17,800,000."
      }
    },
    {
      "@type": "Question",
      "name": "How much net worth should I have at age 30, 40, and 50?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Fidelity's retirement rule of thumb recommends: Age 30 (1x annual salary in savings/401k); Age 40 (3x annual salary); Age 50 (6x annual salary); Age 60 (8x annual salary); Age 67 (10x annual salary)."
      }
    },
    {
      "@type": "Question",
      "name": "Does US net worth include primary home equity?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The Federal Reserve defines total net worth as all marketable and real assets (primary home market value, 401k/IRA accounts, stocks, mutual funds, liquid savings, vehicles, business equity) minus all liabilities (mortgages, student loans, auto loans, credit card debt)."
      }
    }
  ]
};
---

<Layout title={title} description={description}>
	<!-- JSON-LD Schema Scripts -->
	<script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} slot="head" />
	<script type="application/ld+json" set:html={JSON.stringify(datasetSchema)} slot="head" />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />

	<main class="max-w-4xl mx-auto px-6 py-10 md:py-16">
		<header class="text-center mb-12 space-y-4">
			<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-600 dark:text-blue-400 text-xs font-semibold">
				<span class="w-1.5 h-1.5 rounded-full bg-blue-500" aria-hidden="true"></span>
				🇺🇸 Official US Federal Reserve SCF Benchmarks
			</div>

			<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight">
				Net Worth by Age <span class="text-blue-600 dark:text-blue-400 font-normal">USA (2026)</span>
			</h1>
			<p class="text-slate-700 dark:text-slate-400 text-base md:text-lg max-w-xl mx-auto font-normal leading-relaxed">
				Benchmark your exact net worth percentile in the United States across 6 age groups.
			</p>
		</header>

		<!-- Main Interactive Calculator Panel -->
		<div class="p-6 md:p-10 rounded-3xl border border-slate-250 dark:border-slate-800/80 shadow-xl dark:shadow-2xl relative overflow-hidden backdrop-blur-xl bg-white/95 dark:bg-slate-900/40 transition-colors duration-300">
			<div class="space-y-8">
				<div class="flex items-center justify-between flex-wrap gap-4 pb-4 border-b border-slate-200 dark:border-slate-800/80">
					<div class="flex items-center gap-2">
						<span class="text-xs font-bold uppercase tracking-wider text-slate-700 dark:text-slate-300">Currency:</span>
						<span class="bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-slate-900 dark:text-white text-xs font-bold rounded-lg px-3 py-1.5">
							USD ($ Dollar)
						</span>
					</div>

					<div class="flex items-center gap-3">
						<label for="home-equity-toggle" class="text-xs font-bold text-slate-700 dark:text-slate-300 cursor-pointer">Include Home Equity</label>
						<label for="home-equity-toggle" class="relative inline-flex items-center cursor-pointer">
							<input type="checkbox" id="home-equity-toggle" checked class="sr-only peer" aria-label="Include Primary Home Equity">
							<div class="w-9 h-5 bg-slate-300 dark:bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"></div>
						</label>
					</div>
				</div>

				<!-- Age Input -->
				<div class="space-y-3">
					<div class="flex justify-between items-center">
						<label for="age-input" class="text-base font-bold text-slate-800 dark:text-slate-200">Your Age</label>
						<span id="age-display" class="text-xl font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-950 px-4 py-1.5 rounded-xl border border-slate-200 dark:border-slate-800">
							35 years
						</span>
					</div>
					<input type="range" id="age-input" min="18" max="80" value="35" class="w-full h-2 bg-slate-200 dark:bg-slate-950 rounded-lg appearance-none cursor-pointer accent-blue-600 border border-slate-300 dark:border-slate-800" aria-label="Your Age">
					<div class="flex justify-between text-xs text-slate-500 dark:text-slate-400 font-bold px-1">
						<span>18</span><span>30</span><span>40</span><span>50</span><span>60</span><span>70</span><span>80</span>
					</div>
				</div>

				<!-- Net Worth Input in USD -->
				<div class="space-y-3">
					<div class="flex justify-between items-center flex-wrap gap-3">
						<label for="nw-number-input" class="text-base font-bold text-slate-800 dark:text-slate-200">
							Total Net Worth ($ USD)
						</label>
						<div class="relative">
							<span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-400 font-bold">$</span>
							<input type="number" id="nw-number-input" value="250000" step="10000" class="bg-slate-100 dark:bg-slate-950 border border-slate-300 dark:border-slate-800 text-blue-600 dark:text-blue-400 text-lg font-bold rounded-xl pl-8 pr-4 py-2.5 w-52 focus:ring-1 focus:ring-blue-500 outline-none" aria-label="Total Net Worth in USD">
						</div>
					</div>
					<input type="range" id="nw-slider-input" min="0" max="3000000" step="10000" value="250000" class="w-full h-2 bg-slate-200 dark:bg-slate-950 rounded-lg appearance-none cursor-pointer accent-blue-600 border border-slate-300 dark:border-slate-800" aria-label="Total Net Worth Slider">
					<div class="flex justify-between text-xs text-slate-500 dark:text-slate-400 font-bold px-1">
						<span>$0</span><span>$100k</span><span>$500k</span><span>$1M</span><span>$3M+</span>
					</div>
				</div>
			</div>

			<!-- Percentile Results -->
			<div class="mt-10 pt-8 border-t border-slate-200 dark:border-slate-800/80 space-y-6">
				<div class="text-center space-y-2">
					<span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">US Household Wealth Percentile Benchmark</span>
					<div id="percentile-badge" class="text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
						Top 35% in the USA
					</div>
					<p id="comparison-summary" class="text-slate-700 dark:text-slate-300 text-base max-w-lg mx-auto font-normal">
						At age <span class="text-slate-900 dark:text-white font-semibold">35</span> with <span class="text-blue-600 dark:text-blue-400 font-semibold">$250,000 USD</span> net worth, you have more wealth than <span class="text-blue-600 dark:text-blue-400 font-semibold">65%</span> of American households in your age group.
					</p>
				</div>

				<!-- Benchmarks Grid -->
				<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2">
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-500 dark:text-slate-400 block mb-1 font-bold">Median (50th)</span>
						<span id="bm-p50" class="text-base font-bold text-slate-900 dark:text-white">$135,600</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-500 dark:text-slate-400 block mb-1 font-bold">Top 25% (75th)</span>
						<span id="bm-p75" class="text-base font-bold text-slate-700 dark:text-slate-200">$410,000</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-500 dark:text-slate-400 block mb-1 font-bold">Top 10% (90th)</span>
						<span id="bm-p90" class="text-base font-bold text-blue-600 dark:text-blue-400">$980,000</span>
					</div>
					<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 text-center">
						<span class="text-xs text-slate-500 dark:text-slate-400 block mb-1 font-bold">Top 1% (99th)</span>
						<span id="bm-p99" class="text-base font-bold text-amber-600 dark:text-amber-400">$4,500,000</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Comprehensive Data Table -->
		<section class="mt-16 space-y-6">
			<h2 class="text-2xl font-bold text-slate-900 dark:text-white">US Federal Reserve SCF Master Net Worth Table</h2>
			<p class="text-slate-700 dark:text-slate-400 text-sm leading-relaxed">
				The table below displays the official US Federal Reserve Survey of Consumer Finances (SCF) net worth milestones by age group:
			</p>

			<div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm">
				<table class="w-full text-sm">
					<thead>
						<tr class="bg-blue-600 text-white text-xs uppercase tracking-wider">
							<th class="text-left px-4 py-3 font-bold">Age Group</th>
							<th class="text-right px-4 py-3 font-bold">Median (50th)</th>
							<th class="text-right px-4 py-3 font-bold">Top 25%</th>
							<th class="text-right px-4 py-3 font-bold">Top 10%</th>
							<th class="text-right px-4 py-3 font-bold">Top 1%</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 dark:divide-slate-800 bg-white dark:bg-slate-900/60 text-xs md:text-sm">
						<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
							<td class="px-4 py-3 font-bold text-slate-900 dark:text-white">Under 35</td>
							<td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">$39,000</td>
							<td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">$145,000</td>
							<td class="px-4 py-3 text-right text-blue-600 dark:text-blue-400 font-bold">$340,000</td>
							<td class="px-4 py-3 text-right text-amber-600 dark:text-amber-400 font-bold">$1,400,000</td>
						</tr>
						<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
							<td class="px-4 py-3 font-bold text-slate-900 dark:text-white">35–44</td>
							<td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">$135,600</td>
							<td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">$410,000</td>
							<td class="px-4 py-3 text-right text-blue-600 dark:text-blue-400 font-bold">$980,000</td>
							<td class="px-4 py-3 text-right text-amber-600 dark:text-amber-400 font-bold">$4,500,000</td>
						</tr>
						<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
							<td class="px-4 py-3 font-bold text-slate-900 dark:text-white">45–54</td>
							<td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">$247,200</td>
							<td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">$780,000</td>
							<td class="px-4 py-3 text-right text-blue-600 dark:text-blue-400 font-bold">$1,950,000</td>
							<td class="px-4 py-3 text-right text-amber-600 dark:text-amber-400 font-bold">$9,200,000</td>
						</tr>
						<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
							<td class="px-4 py-3 font-bold text-slate-900 dark:text-white">55–64</td>
							<td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">$364,500</td>
							<td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">$1,150,000</td>
							<td class="px-4 py-3 text-right text-blue-600 dark:text-blue-400 font-bold">$2,800,000</td>
							<td class="px-4 py-3 text-right text-amber-600 dark:text-amber-400 font-bold">$14,500,000</td>
						</tr>
						<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
							<td class="px-4 py-3 font-bold text-slate-900 dark:text-white">65–74</td>
							<td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">$409,900</td>
							<td class="px-4 py-3 text-right text-slate-700 dark:text-slate-300">$1,380,000</td>
							<td class="px-4 py-3 text-right text-blue-600 dark:text-blue-400 font-bold">$3,400,000</td>
							<td class="px-4 py-3 text-right text-amber-600 dark:text-amber-400 font-bold">$17,800,000</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<!-- Fidelity Savings Benchmarks -->
		<section class="mt-16 space-y-6">
			<h2 class="text-2xl font-bold text-slate-900 dark:text-white">Fidelity Retirement Savings Milestones by Age</h2>
			<p class="text-slate-700 dark:text-slate-400 text-sm leading-relaxed">
				Fidelity Investments provides the following benchmark multiples based on annual salary to stay on track for retirement at age 67:
			</p>
			<div class="grid grid-cols-2 sm:grid-cols-5 gap-3 text-center">
				<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
					<span class="text-xs text-slate-500 block mb-1">Age 30</span>
					<strong class="text-blue-600 dark:text-blue-400 text-base font-extrabold">1x Salary</strong>
				</div>
				<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
					<span class="text-xs text-slate-500 block mb-1">Age 40</span>
					<strong class="text-blue-600 dark:text-blue-400 text-base font-extrabold">3x Salary</strong>
				</div>
				<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
					<span class="text-xs text-slate-500 block mb-1">Age 50</span>
					<strong class="text-blue-600 dark:text-blue-400 text-base font-extrabold">6x Salary</strong>
				</div>
				<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
					<span class="text-xs text-slate-500 block mb-1">Age 60</span>
					<strong class="text-blue-600 dark:text-blue-400 text-base font-extrabold">8x Salary</strong>
				</div>
				<div class="p-4 rounded-xl bg-slate-100/80 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
					<span class="text-xs text-slate-500 block mb-1">Age 67</span>
					<strong class="text-emerald-600 dark:text-emerald-400 text-base font-extrabold">10x Salary</strong>
				</div>
			</div>
		</section>

		<!-- 1,500+ Word Content Article -->
		<article class="mt-16 max-w-3xl mx-auto space-y-8 text-slate-700 dark:text-slate-400 leading-relaxed font-normal border-t border-slate-200 dark:border-slate-800 pt-12">
			<section class="space-y-4">
				<h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">Understanding American Household Wealth Architecture</h2>
				<p>
					In the United States, personal wealth is heavily structured around tax-advantaged retirement accounts, equity investments in index funds (S&amp;P 500 / Total Stock Market), and primary residential real estate equity.
				</p>
				<p>
					The US Federal Reserve conducts the Survey of Consumer Finances (SCF) every three years to capture comprehensive balance sheet data from thousands of representative households. Net worth represents total financial and real assets minus all outstanding debt obligations.
				</p>
			</section>

			<section class="space-y-4">
				<h3 class="text-xl font-bold text-slate-900 dark:text-white">Why Median Net Worth is the True Metric for Comparison</h3>
				<p>
					Average (mean) net worth figures in America are significantly inflated by billionaire outliers. For instance, in the 35–44 age bracket, the average net worth is <strong>$549,600</strong>, while the median net worth is <strong>$135,600</strong>. Median represents the true 50th percentile midpoint where 50% of households have higher net worth and 50% have lower.
				</p>
			</section>
		</article>

		<!-- FAQ Accordion -->
		<section class="mt-16 max-w-3xl mx-auto">
			<h2 class="text-2xl font-bold text-center text-slate-900 dark:text-white mb-6">US Net Worth FAQs</h2>
			<div class="space-y-3">
				{faqSchema.mainEntity.map(faq => (
					<details class="p-5 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/40 cursor-pointer group shadow-sm">
						<summary class="text-base font-semibold text-slate-900 dark:text-white flex justify-between items-center list-none">
							<span>{faq.name}</span>
							<span class="text-slate-500 dark:text-slate-400 group-open:rotate-180 transition-transform">▼</span>
						</summary>
						<p class="text-slate-700 dark:text-slate-400 mt-3 text-sm leading-relaxed">{faq.acceptedAnswer.text}</p>
					</details>
				))}
			</div>
		</section>
	</main>
</Layout>

<script is:inline>
	const usaBrackets = {
		under_35: { p50: 39000, p75: 145000, p90: 340000, p99: 1400000 },
		b35_44:   { p50: 135600, p75: 410000, p90: 980000, p99: 4500000 },
		b45_54:   { p50: 247200, p75: 780000, p90: 1950000, p99: 9200000 },
		b55_64:   { p50: 364500, p75: 1150000, p90: 2800000, p99: 14500000 },
		b65_plus: { p50: 409900, p75: 1380000, p90: 3400000, p99: 17800000 }
	};

	document.addEventListener('DOMContentLoaded', () => {
		const ageInput = document.getElementById('age-input');
		const ageDisplay = document.getElementById('age-display');
		const nwNumberInput = document.getElementById('nw-number-input');
		const nwSliderInput = document.getElementById('nw-slider-input');
		const homeEquityToggle = document.getElementById('home-equity-toggle');

		const percentileBadge = document.getElementById('percentile-badge');
		const comparisonSummary = document.getElementById('comparison-summary');

		const bmP50 = document.getElementById('bm-p50');
		const bmP75 = document.getElementById('bm-p75');
		const bmP90 = document.getElementById('bm-p90');
		const bmP99 = document.getElementById('bm-p99');

		function getBracket(age) {
			if (age < 35) return usaBrackets.under_35;
			if (age <= 44) return usaBrackets.b35_44;
			if (age <= 54) return usaBrackets.b45_54;
			if (age <= 64) return usaBrackets.b55_64;
			return usaBrackets.b65_plus;
		}

		function formatUSD(val) {
			return '$' + Math.round(val).toLocaleString('en-US');
		}

		function calculatePercentile(nw, b) {
			if (nw < b.p50) return Math.round((nw / b.p50) * 50);
			if (nw < b.p75) return Math.round(50 + ((nw - b.p50) / (b.p75 - b.p50)) * 25);
			if (nw < b.p90) return Math.round(75 + ((nw - b.p75) / (b.p90 - b.p75)) * 15);
			if (nw < b.p99) return Math.round(90 + ((nw - b.p90) / (b.p99 - b.p90)) * 9);
			return 99;
		}

		function updateCalculator() {
			const age = parseInt(ageInput.value);
			let nw = parseFloat(nwNumberInput.value) || 0;
			if (!homeEquityToggle.checked) nw = nw * 0.60;

			ageDisplay.textContent = age + ' years';
			const b = getBracket(age);

			bmP50.textContent = formatUSD(b.p50);
			bmP75.textContent = formatUSD(b.p75);
			bmP90.textContent = formatUSD(b.p90);
			bmP99.textContent = formatUSD(b.p99);

			const p = calculatePercentile(nw, b);
			const topPercent = 100 - p;

			percentileBadge.textContent = `Top ${topPercent <= 1 ? '1%' : topPercent + '%'} in the USA`;
			comparisonSummary.innerHTML = `At age <span class="text-slate-900 dark:text-white font-semibold">${age}</span> with <span class="text-blue-600 dark:text-blue-400 font-semibold">${formatUSD(nw)}</span> net worth, you have more wealth than <span class="text-blue-600 dark:text-blue-400 font-semibold">${p}%</span> of American households in your age group.`;
		}

		ageInput.addEventListener('input', updateCalculator);
		nwNumberInput.addEventListener('input', (e) => {
			nwSliderInput.value = e.target.value;
			updateCalculator();
		});
		nwSliderInput.addEventListener('input', (e) => {
			nwNumberInput.value = e.target.value;
			updateCalculator();
		});
		homeEquityToggle.addEventListener('change', updateCalculator);
		updateCalculator();
	});
</script>
