---
import Layout from '../layouts/Layout.astro';

const title = "Am I Rich? (2026 Calculator) – Find Your Global & US Wealth Tier";
const description = "Am I rich? Check where your net worth and income rank in the United States and globally. Real 2026 percentile tiers from Middle Class to Top 1%.";

const richSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Am I Rich Calculator - US & Global Wealth Percentile Tier Tool",
  "url": "https://getnetworthcalculator.com/am-i-rich-calculator",
  "description": description,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const richFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What net worth is considered 'rich' in the United States in 2026?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In the US, surveys show most Americans define 'rich' as having a net worth of $2.2 Million USD. Statistically, having $1.17M places you in the top 5% of US households, while $5.81M represents the top 1% cutoff according to US Federal Reserve SCF benchmarks."
      }
    },
    {
      "@type": "Question",
      "name": "How rich am I compared to the rest of the world?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "According to the UBS Global Wealth Report: Having a net worth of $100,000 USD puts you in the top 10% of the entire global adult population. A net worth of $1,000,000 USD places you in the top 1.1% globally."
      }
    },
    {
      "@type": "Question",
      "name": "What are the 5 official wealth classes in America?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "1. Lower Class: Net Worth < $15,000\n2. Working / Lower Middle Class: $15,000 to $100,000\n3. Middle Class: $100,000 to $500,000\n4. Upper Middle Class: $500,000 to $1,500,000\n5. High Net Worth (Rich): $1,500,000 to $5,000,000+\n6. Ultra High Net Worth (UHNW): $30,000,000+"
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(richSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(richFaq)} slot="head" />

  <main class="px-4 py-12 max-w-4xl mx-auto space-y-12">

    <!-- Header -->
    <header class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 text-xs font-semibold">
        <span>💎 🌐</span>
        <span>US &amp; Global Wealth Tier Diagnostic</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Am I Rich? Calculator
        <span class="block text-amber-500 dark:text-amber-400 text-xl md:text-2xl mt-1 font-bold">Discover Your Exact Wealth Class &amp; Global Percentile (2026)</span>
      </h1>
      <p class="text-slate-700 dark:text-slate-400 text-base max-w-2xl mx-auto leading-relaxed">
        Enter your net worth and age below to find out where you rank across US income groups, wealth classes, and global population percentiles.
      </p>
    </header>

    <!-- Interactive Richness Tier Calculator -->
    <div class="p-6 md:p-8 rounded-3xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 shadow-xl space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Your Total Net Worth ($)</label>
          <input type="number" id="rich-networth" value="350000" step="10000" min="0" class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-slate-900 dark:text-white font-bold text-lg focus:ring-2 focus:ring-amber-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Your Age</label>
          <input type="number" id="rich-age" value="34" min="18" max="100" class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-slate-900 dark:text-white font-bold text-lg focus:ring-2 focus:ring-amber-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">Annual Household Income ($)</label>
          <input type="number" id="rich-income" value="115000" step="5000" min="0" class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/80 text-slate-900 dark:text-white font-bold text-lg focus:ring-2 focus:ring-amber-500" />
        </div>
      </div>

      <!-- Live Dynamic Tier Badge & Results -->
      <div class="p-6 rounded-2xl bg-slate-100 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 dark:border-slate-700 pb-3">
          <span class="text-sm font-medium text-slate-600 dark:text-slate-400">Your US Wealth Class:</span>
          <span id="rich-badge" class="px-3.5 py-1 rounded-full text-sm font-extrabold bg-amber-500/20 text-amber-500 dark:text-amber-400 border border-amber-500/40">
            UPPER MIDDLE CLASS
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
          <div class="p-3 bg-white dark:bg-slate-900/60 rounded-xl border border-slate-200 dark:border-slate-800">
            <div class="text-xs text-slate-500 dark:text-slate-400 mb-1">US Age-Group Percentile</div>
            <div id="rich-us-pct" class="text-xl md:text-2xl font-black text-amber-500">Top 18%</div>
          </div>
          <div class="p-3 bg-white dark:bg-slate-900/60 rounded-xl border border-slate-200 dark:border-slate-800">
            <div class="text-xs text-slate-500 dark:text-slate-400 mb-1">Global Adult Percentile</div>
            <div id="rich-global-pct" class="text-xl md:text-2xl font-black text-emerald-500">Top 3.8%</div>
          </div>
          <div class="p-3 bg-white dark:bg-slate-900/60 rounded-xl border border-slate-200 dark:border-slate-800">
            <div class="text-xs text-slate-500 dark:text-slate-400 mb-1">Distance to Top 1% (US)</div>
            <div id="rich-top1-dist" class="text-xl md:text-2xl font-black text-slate-900 dark:text-white">$5,460,000</div>
          </div>
        </div>

        <p id="rich-summary" class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed pt-2">
          At age 34 with a net worth of $350,000, you are wealthier than 82% of Americans your age, placing you in the Upper Middle Class tier. Globally, you rank in the top 3.8% of the world's population.
        </p>
      </div>
    </div>

    <!-- US Net Worth Tiers Breakdown Table -->
    <div class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">2026 US Wealth Class Thresholds</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
        <table class="w-full text-left text-sm text-slate-700 dark:text-slate-300">
          <thead class="bg-slate-100 dark:bg-slate-800/80 text-xs uppercase font-bold text-slate-900 dark:text-white">
            <tr>
              <th class="p-3.5">Wealth Class</th>
              <th class="p-3.5">Net Worth Range (USD)</th>
              <th class="p-3.5">US Percentile</th>
              <th class="p-3.5">Lifestyle Profile</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
            <tr>
              <td class="p-3.5 font-bold text-rose-500">Lower / Working</td>
              <td class="p-3.5 font-mono">&lt; $50,000</td>
              <td class="p-3.5">0 – 35th</td>
              <td class="p-3.5 text-xs text-slate-500">Living paycheck-to-paycheck, consumer debt</td>
            </tr>
            <tr>
              <td class="p-3.5 font-bold text-blue-500">Core Middle Class</td>
              <td class="p-3.5 font-mono">$100,000 – $500,000</td>
              <td class="p-3.5">50th – 75th</td>
              <td class="p-3.5 text-xs text-slate-500">Home equity + 401(k), stable emergency fund</td>
            </tr>
            <tr>
              <td class="p-3.5 font-bold text-amber-500">Upper Middle Class</td>
              <td class="p-3.5 font-mono">$500,000 – $1,500,000</td>
              <td class="p-3.5">75th – 90th</td>
              <td class="p-3.5 text-xs text-slate-500">Maxed out investments, real estate, high discretionary spend</td>
            </tr>
            <tr>
              <td class="p-3.5 font-bold text-emerald-500">High Net Worth (Rich)</td>
              <td class="p-3.5 font-mono">$1,500,000 – $5,000,000</td>
              <td class="p-3.5">90th – 99th</td>
              <td class="p-3.5 text-xs text-slate-500">Complete financial independence, dividend passive income</td>
            </tr>
            <tr>
              <td class="p-3.5 font-bold text-purple-500">Top 1% / Ultra Rich</td>
              <td class="p-3.5 font-mono">$5,810,000+</td>
              <td class="p-3.5">Top 1%</td>
              <td class="p-3.5 text-xs text-slate-500">Private wealth management, family office, multi-generational</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Related Diagnostic Tools -->
    <div class="p-6 rounded-2xl bg-slate-100 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 space-y-4">
      <div class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Related Wealth Benchmarks</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 text-sm">
        <a href="/prodigious-accumulator-of-wealth-calculator" class="p-3 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 font-medium hover:border-amber-500 transition-colors">
          📖 PAW Formula Calculator →
        </a>
        <a href="/millionaire-calculator" class="p-3 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 font-medium hover:border-amber-500 transition-colors">
          💰 Millionaire Timeline Calculator →
        </a>
        <a href="/wealth-class-calculator" class="p-3 bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200 font-medium hover:border-amber-500 transition-colors">
          👑 Wealth Class Diagnostic →
        </a>
      </div>
    </div>

  </main>
</Layout>

<script is:inline>
  function recalculateRich() {
    const networth = parseFloat(document.getElementById('rich-networth').value) || 0;
    const age = parseFloat(document.getElementById('rich-age').value) || 30;

    let tier = "MIDDLE CLASS";
    let badgeClass = "px-3.5 py-1 rounded-full text-sm font-extrabold bg-blue-500/20 text-blue-500 dark:text-blue-400 border border-blue-500/40";
    let usPct = "Top 50%";
    let globalPct = "Top 8%";

    if (networth >= 5810000) {
      tier = "TOP 1% / ULTRA RICH";
      badgeClass = "px-3.5 py-1 rounded-full text-sm font-extrabold bg-purple-500/20 text-purple-400 border border-purple-500/40";
      usPct = "Top 1%";
      globalPct = "Top 0.5%";
    } else if (networth >= 1500000) {
      tier = "HIGH NET WORTH (RICH)";
      badgeClass = "px-3.5 py-1 rounded-full text-sm font-extrabold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40";
      usPct = "Top 8%";
      globalPct = "Top 1.1%";
    } else if (networth >= 500000) {
      tier = "UPPER MIDDLE CLASS";
      badgeClass = "px-3.5 py-1 rounded-full text-sm font-extrabold bg-amber-500/20 text-amber-400 border border-amber-500/40";
      usPct = "Top 20%";
      globalPct = "Top 2.5%";
    } else if (networth >= 100000) {
      tier = "CORE MIDDLE CLASS";
      badgeClass = "px-3.5 py-1 rounded-full text-sm font-extrabold bg-blue-500/20 text-blue-400 border border-blue-500/40";
      usPct = "Top 45%";
      globalPct = "Top 9.5%";
    } else {
      tier = "WORKING / LOWER CLASS";
      badgeClass = "px-3.5 py-1 rounded-full text-sm font-extrabold bg-slate-500/20 text-slate-400 border border-slate-500/40";
      usPct = "Bottom 50%";
      globalPct = "Top 35%";
    }

    const distTop1 = Math.max(0, 5810000 - networth);

    document.getElementById('rich-badge').textContent = tier;
    document.getElementById('rich-badge').className = badgeClass;
    document.getElementById('rich-us-pct').textContent = usPct;
    document.getElementById('rich-global-pct').textContent = globalPct;
    document.getElementById('rich-top1-dist').textContent = '$' + Math.round(distTop1).toLocaleString();

    document.getElementById('rich-summary').textContent = 
      `At age ${age} with a net worth of $${Math.round(networth).toLocaleString()}, you rank in the ${usPct} of US wealth for your cohort (${tier}). Globally, having $${Math.round(networth).toLocaleString()} places you in the ${globalPct} of all adults worldwide.`;
  }

  ['rich-networth', 'rich-age', 'rich-income'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('input', recalculateRich);
  });

  recalculateRich();
</script>
