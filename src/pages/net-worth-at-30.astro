---
import Layout from '../layouts/Layout.astro';

const title = "Net Worth at Age 30 (2026) | US Wealth Percentile Benchmark";
const description = "Find out where your net worth ranks at age 30. Compare against official US Federal Reserve Survey of Consumer Finances (SCF) datasets, median benchmarks & top 10% percentiles.";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Net Worth at Age 30 Calculator",
  "url": "https://getnetworthcalculator.com/net-worth-at-30",
  "description": description,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Any",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the median net worth at age 30 in the United States?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "According to the Federal Reserve Survey of Consumer Finances (SCF), the median net worth for households under 35 (centered around age 30) is $39,000 USD."
      }
    },
    {
      "@type": "Question",
      "name": "What net worth is top 10% at age 30?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A net worth of approximately $340,000 USD puts a 30-year-old in the 90th percentile (top 10%) nationally."
      }
    },
    {
      "@type": "Question",
      "name": "How much should you have saved by age 30 according to financial rules?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The standard Fidelity savings rule suggests having 1x your annual salary saved by age 30 across retirement accounts and liquid savings."
      }
    }
  ]
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main class="px-4 py-12 max-w-4xl mx-auto space-y-12">
    <header class="text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-semibold">
        <span>🎂 📊</span>
        <span>Age 30 Milestone Benchmark (2026)</span>
      </div>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Net Worth at Age 30
        <span class="block text-emerald-600 dark:text-emerald-400 text-xl md:text-2xl mt-1 font-bold">Where Do You Rank Among 30-Year-Olds?</span>
      </h1>
      <p class="text-slate-700 dark:text-slate-400 text-base max-w-xl mx-auto leading-relaxed">
        According to US Federal Reserve SCF data, the median net worth for adults under age 35 is <strong>$39,000 USD</strong>, while the average is <strong>$183,500 USD</strong> due to high-net-worth outliers.
      </p>
    </header>

    <div class="p-6 md:p-8 rounded-3xl border border-slate-200 dark:border-slate-800/80 bg-white/95 dark:bg-slate-900/40 shadow-xl space-y-6">
      <div>
        <label for="nw-at-30-input" class="block text-sm font-bold text-slate-900 dark:text-white mb-2">Enter Your Total Net Worth at Age 30 ($)</label>
        <div class="relative">
          <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-400 font-bold text-base">$</span>
          <input type="number" id="nw-at-30-input" placeholder="39000" value="39000"
            class="w-full pl-10 pr-4 py-3.5 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white font-semibold text-lg focus:outline-none focus:ring-2 focus:ring-emerald-500/50" />
        </div>
      </div>

      <button id="nw-30-calc-btn" class="w-full py-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] text-white font-extrabold text-base transition-all tracking-wide shadow-lg shadow-emerald-900/30">
        Calculate Age 30 Percentile
      </button>

      <div id="nw-30-result" class="hidden space-y-4 pt-6 border-t border-slate-200 dark:border-slate-800 text-center">
        <p class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest">Age 30 Percentile Rank</p>
        <div id="nw-30-pct-display" class="text-5xl font-black text-emerald-500 tracking-tight">—</div>
        <p id="nw-30-desc" class="text-sm text-slate-700 dark:text-slate-300 max-w-md mx-auto"></p>

        <div class="pt-4 flex justify-center flex-wrap gap-3 text-xs">
          <a href="/net-worth-by-age-usa" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 font-bold text-slate-900 dark:text-white hover:border-emerald-500 transition-all">🇺🇸 Full US Age Breakdown →</a>
          <a href="/coast-fire-calculator" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 font-bold text-emerald-600 dark:text-emerald-400 hover:border-emerald-500 transition-all">🏝️ Coast FIRE Target at 30 →</a>
          <a href="/net-worth/100k-at-30" class="px-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 font-bold text-indigo-400 hover:border-indigo-500 transition-all">$100k at 30 Guide →</a>
        </div>
      </div>
    </div>

    <!-- Age 30 Data Table -->
    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Net Worth Percentile Table at Age 30 (US Fed SCF)</h2>
      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-slate-900 text-white dark:bg-slate-800">
              <th class="text-left px-4 py-3 font-bold">Percentile</th>
              <th class="text-right px-4 py-3 font-bold">US Net Worth at Age 30 ($)</th>
              <th class="text-left px-4 py-3 font-bold hidden sm:table-cell">Status Category</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 bg-white dark:bg-slate-900">
            <tr>
              <td class="px-4 py-3 font-semibold">25th Percentile</td>
              <td class="px-4 py-3 text-right font-bold">$7,500</td>
              <td class="px-4 py-3 text-slate-500 hidden sm:table-cell">Building Foundations</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-semibold">50th Percentile (Median)</td>
              <td class="px-4 py-3 text-right font-bold text-emerald-600 dark:text-emerald-400">$39,000</td>
              <td class="px-4 py-3 text-slate-500 hidden sm:table-cell">National Middle Benchmark</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-semibold">75th Percentile</td>
              <td class="px-4 py-3 text-right font-bold">$115,000</td>
              <td class="px-4 py-3 text-slate-500 hidden sm:table-cell">Strong Financial Cushion</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-semibold">90th Percentile (Top 10%)</td>
              <td class="px-4 py-3 text-right font-bold text-purple-600 dark:text-purple-400">$340,000</td>
              <td class="px-4 py-3 text-slate-500 hidden sm:table-cell">High Achiever Tier</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-semibold">99th Percentile (Top 1%)</td>
              <td class="px-4 py-3 text-right font-bold text-amber-500">$1,250,000</td>
              <td class="px-4 py-3 text-slate-500 hidden sm:table-cell">Top 1% Millennial Millionaire</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Comprehensive Age 30 Financial Strategy Guide -->
    <article class="bg-slate-900/40 border border-slate-800 rounded-3xl p-6 md:p-8 space-y-6 text-slate-300 text-sm leading-relaxed">
      <h2 class="text-2xl font-bold text-white">The Financial Playbook for Age 30: Turning Savings into Compound Growth</h2>
      
      <p>
        Turning 30 is widely recognized by financial planners as the primary inflection point in wealth accumulation. In your 20s, personal finance is largely defensive: paying off student debt, establishing emergency reserves, and securing initial employment. By age 30, the focus shifts toward aggressive capital compounding and asset accumulation.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-4">
        <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2">
          <h3 class="font-bold text-white text-base">The Fidelity 1x Salary Rule</h3>
          <p class="text-xs text-slate-400">
            A common retirement benchmark established by Fidelity Investments recommends having an amount equal to <strong>1x your annual gross salary</strong> saved by age 30. For someone earning $75,000, having $75,000 across retirement and investment accounts keeps you on track for a standard retirement at age 65–67.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2">
          <h3 class="font-bold text-white text-base">The Power of the First $100k</h3>
          <p class="text-xs text-slate-400">
            Famed investor Charlie Munger famously noted that the first $100,000 is the hardest milestone because interest earnings are minimal. At $100k, an 8% annual market return generates $8,000 per year passively, multiplying your personal savings contributions without additional labor.
          </p>
        </div>
      </div>

      <h3 class="text-lg font-bold text-white pt-2">Key Financial Priorities at Age 30</h3>
      <ul class="list-disc pl-5 space-y-2 text-xs text-slate-300">
        <li><strong>Capture Full Employer 401(k) Match:</strong> Never leave free employer match money on the table; it represents an immediate 50% to 100% guaranteed return on investment.</li>
        <li><strong>Open & Max a Roth IRA:</strong> Contributing the annual maximum ($7,000) into low-cost index funds provides decades of tax-free growth and tax-free distributions in retirement.</li>
        <li><strong>Build a 3–6 Month Cash Runway:</strong> Store liquid reserves in a High-Yield Savings Account (HYSA) paying top market yields rather than traditional low-yield checking accounts.</li>
      </ul>
    </article>
  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('nw-at-30-input');
    const btn = document.getElementById('nw-30-calc-btn');
    const result = document.getElementById('nw-30-result');
    const pctDisplay = document.getElementById('nw-30-pct-display');
    const desc = document.getElementById('nw-30-desc');

    btn?.addEventListener('click', () => {
      const val = parseFloat(input.value) || 0;
      let pct = 50;
      if (val >= 1250000) pct = 99;
      else if (val >= 340000) pct = 90;
      else if (val >= 115000) pct = 75;
      else if (val >= 39000) pct = 50;
      else if (val >= 7500) pct = 25;
      else pct = 10;

      pctDisplay.textContent = `${pct}th Percentile`;
      desc.textContent = `At age 30, a net worth of $${val.toLocaleString()} puts you in the top ${100 - pct}% of your age group in America.`;
      result.classList.remove('hidden');
    });
  });
</script>
